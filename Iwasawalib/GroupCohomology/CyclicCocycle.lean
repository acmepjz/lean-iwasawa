module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import Mathlib.RepresentationTheory.Homological.GroupCohomology.LowDegree

@[expose] public section

/-!
# Multiplicative 1-cocycles of a finite cyclic group

Let `G` be a finite group generated by `σ` acting on a commutative group `M`.  A multiplicative
1-cocycle `f : G → M` is determined by its value `f σ`, and the possible values are exactly the
`x : M` of norm one.  Consequently `H¹(G, M) = 0` is *equivalent* to the elementary statement

`∀ x : M, (∏ g : G, g • x) = 1 → ∃ y : M, σ • y / y = x`,

which is the description of `Ĥ¹` for a cyclic group.  The version with values constrained to a
`G`-stable subgroup `N ≤ M` is `CyclicCocycle.exists_mem_of_isMulCocycle₁`, and it is exactly
the shape needed for the local condition at an unramified place.

## Main definitions

* `CyclicCocycle.mulNorm`: the norm `x ↦ ∏ g : G, g • x` of a multiplicative `G`-module.

## Main statements

* `CyclicCocycle.isMulCocycle₁_pow`: `f (σ ^ n) = ∏ i < n, σ ^ i • f σ`.
* `CyclicCocycle.mulNorm_apply_generator`: the value of a 1-cocycle at a generator has norm `1`.
* `CyclicCocycle.eq_of_apply_generator_eq`: a 1-cocycle is determined by its value at a
  generator.
* `CyclicCocycle.isMulCoboundary₁_of_mulNorm`: `Ĥ¹ = 0` implies `H¹ = 0`.
* `CyclicCocycle.exists_mem_of_isMulCocycle₁`: the same with a witness in a subgroup.
-/

namespace CyclicCocycle

open Finset groupCohomology

section

variable {G M : Type*} [Group G] [CommGroup M] [MulDistribMulAction G M]

/-- The norm `x ↦ ∏ g : G, g • x` of a multiplicative `G`-module. -/
def mulNorm [Fintype G] (x : M) : M := ∏ g : G, g • x

theorem mulNorm_def [Fintype G] (x : M) : mulNorm (G := G) x = ∏ g : G, g • x := rfl

/-- The value of a multiplicative 1-cocycle at a power of `σ`. -/
theorem isMulCocycle₁_pow {f : G → M} (hf : IsMulCocycle₁ f) (σ : G) (n : ℕ) :
    f (σ ^ n) = ∏ i ∈ range n, (σ ^ i) • f σ := by
  induction n with
  | zero => simpa using map_one_of_isMulCocycle₁ hf
  | succ n ih =>
    rw [pow_succ', hf σ (σ ^ n), ih, Finset.prod_range_succ']
    simp only [pow_zero, one_smul, smul_prod', smul_smul, ← pow_succ']

variable [Fintype G] {σ : G}

/-- For a finite cyclic group generated by `σ`, the norm is the product over the first
`Nat.card G` powers of `σ`. -/
theorem mulNorm_eq_prod_range (hg : ∀ x : G, x ∈ Subgroup.zpowers σ) (x : M) :
    mulNorm (G := G) x = ∏ i ∈ range (Nat.card G), (σ ^ i) • x := by
  classical
  have himg : Finset.image (fun i ↦ σ ^ i) (range (Nat.card G)) = univ :=
    IsCyclic.image_range_card hg
  have hinj : ∀ i ∈ range (Nat.card G), ∀ j ∈ range (Nat.card G), σ ^ i = σ ^ j → i = j := by
    intro i hi j hj hij
    rw [mem_range, ← orderOf_eq_card_of_forall_mem_zpowers hg] at hi hj
    exact pow_injOn_Iio_orderOf hi hj hij
  rw [mulNorm_def, ← himg, Finset.prod_image hinj]

/-- The value of a multiplicative 1-cocycle at a generator has norm `1`. -/
theorem mulNorm_apply_generator (hg : ∀ x : G, x ∈ Subgroup.zpowers σ) {f : G → M}
    (hf : IsMulCocycle₁ f) : mulNorm (G := G) (f σ) = 1 := by
  rw [mulNorm_eq_prod_range hg, ← isMulCocycle₁_pow hf σ (Nat.card G),
    ← orderOf_eq_card_of_forall_mem_zpowers hg, pow_orderOf_eq_one,
    map_one_of_isMulCocycle₁ hf]

/-- A multiplicative 1-cocycle of a finite cyclic group is determined by its value at a
generator. -/
theorem eq_of_apply_generator_eq (hg : ∀ x : G, x ∈ Subgroup.zpowers σ) {f f' : G → M}
    (hf : IsMulCocycle₁ f) (hf' : IsMulCocycle₁ f') (h : f σ = f' σ) : f = f' := by
  funext g
  obtain ⟨n, rfl⟩ := (mem_powers_iff_mem_zpowers (x := σ) (y := g)).2 (hg g)
  rw [isMulCocycle₁_pow hf, isMulCocycle₁_pow hf', h]

/-- `x ↦ (g • x / x)` is a multiplicative 1-cocycle. -/
theorem isMulCocycle₁_smul_div (y : M) : IsMulCocycle₁ fun g : G ↦ g • y / y := by
  intro g h
  show (g * h) • y / y = g • (h • y / y) * (g • y / y)
  rw [smul_div', mul_smul, div_mul_div_cancel]

end

section

variable {G M : Type*} [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M] {σ : G}

/-- **`Ĥ¹ = 0` implies `H¹ = 0`** for a finite cyclic group: if every element of norm `1` is of
the form `σ • y / y`, then every multiplicative 1-cocycle is a 1-coboundary. -/
theorem isMulCoboundary₁_of_mulNorm (hg : ∀ x : G, x ∈ Subgroup.zpowers σ)
    (h : ∀ x : M, mulNorm (G := G) x = 1 → ∃ y : M, σ • y / y = x)
    {f : G → M} (hf : IsMulCocycle₁ f) : IsMulCoboundary₁ f := by
  obtain ⟨y, hy⟩ := h (f σ) (mulNorm_apply_generator hg hf)
  refine ⟨y, fun g ↦ ?_⟩
  exact congrFun (eq_of_apply_generator_eq hg (isMulCocycle₁_smul_div y) hf hy) g

/-- **The subgroup form.**  If every element of a `G`-stable subgroup `N` with norm `1` is of
the form `σ • y / y` with `y ∈ N`, then every 1-cocycle with values in `N` is trivialised by an
element of `N`. -/
theorem exists_mem_of_isMulCocycle₁ (hg : ∀ x : G, x ∈ Subgroup.zpowers σ) {N : Subgroup M}
    (h : ∀ x ∈ N, mulNorm (G := G) x = 1 → ∃ y ∈ N, σ • y / y = x)
    {f : G → M} (hf : IsMulCocycle₁ f) (hfN : ∀ g, f g ∈ N) :
    ∃ b ∈ N, ∀ g, g • b / b = f g := by
  obtain ⟨y, hyN, hy⟩ := h (f σ) (hfN σ) (mulNorm_apply_generator hg hf)
  refine ⟨y, hyN, fun g ↦ ?_⟩
  exact congrFun (eq_of_apply_generator_eq hg (isMulCocycle₁_smul_div y) hf hy) g

end

end CyclicCocycle
