module

public import Iwasawalib.GroupCohomology.CyclicTate
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

@[expose] public section

/-!
# Turning an order computation into a canonical isomorphism

Every cohomological computation of global class field theory in this repository produces a
**number**: `h(C_L) = [L : K]`, `#Ĥ⁰(C_L) ≥ [L : K]`, `[C_K : N C_L] = #Ĥ⁰(C_L)`.  Artin
reciprocity is not a number, it is a canonical isomorphism `C_K / N C_L ≅ Gal(L/K)`.  This file
isolates the elementary mechanism that converts the first into the second, and it is the only
step of Tate's theorem that a cyclic group makes unnecessary to prove by cup products:

> a **surjective** homomorphism between finite groups of the **same order** is an isomorphism.

So a homomorphism `Ĥ⁰(G, M) → G` which is merely known to be surjective — no injectivity, no
Brauer–Hasse–Noether, no fundamental class — is upgraded to an isomorphism by the order
statement `#Ĥ⁰(G, M) = #G` that this library already proves.  Dually, an injective one is
upgraded by the same count; both directions are recorded, because global class field theory
produces the surjection (Frobenius elements generate) and local class field theory produces the
injection (the invariant map).

## Main statements

* `AddEquiv.ofSurjectiveOfCardEq`, `AddEquiv.ofInjectiveOfCardEq` : the mechanism, for additive
  groups.
* `MulEquiv.ofSurjectiveOfCardEq`, `MulEquiv.ofInjectiveOfCardEq` : the multiplicative form.
* `CyclicTate.tateH0AddEquivOfSurjective` : `Ĥ⁰(G, M) ≃+ A` from a surjection and the count.
* `CyclicTate.tateH0MulEquivOfSurjective` : the same with a multiplicative target, which is the
  shape `C_K / N C_L ≃* Gal(L/K)` of the reciprocity isomorphism.
* `CyclicTate.zmodAddEquivOfGeneratorMul` : `ZMod #G ≃+ Additive G` for a group generated by one
  element, the normalisation `(1/n)ℤ/ℤ ≅ G` of the invariant map.
-/

noncomputable section

/-! ## Finiteness bookkeeping -/

namespace Nat

theorem finite_of_card_eq_of_finite {α β : Type*} [Finite β] [Nonempty β]
    (h : Nat.card α = Nat.card β) : Finite α :=
  Nat.finite_of_card_ne_zero (h ▸ Nat.card_pos.ne')

end Nat

/-! ## A surjection or an injection, plus a count, is an isomorphism -/

namespace AddEquiv

variable {A B : Type*} [AddGroup A] [AddGroup B]

/-- **A surjective homomorphism between groups of the same finite order is bijective.** -/
theorem bijective_of_surjective_of_card_eq [Finite B] (f : A →+ B)
    (hf : Function.Surjective f) (hcard : Nat.card A = Nat.card B) : Function.Bijective f := by
  haveI : Finite A := Nat.finite_of_card_eq_of_finite hcard
  exact (Nat.bijective_iff_surjective_and_card f).2 ⟨hf, hcard⟩

/-- **An injective homomorphism between groups of the same finite order is bijective.** -/
theorem bijective_of_injective_of_card_eq [Finite B] (f : A →+ B)
    (hf : Function.Injective f) (hcard : Nat.card A = Nat.card B) : Function.Bijective f := by
  haveI : Finite A := Nat.finite_of_card_eq_of_finite hcard
  exact (Nat.bijective_iff_injective_and_card f).2 ⟨hf, hcard⟩

/-- **The isomorphism carried by a surjection between groups of the same finite order.** -/
def ofSurjectiveOfCardEq [Finite B] (f : A →+ B) (hf : Function.Surjective f)
    (hcard : Nat.card A = Nat.card B) : A ≃+ B :=
  AddEquiv.ofBijective f (bijective_of_surjective_of_card_eq f hf hcard)

@[simp] theorem ofSurjectiveOfCardEq_apply [Finite B] (f : A →+ B) (hf : Function.Surjective f)
    (hcard : Nat.card A = Nat.card B) (a : A) : ofSurjectiveOfCardEq f hf hcard a = f a := rfl

/-- **The isomorphism carried by an injection between groups of the same finite order.** -/
def ofInjectiveOfCardEq [Finite B] (f : A →+ B) (hf : Function.Injective f)
    (hcard : Nat.card A = Nat.card B) : A ≃+ B :=
  AddEquiv.ofBijective f (bijective_of_injective_of_card_eq f hf hcard)

@[simp] theorem ofInjectiveOfCardEq_apply [Finite B] (f : A →+ B) (hf : Function.Injective f)
    (hcard : Nat.card A = Nat.card B) (a : A) : ofInjectiveOfCardEq f hf hcard a = f a := rfl

end AddEquiv

namespace MulEquiv

variable {A B : Type*} [Group A] [Group B]

/-- **A surjective homomorphism between groups of the same finite order is bijective.** -/
theorem bijective_of_surjective_of_card_eq [Finite B] (f : A →* B)
    (hf : Function.Surjective f) (hcard : Nat.card A = Nat.card B) : Function.Bijective f := by
  haveI : Finite A := Nat.finite_of_card_eq_of_finite hcard
  exact (Nat.bijective_iff_surjective_and_card f).2 ⟨hf, hcard⟩

/-- **An injective homomorphism between groups of the same finite order is bijective.** -/
theorem bijective_of_injective_of_card_eq [Finite B] (f : A →* B)
    (hf : Function.Injective f) (hcard : Nat.card A = Nat.card B) : Function.Bijective f := by
  haveI : Finite A := Nat.finite_of_card_eq_of_finite hcard
  exact (Nat.bijective_iff_injective_and_card f).2 ⟨hf, hcard⟩

/-- **The isomorphism carried by a surjection between groups of the same finite order.** -/
def ofSurjectiveOfCardEq [Finite B] (f : A →* B) (hf : Function.Surjective f)
    (hcard : Nat.card A = Nat.card B) : A ≃* B :=
  MulEquiv.ofBijective f (bijective_of_surjective_of_card_eq f hf hcard)

@[simp] theorem ofSurjectiveOfCardEq_apply [Finite B] (f : A →* B) (hf : Function.Surjective f)
    (hcard : Nat.card A = Nat.card B) (a : A) : ofSurjectiveOfCardEq f hf hcard a = f a := rfl

/-- **The isomorphism carried by an injection between groups of the same finite order.** -/
def ofInjectiveOfCardEq [Finite B] (f : A →* B) (hf : Function.Injective f)
    (hcard : Nat.card A = Nat.card B) : A ≃* B :=
  MulEquiv.ofBijective f (bijective_of_injective_of_card_eq f hf hcard)

@[simp] theorem ofInjectiveOfCardEq_apply [Finite B] (f : A →* B) (hf : Function.Injective f)
    (hcard : Nat.card A = Nat.card B) (a : A) : ofInjectiveOfCardEq f hf hcard a = f a := rfl

end MulEquiv

/-! ## The Tate group of a finite cyclic group -/

namespace CyclicTate

variable {G : Type*} [Group G] [Fintype G] {M : Type*} [AddCommGroup M]
  [DistribMulAction G M] {σ : G}

/-- **`Ĥ⁰(G, M) ≃+ A` from a surjection onto `A` and the order computation `#Ĥ⁰(G, M) = #A`.**

This is the shape in which the reciprocity isomorphism is obtained for a cyclic extension: the
surjection is the global Artin map, and the count is the norm-index theorem. -/
def tateH0AddEquivOfSurjective {A : Type*} [AddGroup A] [Finite A] (f : TateH0 G M σ →+ A)
    (hf : Function.Surjective f) (hcard : Nat.card (TateH0 G M σ) = Nat.card A) :
    TateH0 G M σ ≃+ A :=
  AddEquiv.ofSurjectiveOfCardEq f hf hcard

@[simp] theorem tateH0AddEquivOfSurjective_apply {A : Type*} [AddGroup A] [Finite A]
    (f : TateH0 G M σ →+ A) (hf : Function.Surjective f)
    (hcard : Nat.card (TateH0 G M σ) = Nat.card A) (t : TateH0 G M σ) :
    tateH0AddEquivOfSurjective f hf hcard t = f t := rfl

/-- **`Ĥ⁰(G, M) ≃+ A` from an injection into `A` and the order computation.**  This is the shape
in which the *local* reciprocity isomorphism is obtained: the injection is the invariant map. -/
def tateH0AddEquivOfInjective {A : Type*} [AddGroup A] [Finite A] (f : TateH0 G M σ →+ A)
    (hf : Function.Injective f) (hcard : Nat.card (TateH0 G M σ) = Nat.card A) :
    TateH0 G M σ ≃+ A :=
  AddEquiv.ofInjectiveOfCardEq f hf hcard

@[simp] theorem tateH0AddEquivOfInjective_apply {A : Type*} [AddGroup A] [Finite A]
    (f : TateH0 G M σ →+ A) (hf : Function.Injective f)
    (hcard : Nat.card (TateH0 G M σ) = Nat.card A) (t : TateH0 G M σ) :
    tateH0AddEquivOfInjective f hf hcard t = f t := rfl

/-- **`Ĥ⁰(G, M) ≃* H` for a multiplicative target**, from a surjection and the count.  `Ĥ⁰` is
an additive quotient by construction, so the statement `C_K / N C_L ≃* Gal(L/K)` is this one
with `H = Gal(L/K)`. -/
def tateH0MulEquivOfSurjective {H : Type*} [Group H] [Finite H]
    (f : TateH0 G M σ →+ Additive H) (hf : Function.Surjective f)
    (hcard : Nat.card (TateH0 G M σ) = Nat.card H) :
    Multiplicative (TateH0 G M σ) ≃* H :=
  AddEquiv.toMultiplicativeLeft (AddEquiv.ofSurjectiveOfCardEq f hf
    (hcard.trans (Nat.card_eq_of_bijective _ (Additive.ofMul (α := H)).bijective)))

@[simp] theorem tateH0MulEquivOfSurjective_apply {H : Type*} [Group H] [Finite H]
    (f : TateH0 G M σ →+ Additive H) (hf : Function.Surjective f)
    (hcard : Nat.card (TateH0 G M σ) = Nat.card H) (t : Multiplicative (TateH0 G M σ)) :
    tateH0MulEquivOfSurjective f hf hcard t = Additive.toMul (f t.toAdd) := rfl

/-! ## The normalisation `ZMod #G ≅ G` -/

/-- **A finite group generated by one element is `ZMod #G`, additively**, with `1 ↦ σ`.  This is
the identification `(1/n)ℤ/ℤ ≅ Gal(L/K)` under which an invariant map becomes a reciprocity
map. -/
def zmodAddEquivOfGeneratorMul (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) :
    ZMod (Nat.card G) ≃+ Additive G :=
  zmodAddEquivOfGenerator (G := Additive G) (g := Additive.ofMul σ)
    (fun x ↦ by
      obtain ⟨k, hk⟩ := hgen x.toMul
      refine AddSubgroup.mem_zmultiples_iff.2 ⟨(k : ℤ), ?_⟩
      rw [natCast_zsmul, ← ofMul_pow, hk]
      rfl)
    rfl

omit [Fintype G] in
@[simp] theorem zmodAddEquivOfGeneratorMul_intCast (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (i : ℤ) :
    zmodAddEquivOfGeneratorMul hgen (i : ZMod (Nat.card G)) = Additive.ofMul (σ ^ i) :=
  (zmodAddEquivOfGenerator_apply_intCast _ _ i).trans (ofMul_zpow i σ).symm

omit [Fintype G] in
@[simp] theorem zmodAddEquivOfGeneratorMul_one (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) :
    zmodAddEquivOfGeneratorMul hgen 1 = Additive.ofMul σ :=
  zmodAddEquivOfGenerator_apply_one _ _

end CyclicTate
