module

public import Mathlib.RepresentationTheory.Homological.GroupCohomology.FiniteCyclic
public import Mathlib.RepresentationTheory.Homological.GroupCohomology.LowDegree

@[expose] public section

/-!
# Tate cohomology of a finite cyclic group, concretely

Let `G` be a finite group generated by `σ` and let `M` be a `G`-module.  Write
`N : M → M` for the norm `x ↦ ∑ g : G, g • x` and `D : M → M` for `x ↦ σ • x - x`.  Both
composites `N ∘ D` and `D ∘ N` vanish, and when `G = ⟨σ⟩` the cohomology of the resulting
two-periodic complex is the Tate cohomology of `G` with coefficients in `M`:

* `CyclicTate.TateH0 G M σ = ker D / im N = M^G / N M` is `Ĥ⁰(G, M)`;
* `CyclicTate.TateH1 G M σ = ker N / im D` is `Ĥ¹(G, M)`.

These are *definitions as explicit quotient groups*, which is what makes the counting
arguments behind the Herbrand quotient possible.  The comparison with Mathlib's `groupCohomology` IS available, but it lives downstream in
`Iwasawalib/NumberTheory/CFT/CyclicTateComparison.lean` (it cannot live here, since it is
built from `Rep.FiniteCyclicGroup.groupCohomologyπEven`/`πOdd`): see
`CyclicTate.tateH0EquivGroupCohomology`, `CyclicTate.tateH1EquivGroupCohomology` and
`CyclicTate.herbrand_eq_card_groupCohomology`, the last of which identifies `herbrand` with
`#H²/#H¹` of the genuine group cohomology. That comparison requires `[CommGroup G]` with `G`
in the same universe as `ℤ`, a constraint inherited from `Rep.FiniteCyclicGroup`. In degree 1
the link is also available directly, without that constraint, via
`CyclicCocycle.isMulCoboundary₁_of_mulNorm` and `CyclicCocycleAdd.isZero_H1_of_normHom`.

## Main definitions

* `CyclicTate.normHom`, `CyclicTate.subHom`: the two maps `N` and `D`.
* `CyclicTate.TateH0`, `CyclicTate.TateH1`: the two Tate cohomology groups.

## Main statements

* `CyclicTate.tateH0_subsingleton_iff`, `CyclicTate.tateH1_subsingleton_iff`: the two
  vanishing criteria, in elementary terms.
-/

namespace CyclicTate

section Defs

variable (G : Type*) [Group G] [Fintype G] (M : Type*) [AddCommGroup M] [DistribMulAction G M]

/-- The norm endomorphism `x ↦ ∑ g : G, g • x` of a `G`-module. -/
def normHom : M →+ M := ∑ g : G, DistribSMul.toAddMonoidHom M g

variable {G M}

@[simp] theorem normHom_apply (x : M) : normHom G M x = ∑ g : G, g • x := by
  simp [normHom]

variable (G) in
/-- The norm of an element is `G`-invariant. -/
theorem smul_normHom (g : G) (x : M) : g • normHom G M x = normHom G M x := by
  simp only [normHom_apply, Finset.smul_sum, smul_smul]
  exact Fintype.sum_equiv (Equiv.mulLeft g) _ _ fun _ ↦ rfl

variable (G) in
/-- The norm is unchanged by precomposing with the action. -/
theorem normHom_smul (g : G) (x : M) : normHom G M (g • x) = normHom G M x := by
  simp only [normHom_apply, smul_smul]
  exact Fintype.sum_equiv (Equiv.mulRight g) _ _ fun _ ↦ rfl

end Defs

section Sub

variable {G : Type*} [Group G] {M : Type*} [AddCommGroup M] [DistribMulAction G M]

/-- The endomorphism `x ↦ σ • x - x` of a `G`-module. -/
def subHom (σ : G) : M →+ M := DistribSMul.toAddMonoidHom M σ - AddMonoidHom.id M

@[simp] theorem subHom_apply (σ : G) (x : M) : subHom σ x = σ • x - x := rfl

variable [Fintype G]

theorem subHom_normHom (σ : G) (x : M) : subHom σ (normHom G M x) = 0 := by
  rw [subHom_apply, smul_normHom, sub_self]

theorem normHom_subHom (σ : G) (x : M) : normHom G M (subHom σ x) = 0 := by
  rw [subHom_apply, map_sub, normHom_smul, sub_self]

end Sub

section Quot

variable (G : Type*) [Group G] [Fintype G] (M : Type*) [AddCommGroup M] [DistribMulAction G M]

/-- The kernel of `x ↦ σ • x - x`; for a cyclic `G = ⟨σ⟩` this is the submodule of
invariants `M^G`. -/
def kerSub (σ : G) : AddSubgroup M := (subHom (M := M) σ).ker

/-- The image of the norm map. -/
def rangeNorm : AddSubgroup M := (normHom G M).range

/-- The kernel of the norm map. -/
def kerNorm : AddSubgroup M := (normHom G M).ker

/-- The image of `x ↦ σ • x - x`. -/
def rangeSub (σ : G) : AddSubgroup M := (subHom (M := M) σ).range

variable {G M}

omit [Fintype G] in
@[simp] theorem mem_kerSub {σ : G} {x : M} : x ∈ kerSub G M σ ↔ σ • x = x := by
  simp [kerSub, AddMonoidHom.mem_ker, sub_eq_zero]

@[simp] theorem mem_rangeNorm {x : M} : x ∈ rangeNorm G M ↔ ∃ y, normHom G M y = x := by
  simp [rangeNorm]

@[simp] theorem mem_kerNorm {x : M} : x ∈ kerNorm G M ↔ normHom G M x = 0 := by
  simp [kerNorm, AddMonoidHom.mem_ker]

omit [Fintype G] in
@[simp] theorem mem_rangeSub {σ : G} {x : M} : x ∈ rangeSub G M σ ↔ ∃ y : M, σ • y - y = x := by
  simp [rangeSub]

theorem rangeNorm_le_kerSub (σ : G) : rangeNorm G M ≤ kerSub G M σ := by
  rintro _ ⟨y, rfl⟩
  simpa using smul_normHom G σ y

theorem rangeSub_le_kerNorm (σ : G) : rangeSub G M σ ≤ kerNorm G M := by
  rintro _ ⟨y, rfl⟩
  simpa using normHom_subHom σ y

variable (G M)

/-- `Ĥ⁰(G, M) = M^G / N M` for a finite cyclic group `G = ⟨σ⟩`. -/
abbrev TateH0 (σ : G) : Type _ :=
  kerSub G M σ ⧸ (rangeNorm G M).addSubgroupOf (kerSub G M σ)

/-- `Ĥ¹(G, M) = ker N / (σ - 1) M` for a finite cyclic group `G = ⟨σ⟩`. -/
abbrev TateH1 (σ : G) : Type _ :=
  kerNorm G M ⧸ (rangeSub G M σ).addSubgroupOf (kerNorm G M)

variable {G M}

theorem tateH0_mk_eq_zero_iff {σ : G} (x : kerSub G M σ) :
    (QuotientAddGroup.mk x : TateH0 G M σ) = 0 ↔ (x : M) ∈ rangeNorm G M :=
  QuotientAddGroup.eq_zero_iff _

theorem tateH1_mk_eq_zero_iff {σ : G} (x : kerNorm G M) :
    (QuotientAddGroup.mk x : TateH1 G M σ) = 0 ↔ (x : M) ∈ rangeSub G M σ :=
  QuotientAddGroup.eq_zero_iff _

/-- `Ĥ⁰(G, M) = 0` exactly when every `σ`-invariant element is a norm. -/
theorem tateH0_subsingleton_iff (σ : G) :
    Subsingleton (TateH0 G M σ) ↔ ∀ x : M, σ • x = x → ∃ y : M, normHom G M y = x := by
  constructor
  · intro h x hx
    have hmem : x ∈ kerSub G M σ := mem_kerSub.2 hx
    have := (tateH0_mk_eq_zero_iff (σ := σ) ⟨x, hmem⟩).1 (Subsingleton.elim _ _)
    simpa using this
  · intro h
    refine ⟨fun a b ↦ ?_⟩
    induction a using QuotientAddGroup.induction_on with | _ a =>
    induction b using QuotientAddGroup.induction_on with | _ b =>
    rw [← sub_eq_zero, ← QuotientAddGroup.mk_sub, tateH0_mk_eq_zero_iff]
    exact mem_rangeNorm.2 (h _ (mem_kerSub.1 (a - b).2))

/-- `Ĥ¹(G, M) = 0` exactly when every element of norm zero has the form `σ • y - y`. -/
theorem tateH1_subsingleton_iff (σ : G) :
    Subsingleton (TateH1 G M σ) ↔ ∀ x : M, normHom G M x = 0 → ∃ y : M, σ • y - y = x := by
  constructor
  · intro h x hx
    have hmem : x ∈ kerNorm G M := mem_kerNorm.2 hx
    have := (tateH1_mk_eq_zero_iff (σ := σ) ⟨x, hmem⟩).1 (Subsingleton.elim _ _)
    simpa using this
  · intro h
    refine ⟨fun a b ↦ ?_⟩
    induction a using QuotientAddGroup.induction_on with | _ a =>
    induction b using QuotientAddGroup.induction_on with | _ b =>
    rw [← sub_eq_zero, ← QuotientAddGroup.mk_sub, tateH1_mk_eq_zero_iff]
    exact mem_rangeSub.2 (h _ (mem_kerNorm.1 (a - b).2))

/-! ### The `mk` interface -/

variable (σ : G)

/-- The class in `Ĥ⁰(G, M)` of a `σ`-invariant element. -/
def TateH0.mk {x : M} (hx : σ • x = x) : TateH0 G M σ :=
  QuotientAddGroup.mk ⟨x, mem_kerSub.2 hx⟩

/-- The class in `Ĥ¹(G, M)` of an element of norm zero. -/
def TateH1.mk {x : M} (hx : normHom G M x = 0) : TateH1 G M σ :=
  QuotientAddGroup.mk ⟨x, mem_kerNorm.2 hx⟩

variable {σ}

theorem TateH0.mk_add {x y : M} (hx : σ • x = x) (hy : σ • y = y) :
    TateH0.mk σ hx + TateH0.mk σ hy = TateH0.mk σ (x := x + y) (by rw [smul_add, hx, hy]) := rfl

theorem TateH1.mk_add {x y : M} (hx : normHom G M x = 0) (hy : normHom G M y = 0) :
    TateH1.mk σ hx + TateH1.mk σ hy = TateH1.mk σ (x := x + y) (by rw [map_add, hx, hy, add_zero]) :=
  rfl

theorem TateH0.mk_surjective (t : TateH0 G M σ) : ∃ (x : M) (hx : σ • x = x), TateH0.mk σ hx = t := by
  induction t using QuotientAddGroup.induction_on with | _ a =>
  exact ⟨a, mem_kerSub.1 a.2, rfl⟩

theorem TateH1.mk_surjective (t : TateH1 G M σ) :
    ∃ (x : M) (hx : normHom G M x = 0), TateH1.mk σ hx = t := by
  induction t using QuotientAddGroup.induction_on with | _ a =>
  exact ⟨a, mem_kerNorm.1 a.2, rfl⟩

theorem TateH0.mk_eq_zero_iff {x : M} (hx : σ • x = x) :
    TateH0.mk σ hx = 0 ↔ ∃ y : M, normHom G M y = x :=
  (QuotientAddGroup.eq_zero_iff _).trans mem_rangeNorm

theorem TateH1.mk_eq_zero_iff {x : M} (hx : normHom G M x = 0) :
    TateH1.mk σ hx = 0 ↔ ∃ y : M, σ • y - y = x :=
  (QuotientAddGroup.eq_zero_iff _).trans mem_rangeSub

theorem TateH0.mk_eq_mk_iff {x y : M} (hx : σ • x = x) (hy : σ • y = y) :
    TateH0.mk σ hx = TateH0.mk σ hy ↔ ∃ z : M, normHom G M z = x - y := by
  rw [← sub_eq_zero]
  exact (QuotientAddGroup.eq_zero_iff _).trans mem_rangeNorm

theorem TateH1.mk_eq_mk_iff {x y : M} (hx : normHom G M x = 0) (hy : normHom G M y = 0) :
    TateH1.mk σ hx = TateH1.mk σ hy ↔ ∃ z : M, σ • z - z = x - y := by
  rw [← sub_eq_zero]
  exact (QuotientAddGroup.eq_zero_iff _).trans mem_rangeSub

end Quot

/-! ## Functoriality -/

section Functoriality

variable {G : Type*} [Group G] [Fintype G] {A B : Type*} [AddCommGroup A] [AddCommGroup B]
  [DistribMulAction G A] [DistribMulAction G B] (f : A →+[G] B) {σ : G}

theorem map_normHom (x : A) : f (normHom G A x) = normHom G B (f x) := by
  simp only [normHom_apply, map_sum, map_smul]

omit [Fintype G] in
theorem map_subHom (σ : G) (x : A) : f (subHom σ x) = subHom σ (f x) := by
  simp only [subHom_apply, map_sub, map_smul]

/-- The restriction of an equivariant map to the `σ`-invariants. -/
def kerSubMap (σ : G) : kerSub G A σ →+ kerSub G B σ :=
  AddMonoidHom.codRestrict (f.toAddMonoidHom.comp (kerSub G A σ).subtype) _ fun x ↦
    mem_kerSub.2 (show σ • f (x : A) = f (x : A) by rw [← map_smul, mem_kerSub.1 x.2])

/-- The restriction of an equivariant map to the kernel of the norm. -/
def kerNormMap : kerNorm G A →+ kerNorm G B :=
  AddMonoidHom.codRestrict (f.toAddMonoidHom.comp (kerNorm G A).subtype) _ fun x ↦
    mem_kerNorm.2 (show normHom G B (f (x : A)) = 0 by
      rw [← map_normHom, mem_kerNorm.1 x.2, map_zero])

/-- `Ĥ⁰` is functorial. -/
def tateH0Map (σ : G) : TateH0 G A σ →+ TateH0 G B σ :=
  QuotientAddGroup.map _ _ (kerSubMap f σ) (by
    rintro ⟨x, hx⟩ hmem
    obtain ⟨y, rfl⟩ := mem_rangeNorm.1 (show x ∈ rangeNorm G A from hmem)
    exact show f (normHom G A y) ∈ rangeNorm G B from
      mem_rangeNorm.2 ⟨f y, (map_normHom f y).symm⟩)

/-- `Ĥ¹` is functorial. -/
def tateH1Map (σ : G) : TateH1 G A σ →+ TateH1 G B σ :=
  QuotientAddGroup.map _ _ (kerNormMap f) (by
    rintro ⟨x, hx⟩ hmem
    obtain ⟨y, rfl⟩ := mem_rangeSub.1 (show x ∈ rangeSub G A σ from hmem)
    exact show f (σ • y - y) ∈ rangeSub G B σ from
      mem_rangeSub.2 ⟨f y, by rw [map_sub, map_smul]⟩)

@[simp] theorem tateH0Map_mk {x : A} (hx : σ • x = x) :
    tateH0Map f σ (TateH0.mk σ hx) = TateH0.mk σ (x := f x) (by rw [← map_smul, hx]) := rfl

@[simp] theorem tateH1Map_mk {x : A} (hx : normHom G A x = 0) :
    tateH1Map f σ (TateH1.mk σ hx) =
      TateH1.mk σ (x := f x) (by rw [← map_normHom, hx, map_zero]) := rfl

end Functoriality

end CyclicTate
