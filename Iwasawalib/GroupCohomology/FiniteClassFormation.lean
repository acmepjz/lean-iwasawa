module

public import Mathlib

@[expose] public section

/-!
# Finite class formations

The standalone finite-class-formation contract used by the class field theory development.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits Rep groupCohomology

variable {R : Type} [CommRing R]
variable {G : Type} [Group G] [Fintype G]
variable {M : Rep R G}

namespace groupCohomology

/-- Restriction of a degree-two class along a group homomorphism. -/
abbrev H2res (sigma : H2 M) {H : Type} [Group H] (phi : H →* G) :
    H2 (Rep.res phi M) :=
  map phi (𝟙 (Rep.res phi M)) 2 sigma

end groupCohomology

namespace Rep.split

open groupCohomology

notation sigma "↡" phi => groupCohomology.H2res sigma phi

/-- A finite class formation: restricted `H^1` vanishes and the restricted degree-two class
generates `H^2` with kernel generated by the subgroup order. -/
class FiniteClassFormation (sigma : H2 M) where
  isZero_H1 {H : Type} [Group H] {phi : H →* G}
      (inj : Function.Injective phi) :
    IsZero (H1 (Rep.res phi M))
  hypothesis₂ (sigma) {H : Type} [Group H] {phi : H →* G}
      (inj : Function.Injective phi) :
    Submodule.span R {sigma ↡ phi} = ⊤
  hypothesis₂' (sigma) {H : Type} [Group H] {phi : H →* G}
      (inj : Function.Injective phi) :
    LinearMap.ker
        (LinearMap.toSpanSingleton R (H2 (Rep.res phi M)) (sigma ↡ phi)) =
      Ideal.span {(Nat.card H : R)}

end Rep.split
