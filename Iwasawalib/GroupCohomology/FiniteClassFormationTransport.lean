module

public import Iwasawalib.GroupCohomology.SplittingModule

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Rep

namespace Rep.split

/-- A degree-two cohomology class equipped with a normalized cyclic invariant:
the chosen invariant identifies the class with `1` modulo the order of the group. -/
structure NormalizedH2Generator
    {H : Type} [Group H] (N : Rep ℤ H) (tau : groupCohomology.H2 N) where
  invariant : groupCohomology.H2 N ≃ₗ[ℤ] ZMod (Nat.card H)
  invariant_tau : invariant tau = 1

/-- A normalized degree-two class generates the full cohomology module. -/
theorem NormalizedH2Generator.span_eq_top
    {H : Type} [Group H] {N : Rep ℤ H} {tau : groupCohomology.H2 N}
    (D : NormalizedH2Generator N tau) :
    Submodule.span ℤ {tau} = ⊤ := by
  apply top_unique
  intro x _
  obtain ⟨z, hz⟩ := ZMod.intCast_surjective (D.invariant x)
  have heq : (LinearMap.toSpanSingleton ℤ _ tau) z = x := by
    apply D.invariant.injective
    rw [LinearMap.toSpanSingleton_apply, D.invariant.map_smul, D.invariant_tau]
    simpa only [Int.cast_smul_eq_zsmul, zsmul_eq_mul, mul_one] using hz
  rw [← heq, LinearMap.toSpanSingleton_apply]
  exact Submodule.smul_mem _ z (Submodule.subset_span (Set.mem_singleton tau))

/-- The singleton-span map of a normalized degree-two class has kernel generated by
the order of the group. -/
theorem NormalizedH2Generator.ker_toSpanSingleton
    {H : Type} [Group H] {N : Rep ℤ H} {tau : groupCohomology.H2 N}
    (D : NormalizedH2Generator N tau) :
    LinearMap.ker (LinearMap.toSpanSingleton ℤ _ tau) =
      Ideal.span {(Nat.card H : ℤ)} := by
  ext z
  rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
  constructor
  · intro hz
    have hcast : (z : ZMod (Nat.card H)) = 0 := by
      have h := congrArg D.invariant hz
      rw [D.invariant.map_smul, D.invariant_tau, map_zero] at h
      simpa only [Int.cast_smul_eq_zsmul, zsmul_eq_mul, mul_one] using h
    rw [← ZMod.ker_intCastRingHom]
    exact RingHom.mem_ker.mpr hcast
  · intro hz
    have hcast : (z : ZMod (Nat.card H)) = 0 := by
      have hmem : z ∈ RingHom.ker (Int.castRingHom (ZMod (Nat.card H))) := by
        rwa [ZMod.ker_intCastRingHom]
      exact RingHom.mem_ker.mp hmem
    apply D.invariant.injective
    rw [D.invariant.map_smul, D.invariant_tau, map_zero]
    simpa only [Int.cast_smul_eq_zsmul, zsmul_eq_mul, mul_one] using hcast

end Rep.split

namespace groupCohomology

/-- Cohomology restricted along an injective homomorphism is canonically equivalent to
cohomology restricted to the homomorphism's range. -/
noncomputable def resRangeIso
    {R G H : Type} [CommRing R] [Group G] [Group H]
    (M : Rep R G) (phi : H →* G) (inj : Function.Injective phi) (n : ℕ) :
    groupCohomology (Rep.res phi M) n ≃ₗ[R]
      groupCohomology (Rep.res phi.range.subtype M) n :=
  (resSubtypeRangeIso M phi n inj).symm.toLinearEquiv

/-- The injection-to-range equivalence carries restriction of a degree-two class along the
original injection to restriction along the range inclusion. -/
theorem resRangeIso_H2res
    {R G H : Type} [CommRing R] [Group G] [Group H]
    (M : Rep R G) (phi : H →* G) (inj : Function.Injective phi)
    (sigma : groupCohomology.H2 M) :
    resRangeIso M phi inj 2 (groupCohomology.H2res sigma phi) =
      groupCohomology.H2res sigma phi.range.subtype := by
  change
    (groupCohomology.map (MonoidHom.ofInjective inj).symm.toMonoidHom
      (Rep.ofHom ⟨LinearMap.id, by simp⟩) 2)
        (groupCohomology.H2res sigma phi) =
      groupCohomology.H2res sigma phi.range.subtype
  simp only [groupCohomology.H2res]
  change
    ((groupCohomology.map phi (𝟙 (Rep.res phi M)) 2 ≫
      groupCohomology.map (MonoidHom.ofInjective inj).symm.toMonoidHom
        (Rep.ofHom ⟨LinearMap.id, by simp⟩) 2) : _) sigma = _
  rw [← groupCohomology.map_comp]
  exact CategoryTheory.ConcreteCategory.congr_hom
    (groupCohomology.map_congr
      (MonoidHom.ext fun x : phi.range ↦ MonoidHom.apply_ofInjective_symm inj x)
      (by rfl) 2) sigma

/-- Degree-one cohomology restricted along an injection is zero exactly when cohomology
restricted to its range is zero. -/
theorem isZero_res_iff_range
    {R G H : Type} [CommRing R] [Group G] [Group H]
    (M : Rep R G) (phi : H →* G) (inj : Function.Injective phi) :
    IsZero (groupCohomology (Rep.res phi M) 1) ↔
      IsZero (groupCohomology (Rep.res phi.range.subtype M) 1) := by
  constructor
  · intro h
    exact IsZero.of_iso h (resSubtypeRangeIso M phi 1 inj)
  · intro h
    exact IsZero.of_iso h (resSubtypeRangeIso M phi 1 inj).symm

end groupCohomology
