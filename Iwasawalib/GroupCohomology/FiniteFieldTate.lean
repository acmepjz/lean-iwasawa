module

public import Iwasawalib.GroupCohomology.CyclicCocycle
public import Iwasawalib.GroupCohomology.TraceOne
public import Mathlib.FieldTheory.Finite.GaloisField
public import Mathlib.RepresentationTheory.Homological.GroupCohomology.Hilbert90

@[expose] public section

/-!
# The residue field is cohomologically trivial

Let `E / F` be a finite Galois extension with cyclic Galois group generated by `σ` — the case of
interest is an extension of *finite* fields, where the Galois group is cyclic, generated by the
Frobenius, and where `E / F` is the residue extension of an unramified extension of local
fields.  This file proves that both Tate cohomology groups of the multiplicative group `Eˣ`
vanish, in the elementary form used by `CyclicCocycle`:

* `Ĥ¹(G, Eˣ) = 0`: an element of norm one is of the form `σ • y / y` (Hilbert 90);
* `Ĥ⁰(G, Eˣ) = 0`: for a *finite* field `E`, an element of `Eˣ` fixed by `σ` is a norm — this is
  the surjectivity of the norm `Eˣ → Fˣ` of finite fields, `FiniteField.unitsMap_norm_surjective`.

Together with `Iwasawalib/GroupCohomology/TraceOne.lean`, which gives the same vanishing for the
additive group `E⁺`, these are the two computations at the bottom of the filtration
`O_wˣ ⊇ 1 + 𝔪_w ⊇ 1 + 𝔪_w² ⊇ ⋯` of the units of an unramified local extension, whose successive
quotients are `E ˣ` and `E ⁺`.

## Main statements

* `CyclicTate.coe_mulNorm_units`: `∏_{g} g • x = algebraMap F E (N_{E/F} x)` for `x : Eˣ`.
* `CyclicTate.exists_smul_div_of_mulNorm_eq_one`: `Ĥ¹(G, Eˣ) = 0` for any finite cyclic Galois
  extension of fields.
* `CyclicTate.exists_mulNorm_eq_of_smul_eq`: `Ĥ⁰(G, Eˣ) = 0` for a finite field `E`.
* `CyclicTate.exists_normHom_eq_of_smul_eq_galois`,
  `CyclicTate.exists_smul_sub_eq_of_normHom_eq_zero_galois`: the additive counterparts.
-/

noncomputable section

open Finset

attribute [local instance] Units.mulDistribMulActionRight

namespace CyclicTate

variable {F E : Type} [Field F] [Field E] [Algebra F E] [FiniteDimensional F E] [IsGalois F E]

/-! ## The multiplicative norm of a unit -/

/-- The norm `∏_{g ∈ Gal(E/F)} g • x` of a unit is the field norm. -/
theorem coe_mulNorm_units (x : Eˣ) :
    ((CyclicCocycle.mulNorm (G := E ≃ₐ[F] E) x : Eˣ) : E)
      = algebraMap F E (Algebra.norm F (x : E)) := by
  rw [CyclicCocycle.mulNorm_def, Algebra.norm_eq_prod_automorphisms, Units.coe_prod]
  exact Finset.prod_congr rfl fun g _ ↦ rfl

/-- A unit has norm one exactly when its field norm is one. -/
theorem mulNorm_units_eq_one_iff (x : Eˣ) :
    CyclicCocycle.mulNorm (G := E ≃ₐ[F] E) x = 1 ↔ Algebra.norm F (x : E) = 1 := by
  rw [← Units.val_inj, coe_mulNorm_units, Units.val_one, ← (algebraMap F E).map_one]
  exact (algebraMap F E).injective.eq_iff

/-! ## `Ĥ¹(G, Eˣ) = 0`: Hilbert 90 -/

/-- **Hilbert 90 in its Tate form.**  For a finite cyclic Galois extension `E / F` with
generator `σ`, every unit of norm one is of the form `σ • y / y`. -/
theorem exists_smul_div_of_mulNorm_eq_one {σ : E ≃ₐ[F] E}
    (hg : ∀ g : E ≃ₐ[F] E, g ∈ Subgroup.zpowers σ) {x : Eˣ}
    (hx : CyclicCocycle.mulNorm (G := E ≃ₐ[F] E) x = 1) :
    ∃ y : Eˣ, σ • y / y = x := by
  haveI : IsCyclic (E ≃ₐ[F] E) := ⟨⟨σ, hg⟩⟩
  obtain ⟨y, hy⟩ := groupCohomology.exists_div_of_norm_eq_one (K := F) (L := E) (g := σ) hg
    ((mulNorm_units_eq_one_iff x).1 hx)
  refine ⟨y⁻¹, Units.ext ?_⟩
  have hσ : ((σ • y⁻¹ : Eˣ) : E) = (σ (y : E))⁻¹ := by
    simp
  rw [Units.val_div_eq_div_val, hσ, Units.val_inv_eq_inv_val, ← hy]
  have hy0 : (y : E) ≠ 0 := y.ne_zero
  have hσy0 : σ (y : E) ≠ 0 := by
    simp [hy0]
  field_simp

/-! ## `Ĥ⁰(G, Eˣ) = 0` for a finite field -/

variable [Finite E]

/-- **The norm of a finite field is surjective onto the invariant units.**  For a finite field
`E` with cyclic Galois group `⟨σ⟩` over `F`, a unit fixed by `σ` is a norm. -/
theorem exists_mulNorm_eq_of_smul_eq {σ : E ≃ₐ[F] E}
    (hg : ∀ g : E ≃ₐ[F] E, g ∈ Subgroup.zpowers σ) {x : Eˣ} (hx : σ • x = x) :
    ∃ y : Eˣ, CyclicCocycle.mulNorm (G := E ≃ₐ[F] E) y = x := by
  have hfix : ∀ g : E ≃ₐ[F] E, g (x : E) = (x : E) := fun g ↦
    congrArg Units.val (smul_eq_self_of_forall_mem_zpowers hg hx g)
  obtain ⟨a, ha⟩ : (x : E) ∈ Set.range (algebraMap F E) :=
    IntermediateField.mem_bot.1 ((IsGalois.mem_bot_iff_fixed (x : E)).2 hfix)
  have ha0 : a ≠ 0 := by
    rintro rfl
    exact x.ne_zero (by simpa using ha.symm)
  obtain ⟨y, hy⟩ := FiniteField.unitsMap_norm_surjective F E (Units.mk0 a ha0)
  have hval : Algebra.norm F (y : E) = a := congrArg Units.val hy
  refine ⟨y, Units.ext ?_⟩
  rw [coe_mulNorm_units, hval, ha]

/-! ## The additive group of a finite field -/

omit [Finite E] in
/-- `Ĥ⁰(G, E⁺) = 0` for a finite cyclic Galois extension: an invariant element is a trace. -/
theorem exists_normHom_eq_of_smul_eq_galois {σ : E ≃ₐ[F] E}
    (hg : ∀ g : E ≃ₐ[F] E, g ∈ Subgroup.zpowers σ) {x : E} (hx : σ • x = x) :
    ∃ y : E, normHom (E ≃ₐ[F] E) E y = x := by
  obtain ⟨c, hc⟩ := exists_sum_smul_eq_one_of_isGalois F E
  exact exists_normHom_eq_of_smul_eq hg hc hx

omit [Finite E] in
/-- `Ĥ¹(G, E⁺) = 0` for a finite cyclic Galois extension: an element of trace zero is of the
form `σ • y - y`. -/
theorem exists_smul_sub_eq_of_normHom_eq_zero_galois {σ : E ≃ₐ[F] E}
    (hg : ∀ g : E ≃ₐ[F] E, g ∈ Subgroup.zpowers σ) {x : E}
    (hx : normHom (E ≃ₐ[F] E) E x = 0) :
    ∃ y : E, σ • y - y = x := by
  obtain ⟨c, hc⟩ := exists_sum_smul_eq_one_of_isGalois F E
  exact exists_smul_sub_eq_of_normHom_eq_zero hg hc hx

/-! ## Cocycles with values in the units of a finite field -/

omit [Finite E] in
/-- **Every multiplicative 1-cocycle with values in the units of a finite cyclic Galois
extension is a coboundary.**  This is `CyclicCocycle.isMulCoboundary₁_of_mulNorm` fed with
Hilbert 90. -/
theorem isMulCoboundary₁_of_isMulCocycle₁_units {σ : E ≃ₐ[F] E}
    (hg : ∀ g : E ≃ₐ[F] E, g ∈ Subgroup.zpowers σ) {f : (E ≃ₐ[F] E) → Eˣ}
    (hf : groupCohomology.IsMulCocycle₁ f) : groupCohomology.IsMulCoboundary₁ f :=
  CyclicCocycle.isMulCoboundary₁_of_mulNorm hg
    (fun _ hx ↦ exists_smul_div_of_mulNorm_eq_one hg hx) hf

end CyclicTate
