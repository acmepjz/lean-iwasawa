module

public import Iwasawalib.NumberTheory.CFT.IdeleClassNormIndex
public import Iwasawalib.GroupCohomology.CyclicOrderIso

@[expose] public section

/-!
# `Ĥ⁰(Gal(L/K), C_L)` **is** the norm quotient `C_K / N_{L/K} C_L`, as a group

`Iwasawalib/NumberTheory/CFT/IdeleClassNormIndex.lean` proves the equality of *numbers*
`#Ĥ⁰(Gal(L/K), C_L) = [C_K : N_{L/K} C_L]`.  That is strictly weaker than what reciprocity
needs: an index is not a quotient group.  This file upgrades it to the canonical isomorphism

`NumberField.IdeleClassGroup.quotientNormEquivTateH0 :`
  `(Additive C_K ⧸ N_{L/K} C_L) ≃+ Ĥ⁰(Gal(L/K), C_L)`

induced by the base change `C_K → C_L`, unconditionally (for `L / K` finite Galois with
`Gal(L/K)` generated by `σ`).  Two facts make it work and both are already in the library:
the base change is injective (`NumberField.IdeleClassGroup.baseChange_injective`) and its image
is exactly the numerator `ker(σ - 1)` of `Ĥ⁰`
(`NumberField.IdeleClassGroup.range_baseChangeAdd_eq_kerSub`).

The consequence is that any homomorphism out of `Ĥ⁰(Gal(L/K), C_L)` may be built from a
homomorphism on `C_K` that kills norms, and conversely — which is how the global Artin map and
the Tate group are matched up in
`Iwasawalib/NumberTheory/GlobalCFT/ReciprocityCyclic.lean`.

## Main definitions and statements

* `NumberField.IdeleClassGroup.toTateH0` : the map `C_K → Ĥ⁰(Gal(L/K), C_L)`, `c ↦ [c]`.
* `NumberField.IdeleClassGroup.surjective_toTateH0`, `ker_toTateH0` : it is surjective with
  kernel `N_{L/K} C_L`.
* `NumberField.IdeleClassGroup.quotientNormEquivTateH0` : the resulting isomorphism.
* `NumberField.IdeleClassGroup.toTateH0_eq_zero_iff` : a class of `C_K` vanishes in `Ĥ⁰` exactly
  when it is a norm.
-/

noncomputable section

open IsDedekindDomain CyclicTate

attribute [local instance] Units.mulDistribMulActionRight
  NumberField.galIdeleMulDistribMulAction NumberField.galIdeleClassMulDistribMulAction
  CyclicTate.Additive.distribMulActionOfMulDistrib

namespace NumberField.IdeleClassGroup

variable {K : Type} [Field K] [NumberField K] {L : Type} [Field L] [NumberField L]
  [Algebra K L] [IsGalois K L] {σ : L ≃ₐ[K] L}

variable (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g)

include hgen

/-- The base change `C_K → C_L` lands in `ker(σ - 1)`, the numerator of `Ĥ⁰(Gal(L/K), C_L)`. -/
theorem baseChangeAdd_mem_kerSub (c : Additive (IdeleClassGroup (𝓞 K) K)) :
    baseChangeAdd K L c ∈ kerSub (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ := by
  rw [← range_baseChangeAdd_eq_kerSub hgen]
  exact ⟨c, rfl⟩

/-- **The canonical map `C_K → Ĥ⁰(Gal(L/K), C_L)`** : a class of `C_K` is `σ`-invariant when
viewed in `C_L`, so it has a class in `Ĥ⁰ = ker(σ - 1) / N C_L`. -/
def toTateH0 : Additive (IdeleClassGroup (𝓞 K) K) →+
    TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ :=
  (QuotientAddGroup.mk' _).comp
    ((baseChangeAdd K L).codRestrict _ (baseChangeAdd_mem_kerSub hgen))

theorem toTateH0_apply (c : Additive (IdeleClassGroup (𝓞 K) K)) :
    toTateH0 hgen c = TateH0.mk σ (mem_kerSub.1 (baseChangeAdd_mem_kerSub hgen c)) := rfl

/-- **The canonical map `C_K → Ĥ⁰(Gal(L/K), C_L)` is surjective**, because the image of the base
change is the whole of `ker(σ - 1)`. -/
theorem surjective_toTateH0 : Function.Surjective (toTateH0 hgen) := by
  intro t
  obtain ⟨x, hx, rfl⟩ := TateH0.mk_surjective t
  obtain ⟨c, hc⟩ : x ∈ (baseChangeAdd K L).range := by
    rw [range_baseChangeAdd_eq_kerSub hgen]; exact mem_kerSub.2 hx
  exact ⟨c, by rw [toTateH0_apply]; congr 1⟩

/-- **A class of `C_K` dies in `Ĥ⁰(Gal(L/K), C_L)` exactly when it is a norm from `C_L`.** -/
theorem toTateH0_eq_zero_iff (c : Additive (IdeleClassGroup (𝓞 K) K)) :
    toTateH0 hgen c = 0 ↔ c ∈ normSubgroup K L := by
  rw [toTateH0_apply, TateH0.mk_eq_zero_iff, mem_normSubgroup_iff]
  simp only [CyclicTate.normHom_apply]

/-- **The kernel of `C_K → Ĥ⁰(Gal(L/K), C_L)` is the group of norms `N_{L/K} C_L`.** -/
theorem ker_toTateH0 : (toTateH0 hgen).ker = normSubgroup K L := by
  ext c
  exact toTateH0_eq_zero_iff hgen c

/-- **`C_K / N_{L/K} C_L ≅ Ĥ⁰(Gal(L/K), C_L)`.**

The order form of this is `NumberField.IdeleClassGroup.card_tateH0_eq_index_normSubgroup`; here
the index is replaced by the quotient group itself, which is what the reciprocity law is about.
The isomorphism is induced by the base change `C_K → C_L` and is therefore canonical. -/
def quotientNormEquivTateH0 :
    (Additive (IdeleClassGroup (𝓞 K) K) ⧸ normSubgroup K L) ≃+
      TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ :=
  (QuotientAddGroup.quotientAddEquivOfEq (ker_toTateH0 hgen).symm).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective _ (surjective_toTateH0 hgen))

@[simp] theorem quotientNormEquivTateH0_mk (c : Additive (IdeleClassGroup (𝓞 K) K)) :
    quotientNormEquivTateH0 hgen (QuotientAddGroup.mk c) = toTateH0 hgen c := rfl

end NumberField.IdeleClassGroup
