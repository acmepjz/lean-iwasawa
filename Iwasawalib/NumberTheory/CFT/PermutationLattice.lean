module

public import Iwasawalib.NumberTheory.CFT.HerbrandLattice
public import Mathlib.Algebra.Group.Action.Sigma

@[expose] public section

/-!
# The permutation lattice of a `G`-set, and its Herbrand quotient

For a group `G` acting on a set `Ω` the **permutation lattice** `PermLattice G Ω` is the
group of functions `Ω → ℤ` with the translation action `(g • f) x = f (g⁻¹ • x)`.  For a
finite cyclic `G = ⟨σ⟩` and a finite *transitive* `Ω` this is the induced module
`Ind_{D}^{G} ℤ` with `D` the stabiliser of a point, and its Tate cohomology is that of the
trivial `D`-module `ℤ`:

* `Ĥ⁰ = ℤ / #D · ℤ`, so `#Ĥ⁰ = #D`;
* `Ĥ¹ = 0`;
* `h(PermLattice G Ω) = #D = #G / #Ω`.

Rather than construct the induced-module comparison and invoke Shapiro's lemma, the two
groups are computed directly, which for the explicit two-periodic model of
`Iwasawalib/GroupCohomology/CyclicTate.lean` is shorter and gives the *orders* directly.
The two computational inputs are

* `PermLattice.eval_eq_of_smul_eq`: a `σ`-invariant function on a `σ`-transitive set is
  constant;
* `PermLattice.mem_rangeSub_of_total_eq_zero`: a function whose total sum vanishes is of the
  form `σ • g - g` (the statement that the augmentation ideal of `ℤ[Z/d]` is generated by
  `σ - 1`), proved by telescoping the indicator functions along the cycle.

## Main results

* `PermLattice.card_tateH0`: `#Ĥ⁰(G, ℤ[Ω]) = #Stab_G(x₀)`.
* `PermLattice.subsingleton_tateH1`: `Ĥ¹(G, ℤ[Ω]) = 0`.
* `PermLattice.herbrand_eq`: `h(ℤ[Ω]) = #Stab_G(x₀)`, for `Ω` transitive.
* `PermLattice.herbrand_sigma_eq_prod`: for a general finite `Ω`, decomposed into transitive
  pieces, `h(ℤ[Σ i, Ω i]) = ∏ i #Stab_G(x i)`.
* `PermLattice.herbrand_congr`: invariance under an equivariant equivalence of `G`-sets.
* `PermLattice.herbrand_kerTotal`: the Herbrand quotient of the augmentation ideal
  `ℤ[Ω]⁰ = ker(Σ)`, namely `h(ℤ[Ω]) / #G`.
-/

noncomputable section

open MulAction

/-- The **permutation lattice** `ℤ[Ω]` of a `G`-set `Ω`: the group of functions `Ω → ℤ` with
the translation action `(g • f) x = f (g⁻¹ • x)`. -/
def PermLattice (G Ω : Type*) [Group G] [MulAction G Ω] : Type _ := Ω → ℤ

namespace PermLattice

section Basic

variable {G Ω : Type*} [Group G] [MulAction G Ω]

instance : AddCommGroup (PermLattice G Ω) := inferInstanceAs (AddCommGroup (Ω → ℤ))

/-- The function underlying an element of the permutation lattice. -/
def eval (f : PermLattice G Ω) : Ω → ℤ := f

/-- An element of the permutation lattice from a function. -/
def ofFun (f : Ω → ℤ) : PermLattice G Ω := f

@[simp] theorem eval_ofFun (f : Ω → ℤ) (x : Ω) : eval (ofFun (G := G) f) x = f x := rfl

@[ext] theorem ext {f g : PermLattice G Ω} (h : ∀ x, eval f x = eval g x) : f = g := funext h

@[simp] theorem eval_zero (x : Ω) : eval (0 : PermLattice G Ω) x = 0 := rfl

@[simp] theorem eval_add (f g : PermLattice G Ω) (x : Ω) :
    eval (f + g) x = eval f x + eval g x := rfl

@[simp] theorem eval_neg (f : PermLattice G Ω) (x : Ω) : eval (-f) x = -eval f x := rfl

@[simp] theorem eval_sub (f g : PermLattice G Ω) (x : Ω) :
    eval (f - g) x = eval f x - eval g x := rfl

@[simp] theorem eval_zsmul (n : ℤ) (f : PermLattice G Ω) (x : Ω) :
    eval (n • f) x = n * eval f x := rfl

/-- Evaluation at a point, as an additive homomorphism. -/
def evalHom (x : Ω) : PermLattice G Ω →+ ℤ where
  toFun f := eval f x
  map_zero' := rfl
  map_add' _ _ := rfl

@[simp] theorem evalHom_apply (x : Ω) (f : PermLattice G Ω) : evalHom x f = eval f x := rfl

theorem eval_sum {ι : Type*} (s : Finset ι) (f : ι → PermLattice G Ω) (x : Ω) :
    eval (∑ i ∈ s, f i) x = ∑ i ∈ s, eval (f i) x :=
  map_sum (evalHom x) f s

/-- The translation action of `G` on `ℤ[Ω]`. -/
instance : DistribMulAction G (PermLattice G Ω) where
  smul g f := ofFun fun x ↦ eval f (g⁻¹ • x)
  one_smul f := ext fun x ↦ by
    show eval f (1⁻¹ • x) = eval f x
    rw [inv_one, one_smul]
  mul_smul g g' f := ext fun x ↦ by
    show eval f ((g * g')⁻¹ • x) = eval f (g'⁻¹ • g⁻¹ • x)
    rw [mul_inv_rev, mul_smul]
  smul_zero _ := ext fun _ ↦ rfl
  smul_add _ _ _ := ext fun _ ↦ rfl

@[simp] theorem eval_smul (g : G) (f : PermLattice G Ω) (x : Ω) :
    eval (g • f) x = eval f (g⁻¹ • x) := rfl

/-! ### Indicator functions -/

variable [DecidableEq Ω]

/-- The indicator function of a point of `Ω`, as an element of `ℤ[Ω]`. -/
def delta (x : Ω) : PermLattice G Ω := ofFun (Pi.single x 1)

@[simp] theorem eval_delta_self (x : Ω) : eval (delta (G := G) x) x = 1 := by
  simp [delta]

theorem eval_delta_of_ne {x y : Ω} (h : y ≠ x) : eval (delta (G := G) x) y = 0 := by
  simp [delta, Pi.single_eq_of_ne h]

theorem eval_delta (x y : Ω) : eval (delta (G := G) x) y = if y = x then 1 else 0 := by
  by_cases h : y = x
  · subst h; simp
  · simp [eval_delta_of_ne h, h]

@[simp] theorem smul_delta (g : G) (x : Ω) :
    g • delta (G := G) x = delta (g • x) := by
  refine ext fun y ↦ ?_
  rw [eval_smul, eval_delta, eval_delta]
  by_cases h : y = g • x
  · subst h; simp
  · have h' : ¬ (g⁻¹ • y = x) := fun hc ↦ h (by rw [← hc, smul_inv_smul])
    simp [h, h']

variable [Fintype Ω]

/-- Every element of `ℤ[Ω]` is the sum of its coordinates times the indicator functions. -/
theorem sum_smul_delta (f : PermLattice G Ω) :
    ∑ x : Ω, (eval f x) • delta (G := G) x = f := by
  refine ext fun y ↦ ?_
  rw [eval_sum]
  simp only [eval_zsmul, eval_delta, mul_ite, mul_one, mul_zero]
  rw [Finset.sum_ite_eq Finset.univ y fun x ↦ eval f x]
  simp

end Basic

/-! ## The total sum -/

section Total

variable {G Ω : Type*} [Group G] [MulAction G Ω] [Fintype Ω]

/-- The sum of the coordinates of an element of `ℤ[Ω]`. -/
def total (f : PermLattice G Ω) : ℤ := ∑ x : Ω, eval f x

@[simp] theorem total_smul (g : G) (f : PermLattice G Ω) : total (g • f) = total f := by
  exact Fintype.sum_equiv (MulAction.toPerm g⁻¹) _ _ fun _ ↦ rfl

@[simp] theorem total_add (f g : PermLattice G Ω) : total (f + g) = total f + total g := by
  simp [total, Finset.sum_add_distrib]

@[simp] theorem total_zero : total (0 : PermLattice G Ω) = 0 := by simp [total]

theorem total_sum {ι : Type*} (s : Finset ι) (f : ι → PermLattice G Ω) :
    total (∑ i ∈ s, f i) = ∑ i ∈ s, total (f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, total_add, ih]

@[simp] theorem total_zsmul (n : ℤ) (f : PermLattice G Ω) : total (n • f) = n * total f := by
  simp [total, Finset.mul_sum]

@[simp] theorem total_delta [DecidableEq Ω] (x : Ω) : total (delta (G := G) x) = 1 := by
  simp [total, eval_delta]

end Total

/-! ## Tate cohomology of a transitive permutation lattice -/

section Transitive

variable {G Ω : Type*} [Group G] [Fintype G] [MulAction G Ω] [Fintype Ω] [DecidableEq Ω]
  {σ : G}

omit [Fintype G] [Fintype Ω] [DecidableEq Ω] in
/-- If `σ` generates `G` then `σ` alone acts transitively on a transitive `G`-set, by
*natural* powers. -/
theorem exists_pow_smul_eq (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)
    [IsPretransitive G Ω] (x y : Ω) : ∃ k : ℕ, σ ^ k • x = y := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G x y
  obtain ⟨k, hk⟩ := hgen g
  exact ⟨k, by rw [hk, hg]⟩

/-- A subgroup generated by a single element, in a finite group, is reached by natural
powers. -/
theorem exists_pow_eq_of_zpowers_eq_top (h : Subgroup.zpowers σ = ⊤) (g : G) :
    ∃ k : ℕ, σ ^ k = g := by
  have : g ∈ Subgroup.zpowers σ := h ▸ Subgroup.mem_top g
  obtain ⟨k, hk⟩ := mem_powers_iff_mem_zpowers.2 this
  exact ⟨k, hk⟩

omit [MulAction G Ω] [Fintype Ω] [DecidableEq Ω] in
/-- Every finite cyclic group has a generator in the sense used throughout this file. -/
theorem exists_generator_pow [IsCyclic G] : ∃ τ : G, ∀ g : G, ∃ k : ℕ, τ ^ k = g := by
  obtain ⟨τ, hτ⟩ := IsCyclic.exists_generator (α := G)
  refine ⟨τ, fun g ↦ exists_pow_eq_of_zpowers_eq_top ?_ g⟩
  exact (Subgroup.eq_top_iff' _).2 hτ

omit [Fintype G] [Fintype Ω] [DecidableEq Ω] in
/-- A `σ`-invariant function is constant along the `σ`-orbit. -/
theorem eval_pow_smul_of_smul_eq {f : PermLattice G Ω} (hf : σ • f = f) (k : ℕ) (x : Ω) :
    eval f (σ ^ k • x) = eval f x := by
  induction k with
  | zero => simp
  | succ k ih =>
      have := congrFun (congrArg eval hf) (σ ^ (k + 1) • x)
      rw [eval_smul] at this
      rw [← this, pow_succ', mul_smul, inv_smul_smul, ih]

omit [Fintype G] [Fintype Ω] [DecidableEq Ω] in
/-- **A `σ`-invariant function on a transitive `G`-set is constant.** -/
theorem eval_eq_of_smul_eq (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) [IsPretransitive G Ω]
    {f : PermLattice G Ω} (hf : σ • f = f) (x y : Ω) : eval f x = eval f y := by
  obtain ⟨k, hk⟩ := exists_pow_smul_eq hgen x y
  rw [← hk, eval_pow_smul_of_smul_eq hf]

/-! ### The image of the norm -/

omit [Fintype Ω] [DecidableEq Ω] in
theorem eval_normHom (f : PermLattice G Ω) (x : Ω) :
    eval (CyclicTate.normHom G (PermLattice G Ω) f) x = ∑ g : G, eval f (g⁻¹ • x) := by
  rw [CyclicTate.normHom_apply, eval_sum]
  exact Finset.sum_congr rfl fun g _ ↦ rfl

omit [DecidableEq Ω] in
/-- The total sum of a norm: `Σ N f = #G · Σ f`. -/
theorem total_normHom (f : PermLattice G Ω) :
    total (CyclicTate.normHom G (PermLattice G Ω) f) = (Nat.card G : ℤ) * total f := by
  rw [CyclicTate.normHom_apply, total_sum]
  simp only [total_smul]
  rw [Finset.sum_const, Nat.card_eq_fintype_card, Finset.card_univ, nsmul_eq_mul]

omit [Fintype G] [DecidableEq Ω] in
/-- The total sum of a constant function. -/
theorem total_eq_of_const {f : PermLattice G Ω} {c : ℤ} (h : ∀ x, eval f x = c) :
    total f = (Nat.card Ω : ℤ) * c := by
  rw [total]
  simp only [h]
  rw [Finset.sum_const, Nat.card_eq_fintype_card, Finset.card_univ, nsmul_eq_mul]

omit [DecidableEq Ω] in
/-- **The value of a norm**: `#Ω · (N f)(x) = #G · Σ f`. -/
theorem card_mul_eval_normHom (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) [IsPretransitive G Ω]
    (f : PermLattice G Ω) (x : Ω) :
    (Nat.card Ω : ℤ) * eval (CyclicTate.normHom G (PermLattice G Ω) f) x
      = (Nat.card G : ℤ) * total f := by
  have hinv : σ • CyclicTate.normHom G (PermLattice G Ω) f
      = CyclicTate.normHom G (PermLattice G Ω) f := CyclicTate.smul_normHom G σ f
  have hconst : ∀ y, eval (CyclicTate.normHom G (PermLattice G Ω) f) y
      = eval (CyclicTate.normHom G (PermLattice G Ω) f) x :=
    fun y ↦ eval_eq_of_smul_eq hgen hinv y x
  rw [← total_eq_of_const hconst, total_normHom]

/-! ### The kernel of the augmentation is the image of `σ - 1` -/

omit [Fintype G] [Fintype Ω] in
theorem delta_sub_delta_mem_rangeSub (x : Ω) (k : ℕ) :
    delta (G := G) (σ ^ k • x) - delta x ∈ CyclicTate.rangeSub G (PermLattice G Ω) σ := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hstep : delta (G := G) (σ ^ (k + 1) • x) - delta (σ ^ k • x)
          ∈ CyclicTate.rangeSub G (PermLattice G Ω) σ := by
        refine CyclicTate.mem_rangeSub.2 ⟨delta (σ ^ k • x), ?_⟩
        rw [smul_delta, ← mul_smul, ← pow_succ']
      have := (CyclicTate.rangeSub G (PermLattice G Ω) σ).add_mem hstep ih
      simpa using this

omit [Fintype G] in
/-- **A function with vanishing total sum is of the form `σ • g - g`.**  This is the
statement that the augmentation ideal of `ℤ[Ω]` for a cyclic transitive action is generated
by `σ - 1`. -/
theorem mem_rangeSub_of_total_eq_zero (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) [IsPretransitive G Ω]
    [Nonempty Ω] {f : PermLattice G Ω} (hf : total f = 0) :
    f ∈ CyclicTate.rangeSub G (PermLattice G Ω) σ := by
  classical
  set x₀ : Ω := Classical.arbitrary Ω with hx₀
  have hmem : ∀ x : Ω, delta (G := G) x - delta x₀ ∈ CyclicTate.rangeSub G (PermLattice G Ω) σ := by
    intro x
    obtain ⟨k, hk⟩ := exists_pow_smul_eq hgen x₀ x
    rw [← hk]
    exact delta_sub_delta_mem_rangeSub x₀ k
  have hsum : f = ∑ x : Ω, (eval f x) • (delta (G := G) x - delta x₀) := by
    have h1 : ∑ x : Ω, (eval f x) • (delta (G := G) x - delta x₀)
        = (∑ x : Ω, (eval f x) • delta (G := G) x) - (∑ x : Ω, eval f x) • delta (G := G) x₀ := by
      rw [Finset.sum_smul, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun x _ ↦ smul_sub _ _ _
    rw [h1, sum_smul_delta]
    have : (∑ x : Ω, eval f x) = 0 := hf
    rw [this, zero_smul, sub_zero]
  rw [hsum]
  exact AddSubgroup.sum_mem _ fun x _ ↦ AddSubgroup.zsmul_mem _ (hmem x) _

/-- **`Ĥ¹(G, ℤ[Ω]) = 0`** for a transitive `G`-set `Ω`. -/
theorem subsingleton_tateH1 (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) [IsPretransitive G Ω]
    [Nonempty Ω] : Subsingleton (CyclicTate.TateH1 G (PermLattice G Ω) σ) := by
  refine (CyclicTate.tateH1_subsingleton_iff σ).2 fun f hf ↦ ?_
  have hx₀ : (Nat.card Ω : ℤ) * eval (CyclicTate.normHom G (PermLattice G Ω) f)
      (Classical.arbitrary Ω) = (Nat.card G : ℤ) * total f :=
    card_mul_eval_normHom hgen f _
  rw [hf] at hx₀
  have hG : (Nat.card G : ℤ) ≠ 0 := by
    simp only [ne_eq, Nat.cast_eq_zero]
    exact Nat.card_pos.ne'
  have htot : total f = 0 := by
    have : (Nat.card G : ℤ) * total f = 0 := by rw [← hx₀]; simp
    exact (mul_eq_zero.1 this).resolve_left hG
  exact CyclicTate.mem_rangeSub.1 (mem_rangeSub_of_total_eq_zero hgen htot)

/-! ### `Ĥ⁰` and the Herbrand quotient -/

section H0

variable [IsPretransitive G Ω] (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)

omit [Fintype G] [Fintype Ω] [DecidableEq Ω] in
/-- **Orbit–stabiliser**, in the form used here: `#Ω · #D = #G`. -/
theorem card_mul_card_stabilizer (x₀ : Ω) :
    Nat.card Ω * Nat.card (stabilizer G x₀) = Nat.card G := by
  have h1 : Nat.card Ω = Nat.card (G ⧸ stabilizer G x₀) :=
    Nat.card_congr ((Equiv.Set.univ Ω).symm.trans
      ((Set.equivOfEq (MulAction.orbit_eq_univ G x₀).symm).trans
        (MulAction.orbitEquivQuotientStabilizer G x₀)))
  rw [h1]
  exact (Subgroup.card_eq_card_quotient_mul_card_subgroup _).symm

include hgen

/-- **Evaluation at a base point identifies the `σ`-invariants of `ℤ[Ω]` with `ℤ`.** -/
def kerSubEquiv (x₀ : Ω) : CyclicTate.kerSub G (PermLattice G Ω) σ ≃+ ℤ where
  toFun f := eval (f : PermLattice G Ω) x₀
  invFun c := ⟨ofFun fun _ ↦ c, CyclicTate.mem_kerSub.2 (ext fun _ ↦ rfl)⟩
  left_inv f := Subtype.ext (ext fun y ↦
    eval_eq_of_smul_eq hgen (CyclicTate.mem_kerSub.1 f.2) x₀ y)
  right_inv _ := rfl
  map_add' _ _ := rfl

omit [Fintype G] [Fintype Ω] [DecidableEq Ω] in
@[simp] theorem kerSubEquiv_apply (x₀ : Ω) (f : CyclicTate.kerSub G (PermLattice G Ω) σ) :
    kerSubEquiv hgen x₀ f = eval (f : PermLattice G Ω) x₀ := rfl

/-- **The image of the norm, read off at the base point, is `#D · ℤ`.** -/
theorem map_kerSubEquiv_rangeNorm (x₀ : Ω) :
    AddSubgroup.map (kerSubEquiv hgen x₀ : CyclicTate.kerSub G (PermLattice G Ω) σ →+ ℤ)
        ((CyclicTate.rangeNorm G (PermLattice G Ω)).addSubgroupOf
          (CyclicTate.kerSub G (PermLattice G Ω) σ))
      = AddSubgroup.zmultiples (Nat.card (stabilizer G x₀) : ℤ) := by
  haveI : Nonempty Ω := ⟨x₀⟩
  have hd : (0 : ℤ) < (Nat.card Ω : ℤ) := by
    exact_mod_cast Nat.card_pos
  have hcard : (Nat.card Ω : ℤ) * (Nat.card (stabilizer G x₀) : ℤ) = (Nat.card G : ℤ) := by
    exact_mod_cast congrArg (Nat.cast : ℕ → ℤ) (card_mul_card_stabilizer x₀)
  ext t
  simp only [AddSubgroup.mem_map, AddSubgroup.mem_addSubgroupOf, AddSubgroup.mem_zmultiples_iff,
    smul_eq_mul]
  constructor
  · rintro ⟨f, hf, rfl⟩
    obtain ⟨y, hy⟩ := CyclicTate.mem_rangeNorm.1 hf
    refine ⟨total y, ?_⟩
    have hkey := card_mul_eval_normHom hgen y x₀
    rw [hy] at hkey
    have : (Nat.card Ω : ℤ) * eval (f : PermLattice G Ω) x₀
        = (Nat.card Ω : ℤ) * (total y * (Nat.card (stabilizer G x₀) : ℤ)) := by
      rw [hkey, ← hcard]; ring
    exact (mul_left_cancel₀ hd.ne' this).symm
  · rintro ⟨k, rfl⟩
    classical
    refine ⟨⟨CyclicTate.normHom G (PermLattice G Ω) (k • delta x₀),
      CyclicTate.rangeNorm_le_kerSub σ (CyclicTate.mem_rangeNorm.2 ⟨_, rfl⟩)⟩,
      CyclicTate.mem_rangeNorm.2 ⟨_, rfl⟩, ?_⟩
    have hkey := card_mul_eval_normHom hgen (k • delta (G := G) x₀) x₀
    rw [total_zsmul, total_delta, mul_one] at hkey
    refine mul_left_cancel₀ hd.ne' ?_
    show (Nat.card Ω : ℤ)
        * eval (CyclicTate.normHom G (PermLattice G Ω) (k • delta (G := G) x₀)) x₀
      = (Nat.card Ω : ℤ) * (k * (Nat.card (stabilizer G x₀) : ℤ))
    rw [hkey, ← hcard]
    ring

/-- **`Ĥ⁰(G, ℤ[Ω]) ≅ ℤ / #D`** for a transitive `G`-set `Ω` with `D = Stab_G(x₀)`. -/
def tateH0Equiv (x₀ : Ω) :
    CyclicTate.TateH0 G (PermLattice G Ω) σ ≃+ ZMod (Nat.card (stabilizer G x₀)) :=
  (QuotientAddGroup.congr _ _ (kerSubEquiv hgen x₀) (map_kerSubEquiv_rangeNorm hgen x₀)).trans
    (Int.quotientZMultiplesNatEquivZMod _)

/-- **`#Ĥ⁰(G, ℤ[Ω]) = #Stab_G(x₀)`.** -/
theorem card_tateH0 (x₀ : Ω) :
    Nat.card (CyclicTate.TateH0 G (PermLattice G Ω) σ) = Nat.card (stabilizer G x₀) := by
  haveI : NeZero (Nat.card (stabilizer G x₀)) := ⟨Nat.card_pos.ne'⟩
  rw [Nat.card_congr (tateH0Equiv hgen x₀).toEquiv, Nat.card_eq_fintype_card, ZMod.card]

theorem finite_tateH0 (x₀ : Ω) : Finite (CyclicTate.TateH0 G (PermLattice G Ω) σ) := by
  haveI : NeZero (Nat.card (stabilizer G x₀)) := ⟨Nat.card_pos.ne'⟩
  exact Finite.of_equiv _ (tateH0Equiv hgen x₀).toEquiv.symm

theorem finite_tateH1 (x₀ : Ω) : Finite (CyclicTate.TateH1 G (PermLattice G Ω) σ) := by
  haveI : Nonempty Ω := ⟨x₀⟩
  haveI := subsingleton_tateH1 hgen (Ω := Ω) (σ := σ)
  infer_instance

/-- **The Herbrand quotient of a transitive permutation lattice is the order of the
stabiliser**: `h(ℤ[Ω]) = #Stab_G(x₀) = #G / #Ω`. -/
theorem herbrand_eq (x₀ : Ω) :
    CyclicTate.herbrand G (PermLattice G Ω) σ = (Nat.card (stabilizer G x₀) : ℚ) := by
  haveI : Nonempty Ω := ⟨x₀⟩
  haveI := subsingleton_tateH1 hgen (Ω := Ω) (σ := σ)
  have h1 : Nat.card (CyclicTate.TateH1 G (PermLattice G Ω) σ) = 1 :=
    Nat.card_eq_one_iff_unique.2 ⟨inferInstance, ⟨0⟩⟩
  rw [CyclicTate.herbrand_def, card_tateH0 hgen x₀, h1]
  norm_num

end H0

end Transitive

/-! ## A permutation lattice on a finite `G`-set is a lattice -/

section Finite

variable {G Ω : Type*} [Group G] [MulAction G Ω] [Finite Ω]

instance moduleFinite : Module.Finite ℤ (PermLattice G Ω) :=
  inferInstanceAs (Module.Finite ℤ (Ω → ℤ))

variable [Fintype G] {σ : G}

/-- The Tate cohomology of a permutation lattice on a finite `G`-set is finite, with no
transitivity assumption. -/
theorem finite_tateH0_of_finite (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) :
    Finite (CyclicTate.TateH0 G (PermLattice G Ω) σ) :=
  CyclicTate.finite_tateH0_of_moduleFinite hgen

theorem finite_tateH1_of_finite (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) :
    Finite (CyclicTate.TateH1 G (PermLattice G Ω) σ) :=
  CyclicTate.finite_tateH1_of_moduleFinite hgen

end Finite

/-! ## Transport along an equivariant equivalence of `G`-sets -/

section Congr

variable {G Ω Ω' : Type*} [Group G] [MulAction G Ω] [MulAction G Ω']

/-- An equivalence of `G`-sets induces an isomorphism of permutation lattices. -/
def congrAddEquiv (e : Ω ≃ Ω') : PermLattice G Ω ≃+ PermLattice G Ω' where
  toFun f := ofFun fun x ↦ eval f (e.symm x)
  invFun f := ofFun fun x ↦ eval f (e x)
  left_inv _ := ext fun x ↦ by simp
  right_inv _ := ext fun x ↦ by simp
  map_add' _ _ := rfl

@[simp] theorem eval_congrAddEquiv (e : Ω ≃ Ω') (f : PermLattice G Ω) (x : Ω') :
    eval (congrAddEquiv e f) x = eval f (e.symm x) := rfl

/-- The inverse of an equivariant equivalence of `G`-sets is equivariant. -/
theorem equiv_symm_equivariant {e : Ω ≃ Ω'} (he : ∀ (g : G) (x : Ω), e (g • x) = g • e x)
    (g : G) (y : Ω') : e.symm (g • y) = g • e.symm y := by
  apply e.injective
  rw [Equiv.apply_symm_apply, he, Equiv.apply_symm_apply]

/-- The isomorphism induced by an *equivariant* equivalence of `G`-sets is equivariant. -/
theorem congrAddEquiv_equivariant {e : Ω ≃ Ω'} (he : ∀ (g : G) (x : Ω), e (g • x) = g • e x)
    (g : G) (f : PermLattice G Ω) :
    congrAddEquiv e (g • f) = g • congrAddEquiv (G := G) e f := by
  refine ext fun x ↦ ?_
  rw [eval_congrAddEquiv, eval_smul, eval_smul, eval_congrAddEquiv]
  congr 1
  apply e.injective
  rw [Equiv.apply_symm_apply, he, Equiv.apply_symm_apply]

variable [Fintype G] (σ : G)

/-- **The Herbrand quotient only depends on the `G`-set up to equivariant equivalence.** -/
theorem herbrand_congr {e : Ω ≃ Ω'} (he : ∀ (g : G) (x : Ω), e (g • x) = g • e x) :
    CyclicTate.herbrand G (PermLattice G Ω) σ = CyclicTate.herbrand G (PermLattice G Ω') σ :=
  CyclicTate.herbrand_eq_of_addEquiv _ (congrAddEquiv_equivariant he) σ

theorem finite_tateH0_congr {e : Ω ≃ Ω'} (he : ∀ (g : G) (x : Ω), e (g • x) = g • e x)
    [Finite (CyclicTate.TateH0 G (PermLattice G Ω) σ)] :
    Finite (CyclicTate.TateH0 G (PermLattice G Ω') σ) :=
  CyclicTate.finite_tateH0_of_addEquiv _ (congrAddEquiv_equivariant he) σ

theorem finite_tateH1_congr {e : Ω ≃ Ω'} (he : ∀ (g : G) (x : Ω), e (g • x) = g • e x)
    [Finite (CyclicTate.TateH1 G (PermLattice G Ω) σ)] :
    Finite (CyclicTate.TateH1 G (PermLattice G Ω') σ) :=
  CyclicTate.finite_tateH1_of_addEquiv _ (congrAddEquiv_equivariant he) σ

end Congr

/-! ## The orbit decomposition -/

section Sigma

variable {G : Type*} [Group G] {ι : Type*} {Ω : ι → Type*} [∀ i, MulAction G (Ω i)]

/-- A permutation lattice on a disjoint union is the product of the permutation lattices. -/
def sigmaAddEquiv : PermLattice G (Σ i, Ω i) ≃+ (∀ i, PermLattice G (Ω i)) where
  toFun f i := ofFun fun x ↦ eval f ⟨i, x⟩
  invFun F := ofFun fun p ↦ eval (F p.1) p.2
  left_inv _ := ext fun _ ↦ rfl
  right_inv _ := funext fun _ ↦ ext fun _ ↦ rfl
  map_add' _ _ := funext fun _ ↦ ext fun _ ↦ rfl

@[simp] theorem eval_sigmaAddEquiv (f : PermLattice G (Σ i, Ω i)) (i : ι) (x : Ω i) :
    eval (sigmaAddEquiv f i) x = eval f ⟨i, x⟩ := rfl

theorem sigmaAddEquiv_equivariant (g : G) (f : PermLattice G (Σ i, Ω i)) :
    sigmaAddEquiv (g • f) = g • (sigmaAddEquiv (Ω := Ω) f) :=
  funext fun _ ↦ ext fun _ ↦ rfl

variable [Fintype G] (σ : G) [Fintype ι]

/-- **The Herbrand quotient of a permutation lattice is multiplicative over the orbit
decomposition.** -/
theorem herbrand_sigma
    [∀ i, Finite (CyclicTate.TateH0 G (PermLattice G (Ω i)) σ)]
    [∀ i, Finite (CyclicTate.TateH1 G (PermLattice G (Ω i)) σ)] :
    CyclicTate.herbrand G (PermLattice G (Σ i, Ω i)) σ
      = ∏ i, CyclicTate.herbrand G (PermLattice G (Ω i)) σ := by
  rw [CyclicTate.herbrand_eq_of_addEquiv (sigmaAddEquiv (G := G) (Ω := Ω))
    sigmaAddEquiv_equivariant σ]
  exact CyclicTate.herbrand_pi σ

end Sigma

/-! ## The Herbrand quotient of an arbitrary finite permutation lattice -/

section Orbits

variable {G : Type*} [Group G] [Fintype G] {σ : G} {ι : Type*} [Fintype ι] {Ω : ι → Type*}
  [∀ i, MulAction G (Ω i)] [∀ i, Fintype (Ω i)] [∀ i, DecidableEq (Ω i)]
  [∀ i, MulAction.IsPretransitive G (Ω i)]

/-- **The Herbrand quotient of a finite permutation lattice**: for a `G`-set which is the
disjoint union of transitive `G`-sets `Ω i` with base points `x i`,
`h(ℤ[Σ i, Ω i]) = ∏ i #Stab_G(x i)`. -/
theorem herbrand_sigma_eq_prod (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (x : ∀ i, Ω i) :
    CyclicTate.herbrand G (PermLattice G (Σ i, Ω i)) σ
      = ∏ i, (Nat.card (MulAction.stabilizer G (x i)) : ℚ) := by
  haveI : ∀ i, Finite (CyclicTate.TateH0 G (PermLattice G (Ω i)) σ) :=
    fun i ↦ finite_tateH0 hgen (x i)
  haveI : ∀ i, Finite (CyclicTate.TateH1 G (PermLattice G (Ω i)) σ) :=
    fun i ↦ finite_tateH1 hgen (x i)
  rw [herbrand_sigma σ]
  exact Finset.prod_congr rfl fun i _ ↦ herbrand_eq hgen (x i)

theorem finite_tateH0_sigma (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (x : ∀ i, Ω i) :
    Finite (CyclicTate.TateH0 G (PermLattice G (Σ i, Ω i)) σ) := by
  haveI : ∀ i, Finite (CyclicTate.TateH0 G (PermLattice G (Ω i)) σ) :=
    fun i ↦ finite_tateH0 hgen (x i)
  exact CyclicTate.finite_tateH0_of_addEquiv (sigmaAddEquiv (G := G) (Ω := Ω)).symm
    (CyclicTate.symm_equivariant _ sigmaAddEquiv_equivariant) σ

theorem finite_tateH1_sigma (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (x : ∀ i, Ω i) :
    Finite (CyclicTate.TateH1 G (PermLattice G (Σ i, Ω i)) σ) := by
  haveI : ∀ i, Finite (CyclicTate.TateH1 G (PermLattice G (Ω i)) σ) :=
    fun i ↦ finite_tateH1 hgen (x i)
  exact CyclicTate.finite_tateH1_of_addEquiv (sigmaAddEquiv (G := G) (Ω := Ω)).symm
    (CyclicTate.symm_equivariant _ sigmaAddEquiv_equivariant) σ

end Orbits

/-! ## The augmentation ideal -/

section Augmentation

variable {G Ω : Type*} [Group G] [MulAction G Ω] [Fintype Ω]

/-- The augmentation `ℤ[Ω] → ℤ`, with `ℤ` presented as the permutation lattice of a point so
that it carries the trivial action. -/
def totalHom : PermLattice G Ω →+[G] PermLattice G Unit where
  toFun f := ofFun fun _ ↦ total f
  map_smul' g f := ext fun _ ↦ by rw [eval_smul, eval_ofFun, eval_ofFun, total_smul]
  map_zero' := ext fun _ ↦ by simp [total]
  map_add' f f' := ext fun _ ↦ by simp

@[simp] theorem eval_totalHom (f : PermLattice G Ω) (x : Unit) :
    eval (totalHom (G := G) f) x = total f := rfl

/-- **The augmentation ideal** `ℤ[Ω]⁰ = { f : Σ f = 0 }`, the kernel of the augmentation. -/
def kerTotal : AddSubgroup (PermLattice G Ω) where
  carrier := {f | total f = 0}
  zero_mem' := total_zero
  add_mem' hx hy := by
    show total _ = 0
    rw [total_add, hx, hy, add_zero]
  neg_mem' {x} hx := by
    show total (-x) = 0
    have hneg : total (-x) = -total x := by simp [total, Finset.sum_neg_distrib]
    rw [hneg, show total x = 0 from hx, neg_zero]

@[simp] theorem mem_kerTotal {f : PermLattice G Ω} : f ∈ kerTotal (G := G) ↔ total f = 0 := Iff.rfl

instance : CyclicTate.IsStableSubgroup G (kerTotal (G := G) (Ω := Ω)) where
  smul_mem g {x} hx := by
    show total (g • x) = 0
    rw [total_smul]
    exact hx

instance moduleFinite_kerTotal [Finite Ω] :
    Module.Finite ℤ (kerTotal (G := G) (Ω := Ω)) :=
  Module.Finite.of_injective ((kerTotal (G := G) (Ω := Ω)).subtype.toIntLinearMap)
    fun _ _ h ↦ Subtype.ext h

variable [DecidableEq Ω] [Nonempty Ω]

/-- `0 → ℤ[Ω]⁰ → ℤ[Ω] → ℤ → 0` is short exact. -/
theorem isShortExact_totalHom :
    CyclicTate.IsShortExact (CyclicTate.stableSubgroupIncl G (kerTotal (G := G) (Ω := Ω)))
      (totalHom (G := G) (Ω := Ω)) where
  inj _ _ h := Subtype.ext h
  surj y := by
    classical
    refine ⟨(eval y ()) • delta (G := G) (Classical.arbitrary Ω), ext fun x ↦ ?_⟩
    rw [eval_totalHom, total_zsmul, total_delta, mul_one]
  exact f := by
    constructor
    · intro hf
      exact ⟨⟨f, mem_kerTotal.2 (congrFun (congrArg eval hf) ())⟩, rfl⟩
    · rintro ⟨⟨a, ha⟩, rfl⟩
      refine ext fun _ ↦ ?_
      show total a = 0
      exact ha

variable [Fintype G] {σ : G}

/-- **The Herbrand quotient of the augmentation ideal**: `h(ℤ[Ω]⁰) · #G = h(ℤ[Ω])`.  With
`h(ℤ[Ω]) = ∏ #D` over the orbits, this is the shape `(∏_v n_v) / n` of the Herbrand quotient
of the `S`-unit lattice. -/
theorem herbrand_kerTotal_mul_card (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) :
    CyclicTate.herbrand G (kerTotal (G := G) (Ω := Ω)) σ * (Nat.card G : ℚ)
      = CyclicTate.herbrand G (PermLattice G Ω) σ := by
  haveI := finite_tateH0_of_finite (G := G) (Ω := Ω) (σ := σ) hgen
  haveI := finite_tateH1_of_finite (G := G) (Ω := Ω) (σ := σ) hgen
  haveI := finite_tateH0_of_finite (G := G) (Ω := Unit) (σ := σ) hgen
  haveI := finite_tateH1_of_finite (G := G) (Ω := Unit) (σ := σ) hgen
  haveI := CyclicTate.finite_tateH0_of_moduleFinite
    (G := G) (M := (kerTotal (G := G) (Ω := Ω) : Type _)) (σ := σ) hgen
  haveI := CyclicTate.finite_tateH1_of_moduleFinite
    (G := G) (M := (kerTotal (G := G) (Ω := Ω) : Type _)) (σ := σ) hgen
  have hpt : CyclicTate.herbrand G (PermLattice G Unit) σ = (Nat.card G : ℚ) := by
    rw [herbrand_eq hgen ()]
    congr 1
    rw [show MulAction.stabilizer G (()) = ⊤ by
      ext g; simp [MulAction.mem_stabilizer_iff], Subgroup.card_top]
  rw [(isShortExact_totalHom (G := G) (Ω := Ω)).herbrand_eq_mul σ, hpt]

/-- The Herbrand quotient of the augmentation ideal, as a quotient. -/
theorem herbrand_kerTotal (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) :
    CyclicTate.herbrand G (kerTotal (G := G) (Ω := Ω)) σ
      = CyclicTate.herbrand G (PermLattice G Ω) σ / (Nat.card G : ℚ) := by
  have hne : (Nat.card G : ℚ) ≠ 0 := by
    simp only [ne_eq, Nat.cast_eq_zero]
    exact Nat.card_pos.ne'
  field_simp
  exact herbrand_kerTotal_mul_card hgen

end Augmentation

/-! ## A numerical check

The cyclic group of order `2` acting on a point: the permutation lattice is `ℤ` with the
trivial action, and `h(ℤ) = #G = 2`.  This exercises the whole computation
(`kerSubEquiv`, `map_kerSubEquiv_rangeNorm`, `card_tateH0`, `subsingleton_tateH1`). -/

section Example

private theorem exists_pow_eq_zmod_two (g : Multiplicative (ZMod 2)) :
    ∃ k : ℕ, (Multiplicative.ofAdd (1 : ZMod 2)) ^ k = g := by
  refine ⟨(Multiplicative.toAdd g).val, ?_⟩
  have h : (Multiplicative.ofAdd (1 : ZMod 2)) ^ ((Multiplicative.toAdd g).val)
      = Multiplicative.ofAdd ((Multiplicative.toAdd g).val • (1 : ZMod 2)) := by
    rw [← ofAdd_nsmul]
  rw [h, nsmul_eq_mul, mul_one, ZMod.natCast_val, ZMod.cast_id]
  rfl

example : CyclicTate.herbrand (Multiplicative (ZMod 2))
    (PermLattice (Multiplicative (ZMod 2)) Unit) (Multiplicative.ofAdd 1) = 2 := by
  rw [herbrand_eq exists_pow_eq_zmod_two ()]
  norm_num [show MulAction.stabilizer (Multiplicative (ZMod 2)) () = ⊤ by
    ext g; simp [MulAction.mem_stabilizer_iff]]

end Example

end PermLattice
