module

public import Iwasawalib.NumberTheory.CFT.IdeleClassHerbrand

@[expose] public section

/-!
# The second fundamental inequality

Let `L / K` be a cyclic extension of number fields with group `G = ⟨σ⟩`.  The **second
fundamental inequality** of class field theory is

`#H²(Gal(L/K), C_L) ≥ [L : K]`.

It is a formal consequence of the computation `h(C_L) = [L : K]`
(`NumberField.herbrand_ideleClassGroup_of_herbrand_sIdele`), because the Herbrand quotient is
`#Ĥ⁰ / #Ĥ¹` and `#Ĥ¹ ≥ 1`.  No vanishing statement for `H¹(Gal(L/K), C_L)` is needed for the
*inequality*; the vanishing only upgrades it to an equality
(`NumberField.card_tateH0_ideleClassGroup_eq_of_subsingleton`).

## Why it is stated with `Ĥ⁰` as well as with `groupCohomology`

`CyclicTate.herbrand_eq_card_groupCohomology` identifies `Ĥ⁰(G, M)` with `H²(G, M)` for a
finite cyclic group, but Mathlib's finite-cyclic machinery requires `G` to carry a `CommGroup`
instance, whereas `L ≃ₐ[K] L` carries only `Group`.  `CyclicTate.commGroupOfGen` builds the
missing `CommGroup` structure *on top of* the existing `Group` structure out of the generation
hypothesis `hgen`, so both forms are available and agree:
`NumberField.card_groupCohomology_two_ideleClassGroup_ge` is the inequality for Mathlib's
`groupCohomology`.

## What is assumed

The arithmetic input taken as a hypothesis is inherited verbatim from
`NumberField.herbrand_ideleClassGroup_of_herbrand_sIdele`: the hypothesis `hidele`, the value
`h(𝕀_{L,S}) = ∏_{v ∈ S ∪ S_∞} n_v` of the Herbrand quotient of the `S`-ideles.  That is the
*local* half of the computation (semilocal decomposition, Shapiro, and `h(L_wˣ) = #D_w`).
Dirichlet's `S`-unit theorem in full-lattice form, the Noether-Deuring comparison, the value
`h(O_{L,S}^×) = (∏_v n_v) / n` and the short exact sequence
`1 → O_{L,S}^× → 𝕀_{L,S} → C_L → 1` are all proved, in
`Iwasawalib/NumberTheory/CFT/SUnitLattice.lean`, `Iwasawalib/NumberTheory/CFT/SUnitHerbrand.lean`
and `Iwasawalib/NumberTheory/CFT/IdeleClassHerbrand.lean`.

`hidele` is discharged in exactly one case: every finite place of `K` is unramified in `L`, and
every archimedean place of `K` has trivial decomposition group in `Gal(L/K)`.  There
`NumberField.herbrand_ideleClassGroup_eq_card_of_unramified`
(`Iwasawalib/NumberTheory/CFT/IdeleClassHerbrandValue.lean`) proves the value of `h(𝕀_{L,S})`
inside its proof, for its own choice of places above `S`, from `NumberField.herbrand_sIdele` and
the local value `NumberField.herbrand_adicCompletion_units_eq_card`, and concludes
`h(C_L) = [L : K]` with no hypothesis left over;
`NumberField.herbrand_ideleClassGroup_eq_card_of_unramified_everywhere` supplies `S` as well.
The second inequality in that case, without `hidele`, is
`NumberField.card_tateH0_ideleClassGroup_ge_of_unramified` and
`NumberField.card_tateH0_ideleClassGroup_ge_everywhere`
(`Iwasawalib/NumberTheory/CFT/FirstInequality.lean`).  When some finite place of `K` ramifies in
`L`, or some archimedean decomposition group is nontrivial, no declaration of this repository
discharges `hidele`.

## Main statements

* `CyclicTate.herbrand_le_card_tateH0` : `h(M) ≤ #Ĥ⁰(M)`, the elementary inequality behind
  everything here.
* `CyclicTate.commGroupOfGen` : a group generated by one element is commutative.
* `NumberField.card_tateH0_ideleClassGroup_ge` : `#Ĥ⁰(Gal(L/K), C_L) ≥ [L : K]`.
* `NumberField.card_groupCohomology_two_ideleClassGroup_ge` : the same with Mathlib's
  `H²(Gal(L/K), C_L)`.
* `NumberField.card_tateH0_ideleClassGroup_eq_of_subsingleton` : if `Ĥ¹(Gal(L/K), C_L) = 0`
  then `#Ĥ⁰(Gal(L/K), C_L) = [L : K]` exactly.
-/

noncomputable section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum MulAction CategoryTheory
open NumberField.InfiniteAdeleRing

attribute [local instance] NumberField.galIdeleClassMulDistribMulAction

/-! ## The elementary inequality `h ≤ #Ĥ⁰` -/

namespace CyclicTate

section Elementary

variable {G : Type*} [Group G] [Fintype G] {M : Type*} [AddCommGroup M]
  [DistribMulAction G M]

/-- **A group in which every element is a power of a fixed `σ` is commutative.**  The resulting
`CommGroup` structure is built on top of the given `Group` structure, so it is definitionally
compatible with it and can be introduced with `letI` in the middle of a proof about a group
that is only known to be cyclic by hypothesis. -/
@[instance_reducible] def commGroupOfGen {σ : G} (hgen : ∀ g : G, ∃ m : ℕ, σ ^ m = g) : CommGroup G :=
  { ‹Group G› with
    mul_comm := by
      intro a b
      obtain ⟨m, rfl⟩ := hgen a
      obtain ⟨n, rfl⟩ := hgen b
      rw [← pow_add, ← pow_add, Nat.add_comm] }

/-- **`h(M) ≤ #Ĥ⁰(G, M)`.**  The Herbrand quotient is `#Ĥ⁰ / #Ĥ¹` and `#Ĥ¹ ≥ 1`. -/
theorem herbrand_le_card_tateH0 (σ : G) [Finite (TateH1 G M σ)] :
    herbrand G M σ ≤ (Nat.card (TateH0 G M σ) : ℚ) := by
  rw [herbrand_def]
  refine div_le_self (by positivity) ?_
  exact_mod_cast card_tateH1_pos (M := M) σ

/-- A lower bound for the Herbrand quotient is a lower bound for `#Ĥ⁰`. -/
theorem le_card_tateH0_of_le_herbrand {q : ℚ} (σ : G) [Finite (TateH1 G M σ)]
    (h : q ≤ herbrand G M σ) : q ≤ (Nat.card (TateH0 G M σ) : ℚ) :=
  h.trans (herbrand_le_card_tateH0 σ)

/-- **If `Ĥ¹(G, M) = 0` then `h(M) = #Ĥ⁰(G, M)` exactly.** -/
theorem herbrand_eq_card_tateH0_of_subsingleton (σ : G) [Subsingleton (TateH1 G M σ)] :
    herbrand G M σ = (Nat.card (TateH0 G M σ) : ℚ) := by
  have h1 : Nat.card (TateH1 G M σ) = 1 := Nat.card_eq_one_iff_unique.2 ⟨‹_›, ⟨0⟩⟩
  rw [herbrand_def, h1, Nat.cast_one, div_one]

end Elementary

/-! ## The same, for Mathlib's `groupCohomology` -/

section Cohomology

variable {G M : Type} [CommGroup G] [Fintype G] [AddCommGroup M] [DistribMulAction G M]

/-- **A lower bound for the Herbrand quotient is a lower bound for `#H²(G, M)`.** -/
theorem le_card_groupCohomology_two_of_le_herbrand {σ : G}
    (hσ : ∀ g : G, g ∈ Subgroup.zpowers σ) [Finite (TateH1 G M σ)] {q : ℚ}
    (h : q ≤ herbrand G M σ) :
    q ≤ (Nat.card (groupCohomology (rep G M) 2 : ModuleCat ℤ) : ℚ) := by
  rw [← card_tateH0_eq (M := M) σ hσ 2 (by decide)]
  exact le_card_tateH0_of_le_herbrand σ h

end Cohomology

end CyclicTate

/-! ## The second fundamental inequality for the idele class group -/

namespace NumberField

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
variable (S : Set (HeightOneSpectrum (𝓞 K))) [Fintype (placesOverSet K L S)]
variable [IsGalois K L] {σ : L ≃ₐ[K] L} [Fintype S]

omit [IsGalois K L] [Fintype S] in
/-- `Ĥ¹(Gal(L/K), C_L)` is finite as soon as `Ĥ¹(Gal(L/K), 𝕀_{L,S})` is: the `S`-units have
finite Tate cohomology because `O_{L,S}^×` is a finitely generated `ℤ`-module
(`NumberField.module_finite_sUnit`), and `1 → O_{L,S}^× → 𝕀_{L,S} → C_L → 1` is exact
(`NumberField.isShortExact_sUnit_sIdele`). -/
theorem finite_tateH1_ideleClassGroup
    (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g)
    (hsup : IdeleGroup.principalSubgroup (𝓞 L) L
      ⊔ IdeleGroup.sIdeleSubgroup L (placesOverSet K L S) = ⊤)
    [Finite (CyclicTate.TateH1 (L ≃ₐ[K] L)
      (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ)] :
    Finite (CyclicTate.TateH1 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ) := by
  haveI : Finite (CyclicTate.TateH0 (L ≃ₐ[K] L) (Additive (SUnitGroup K L S)) σ) :=
    CyclicTate.finite_tateH0_of_moduleFinite hgen
  exact (isShortExact_sUnit_sIdele S hsup).finite_tateH1_right σ

/-- **The second fundamental inequality, in Tate form:**
`#Ĥ⁰(Gal(L/K), C_L) ≥ [L : K]` for a cyclic extension `L / K`.

This is `NumberField.herbrand_ideleClassGroup_of_herbrand_sIdele`, which gives
`h(C_L) = [L : K]`, combined with `CyclicTate.herbrand_le_card_tateH0`.  The hypothesis
`hidele` is the local half of the computation of `h(𝕀_{L,S})`.  It is discharged only when
every finite place is unramified and every archimedean decomposition group is trivial, where
`NumberField.card_tateH0_ideleClassGroup_ge_of_unramified` states this inequality without it;
see the module docstring. -/
theorem card_tateH0_ideleClassGroup_ge
    (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g)
    (hsup : IdeleGroup.principalSubgroup (𝓞 L) L
      ⊔ IdeleGroup.sIdeleSubgroup L (placesOverSet K L S) = ⊤)
    (w₁ : ∀ v : InfinitePlace K, Fibre L v)
    (w₂ : ∀ v : S, FinitePlaceFibre L (v : HeightOneSpectrum (𝓞 K)))
    [Finite (CyclicTate.TateH0 (L ≃ₐ[K] L)
      (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ)]
    [Finite (CyclicTate.TateH1 (L ≃ₐ[K] L)
      (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ)]
    (hidele : CyclicTate.herbrand (L ≃ₐ[K] L)
        (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ
      = (∏ v : InfinitePlace K, (Nat.card (stabilizer (L ≃ₐ[K] L) (w₁ v)) : ℚ))
        * ∏ v : S, (Nat.card (stabilizer (L ≃ₐ[K] L) (w₂ v)) : ℚ)) :
    Nat.card (L ≃ₐ[K] L)
      ≤ Nat.card (CyclicTate.TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ) := by
  haveI := finite_tateH1_ideleClassGroup S hgen hsup
  have h := herbrand_ideleClassGroup_of_herbrand_sIdele S hgen hsup w₁ w₂ hidele
  have h' : (Nat.card (L ≃ₐ[K] L) : ℚ)
      ≤ (Nat.card (CyclicTate.TateH0 (L ≃ₐ[K] L)
          (Additive (IdeleClassGroup (𝓞 L) L)) σ) : ℚ) :=
    CyclicTate.le_card_tateH0_of_le_herbrand σ h.ge
  exact_mod_cast h'

/-- **The second fundamental inequality:** `#H²(Gal(L/K), C_L) ≥ [L : K]` for a cyclic
extension `L / K`, stated for Mathlib's `groupCohomology`.

The `CommGroup` structure that Mathlib's finite-cyclic machinery needs is manufactured from
`hgen` by `CyclicTate.commGroupOfGen`; it refines the existing `Group` structure on
`L ≃ₐ[K] L`, so the representation `CyclicTate.rep` appearing in the conclusion is the one
attached to the usual Galois action on `C_L`. -/
theorem card_groupCohomology_two_ideleClassGroup_ge
    (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g)
    (hsup : IdeleGroup.principalSubgroup (𝓞 L) L
      ⊔ IdeleGroup.sIdeleSubgroup L (placesOverSet K L S) = ⊤)
    (w₁ : ∀ v : InfinitePlace K, Fibre L v)
    (w₂ : ∀ v : S, FinitePlaceFibre L (v : HeightOneSpectrum (𝓞 K)))
    [Finite (CyclicTate.TateH0 (L ≃ₐ[K] L)
      (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ)]
    [Finite (CyclicTate.TateH1 (L ≃ₐ[K] L)
      (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ)]
    (hidele : CyclicTate.herbrand (L ≃ₐ[K] L)
        (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ
      = (∏ v : InfinitePlace K, (Nat.card (stabilizer (L ≃ₐ[K] L) (w₁ v)) : ℚ))
        * ∏ v : S, (Nat.card (stabilizer (L ≃ₐ[K] L) (w₂ v)) : ℚ)) :
    letI : CommGroup (L ≃ₐ[K] L) := CyclicTate.commGroupOfGen hgen
    Nat.card (L ≃ₐ[K] L)
      ≤ Nat.card (groupCohomology
          (CyclicTate.rep (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L))) 2 : ModuleCat ℤ) := by
  letI : CommGroup (L ≃ₐ[K] L) := CyclicTate.commGroupOfGen hgen
  haveI := finite_tateH1_ideleClassGroup S hgen hsup
  have hσ : ∀ g : L ≃ₐ[K] L, g ∈ Subgroup.zpowers σ := fun g ↦ by
    obtain ⟨m, rfl⟩ := hgen g
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers σ) m
  have h := herbrand_ideleClassGroup_of_herbrand_sIdele S hgen hsup w₁ w₂ hidele
  have h' : (Nat.card (L ≃ₐ[K] L) : ℚ)
      ≤ (Nat.card (groupCohomology
          (CyclicTate.rep (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L))) 2 :
            ModuleCat ℤ) : ℚ) :=
    CyclicTate.le_card_groupCohomology_two_of_le_herbrand hσ h.ge
  exact_mod_cast h'

/-- **If `Ĥ¹(Gal(L/K), C_L) = 0` then `#Ĥ⁰(Gal(L/K), C_L) = [L : K]` exactly.**

The vanishing of `H¹(Gal(L/K), C_L)` is the first fundamental inequality.  It is not proved in
this repository, so it is taken here as an instance hypothesis.  Since `H¹(Gal(L/K), 𝕀_L) = 0`
is unconditional (`NumberField.isZero_H1_repIdele`), in Mathlib's `groupCohomology` it is
equivalent to the Hasse principle for the Brauer group
(`NumberField.brauerHassePrinciple_iff_isZero_H1_repIdeleClass`), and, for a cyclic extension in
which every finite place is unramified and every archimedean decomposition group is trivial, to
the norm-index bound `#Ĥ⁰(Gal(L/K), C_L) ≤ [L : K]`
(`NumberField.subsingleton_tateH1_ideleClassGroup_iff_everywhere`).  Note that the *inequality*
`NumberField.card_tateH0_ideleClassGroup_ge` does not need it.

In that unramified case the hypothesis `hidele` is not needed either:
`NumberField.subsingleton_tateH1_ideleClassGroup_iff_card_eq` gives the same equality without
it. -/
theorem card_tateH0_ideleClassGroup_eq_of_subsingleton
    (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g)
    (hsup : IdeleGroup.principalSubgroup (𝓞 L) L
      ⊔ IdeleGroup.sIdeleSubgroup L (placesOverSet K L S) = ⊤)
    (w₁ : ∀ v : InfinitePlace K, Fibre L v)
    (w₂ : ∀ v : S, FinitePlaceFibre L (v : HeightOneSpectrum (𝓞 K)))
    [Finite (CyclicTate.TateH0 (L ≃ₐ[K] L)
      (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ)]
    [Finite (CyclicTate.TateH1 (L ≃ₐ[K] L)
      (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ)]
    [Subsingleton (CyclicTate.TateH1 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ)]
    (hidele : CyclicTate.herbrand (L ≃ₐ[K] L)
        (Additive (IdeleGroup.sIdeleSubgroup L (placesOverSet K L S))) σ
      = (∏ v : InfinitePlace K, (Nat.card (stabilizer (L ≃ₐ[K] L) (w₁ v)) : ℚ))
        * ∏ v : S, (Nat.card (stabilizer (L ≃ₐ[K] L) (w₂ v)) : ℚ)) :
    Nat.card (CyclicTate.TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ)
      = Nat.card (L ≃ₐ[K] L) := by
  have h := herbrand_ideleClassGroup_of_herbrand_sIdele S hgen hsup w₁ w₂ hidele
  rw [CyclicTate.herbrand_eq_card_tateH0_of_subsingleton σ] at h
  exact_mod_cast h

end NumberField
