module

public import Iwasawalib.NumberTheory.CFT.TateTransport
public import Iwasawalib.NumberTheory.CFT.HerbrandProduct

@[expose] public section

/-!
# The semilocal decomposition as an isomorphism of Tate cohomology groups

`Iwasawalib/NumberTheory/CFT/TateTransport.lean` transports Shapiro's lemma for a transitive
equivariant family only as a transfer of `Subsingleton` and of `Finite`.  That is enough to
feed the Herbrand-quotient computations, but it is *not* enough for anything that has to
transport an element, a class, or an order: the semilocal decomposition

`Ĥⁿ(G, (∏_{w : Ω} M w)^×) ≅ Ĥⁿ(Stab_G(w₀), (M w₀)^×)`

is the single most reused fact of global class field theory, and downstream it is needed as an
honest isomorphism.

This file supplies it.  No new mathematics is involved: `EquivariantFamily.shapiroUnits`
already gives the isomorphism in Mathlib's `groupCohomology`, and
`CyclicTate.tateH0EquivGroupCohomology` / `CyclicTate.tateH1EquivGroupCohomology` identify the
explicit Tate groups with `H²` and `H¹`.  What was missing was the composite, and the
consequence that the two orders agree.

The hypotheses are those of `EquivariantFamily.subsingleton_tateH0_piUnits`: `G` is finite
abelian and generated by `σ`, it acts transitively on `Ω`, the stabiliser of `w₀` is generated
by `τ`, and the family is compatible (`IsStabilizerAction`, `IsPiAction`).

## Main definitions

* `EquivariantFamily.tateH0EquivPiUnits`, `EquivariantFamily.tateH1EquivPiUnits` :
  the decomposition for the units of the family.
* `EquivariantFamily.tateH0EquivPi`, `EquivariantFamily.tateH1EquivPi` :
  the same additively.

## Main statements

* `EquivariantFamily.card_tateH0_piUnits`, `EquivariantFamily.card_tateH1_piUnits` :
  the orders agree (no finiteness hypothesis: `Nat.card` is `0` on both sides if infinite).
* `EquivariantFamily.subsingleton_tateH0_piUnits_iff`,
  `EquivariantFamily.subsingleton_tateH1_piUnits_iff` : the vanishing transfer of
  `TateTransport.lean`, upgraded to an `iff`.
-/

noncomputable section

open CategoryTheory MulAction CyclicTate

/-! ## Changing the acting group, as an isomorphism

`Iwasawalib/NumberTheory/CFT/TateTransport.lean` already proves that the four defining
subgroups `kerSub`, `rangeNorm`, `kerNorm`, `rangeSub` are *equal* for two finite groups
identified by a multiplicative isomorphism under which the actions agree.  The two Tate
groups are therefore quotients of equal subgroups by equal subgroups, and the induced
identification is recorded here.  Only the `Subsingleton` consequence was available before.
-/

namespace CyclicTate

section ChangeGroupIso

variable {G G' M : Type*} [Group G] [Fintype G] [Group G'] [Fintype G'] [AddCommGroup M]
  [DistribMulAction G M] [DistribMulAction G' M]

/-- A subquotient `A ⧸ (N ∩ A)` of an abelian group depends only on the pair of subgroups
`(A, N)`.  A `rw` cannot do this: `AddSubgroup.addSubgroupOf N A` has a type depending on `A`,
so rewriting `A` fails to produce a well-typed motive. -/
def quotEquivOfEq {M : Type*} [AddCommGroup M] {A A' N N' : AddSubgroup M} (hA : A = A')
    (hN : N = N') : (A ⧸ N.addSubgroupOf A) ≃+ (A' ⧸ N'.addSubgroupOf A') := by
  subst hA; subst hN; exact AddEquiv.refl _

/-- **`Ĥ⁰` does not depend on the name of the acting group**, as an isomorphism. -/
def tateH0EquivOfGroupEquiv (e : G ≃* G') (he : ∀ (g : G) (x : M), e g • x = g • x) (σ : G) :
    TateH0 G M σ ≃+ TateH0 G' M (e σ) :=
  quotEquivOfEq (kerSub_eq_of_groupEquiv e he σ) (rangeNorm_eq_of_groupEquiv e he)

/-- **`Ĥ¹` does not depend on the name of the acting group**, as an isomorphism. -/
def tateH1EquivOfGroupEquiv (e : G ≃* G') (he : ∀ (g : G) (x : M), e g • x = g • x) (σ : G) :
    TateH1 G M σ ≃+ TateH1 G' M (e σ) :=
  quotEquivOfEq (kerNorm_eq_of_groupEquiv e he) (rangeSub_eq_of_groupEquiv e he σ)

end ChangeGroupIso

/-! ## Changing the module

The isomorphism form is already available elementarily as `CyclicTate.tateH0Equiv` /
`CyclicTate.tateH1Equiv` in `Iwasawalib/NumberTheory/CFT/HerbrandProduct.lean`, for an
equivariant `AddEquiv`.  Recorded here is only the multiplicative repackaging, which is the
form the idele-theoretic modules come in; it needs no cyclicity and no `CommGroup` on `G`,
unlike the `Subsingleton`-only `CyclicTate.subsingleton_tateH0_of_moduleEquiv` of
`Iwasawalib/NumberTheory/CFT/TateTransport.lean`. -/

section ChangeModuleIso

variable {G A B : Type*} [Group G] [Fintype G] [CommGroup A] [CommGroup B]
  [MulDistribMulAction G A] [MulDistribMulAction G B]

attribute [local instance] Additive.distribMulActionOfMulDistrib

variable (e : A ≃* B) (he : ∀ (g : G) (a : A), e (g • a) = g • e a) (σ : G)

include he

/-- **`Ĥ⁰` transfers along an equivariant multiplicative isomorphism**, as an isomorphism. -/
def tateH0EquivOfMulEquiv : TateH0 G (Additive A) σ ≃+ TateH0 G (Additive B) σ :=
  tateH0Equiv (MulEquiv.toAdditive e) (fun g a ↦ he g (Additive.toMul a)) σ

/-- **`Ĥ¹` transfers along an equivariant multiplicative isomorphism**, as an isomorphism. -/
def tateH1EquivOfMulEquiv : TateH1 G (Additive A) σ ≃+ TateH1 G (Additive B) σ :=
  tateH1Equiv (MulEquiv.toAdditive e) (fun g a ↦ he g (Additive.toMul a)) σ

end ChangeModuleIso

end CyclicTate

namespace EquivariantFamily

attribute [local instance] Units.mulDistribMulActionRight
  CyclicTate.Additive.distribMulActionOfMulDistrib

variable {G Ω : Type} [CommGroup G] [Fintype G] [MulAction G Ω] {M : Ω → Type}
  [∀ w, CommRing (M w)] (F : EquivariantFamily G Ω M) {w₀ : Ω}
  [MulSemiringAction G (∀ w : Ω, M w)] [MulSemiringAction (stabilizer G w₀) (M w₀)]
  [IsPretransitive G Ω] [Fintype (stabilizer G w₀)]

variable (hstab : F.IsStabilizerAction (w₀ := w₀)) (hpi : F.IsPiAction)
  {σ : G} (hσ : ∀ g : G, g ∈ Subgroup.zpowers σ)
  {τ : stabilizer G w₀} (hτ : ∀ d : stabilizer G w₀, d ∈ Subgroup.zpowers τ)

include hstab hpi hσ hτ

/-- **The semilocal decomposition of `Ĥ⁰`, as an isomorphism**:
`Ĥ⁰(G, (∏ w : Ω, M w)^×) ≅ Ĥ⁰(Stab_G(w₀), (M w₀)^×)`. -/
def tateH0EquivPiUnits :
    TateH0 G (Additive (∀ w : Ω, M w)ˣ) σ ≃+ TateH0 (stabilizer G w₀) (Additive (M w₀)ˣ) τ :=
  (tateH0EquivGroupCohomology (M := Additive (∀ w : Ω, M w)ˣ) σ hσ 2 (by decide)).trans
    (((F.shapiroUnits hstab hpi 2).toLinearEquiv.toAddEquiv).trans
      (tateH0EquivGroupCohomology (M := Additive (M w₀)ˣ) τ hτ 2 (by decide)).symm)

/-- **The semilocal decomposition of `Ĥ¹`, as an isomorphism**:
`Ĥ¹(G, (∏ w : Ω, M w)^×) ≅ Ĥ¹(Stab_G(w₀), (M w₀)^×)`. -/
def tateH1EquivPiUnits :
    TateH1 G (Additive (∀ w : Ω, M w)ˣ) σ ≃+ TateH1 (stabilizer G w₀) (Additive (M w₀)ˣ) τ :=
  (tateH1EquivGroupCohomology (M := Additive (∀ w : Ω, M w)ˣ) σ hσ 1 ⟨0, by ring⟩).trans
    (((F.shapiroUnits hstab hpi 1).toLinearEquiv.toAddEquiv).trans
      (tateH1EquivGroupCohomology (M := Additive (M w₀)ˣ) τ hτ 1 ⟨0, by ring⟩).symm)

/-- **The semilocal decomposition of `Ĥ⁰` for the additive groups.** -/
def tateH0EquivPi :
    TateH0 G (∀ w : Ω, M w) σ ≃+ TateH0 (stabilizer G w₀) (M w₀) τ :=
  (tateH0EquivGroupCohomology (M := ∀ w : Ω, M w) σ hσ 2 (by decide)).trans
    (((F.shapiro hstab hpi 2).toLinearEquiv.toAddEquiv).trans
      (tateH0EquivGroupCohomology (M := M w₀) τ hτ 2 (by decide)).symm)

/-- **The semilocal decomposition of `Ĥ¹` for the additive groups.** -/
def tateH1EquivPi :
    TateH1 G (∀ w : Ω, M w) σ ≃+ TateH1 (stabilizer G w₀) (M w₀) τ :=
  (tateH1EquivGroupCohomology (M := ∀ w : Ω, M w) σ hσ 1 ⟨0, by ring⟩).trans
    (((F.shapiro hstab hpi 1).toLinearEquiv.toAddEquiv).trans
      (tateH1EquivGroupCohomology (M := M w₀) τ hτ 1 ⟨0, by ring⟩).symm)

/-! ## Consequences -/

/-- The order of `Ĥ⁰(G, (∏ w, M w)^×)` is the order of `Ĥ⁰(Stab_G(w₀), (M w₀)^×)`.  No
finiteness is assumed: if either side is infinite, both `Nat.card`s are `0`. -/
theorem card_tateH0_piUnits :
    Nat.card (TateH0 G (Additive (∀ w : Ω, M w)ˣ) σ)
      = Nat.card (TateH0 (stabilizer G w₀) (Additive (M w₀)ˣ) τ) :=
  Nat.card_congr (F.tateH0EquivPiUnits hstab hpi hσ hτ).toEquiv

/-- The order of `Ĥ¹(G, (∏ w, M w)^×)` is the order of `Ĥ¹(Stab_G(w₀), (M w₀)^×)`. -/
theorem card_tateH1_piUnits :
    Nat.card (TateH1 G (Additive (∀ w : Ω, M w)ˣ) σ)
      = Nat.card (TateH1 (stabilizer G w₀) (Additive (M w₀)ˣ) τ) :=
  Nat.card_congr (F.tateH1EquivPiUnits hstab hpi hσ hτ).toEquiv

/-- `Ĥ⁰(G, (∏ w, M w)^×)` vanishes **exactly when** `Ĥ⁰(Stab_G(w₀), (M w₀)^×)` does. -/
theorem subsingleton_tateH0_piUnits_iff :
    Subsingleton (TateH0 G (Additive (∀ w : Ω, M w)ˣ) σ)
      ↔ Subsingleton (TateH0 (stabilizer G w₀) (Additive (M w₀)ˣ) τ) :=
  ⟨fun _ ↦ (F.tateH0EquivPiUnits hstab hpi hσ hτ).symm.toEquiv.subsingleton,
    fun _ ↦ (F.tateH0EquivPiUnits hstab hpi hσ hτ).toEquiv.subsingleton⟩

/-- `Ĥ¹(G, (∏ w, M w)^×)` vanishes **exactly when** `Ĥ¹(Stab_G(w₀), (M w₀)^×)` does. -/
theorem subsingleton_tateH1_piUnits_iff :
    Subsingleton (TateH1 G (Additive (∀ w : Ω, M w)ˣ) σ)
      ↔ Subsingleton (TateH1 (stabilizer G w₀) (Additive (M w₀)ˣ) τ) :=
  ⟨fun _ ↦ (F.tateH1EquivPiUnits hstab hpi hσ hτ).symm.toEquiv.subsingleton,
    fun _ ↦ (F.tateH1EquivPiUnits hstab hpi hσ hτ).toEquiv.subsingleton⟩

/-- The Herbrand quotient of the product is that of the factor, for the units.  (Recorded
here as a direct consequence of the two order equalities; the same statement is proved by a
different route in `CyclicTate.herbrand_piUnits`.) -/
theorem herbrand_piUnits_of_card :
    herbrand G (Additive (∀ w : Ω, M w)ˣ) σ
      = herbrand (stabilizer G w₀) (Additive (M w₀)ˣ) τ := by
  rw [herbrand_def, herbrand_def, F.card_tateH0_piUnits hstab hpi hσ hτ,
    F.card_tateH1_piUnits hstab hpi hσ hτ]

end EquivariantFamily
