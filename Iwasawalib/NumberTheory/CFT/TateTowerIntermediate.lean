module

public import Iwasawalib.NumberTheory.CFT.IdeleClassNormIndex
public import Iwasawalib.NumberTheory.CFT.TateTower

@[expose] public section

/-!
# The levels of the tower are the idele class groups of the intermediate fields

`Iwasawalib/NumberTheory/CFT/TateTower.lean` runs the tower calculus for `Ĥ⁰` purely in terms of
one additive endomorphism `T`.  This file identifies its ingredients for `M = C_L` and `T` the
action of `σ ∈ Gal(L/K)`:

* `NumberField.IdeleClassGroup.invSub_eq_range_baseChangeAdd` : the `⟨σ ^ a⟩`-invariants of
  `C_L` are the image of `C_F` for `F = L ^ ⟨σ ^ a⟩`, so level `a` of the tower is the idele
  class group of the intermediate field.  This is
  `NumberField.IdeleClassGroup.range_baseChange_eq_setOf_fixed` for `L / F` together with the
  Galois correspondence `IntermediateField.fixingSubgroup_fixedField`; the two Galois actions on
  `C_L`, for the base `K` and for the base `F`, agree definitionally
  (`NumberField.IdeleClassGroup.galIdeleClassAut_fixingSubgroupEquiv`) because
  `NumberField.ideleClassAut` depends only on the ring automorphism of `L`.
* `NumberField.IdeleClassGroup.relTateH0_eq_index_comap`,
  `NumberField.IdeleClassGroup.chainLe_cons_index` : consequently each step of a chain is a norm
  index over the corresponding intermediate field.
-/

noncomputable section

open IsDedekindDomain CyclicTate

attribute [local instance] Units.mulDistribMulActionRight
  NumberField.galIdeleMulDistribMulAction NumberField.galIdeleClassMulDistribMulAction
  CyclicTate.Additive.distribMulActionOfMulDistrib

namespace NumberField.IdeleClassGroup

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
  [Algebra K L] [IsGalois K L]

omit [NumberField K] [IsGalois K L] in
/-- The `Gal(L/K)`-action on `C_L` restricted to an intermediate field is the
`Gal(L/F)`-action. -/
theorem galIdeleClassAut_fixingSubgroupEquiv (F : IntermediateField K L)
    (e : F.fixingSubgroup) (c : IdeleClassGroup (𝓞 L) L) :
    galIdeleClassAut F L (IntermediateField.fixingSubgroupEquiv F e) c
      = galIdeleClassAut K L (e : L ≃ₐ[K] L) c := rfl

/-- The intermediate field `L ^ ⟨σ ^ a⟩` fixed by the subgroup generated by `σ ^ a`. -/
abbrev towerField (σ : L ≃ₐ[K] L) (a : ℕ) : IntermediateField K L :=
  IntermediateField.fixedField (Subgroup.zpowers (σ ^ a))



omit [IsGalois K L] in
theorem mem_fixingSubgroup_towerField (σ : L ≃ₐ[K] L) (a : ℕ) :
    σ ^ a ∈ (towerField σ a).fixingSubgroup := by
  rw [towerField, IntermediateField.fixingSubgroup_fixedField]
  exact Subgroup.mem_zpowers _

/-- **Level `a` of the tower is the idele class group of `L ^ ⟨σ ^ a⟩`.**

The `⟨σ ^ a⟩`-invariants of `C_L`, which is what `CyclicTate.invSub` computes, are exactly the
image of the idele class group of the fixed field `L ^ ⟨σ ^ a⟩`. -/
theorem invSub_eq_range_baseChangeAdd (σ : L ≃ₐ[K] L) (a : ℕ) :
    invSub (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a
      = (baseChangeAdd (towerField σ a) L).range := by
  ext c
  rw [mem_invSub_actEnd]
  have hfix : (towerField σ a).fixingSubgroup = Subgroup.zpowers (σ ^ a) :=
    IntermediateField.fixingSubgroup_fixedField _
  set F := towerField σ a with hF
  set d := Additive.toMul c with hd
  constructor
  · intro h
    have hstab : σ ^ a ∈ MulAction.stabilizer (L ≃ₐ[K] L) d := h
    refine ⟨Additive.ofMul ((baseChangeEquivRange F L).symm ⟨d, ?_⟩), ?_⟩
    · refine MonoidHom.mem_range.2 ?_
      rw [← Set.mem_range, range_baseChange_eq_setOf_fixed]
      intro τ
      set e := (IntermediateField.fixingSubgroupEquiv F).symm τ with he
      have hτ : (IntermediateField.fixingSubgroupEquiv F) e = τ := by
        rw [he, MulEquiv.apply_symm_apply]
      have hmem : (e : L ≃ₐ[K] L) ∈ Subgroup.zpowers (σ ^ a) := hfix ▸ e.2
      have : (e : L ≃ₐ[K] L) ∈ MulAction.stabilizer (L ≃ₐ[K] L) d :=
        (Subgroup.zpowers_le.mpr hstab) hmem
      rw [← hτ, galIdeleClassAut_fixingSubgroupEquiv]
      exact this
    · refine Additive.toMul.injective ?_
      show (baseChange F L) ((baseChangeEquivRange F L).symm _ : IdeleClassGroup (𝓞 F) F) = d
      exact congrArg Subtype.val ((baseChangeEquivRange F L).apply_symm_apply _)
  · rintro ⟨b, rfl⟩
    have hmem : Additive.toMul (baseChangeAdd F L b) ∈ Set.range (baseChange F L) :=
      ⟨Additive.toMul b, rfl⟩
    rw [range_baseChange_eq_setOf_fixed] at hmem
    have := hmem ((IntermediateField.fixingSubgroupEquiv F) ⟨σ ^ a, mem_fixingSubgroup_towerField σ a⟩)
    rw [galIdeleClassAut_fixingSubgroupEquiv] at this
    exact this

/-- **The relative `Ĥ⁰` at level `a` is a norm index for the field `L ^ ⟨σ ^ a⟩`.**

`CyclicTate.relTateH0 T a b` is the index, in `C_{L ^ ⟨σ ^ a⟩}`, of the subgroup of classes whose
image in `C_L` is a relative norm from `C_{L ^ ⟨σ ^ (a * b)⟩}`. -/
theorem relTateH0_eq_index_comap (σ : L ≃ₐ[K] L) (a b : ℕ) :
    relTateH0 (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a b
      = ((relNorm (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a b).comap
          (baseChangeAdd (towerField σ a) L)).index := by
  rw [relTateH0, AddSubgroup.index_comap, invSub_eq_range_baseChangeAdd]

omit [IsGalois K L] in
/-- **The relative norms, spelled out.**  A class of `C_{L ^ ⟨σ ^ a⟩}` lies in the subgroup
measured by `CyclicTate.relTateH0 T a b` exactly when its image in `C_L` is a relative norm
`∏ i < b, σ ^ (a * i) • d` of a `⟨σ ^ (a * b)⟩`-invariant class `d`, i.e. of a class of
`C_{L ^ ⟨σ ^ (a * b)⟩}`. -/
theorem mem_comap_relNorm_iff (σ : L ≃ₐ[K] L) (a b : ℕ)
    (c : Additive (IdeleClassGroup (𝓞 (towerField σ a)) (towerField σ a))) :
    c ∈ (relNorm (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a b).comap
        (baseChangeAdd (towerField σ a) L) ↔
      ∃ d : IdeleClassGroup (𝓞 L) L, (σ ^ (a * b)) • d = d ∧
        ∏ i ∈ Finset.range b, (σ ^ (a * i)) • d
          = baseChange (towerField σ a) L (Additive.toMul c) := by
  rw [AddSubgroup.mem_comap, mem_relNorm_actEnd]
  constructor
  · rintro ⟨y, hy, hsum⟩
    exact ⟨Additive.toMul y, hy, congrArg Additive.toMul hsum⟩
  · rintro ⟨d, hd, hprod⟩
    exact ⟨Additive.ofMul d, hd, Additive.toMul.injective hprod⟩

/-- **The chain hypothesis, step by step, in norm-index language.**  The first step of the
chain `p :: l` at level `a` asks exactly that the index, inside `C_{L ^ ⟨σ ^ a⟩}`, of the classes
that become relative norms from `C_{L ^ ⟨σ ^ (a * p)⟩}` be finite and at most `p`: the first
fundamental inequality for the degree-`p` step `L ^ ⟨σ ^ (a * p)⟩ / L ^ ⟨σ ^ a⟩`. -/
theorem chainLe_cons_index (σ : L ≃ₐ[K] L) (a p : ℕ) (l : List ℕ) :
    ChainLe (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a (p :: l) ↔
      (0 < ((relNorm (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a p).comap
            (baseChangeAdd (towerField σ a) L)).index ∧
        ((relNorm (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a p).comap
            (baseChangeAdd (towerField σ a) L)).index ≤ p ∧
        ChainLe (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) (a * p) l) := by
  rw [chainLe_cons, relTateH0_eq_index_comap]

end NumberField.IdeleClassGroup
