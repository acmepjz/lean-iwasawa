module

public import Iwasawalib.NumberTheory.CFT.AdeleBaseChangeNaturality
public import Iwasawalib.NumberTheory.CFT.NormIndexIdele
public import Iwasawalib.NumberTheory.CFT.TateTowerIntermediate

@[expose] public section

/-!
# The interior steps of the tower are norm indices of the intermediate extensions

`Iwasawalib/NumberTheory/CFT/TateTowerIntermediate.lean` identifies level `a` of the `Ĥ⁰`
tower with the idele class group of `F = L ^ ⟨σ ^ a⟩`, leaving the step from level `a` to level
`a * p` expressed by the *explicit relative norm* `∏_{i < p} σ^{a i}` on `C_L`.  This file
carries out the Galois-correspondence computation that turns that explicit relative norm into
the norm of the extension `F' / F`, where `F' = L ^ ⟨(σ^a)^p⟩` is the next field up:

`relTateH0 T a p = [C_F : N_{F'/F} C_{F'}]`.

For `a = 1` and `p = [L : K]` this is
`NumberField.IdeleClassGroup.card_tateH0_eq_index_normSubgroup`, the classical
`#Ĥ⁰(Gal(L/K), C_L) = [C_K : N C_L]`; for general `a` it is the same statement one level up
the tower, which is what `Iwasawalib/NumberTheory/CFT/FirstInequalityTower.lean` needs at every
interior level.

The mathematical content is in three steps.

1. **Level `a` over `K` is level `1` over `F`.**  `CyclicTate.relNorm_pow` and
   `CyclicTate.invSub_pow` say `relNorm T a b = relNorm (T ^ a) 1 b` and
   `invSub T a = invSub (T ^ a) 1` as subgroups, and
   `NumberField.IdeleClassGroup.actEnd_towerGen` says that `T ^ a` is the action of
   `σ ^ a` viewed as an automorphism of `L` over `F` — the two actions on `C_L` agree
   *definitionally*, because `NumberField.ideleClassAut` is defined on `RingAut L` and never
   sees the base field.  So the whole problem reduces to the case `a = 1`.

2. **The norm of `L ^ ⟨σ ^ p⟩ / K` is `∏_{i < p} σ^i`.**  This is
   `NumberField.IdeleClassGroup.baseChange_prod_smul`: the restriction map
   `Gal(L/K) → Gal(L^⟨σ^p⟩/K)` is surjective, its image is generated by `ρ = σ|_{L^⟨σ^p⟩}`,
   and `ρ ^ p = 1`, so `i ↦ ρ ^ i` is a surjection `Fin p → Gal(L^⟨σ^p⟩/K)` — a bijection once
   the order of that Galois group is known to be `p`.  Base change is equivariant along it by
   `NumberField.IdeleClassGroup.baseChange_ideleClassAut_restrictStable`.

3. **The invariants are the image.**  `NumberField.IdeleClassGroup.invSub_eq_range_baseChangeAdd`
   identifies the `σ^p`-invariant classes of `C_L` with `C_{L^⟨σ^p⟩}`.

The single arithmetic input that is *not* proved here is the order of the Galois group of the
step, `Nat.card Gal(F'/F) = p`; it appears as the explicit hypothesis `hcard`.  It is exactly
`[F' : F] = p`, which in the application holds because `p` divides the order of `σ ^ a`.

## Main definitions

* `NumberField.IdeleClassGroup.towerGen` : `σ ^ a` as an automorphism of `L` over `L ^ ⟨σ ^ a⟩`.

## Main statements

* `CyclicTate.invSub_pow`, `CyclicTate.relNorm_pow`, `CyclicTate.relTateH0_pow` : level `a` for
  `T` is level `1` for `T ^ a`.
* `NumberField.IdeleClassGroup.actEnd_towerGen`,
  `NumberField.IdeleClassGroup.towerGen_gen` : the action of `towerGen σ a` on `C_L` is `T ^ a`,
  and it generates `Gal(L / L^⟨σ^a⟩)`.
* `NumberField.IdeleClassGroup.baseChange_prod_smul` : the norm over `Gal(L^⟨σ^p⟩/K)`, pushed
  into `C_L`, is `∏_{i < p} σ^i`.
* `NumberField.IdeleClassGroup.relNorm_one_comap_eq_normSubgroup` : **the case `a = 1`**, an
  equality of subgroups of `C_K`.
* `NumberField.IdeleClassGroup.relNorm_comap_eq_normSubgroup`,
  `NumberField.IdeleClassGroup.relTateH0_eq_index_normSubgroup` : **the general level**,
  `relTateH0 T a p = [C_F : N_{F'/F} C_{F'}]`.
* `NumberField.IdeleClassGroup.chainLe_cons_iff_index_normSubgroup` : the chain condition at
  level `a`, step `p`, is exactly the first fundamental inequality for `F' / F`.
* `NumberField.IdeleClassGroup.chainLe_cons_of_normIdeles` : the classical entry point at an
  interior level — a subgroup `D ≤ 𝕀_F` of norms of ideles of `F'` with `[𝕀_F : F^× · D] ≤ p`
  gives the chain step, which for `a = 1` is
  `NumberField.IdeleClassGroup.chainLe_singleton_of_idele_norms`.
* `NumberField.IdeleClassGroup.normSubgroup_towerField_card_eq` : the consistency check at
  `p = [L : K]`, where `L ^ ⟨σ ^ p⟩ = L` and the statement must reduce to
  `card_tateH0_eq_index_normSubgroup`.
-/

noncomputable section

open IsDedekindDomain CyclicTate

attribute [local instance] Units.mulDistribMulActionRight
  NumberField.galIdeleMulDistribMulAction NumberField.galIdeleClassMulDistribMulAction
  CyclicTate.Additive.distribMulActionOfMulDistrib

/-! ## Level `a` for `T` is level `1` for `T ^ a` -/

namespace CyclicTate

variable {M : Type*} [AddCommGroup M]

theorem invSub_pow (T : AddMonoid.End M) (a b : ℕ) : invSub (T ^ a) b = invSub T (a * b) := by
  rw [invSub, invSub, ← pow_mul]

theorem relNorm_pow (T : AddMonoid.End M) (a b : ℕ) : relNorm (T ^ a) 1 b = relNorm T a b := by
  rw [relNorm, relNorm, one_mul, pow_one, invSub_pow]

theorem relTateH0_pow (T : AddMonoid.End M) (a b : ℕ) :
    relTateH0 (T ^ a) 1 b = relTateH0 T a b := by
  rw [relTateH0, relTateH0, relNorm_pow, invSub_pow, mul_one]

end CyclicTate

namespace NumberField.IdeleClassGroup

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
  [Algebra K L] [IsGalois K L]

/-! ## Fixed fields of cyclic subgroups -/

omit [NumberField K] [NumberField L] [IsGalois K L] in
/-- Membership in the fixed field of `⟨s⟩` is fixedness under `s`. -/
theorem mem_fixedField_zpowers_iff (s : L ≃ₐ[K] L) (x : L) :
    x ∈ IntermediateField.fixedField (Subgroup.zpowers s) ↔ s x = x := by
  rw [IntermediateField.mem_fixedField_iff]
  refine ⟨fun h ↦ h s (Subgroup.mem_zpowers s), fun h f hf ↦ ?_⟩
  have hle : Subgroup.zpowers s ≤ MulAction.stabilizer (L ≃ₐ[K] L) x :=
    Subgroup.zpowers_le.2 (show s • x = x from h)
  exact hle hf

omit [NumberField K] [NumberField L] [IsGalois K L] in
/-- An automorphism commuting with `s` stabilises the fixed field of `⟨s⟩`. -/
theorem map_fixedField_zpowers (s τ : L ≃ₐ[K] L) (h : Commute τ s) :
    (IntermediateField.fixedField (Subgroup.zpowers s)).map (τ : L →ₐ[K] L)
      = IntermediateField.fixedField (Subgroup.zpowers s) := by
  have key : ∀ t : L ≃ₐ[K] L, Commute t s → ∀ x : L,
      x ∈ IntermediateField.fixedField (Subgroup.zpowers s) →
      t x ∈ IntermediateField.fixedField (Subgroup.zpowers s) := by
    intro t ht x hx
    rw [mem_fixedField_zpowers_iff] at hx ⊢
    have := congrArg (fun f : L ≃ₐ[K] L ↦ f x) ht.symm
    simpa [hx] using this
  refine le_antisymm ?_ ?_
  · rintro _ ⟨x, hx, rfl⟩
    exact key τ h x hx
  · intro x hx
    exact ⟨τ.symm x, key τ.symm h.inv_left x hx, by simp⟩

omit [NumberField K] [NumberField L] [IsGalois K L] in
/-- If `Gal(L/K)` is generated by `σ` then it is commutative. -/
theorem isMulCommutative_of_gen {σ : L ≃ₐ[K] L}
    (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g) : IsMulCommutative (L ≃ₐ[K] L) := by
  refine ⟨⟨fun x y ↦ ?_⟩⟩
  obtain ⟨m, rfl⟩ := hgen x
  obtain ⟨n, rfl⟩ := hgen y
  rw [← pow_add, ← pow_add, Nat.add_comm]

omit [NumberField K] [NumberField L] in
/-- `L ^ ⟨σ ^ p⟩` is Galois over `K` when `σ` generates `Gal(L/K)`. -/
theorem isGalois_towerField {σ : L ≃ₐ[K] L} (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g)
    (p : ℕ) : IsGalois K (towerField σ p) := by
  haveI := isMulCommutative_of_gen hgen
  haveI : (Subgroup.zpowers (σ ^ p)).Normal := Subgroup.normal_of_isMulCommutative _
  exact IsGalois.of_fixedField_normal_subgroup _

omit [NumberField K] [NumberField L] [IsGalois K L] in
/-- Restriction to a stable intermediate field agrees with `AlgEquiv.restrictNormalHom`. -/
theorem restrictNormalHom_eq_restrictStable (E : IntermediateField K L) [Normal K E]
    (τ : L ≃ₐ[K] L) (hE : E.map (τ : L →ₐ[K] L) = E) :
    AlgEquiv.restrictNormalHom E τ = E.restrictStable τ hE := by
  refine AlgEquiv.ext fun x ↦ ?_
  refine (algebraMap E L).injective ?_
  rw [show AlgEquiv.restrictNormalHom E τ = τ.restrictNormal E from rfl,
    AlgEquiv.restrictNormal_commutes]
  exact (IntermediateField.coe_restrictStable E τ hE x).symm

/-! ## `σ ^ a` as an automorphism over the fixed field -/

/-- **`σ ^ a` as an automorphism of `L` over `L ^ ⟨σ ^ a⟩`.** -/
def towerGen (σ : L ≃ₐ[K] L) (a : ℕ) : L ≃ₐ[towerField σ a] L :=
  IntermediateField.fixingSubgroupEquiv _ ⟨σ ^ a, mem_fixingSubgroup_towerField σ a⟩

omit [IsGalois K L] in
/-- **The action of `towerGen σ a` on `C_L` is `T ^ a`.**  The two `MulDistribMulAction`s,
over `K` and over `L ^ ⟨σ ^ a⟩`, agree definitionally. -/
theorem actEnd_towerGen (σ : L ≃ₐ[K] L) (a : ℕ) :
    actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) (towerGen σ a)
      = (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) ^ a := by
  rw [actEnd_pow]
  rfl

omit [IsGalois K L] in
/-- **`towerGen σ a` generates `Gal(L / L^⟨σ^a⟩)`.** -/
theorem towerGen_gen (σ : L ≃ₐ[K] L) (a : ℕ) (g : L ≃ₐ[towerField σ a] L) :
    ∃ m : ℕ, (towerGen σ a) ^ m = g := by
  obtain ⟨x, hx⟩ := (IntermediateField.fixingSubgroupEquiv (towerField σ a)).surjective g
  have hmem : (x : L ≃ₐ[K] L) ∈ Subgroup.zpowers (σ ^ a) := by
    rw [← IntermediateField.fixingSubgroup_fixedField (Subgroup.zpowers (σ ^ a))]
    exact x.2
  rw [← mem_powers_iff_mem_zpowers] at hmem
  obtain ⟨n, hn⟩ := hmem
  have key : (⟨σ ^ a, mem_fixingSubgroup_towerField σ a⟩ :
      (towerField σ a).fixingSubgroup) ^ n = x := Subtype.ext (by simpa using hn)
  exact ⟨n, by rw [towerGen, ← map_pow, key, hx]⟩

/-! ## The norm of `L ^ ⟨σ ^ p⟩ / K`, pushed into `C_L` -/

variable {σ : L ≃ₐ[K] L}

/-- **The norm over `Gal(L^⟨σ^p⟩ / K)`, pushed into `C_L`, is `∏_{i < p} σ^i`.**

The Galois-correspondence computation: `i ↦ σ^i|_{L^⟨σ^p⟩}` is a bijection from `Fin p` onto
`Gal(L^⟨σ^p⟩/K)` as soon as that group has order `p`, and base change `C_{L^⟨σ^p⟩} → C_L` is
equivariant along it. -/
theorem baseChange_prod_smul (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g) (p : ℕ)
    (hcard : Nat.card (↥(towerField σ p) ≃ₐ[K] ↥(towerField σ p)) = p)
    (d : IdeleClassGroup (𝓞 ↥(towerField σ p)) ↥(towerField σ p)) :
    baseChange ↥(towerField σ p) L (∏ g : ↥(towerField σ p) ≃ₐ[K] ↥(towerField σ p), g • d)
      = ∏ i ∈ Finset.range p, (σ ^ i) • baseChange ↥(towerField σ p) L d := by
  haveI := isGalois_towerField hgen p
  revert d
  set E := towerField σ p with hE
  intro d
  set ρ : ↥E ≃ₐ[K] ↥E := AlgEquiv.restrictNormalHom ↥E σ with hρ
  have hstab : ∀ i : ℕ, E.map ((σ ^ i : L ≃ₐ[K] L) : L →ₐ[K] L) = E := fun i ↦
    map_fixedField_zpowers (σ ^ p) (σ ^ i) ((Commute.refl σ).pow_pow i p)
  have hres : ∀ i : ℕ, ρ ^ i = E.restrictStable (σ ^ i) (hstab i) := by
    intro i
    rw [hρ, ← map_pow, restrictNormalHom_eq_restrictStable]
  have hnat : ∀ i : ℕ, baseChange ↥E L ((ρ ^ i) • d) = (σ ^ i) • baseChange ↥E L d := by
    intro i
    rw [hres i]
    exact IdeleClassGroup.baseChange_ideleClassAut_restrictStable E (σ ^ i) (hstab i) d
  have hp : 0 < p := by
    rw [← hcard]
    exact Nat.card_pos
  have hρp : ρ ^ p = 1 := by
    rw [hres p]
    refine AlgEquiv.ext fun x ↦ Subtype.ext ?_
    rw [IntermediateField.coe_restrictStable]
    exact (mem_fixedField_zpowers_iff (σ ^ p) (x : L)).1 x.2
  have hsurj : Function.Surjective (fun i : Fin p ↦ ρ ^ (i : ℕ)) := by
    intro g
    obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective (F := K) (K₁ := ↥E) (E := L) g
    obtain ⟨m, rfl⟩ := hgen τ
    refine ⟨⟨m % p, Nat.mod_lt _ hp⟩, ?_⟩
    show ρ ^ (m % p) = AlgEquiv.restrictNormalHom ↥E (σ ^ m)
    rw [map_pow, ← hρ]
    conv_rhs => rw [← Nat.div_add_mod m p]
    rw [pow_add, pow_mul, hρp, one_pow, one_mul]
  have hbij : Function.Bijective (fun i : Fin p ↦ ρ ^ (i : ℕ)) :=
    (Nat.bijective_iff_surjective_and_card _).2 ⟨hsurj, by rw [Nat.card_fin, hcard]⟩
  rw [map_prod, ← Fin.prod_univ_eq_prod_range
    (fun i : ℕ ↦ (σ ^ i) • baseChange ↥E L d) p]
  exact (Fintype.prod_bijective (fun i : Fin p ↦ ρ ^ (i : ℕ)) hbij
    (fun i : Fin p ↦ (σ ^ (i : ℕ)) • baseChange ↥E L d)
    (fun g ↦ baseChange ↥E L (g • d)) (fun i ↦ (hnat i).symm)).symm

/-! ## The identification, first at level one and then at every level -/

omit [IsGalois K L] in
/-- Membership in the level-one relative norms, in multiplicative notation. -/
theorem mem_comap_relNorm_one_iff (p : ℕ) (c : Additive (IdeleClassGroup (𝓞 K) K)) :
    c ∈ (relNorm (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) 1 p).comap
        (baseChangeAdd K L) ↔
      ∃ d : IdeleClassGroup (𝓞 L) L, (σ ^ p) • d = d ∧
        ∏ i ∈ Finset.range p, (σ ^ i) • d = baseChange K L (Additive.toMul c) := by
  rw [AddSubgroup.mem_comap, mem_relNorm_actEnd]
  simp only [one_mul]
  constructor
  · rintro ⟨y, hy, hsum⟩
    exact ⟨Additive.toMul y, hy, congrArg Additive.toMul hsum⟩
  · rintro ⟨d, hd, hprod⟩
    exact ⟨Additive.ofMul d, hd, Additive.toMul.injective hprod⟩

/-- **The level-one relative norms are the norms of `L ^ ⟨σ ^ p⟩ / K`.**

An equality of subgroups of `C_K`: the classes whose image in `C_L` is `∏_{i < p} σ^i · d` for a
`σ^p`-invariant `d` are exactly the norms from `C_{L^⟨σ^p⟩}`. -/
theorem relNorm_one_comap_eq_normSubgroup (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g) (p : ℕ)
    (hcard : Nat.card (↥(towerField σ p) ≃ₐ[K] ↥(towerField σ p)) = p) :
    (relNorm (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) 1 p).comap
        (baseChangeAdd K L) = normSubgroup K ↥(towerField σ p) := by
  have hrange := invSub_eq_range_baseChangeAdd σ p
  have hmem : ∀ d : IdeleClassGroup (𝓞 L) L, (σ ^ p) • d = d ↔
      ∃ d' : IdeleClassGroup (𝓞 ↥(towerField σ p)) ↥(towerField σ p),
        baseChange ↥(towerField σ p) L d' = d := by
    intro d
    constructor
    · intro h
      have hd : Additive.ofMul d ∈ invSub (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) p :=
        mem_invSub_actEnd.2 h
      rw [hrange] at hd
      obtain ⟨b, hb⟩ := hd
      exact ⟨Additive.toMul b, congrArg Additive.toMul hb⟩
    · rintro ⟨d', rfl⟩
      have hd : Additive.ofMul (baseChange ↥(towerField σ p) L d')
          ∈ invSub (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) p := by
        rw [hrange]
        exact ⟨Additive.ofMul d', rfl⟩
      exact mem_invSub_actEnd.1 hd
  ext c
  rw [mem_comap_relNorm_one_iff, mem_normSubgroup_iff_prod]
  constructor
  · rintro ⟨d, hd, hprod⟩
    obtain ⟨d', rfl⟩ := (hmem d).1 hd
    refine ⟨d', baseChange_injective ↥(towerField σ p) L ?_⟩
    rw [baseChange_prod_smul hgen p hcard d', hprod,
      IdeleClassGroup.baseChange_trans K ↥(towerField σ p) L]
  · rintro ⟨d', hprod⟩
    refine ⟨baseChange ↥(towerField σ p) L d', (hmem _).2 ⟨d', rfl⟩, ?_⟩
    rw [← baseChange_prod_smul hgen p hcard d', hprod,
      IdeleClassGroup.baseChange_trans K ↥(towerField σ p) L]

/-- **The step from level `a` to level `a * p` is the norm of `F' / F`.**

Here `F = L ^ ⟨σ ^ a⟩` and `F' = L ^ ⟨(σ^a)^p⟩ = L ^ ⟨σ ^ (a * p)⟩`, and `F'` is presented as an
intermediate field of `L / F` so that `normSubgroup F F'` makes sense.  The hypothesis `hcard`
is `[F' : F] = p`. -/
theorem relNorm_comap_eq_normSubgroup (σ : L ≃ₐ[K] L) (a p : ℕ)
    (hcard : Nat.card (↥(towerField (towerGen σ a) p) ≃ₐ[↥(towerField σ a)]
      ↥(towerField (towerGen σ a) p)) = p) :
    (relNorm (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a p).comap
        (baseChangeAdd ↥(towerField σ a) L)
      = normSubgroup ↥(towerField σ a) ↥(towerField (towerGen σ a) p) := by
  rw [← relNorm_pow, ← actEnd_towerGen]
  exact relNorm_one_comap_eq_normSubgroup (towerGen_gen σ a) p hcard

/-- **The relative `Ĥ⁰` at level `a`, step `p`, is the norm index of `F' / F`.**

`relTateH0 T a p = [C_{L^⟨σ^a⟩} : N C_{L^⟨σ^{a p}⟩}]`. -/
theorem relTateH0_eq_index_normSubgroup (σ : L ≃ₐ[K] L) (a p : ℕ)
    (hcard : Nat.card (↥(towerField (towerGen σ a) p) ≃ₐ[↥(towerField σ a)]
      ↥(towerField (towerGen σ a) p)) = p) :
    relTateH0 (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a p
      = (normSubgroup ↥(towerField σ a) ↥(towerField (towerGen σ a) p)).index := by
  rw [relTateH0_eq_index_comap, relNorm_comap_eq_normSubgroup σ a p hcard]

/-- **The chain condition at an interior level is the first fundamental inequality for the
step.**  An equivalence: the chain step is neither more nor less than
`[C_F : N_{F'/F} C_{F'}] ≤ p`. -/
theorem chainLe_cons_iff_index_normSubgroup (σ : L ≃ₐ[K] L) (a p : ℕ) (l : List ℕ)
    (hcard : Nat.card (↥(towerField (towerGen σ a) p) ≃ₐ[↥(towerField σ a)]
      ↥(towerField (towerGen σ a) p)) = p) :
    ChainLe (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a (p :: l) ↔
      (0 < (normSubgroup ↥(towerField σ a) ↥(towerField (towerGen σ a) p)).index ∧
        (normSubgroup ↥(towerField σ a) ↥(towerField (towerGen σ a) p)).index ≤ p ∧
        ChainLe (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) (a * p) l) := by
  rw [chainLe_cons, relTateH0_eq_index_normSubgroup σ a p hcard]

/-- **The first inequality for an interior step, granted a subgroup of norm ideles.**

The interior-level form of `NumberField.IdeleClassGroup.chainLe_singleton_of_idele_norms`:
with `F = L ^ ⟨σ ^ a⟩` and `F' = L ^ ⟨σ ^ (a * p)⟩`, a subgroup `D ≤ 𝕀_F` whose elements are
honest norms `∏_{g ∈ Gal(F'/F)} g · b` of ideles of `F'`, with `[𝕀_F : F^× · D]` finite and at
most `p`, gives the chain step at level `a`.  This is the shape in which Chevalley's count
delivers its input, now at every level of the tower rather than only at the bottom. -/
theorem chainLe_cons_of_normIdeles (σ : L ≃ₐ[K] L) (a p : ℕ) (l : List ℕ)
    (hcard : Nat.card (↥(towerField (towerGen σ a) p) ≃ₐ[↥(towerField σ a)]
      ↥(towerField (towerGen σ a) p)) = p)
    (D : Subgroup (IdeleGroup (𝓞 ↥(towerField σ a)) ↥(towerField σ a)))
    (hD : ∀ u ∈ D, ∃ b : IdeleGroup (𝓞 ↥(towerField (towerGen σ a) p))
        ↥(towerField (towerGen σ a) p),
      ∏ g : ↥(towerField (towerGen σ a) p) ≃ₐ[↥(towerField σ a)]
          ↥(towerField (towerGen σ a) p), g • b
        = IdeleGroup.baseChange ↥(towerField σ a) ↥(towerField (towerGen σ a) p) u)
    (hpos : 0 < (IdeleGroup.principalSubgroup (𝓞 ↥(towerField σ a)) ↥(towerField σ a) ⊔ D).index)
    (hle : (IdeleGroup.principalSubgroup (𝓞 ↥(towerField σ a)) ↥(towerField σ a) ⊔ D).index ≤ p)
    (hchain : ChainLe (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) (a * p) l) :
    ChainLe (actEnd (M := Additive (IdeleClassGroup (𝓞 L) L)) σ) a (p :: l) := by
  have hdvd := index_normSubgroup_dvd_index_sup_of_idele
    (K := ↥(towerField σ a)) (L := ↥(towerField (towerGen σ a) p)) D hD
  rw [chainLe_cons_iff_index_normSubgroup σ a p l hcard]
  refine ⟨?_, ?_, hchain⟩
  · rcases Nat.eq_zero_or_pos
      (normSubgroup ↥(towerField σ a) ↥(towerField (towerGen σ a) p)).index with h | h
    · rw [h] at hdvd
      exact absurd (Nat.eq_zero_of_zero_dvd hdvd) hpos.ne'
    · exact h
  · exact le_trans (Nat.le_of_dvd hpos hdvd) hle

/-! ## Consistency control at the top of the tower -/

/-- **The anti-vacuity control.**  At `p = [L : K]` the fixed field `L ^ ⟨σ ^ p⟩` is all of `L`,
and `relNorm_one_comap_eq_normSubgroup` must then reproduce the definition of `N_{L/K} C_L`.
It does: the two norm subgroups of `C_K` coincide.  This is a genuine non-degeneracy pair —
`normSubgroup K ↥(towerField σ p)` is computed through the Galois correspondence of
`baseChange_prod_smul` while `normSubgroup K L` is the plain `∏_{g ∈ Gal(L/K)} g`, and they
could not both be what they are if the enumeration `i ↦ σ^i` of `Gal(L^⟨σ^p⟩/K)` were wrong. -/
theorem normSubgroup_towerField_card_eq (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g) :
    normSubgroup K ↥(towerField σ (Nat.card (L ≃ₐ[K] L))) = normSubgroup K L := by
  have hσ : ∀ g : L ≃ₐ[K] L, g ∈ Subgroup.zpowers σ := fun g ↦ by
    obtain ⟨m, rfl⟩ := hgen g
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers σ) m
  have htop : towerField σ (Nat.card (L ≃ₐ[K] L)) = ⊤ := by
    have h1 : σ ^ Nat.card (L ≃ₐ[K] L) = 1 := pow_card_eq_one'
    show IntermediateField.fixedField (Subgroup.zpowers (σ ^ Nat.card (L ≃ₐ[K] L))) = ⊤
    rw [h1, Subgroup.zpowers_one_eq_bot, IntermediateField.fixedField_bot]
  have hcard : Nat.card (↥(towerField σ (Nat.card (L ≃ₐ[K] L))) ≃ₐ[K]
      ↥(towerField σ (Nat.card (L ≃ₐ[K] L)))) = Nat.card (L ≃ₐ[K] L) := by
    rw [htop]
    exact Nat.card_congr (AlgEquiv.autCongr IntermediateField.topEquiv).toEquiv
  rw [← relNorm_one_comap_eq_normSubgroup hgen _ hcard, normSubgroup, rangeNorm_eq_relNorm hσ]

end NumberField.IdeleClassGroup

