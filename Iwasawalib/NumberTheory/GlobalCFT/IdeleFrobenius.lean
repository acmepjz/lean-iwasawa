module

public import Iwasawalib.NumberTheory.GlobalCFT.ArtinMap
public import Iwasawalib.NumberTheory.CFT.IdeleClassGroup
public import Iwasawalib.NumberTheory.CFT.AdicOrd

@[expose] public section

/-!
# The reciprocity map on ideles of an unramified abelian extension

`Iwasawalib/NumberTheory/GlobalCFT/ArtinMap.lean` builds the Frobenius homomorphism
`NumberField.frobIdealHom : (FractionalIdeal (𝓞 F)⁰ F)ˣ →* Gal(K/F)` on *fractional ideals* and
isolates `NumberField.IsArtinReciprocal` as the hypothesis that it kills principal ideals.
Class field theory, however, needs the reciprocity map on the **idele class group**, because
that is the group whose norm quotient the cohomological machinery of this repository computes
(`Iwasawalib/NumberTheory/CFT/IdeleClassNormIndex.lean`).

This file supplies the missing link.  An idele `a ∈ 𝕀_F` has a well-defined order
`ord_p(a_p) ∈ ℤ` at each finite place, zero for all but finitely many `p` — that is exactly the
statement that `a` and `a⁻¹` are both integral almost everywhere, which is
`IsDedekindDomain.FiniteAdeleRing.isUnit_iff`.  So

`NumberField.frobIdeleHom F K a = ∏_p Frob_p ^ ord_p(a_p)`

is defined with no hypothesis at all beyond `K / F` unramified abelian, and:

* on a **principal** idele it is `frobIdealHom` of the principal ideal
  (`NumberField.frobIdeleHom_principalEmbedding`), so
  `NumberField.isArtinReciprocal_iff_frobIdeleHom` : `IsArtinReciprocal F K` is *equivalent* to
  the statement that `frobIdeleHom` kills the principal ideles;
* granted reciprocity it therefore descends to the idele class group,
  `NumberField.artinIdeleClassMap : C_F →* Gal(K/F)`;
* its image is the subgroup generated by the Frobenius elements
  (`NumberField.range_frobIdeleHom`), so its surjectivity is again the Chebotarev input and
  nothing new;
* it sends a uniformiser at `p`, placed in the single coordinate `p`, to `Frob_p`
  (`NumberField.frobIdeleHom_single`), which is the normalisation that makes it *the* Artin
  map and not some other isomorphism of the same groups.

Nothing here is conditional except where `IsArtinReciprocal` is an explicit argument.

## Main definitions

* `IsDedekindDomain.HeightOneSpectrum.ordCompletion` : the `ℤ`-valued valuation on `K_v`.
* `NumberField.IdeleGroup.ord` : the order of an idele at a finite place.
* `NumberField.frobIdeleHom` : the reciprocity map on ideles.
* `NumberField.artinIdeleClassMap` : its descent to `C_F`, granted `IsArtinReciprocal F K`.

## Main statements

* `NumberField.IdeleGroup.ord_mul`, `NumberField.IdeleGroup.finite_support_ord`.
* `NumberField.frobIdeleHom_principalEmbedding`,
  `NumberField.isArtinReciprocal_iff_frobIdeleHom`.
* `NumberField.artinIdeleClassMap_mk`, `NumberField.surjective_artinIdeleClassMap_iff`.
-/

noncomputable section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum FractionalIdeal WithZero NumberField
open scoped IsMulCommutative nonZeroDivisors

/-! ## The `ℤ`-valued valuation on a completion -/

namespace IsDedekindDomain.HeightOneSpectrum

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K]
variable (v : HeightOneSpectrum R)

/-- The `ℤ`-valued `v`-adic valuation on the completion `K_v`, normalised so that a uniformiser
has value `1`.  It extends `IsDedekindDomain.HeightOneSpectrum.ord`
(`IsDedekindDomain.HeightOneSpectrum.ordCompletion_coe`). -/
def ordCompletion (x : v.adicCompletion K) : ℤ := - WithZero.log (Valued.v x)

variable {K v}

@[simp] theorem ordCompletion_coe (x : K) :
    v.ordCompletion K (x : v.adicCompletion K) = v.ord K x := by
  rw [ordCompletion, valuedAdicCompletion_eq_valuation', ord]

@[simp] theorem ordCompletion_one : v.ordCompletion K 1 = 0 := by
  rw [ordCompletion, map_one, WithZero.log_one, neg_zero]

theorem ordCompletion_mul {x y : v.adicCompletion K} (hx : x ≠ 0) (hy : y ≠ 0) :
    v.ordCompletion K (x * y) = v.ordCompletion K x + v.ordCompletion K y := by
  rw [ordCompletion, ordCompletion, ordCompletion, map_mul, WithZero.log_mul
    ((Valuation.ne_zero_iff _).2 hx) ((Valuation.ne_zero_iff _).2 hy), neg_add]

theorem ordCompletion_eq_zero_of_valued_eq_one {x : v.adicCompletion K}
    (hx : Valued.v x = 1) : v.ordCompletion K x = 0 := by
  rw [ordCompletion, hx, WithZero.log_one, neg_zero]

end IsDedekindDomain.HeightOneSpectrum

/-! ## The order of an idele at a finite place -/

namespace NumberField.IdeleGroup

variable {R K : Type*} [CommRing R] [IsDedekindDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]

/-- The finite part of an idele, as a unit of the ring of finite adeles. -/
def finitePart (a : IdeleGroup R K) : (FiniteAdeleRing R K)ˣ :=
  Units.map (RingHom.snd (InfiniteAdeleRing K) (FiniteAdeleRing R K)).toMonoidHom a

/-- **The order of an idele at a finite place** `v`, i.e. `ord_v` of its `v`-th component. -/
def ord (a : IdeleGroup R K) (v : HeightOneSpectrum R) : ℤ :=
  v.ordCompletion K ((a : AdeleRing R K).2 v)

theorem component_ne_zero (a : IdeleGroup R K) (v : HeightOneSpectrum R) :
    (a : AdeleRing R K).2 v ≠ 0 :=
  (FiniteAdeleRing.isUnit_iff.1 (finitePart a).isUnit).1 v

theorem eventually_valued_eq_one (a : IdeleGroup R K) :
    ∀ᶠ v : HeightOneSpectrum R in Filter.cofinite, Valued.v ((a : AdeleRing R K).2 v) = 1 :=
  (FiniteAdeleRing.isUnit_iff.1 (finitePart a).isUnit).2

/-- **An idele has order zero at all but finitely many places.** -/
theorem eventually_ord_eq_zero (a : IdeleGroup R K) :
    ∀ᶠ v : HeightOneSpectrum R in Filter.cofinite, ord a v = 0 :=
  (eventually_valued_eq_one a).mono fun _ h ↦
    IsDedekindDomain.HeightOneSpectrum.ordCompletion_eq_zero_of_valued_eq_one h

@[simp] theorem ord_one (v : HeightOneSpectrum R) : ord (1 : IdeleGroup R K) v = 0 :=
  IsDedekindDomain.HeightOneSpectrum.ordCompletion_one

theorem ord_mul (a b : IdeleGroup R K) (v : HeightOneSpectrum R) :
    ord (a * b) v = ord a v + ord b v :=
  IsDedekindDomain.HeightOneSpectrum.ordCompletion_mul
    (component_ne_zero a v) (component_ne_zero b v)

/-- **The order of a principal idele is the order of the element.** -/
@[simp] theorem ord_principalEmbedding (x : Kˣ) (v : HeightOneSpectrum R) :
    ord (principalEmbedding R K x) v = v.ord K (x : K) :=
  IsDedekindDomain.HeightOneSpectrum.ordCompletion_coe (x : K)

end NumberField.IdeleGroup


/-! ## Ideles supported at a single place -/

namespace NumberField.IdeleGroup

variable {R K : Type*} [CommRing R] [IsDedekindDomain R] [Field K]
  [Algebra R K] [IsFractionRing R K]

open scoped Classical in
/-- The finite adele with value `x` at `p` and `1` at every other place. -/
def singleFiniteAdele (p : HeightOneSpectrum R) (x : p.adicCompletion K) :
    FiniteAdeleRing R K :=
  ⟨Function.update (fun v : HeightOneSpectrum R ↦ (1 : v.adicCompletion K)) p x, by
    refine Set.Finite.subset (Set.finite_singleton p) ?_
    intro v hv
    by_contra hne
    apply hv
    show Function.update (fun v : HeightOneSpectrum R ↦ (1 : v.adicCompletion K)) p x v ∈
      (v.adicCompletionIntegers K : Set (v.adicCompletion K))
    rw [Function.update_of_ne (by simpa using hne)]
    exact one_mem _⟩

@[simp] theorem singleFiniteAdele_apply_self (p : HeightOneSpectrum R)
    (x : p.adicCompletion K) : singleFiniteAdele p x p = x := by
  classical
  exact Function.update_self (f := fun v : HeightOneSpectrum R ↦ (1 : v.adicCompletion K)) p x

@[simp] theorem singleFiniteAdele_apply_of_ne (p : HeightOneSpectrum R)
    (x : p.adicCompletion K) {v : HeightOneSpectrum R} (h : v ≠ p) :
    singleFiniteAdele p x v = 1 := by
  classical
  exact Function.update_of_ne h _ (fun v : HeightOneSpectrum R ↦ (1 : v.adicCompletion K))

/-- The finite adele supported at one place, as a unit when its value there is one. -/
def singleFiniteUnit (p : HeightOneSpectrum R) (x : (p.adicCompletion K)ˣ) :
    (FiniteAdeleRing R K)ˣ where
  val := singleFiniteAdele p (x : p.adicCompletion K)
  inv := singleFiniteAdele p ((x⁻¹ : (p.adicCompletion K)ˣ) : p.adicCompletion K)
  val_inv := by
    refine FiniteAdeleRing.ext (K := K) fun v ↦ ?_
    show singleFiniteAdele p (x : p.adicCompletion K) v
        * singleFiniteAdele p ((x⁻¹ : (p.adicCompletion K)ˣ) : p.adicCompletion K) v = 1
    rcases eq_or_ne v p with rfl | h
    · rw [singleFiniteAdele_apply_self, singleFiniteAdele_apply_self]
      exact_mod_cast x.mul_inv
    · rw [singleFiniteAdele_apply_of_ne _ _ h, singleFiniteAdele_apply_of_ne _ _ h, one_mul]
  inv_val := by
    refine FiniteAdeleRing.ext (K := K) fun v ↦ ?_
    show singleFiniteAdele p ((x⁻¹ : (p.adicCompletion K)ˣ) : p.adicCompletion K) v
        * singleFiniteAdele p (x : p.adicCompletion K) v = 1
    rcases eq_or_ne v p with rfl | h
    · rw [singleFiniteAdele_apply_self, singleFiniteAdele_apply_self]
      exact_mod_cast x.inv_mul
    · rw [singleFiniteAdele_apply_of_ne _ _ h, singleFiniteAdele_apply_of_ne _ _ h, one_mul]

/-- The multiplicative embedding of the finite adeles into the adeles which is the identity on
the finite part and `1` on the infinite part.  It is not a ring homomorphism, but it is all that
is needed to turn a finite idele into an idele. -/
def fromFiniteHom : FiniteAdeleRing R K →* AdeleRing R K :=
  MonoidHom.prod (1 : FiniteAdeleRing R K →* InfiniteAdeleRing K) (MonoidHom.id _)

@[simp] theorem fromFiniteHom_snd (a : FiniteAdeleRing R K) (v : HeightOneSpectrum R) :
    (fromFiniteHom a).2 v = a v := rfl

/-- **The idele which is `x` at the place `p` and `1` everywhere else.** -/
def singleIdele (p : HeightOneSpectrum R) (x : (p.adicCompletion K)ˣ) : IdeleGroup R K :=
  Units.map fromFiniteHom (singleFiniteUnit p x)

theorem coe_singleIdele_snd (p : HeightOneSpectrum R) (x : (p.adicCompletion K)ˣ)
    (v : HeightOneSpectrum R) :
    ((singleIdele p x : AdeleRing R K)).2 v
      = (singleFiniteUnit p x : FiniteAdeleRing R K) v := rfl

@[simp] theorem ord_singleIdele_self (p : HeightOneSpectrum R) (x : (p.adicCompletion K)ˣ) :
    ord (singleIdele p x) p = p.ordCompletion K (x : p.adicCompletion K) := by
  rw [ord, coe_singleIdele_snd]
  exact congrArg _ (singleFiniteAdele_apply_self p (x : p.adicCompletion K))

@[simp] theorem ord_singleIdele_of_ne (p : HeightOneSpectrum R) (x : (p.adicCompletion K)ˣ)
    {v : HeightOneSpectrum R} (h : v ≠ p) : ord (singleIdele p x) v = 0 := by
  rw [ord, coe_singleIdele_snd,
    show (singleFiniteUnit p x : FiniteAdeleRing R K) v = 1 from
      singleFiniteAdele_apply_of_ne p (x : p.adicCompletion K) h,
    IsDedekindDomain.HeightOneSpectrum.ordCompletion_one]

end NumberField.IdeleGroup

/-! ## The reciprocity map on ideles -/

namespace NumberField

variable (F K : Type*) [Field F] [NumberField F] [Field K] [Algebra F K]
  [IsAbelianGalois F K] [IsUnramifiedEverywhere F K]

theorem finite_mulSupport_frobAt_zpow_ord (a : IdeleGroup (𝓞 F) F) :
    (Function.mulSupport fun p : HeightOneSpectrum (𝓞 F) =>
      frobAt (K := K) p ^ IdeleGroup.ord a p).Finite := by
  refine Set.Finite.subset
    (Filter.eventually_cofinite.1 (IdeleGroup.eventually_ord_eq_zero a)) ?_
  intro p hp
  simp only [Function.mem_mulSupport] at hp
  exact fun h ↦ hp (by rw [h, zpow_zero])

/-- **The reciprocity map on the idele group** of the base field of an unramified abelian
extension `K / F`, `a ↦ ∏_p Frob_p ^ ord_p(a_p)`.

It is defined unconditionally.  What is *not* unconditional is that it kills the principal
ideles: that is `NumberField.IsArtinReciprocal`, see
`NumberField.isArtinReciprocal_iff_frobIdeleHom`. -/
def frobIdeleHom : IdeleGroup (𝓞 F) F →* Gal(K/F) where
  toFun a := ∏ᶠ p : HeightOneSpectrum (𝓞 F), frobAt (K := K) p ^ IdeleGroup.ord a p
  map_one' := by
    simp only [IdeleGroup.ord_one, zpow_zero, finprod_one]
  map_mul' a b := by
    rw [← finprod_mul_distrib (finite_mulSupport_frobAt_zpow_ord F K a)
      (finite_mulSupport_frobAt_zpow_ord F K b)]
    exact finprod_congr fun p => by rw [IdeleGroup.ord_mul, zpow_add]

theorem frobIdeleHom_apply (a : IdeleGroup (𝓞 F) F) :
    frobIdeleHom F K a = ∏ᶠ p : HeightOneSpectrum (𝓞 F),
      frobAt (K := K) p ^ IdeleGroup.ord a p := rfl

/-- **On a principal idele the reciprocity map is the Frobenius symbol of the principal
ideal.**  Both sides are `∏_p Frob_p ^ ord_p(x)`, by
`IsDedekindDomain.HeightOneSpectrum.ord_eq_count`. -/
theorem frobIdeleHom_principalEmbedding (x : Fˣ) :
    frobIdeleHom F K (IdeleGroup.principalEmbedding (𝓞 F) F x)
      = frobIdealHom F K (toPrincipalIdeal (𝓞 F) F x) := by
  classical
  rw [frobIdeleHom_apply]
  show _ = ∏ᶠ p : HeightOneSpectrum (𝓞 F), frobAt (K := K) p ^
    FractionalIdeal.count F p ((toPrincipalIdeal (𝓞 F) F x : (FractionalIdeal (𝓞 F)⁰ F)ˣ) :
      FractionalIdeal (𝓞 F)⁰ F)
  refine finprod_congr fun p => ?_
  rw [IdeleGroup.ord_principalEmbedding, coe_toPrincipalIdeal,
    IsDedekindDomain.HeightOneSpectrum.ord_eq_count (Units.ne_zero x)]

/-- **Artin reciprocity is exactly the statement that the reciprocity map on ideles kills the
principal ideles**, i.e. that it factors through the idele class group `C_F`. -/
theorem isArtinReciprocal_iff_frobIdeleHom :
    IsArtinReciprocal F K ↔
      ∀ x : Fˣ, frobIdeleHom F K (IdeleGroup.principalEmbedding (𝓞 F) F x) = 1 := by
  simp only [frobIdeleHom_principalEmbedding]
  rfl

/-- **The reciprocity map on ideles kills the principal ideles, granted reciprocity.** -/
theorem frobIdeleHom_eq_one_of_mem_principalSubgroup (h : IsArtinReciprocal F K)
    {a : IdeleGroup (𝓞 F) F} (ha : a ∈ IdeleGroup.principalSubgroup (𝓞 F) F) :
    frobIdeleHom F K a = 1 := by
  obtain ⟨x, rfl⟩ := ha
  exact (isArtinReciprocal_iff_frobIdeleHom F K).1 h x

/-- **The reciprocity map on the idele class group `C_F → Gal(K/F)`**, granted Artin
reciprocity.  This is the map whose norm quotient statement is the reciprocity isomorphism; see
`Iwasawalib/NumberTheory/GlobalCFT/ReciprocityCyclic.lean`. -/
def artinIdeleClassMap (h : IsArtinReciprocal F K) :
    IdeleClassGroup (𝓞 F) F →* Gal(K/F) :=
  QuotientGroup.lift _ (frobIdeleHom F K) fun _ ha =>
    frobIdeleHom_eq_one_of_mem_principalSubgroup F K h ha

@[simp] theorem artinIdeleClassMap_mk (h : IsArtinReciprocal F K) (a : IdeleGroup (𝓞 F) F) :
    artinIdeleClassMap F K h (IdeleClassGroup.mk (𝓞 F) F a) = frobIdeleHom F K a := rfl

theorem surjective_artinIdeleClassMap_iff (h : IsArtinReciprocal F K) :
    Function.Surjective (artinIdeleClassMap F K h) ↔ Function.Surjective (frobIdeleHom F K) := by
  constructor
  · intro hs g
    obtain ⟨c, hc⟩ := hs g
    obtain ⟨a, rfl⟩ := IdeleClassGroup.mk_surjective (𝓞 F) F c
    exact ⟨a, hc⟩
  · intro hs g
    obtain ⟨a, ha⟩ := hs g
    exact ⟨IdeleClassGroup.mk (𝓞 F) F a, ha⟩

end NumberField

/-! ## Normalisation: the value at a uniformiser is the Frobenius -/

namespace NumberField

variable (F K : Type*) [Field F] [NumberField F] [Field K] [Algebra F K]
  [IsAbelianGalois F K] [IsUnramifiedEverywhere F K]

/-- **The value of the reciprocity map at an idele supported at one place.** -/
theorem frobIdeleHom_eq_zpow_of_ord (a : IdeleGroup (𝓞 F) F) (p : HeightOneSpectrum (𝓞 F))
    (h : ∀ q : HeightOneSpectrum (𝓞 F), q ≠ p → IdeleGroup.ord a q = 0) :
    frobIdeleHom F K a = frobAt (K := K) p ^ IdeleGroup.ord a p := by
  rw [frobIdeleHom_apply, finprod_eq_single _ p fun q hq ↦ by rw [h q hq, zpow_zero]]

@[simp] theorem frobIdeleHom_singleIdele (p : HeightOneSpectrum (𝓞 F))
    (x : (p.adicCompletion F)ˣ) :
    frobIdeleHom F K (IdeleGroup.singleIdele p x)
      = frobAt (K := K) p ^ p.ordCompletion F (x : p.adicCompletion F) := by
  rw [frobIdeleHom_eq_zpow_of_ord F K _ p fun q hq ↦ IdeleGroup.ord_singleIdele_of_ne p x hq,
    IdeleGroup.ord_singleIdele_self]

/-- **There is an idele whose reciprocity image is exactly `Frob_p`** : take a uniformiser at
`p` in the coordinate `p` and `1` everywhere else.  This is the normalisation that distinguishes
the Artin map among all isomorphisms between the same two groups. -/
theorem exists_frobIdeleHom_eq_frobAt (p : HeightOneSpectrum (𝓞 F)) :
    ∃ a : IdeleGroup (𝓞 F) F, frobIdeleHom F K a = frobAt (K := K) p := by
  obtain ⟨π, hπ⟩ := valuedAdicCompletion_surjective F p (WithZero.exp (-1 : ℤ))
  have hπ0 : π ≠ 0 := by
    intro h
    rw [h, map_zero] at hπ
    exact WithZero.exp_ne_zero hπ.symm
  refine ⟨IdeleGroup.singleIdele p (Units.mk0 π hπ0), ?_⟩
  rw [frobIdeleHom_singleIdele]
  have : p.ordCompletion F (Units.mk0 π hπ0 : p.adicCompletion F) = 1 := by
    show - WithZero.log (Valued.v π) = 1
    rw [hπ, WithZero.log_exp, neg_neg]
  rw [this, zpow_one]

/-- **The image of the reciprocity map on ideles is generated by the Frobenius elements.** -/
theorem range_frobIdeleHom :
    (frobIdeleHom F K).range = Subgroup.closure (Set.range (frobAt (F := F) (K := K))) := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨a, rfl⟩
    show (∏ᶠ p : HeightOneSpectrum (𝓞 F), frobAt (K := K) p ^ IdeleGroup.ord a p) ∈ _
    exact finprod_induction _ (Subgroup.one_mem _) (fun _ _ ↦ Subgroup.mul_mem _)
      fun p ↦ zpow_mem (Subgroup.subset_closure
        (Set.mem_range_self (f := frobAt (F := F) (K := K)) p)) _
  · rw [Subgroup.closure_le]
    rintro _ ⟨p, rfl⟩
    exact exists_frobIdeleHom_eq_frobAt F K p

/-- **Surjectivity of the reciprocity map on ideles is again the statement that the Frobenius
elements generate `Gal(K/F)`**, exactly as for `NumberField.frobIdealHom`.  So passing from
ideals to ideles costs nothing and gains nothing on this point. -/
theorem surjective_frobIdeleHom_iff :
    Function.Surjective (frobIdeleHom F K) ↔
      Subgroup.closure (Set.range (frobAt (F := F) (K := K))) = ⊤ := by
  rw [← MonoidHom.range_eq_top, range_frobIdeleHom]

/-- **The reciprocity map on the idele class group sends the class of a uniformiser idele at `p`
to `Frob_p`.** -/
theorem exists_artinIdeleClassMap_eq_frobAt (h : IsArtinReciprocal F K)
    (p : HeightOneSpectrum (𝓞 F)) :
    ∃ c : IdeleClassGroup (𝓞 F) F, artinIdeleClassMap F K h c = frobAt (K := K) p := by
  obtain ⟨a, ha⟩ := exists_frobIdeleHom_eq_frobAt F K p
  exact ⟨IdeleClassGroup.mk (𝓞 F) F a, ha⟩

end NumberField
