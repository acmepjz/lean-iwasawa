module

public import Iwasawalib.NumberTheory.GlobalCFT.ReciprocityCyclic
public import Iwasawalib.NumberTheory.GlobalCFT.IdeleFrobeniusNorm

@[expose] public section

/-!
# The reciprocity isomorphism of a cyclic unramified extension

This file puts together the two halves built in
`Iwasawalib/NumberTheory/GlobalCFT/IdeleFrobenius.lean` (the reciprocity map
`ρ : C_K → Gal(L/K)`, `a ↦ ∏_p Frob_p ^ ord_p(a_p)`, defined on the idele class group as soon
as `NumberField.IsArtinReciprocal K L` holds) and
`Iwasawalib/NumberTheory/GlobalCFT/ReciprocityCyclic.lean` (an order computation plus a
one-sided map is an isomorphism) into the statement that global class field theory is about:

`C_K / N_{L/K} C_L ≅ Gal(L/K)`, **canonically**, the class of a uniformiser idele at an
unramified prime `p` going to `Frob_p`.

## What is assumed and why

Three hypotheses appear, and each is named rather than hidden:

* `hgen` : `Gal(L/K)` is cyclic, generated by `σ`.  This is the scope of the whole cyclic Tate
  apparatus of this repository, and it is what makes `Ĥ⁰ = Ĥ²` free of charge.
* `NumberField.IsArtinReciprocal K L` : `∏_p Frob_p ^ ord_p(x) = 1` for `x ∈ Kˣ`.  This is
  Artin reciprocity itself and is not proved here; see the module docstring of
  `Iwasawalib/NumberTheory/GlobalCFT/ArtinMap.lean`.
  (That the reciprocity map kills `N_{L/K} C_L` is *not* an extra hypothesis: it is proved in
  `Iwasawalib/NumberTheory/GlobalCFT/IdeleFrobeniusNorm.lean` from Artin reciprocity alone.)
* surjectivity of `NumberField.frobIdeleHom`, equivalently that the Frobenius elements generate
  `Gal(L/K)` (`NumberField.surjective_frobIdeleHom_iff`); and the count
  `#Ĥ⁰(Gal(L/K), C_L) = [L : K]`, which is the first fundamental inequality.

The point of the file is that *given those*, nothing further about cup products or fundamental
classes is required: the passage from the cardinality to the canonical map is
`AddEquiv.ofSurjectiveOfCardEq`.

## Main statements

* `NumberField.reciprocityEquivOfArtinReciprocal` : `Ĥ⁰(Gal(L/K), C_L) ≃+ Additive Gal(L/K)`.
* `NumberField.reciprocityEquivOfArtinReciprocal_singleIdele` : its value at the class of an
  idele supported at one place is `Frob_p ^ ord_p`, the Frobenius normalisation.
* `NumberField.quotientNormEquivGalOfArtinReciprocal` : the same read as
  `C_K / N_{L/K} C_L ≅ Gal(L/K)`.
-/

noncomputable section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum CyclicTate
open NumberField.IdeleClassGroup

attribute [local instance] Units.mulDistribMulActionRight
  NumberField.galIdeleMulDistribMulAction NumberField.galIdeleClassMulDistribMulAction
  CyclicTate.Additive.distribMulActionOfMulDistrib

namespace NumberField

variable {K : Type} [Field K] [NumberField K] {L : Type} [Field L] [NumberField L]
  [Algebra K L] [IsAbelianGalois K L] [IsUnramifiedEverywhere K L] {σ : L ≃ₐ[K] L}
  (hgen : ∀ g : L ≃ₐ[K] L, ∃ m : ℕ, σ ^ m = g)
  (h : IsArtinReciprocal K L)

include hgen h

/-- **The reciprocity isomorphism `Ĥ⁰(Gal(L/K), C_L) ≃ Gal(L/K)` of a cyclic unramified
extension.**

The map is the Artin map `c ↦ ∏_p Frob_p ^ ord_p(c)` descended to the norm quotient; the proof
that it is bijective is the count `#Ĥ⁰ = [L : K]` together with its surjectivity. -/
def reciprocityEquivOfArtinReciprocal
    (hsurj : Function.Surjective (frobIdeleHom K L))
    (hcard : Nat.card (TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ)
      = Nat.card (L ≃ₐ[K] L)) :
    TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ ≃+ Additive (L ≃ₐ[K] L) :=
  reciprocityEquivOfSurjective hgen (artinIdeleClassMap K L h) (killsNorms_artinIdeleClassMap h)
    ((surjective_artinIdeleClassMap_iff K L h).2 hsurj) hcard

/-- **The reciprocity isomorphism is the Artin map**: on the class of an idele `a` it is
`∏_p Frob_p ^ ord_p(a_p)`. -/
theorem reciprocityEquivOfArtinReciprocal_apply
    (hsurj : Function.Surjective (frobIdeleHom K L))
    (hcard : Nat.card (TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ)
      = Nat.card (L ≃ₐ[K] L)) (a : IdeleGroup (𝓞 K) K) :
    reciprocityEquivOfArtinReciprocal hgen h hsurj hcard
        (toTateH0 hgen (Additive.ofMul (IdeleClassGroup.mk (𝓞 K) K a)))
      = Additive.ofMul (frobIdeleHom K L a) := by
  rw [reciprocityEquivOfArtinReciprocal, reciprocityEquivOfSurjective_apply,
    artinTateH0_toTateH0]
  rfl

/-- **The Frobenius normalisation of the reciprocity isomorphism.**  The class of the idele
which is `x` at `p` and `1` at every other place goes to `Frob_p ^ ord_p(x)`; in particular a
uniformiser at `p` goes to `Frob_p`.  This is the compatibility that
`NumberField.IsUnramifiedEverywhere.artinMap_spec` asks for. -/
theorem reciprocityEquivOfArtinReciprocal_singleIdele
    (hsurj : Function.Surjective (frobIdeleHom K L))
    (hcard : Nat.card (TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ)
      = Nat.card (L ≃ₐ[K] L)) (p : HeightOneSpectrum (𝓞 K)) (x : (p.adicCompletion K)ˣ) :
    reciprocityEquivOfArtinReciprocal hgen h hsurj hcard
        (toTateH0 hgen (Additive.ofMul
          (IdeleClassGroup.mk (𝓞 K) K (IdeleGroup.singleIdele p x))))
      = Additive.ofMul (frobAt (K := L) p ^ p.ordCompletion K (x : p.adicCompletion K)) := by
  rw [reciprocityEquivOfArtinReciprocal_apply, frobIdeleHom_singleIdele]

/-- **`C_K / N_{L/K} C_L ≅ Gal(L/K)`**, the classical form of the reciprocity law for a cyclic
unramified extension. -/
def quotientNormEquivGalOfArtinReciprocal
    (hsurj : Function.Surjective (frobIdeleHom K L))
    (hcard : Nat.card (TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ)
      = Nat.card (L ≃ₐ[K] L)) :
    (Additive (IdeleClassGroup (𝓞 K) K) ⧸ normSubgroup K L) ≃+ Additive (L ≃ₐ[K] L) :=
  quotientNormEquivGalOfSurjective hgen (artinIdeleClassMap K L h) (killsNorms_artinIdeleClassMap h)
    ((surjective_artinIdeleClassMap_iff K L h).2 hsurj) hcard

@[simp] theorem quotientNormEquivGalOfArtinReciprocal_mk
    (hsurj : Function.Surjective (frobIdeleHom K L))
    (hcard : Nat.card (TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ)
      = Nat.card (L ≃ₐ[K] L)) (a : IdeleGroup (𝓞 K) K) :
    quotientNormEquivGalOfArtinReciprocal hgen h hsurj hcard
        (QuotientAddGroup.mk (Additive.ofMul (IdeleClassGroup.mk (𝓞 K) K a)))
      = Additive.ofMul (frobIdeleHom K L a) := by
  rw [quotientNormEquivGalOfArtinReciprocal, quotientNormEquivGalOfSurjective_mk]
  rfl

/-- **The kernel of the Artin map is exactly the group of norms**:
`c ∈ N_{L/K} C_L ↔ ∏_p Frob_p ^ ord_p(c) = 1`.

This is the substantive form of the reciprocity law — Artin reciprocity says that the kernel of
the Frobenius symbol is the norm group, not merely that it contains it.  The inclusion `⊆` is
`NumberField.killsNorms_artinIdeleClassMap` and is unconditional; the inclusion `⊇` is
injectivity of the induced map on `Ĥ⁰`, which here comes from the order computation together
with the surjectivity. -/
theorem mem_normSubgroup_iff_artinIdeleClassMap_eq_one
    (hsurj : Function.Surjective (frobIdeleHom K L))
    (hcard : Nat.card (TateH0 (L ≃ₐ[K] L) (Additive (IdeleClassGroup (𝓞 L) L)) σ)
      = Nat.card (L ≃ₐ[K] L)) (c : IdeleClassGroup (𝓞 K) K) :
    Additive.ofMul c ∈ normSubgroup K L ↔ artinIdeleClassMap K L h c = 1 := by
  rw [← toTateH0_eq_zero_iff hgen]
  constructor
  · intro hz
    have := artinTateH0_toTateH0 hgen (artinIdeleClassMap K L h)
      (killsNorms_artinIdeleClassMap h) (Additive.ofMul c)
    rw [hz, map_zero] at this
    exact this.symm
  · intro hz
    refine (reciprocityEquivOfArtinReciprocal hgen h hsurj hcard).injective ?_
    rw [map_zero, reciprocityEquivOfArtinReciprocal, reciprocityEquivOfSurjective_apply,
      artinTateH0_toTateH0]
    show Additive.ofMul (artinIdeleClassMap K L h c) = 0
    rw [hz]
    rfl

end NumberField
