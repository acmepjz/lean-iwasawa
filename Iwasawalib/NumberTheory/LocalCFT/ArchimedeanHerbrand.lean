module

public import Iwasawalib.NumberTheory.LocalCFT.FaithfulHilbert90
public import Iwasawalib.NumberTheory.LocalCFT.HerbrandTransport
public import Iwasawalib.NumberTheory.CFT.HerbrandProduct
public import Mathlib.LinearAlgebra.Complex.Module
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.Analysis.SpecialFunctions.Sqrt

@[expose] public section

/-!
# The archimedean local Herbrand quotient `h(Gal(ℂ/ℝ), ℂˣ) = 2`

The only ramified archimedean local extension is `ℂ / ℝ`.  Its Galois group has order two,
generated by complex conjugation, and this file computes the two Tate cohomology groups of
`ℂˣ` outright:

* `Ĥ¹(Gal(ℂ/ℝ), ℂˣ) = 0` — Hilbert 90, via
  `LocalCFT.subsingleton_tateH1_units_of_faithful`;
* `Ĥ⁰(Gal(ℂ/ℝ), ℂˣ) = ℝˣ / N(ℂˣ) = ℝˣ / ℝ_{>0}` has order two — the class of `-1` is the
  nontrivial element, and it is nontrivial because `N z = z · z̄ = |z|²` is positive.

Hence `h(ℂˣ) = 2 = [ℂ : ℝ]`, the archimedean counterpart of
`NumberField.herbrand_adicCompletion_units_eq_card_tame`, and the local input at a real place
ramified in `L` for the global identity `h(C_L) = [L : K]`.

The computation of `Ĥ⁰` is elementary and self-contained: a conjugation-invariant unit is a
nonzero real `r`, and `r = N(√r)` if `r > 0` while `r = (-1) · N(√(-r))` if `r < 0`
(`LocalCFT.exists_mulNorm_eq_of_pos`).

## Main statements

* `LocalCFT.mem_zpowers_conjAe`, `LocalCFT.card_galComplexReal`: `Gal(ℂ/ℝ) = ⟨conj⟩` has
  order `2`.
* `LocalCFT.mulNorm_complexUnits`: the norm of `x : ℂˣ` is `x · x̄ = |x|²`.
* `LocalCFT.subsingleton_tateH1_complexUnits`: `Ĥ¹(Gal(ℂ/ℝ), ℂˣ) = 0`.
* `LocalCFT.card_tateH0_complexUnits`: `#Ĥ⁰(Gal(ℂ/ℝ), ℂˣ) = 2`.
* `LocalCFT.herbrand_complexUnits`: **`h(Gal(ℂ/ℝ), ℂˣ) = 2`**.
* `LocalCFT.herbrand_complexUnits_of_group_mulEquiv`: the same for any group acting on `ℂˣ`
  through an isomorphism onto `Gal(ℂ/ℝ)`, which is the form a decomposition group at a
  ramified infinite place takes.
* `LocalCFT.galComplexRealEquiv`: a two-element group `G = {1, σ}` is `Gal(ℂ/ℝ)`.
* `LocalCFT.eq_conj_of_ringEquiv_complex_of_faithful`: an element of a faithful two-element
  action that fixes the reals *is* complex conjugation, under any `e : F ≃+* ℂ`.
* `LocalCFT.herbrand_units_eq_two_of_ringEquiv_complex`,
  `LocalCFT.herbrand_units_eq_two_of_ringEquiv_complex_of_faithful`: `h(G, Fˣ) = 2` for an
  abstract completion `F ≃+* ℂ`, which is the form the statement takes at an infinite place of
  `L` ramified over a real place of `K`.
-/

noncomputable section

open Complex CyclicCocycle

namespace LocalCFT

/-- `Gal(ℂ/ℝ)` is finite (`Finite.algEquiv`); this is the `Fintype` that the Herbrand
quotient of `Iwasawalib/GroupCohomology/Herbrand.lean` asks for. -/
instance galComplexRealFintype : Fintype (ℂ ≃ₐ[ℝ] ℂ) := Fintype.ofFinite _

attribute [local instance] Units.mulDistribMulActionRight

/-! ## `Gal(ℂ/ℝ) = ⟨conj⟩`, of order two -/

@[simp] theorem galComplexReal_smul (g : ℂ ≃ₐ[ℝ] ℂ) (z : ℂ) : g • z = g z := rfl

theorem conjAe_apply (z : ℂ) : (conjAe : ℂ ≃ₐ[ℝ] ℂ) z = (starRingEnd ℂ) z := rfl

/-- **Every `ℝ`-algebra automorphism of `ℂ` is the identity or conjugation.** -/
theorem eq_one_or_eq_conjAe (g : ℂ ≃ₐ[ℝ] ℂ) : g = 1 ∨ g = conjAe := by
  rcases Complex.real_algHom_eq_id_or_conj g.toAlgHom with h | h
  · exact Or.inl (AlgEquiv.ext fun z ↦
      congrFun (congrArg (fun f : ℂ →ₐ[ℝ] ℂ ↦ (f : ℂ → ℂ)) h) z)
  · exact Or.inr (AlgEquiv.ext fun z ↦
      congrFun (congrArg (fun f : ℂ →ₐ[ℝ] ℂ ↦ (f : ℂ → ℂ)) h) z)

theorem conjAe_ne_one : (conjAe : ℂ ≃ₐ[ℝ] ℂ) ≠ 1 := by
  intro h
  have hI := congrArg (fun f : ℂ ≃ₐ[ℝ] ℂ ↦ f I) h
  simp [Complex.ext_iff] at hI
  exact absurd hI (by norm_num)

/-- `Gal(ℂ/ℝ)` is generated by complex conjugation. -/
theorem mem_zpowers_conjAe (g : ℂ ≃ₐ[ℝ] ℂ) : g ∈ Subgroup.zpowers (conjAe : ℂ ≃ₐ[ℝ] ℂ) := by
  rcases eq_one_or_eq_conjAe g with rfl | rfl
  · exact Subgroup.one_mem _
  · exact Subgroup.mem_zpowers _

/-- **`#Gal(ℂ/ℝ) = 2`.** -/
theorem card_galComplexReal : Nat.card (ℂ ≃ₐ[ℝ] ℂ) = 2 := by
  rw [Nat.card_eq_two_iff' (1 : ℂ ≃ₐ[ℝ] ℂ)]
  refine ⟨conjAe, conjAe_ne_one, fun g hg ↦ ?_⟩
  rcases eq_one_or_eq_conjAe g with rfl | rfl
  · exact absurd rfl hg
  · rfl

/-- `Gal(ℂ/ℝ)` acts faithfully on `ℂ`. -/
theorem faithful_galComplexReal :
    Function.Injective fun (g : ℂ ≃ₐ[ℝ] ℂ) ↦ (fun z : ℂ ↦ g • z) :=
  fun _ _ h ↦ AlgEquiv.ext fun z ↦ congrFun h z

/-! ## The norm map of `ℂˣ` -/

/-- **The norm of `Gal(ℂ/ℝ)` on `ℂˣ` is `x ↦ x · x̄`.** -/
theorem mulNorm_complexUnits (x : ℂˣ) :
    mulNorm (G := ℂ ≃ₐ[ℝ] ℂ) x = x * ((conjAe : ℂ ≃ₐ[ℝ] ℂ) • x) := by
  classical
  have huniv : (Finset.univ : Finset (ℂ ≃ₐ[ℝ] ℂ)) = {1, (conjAe : ℂ ≃ₐ[ℝ] ℂ)} := by
    refine (Finset.eq_univ_of_forall fun g ↦ ?_).symm
    rcases eq_one_or_eq_conjAe g with rfl | rfl
    · exact Finset.mem_insert_self _ _
    · exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _)
  rw [mulNorm_def, huniv, Finset.prod_pair (Ne.symm conjAe_ne_one), one_smul]

theorem val_mulNorm_complexUnits (x : ℂˣ) :
    ((mulNorm (G := ℂ ≃ₐ[ℝ] ℂ) x : ℂˣ) : ℂ) = (x : ℂ) * (starRingEnd ℂ) (x : ℂ) := by
  rw [mulNorm_complexUnits]; rfl

/-- The norm of `x : ℂˣ` is the (positive real) square of its absolute value. -/
theorem mulNorm_complexUnits_eq_normSq (x : ℂˣ) :
    ((mulNorm (G := ℂ ≃ₐ[ℝ] ℂ) x : ℂˣ) : ℂ) = (Complex.normSq (x : ℂ) : ℂ) := by
  rw [val_mulNorm_complexUnits, Complex.mul_conj]

/-- **Every positive real is a norm.**  If `0 < r` then `(r : ℂ)ˣ = N(√r)`. -/
theorem exists_mulNorm_eq_of_pos {r : ℝ} (hr : 0 < r) :
    ∃ y : ℂˣ, ((mulNorm (G := ℂ ≃ₐ[ℝ] ℂ) y : ℂˣ) : ℂ) = (r : ℂ) := by
  have hs : (0 : ℝ) < Real.sqrt r := Real.sqrt_pos.2 hr
  refine ⟨Units.mk0 ((Real.sqrt r : ℝ) : ℂ) (by exact_mod_cast hs.ne'), ?_⟩
  rw [mulNorm_complexUnits_eq_normSq]
  norm_cast
  rw [Units.val_mk0, Complex.normSq_ofReal, Real.mul_self_sqrt hr.le]

/-- A conjugation-invariant unit of `ℂ` is real. -/
theorem im_eq_zero_of_smul_conjAe_eq {x : ℂˣ} (hx : (conjAe : ℂ ≃ₐ[ℝ] ℂ) • x = x) :
    (x : ℂ).im = 0 := by
  have : (starRingEnd ℂ) (x : ℂ) = (x : ℂ) := congrArg Units.val hx
  exact Complex.conj_eq_iff_im.1 this

/-! ## The two Tate groups -/

/-- **Hilbert 90 at the ramified real place**: `Ĥ¹(Gal(ℂ/ℝ), ℂˣ) = 0`. -/
theorem subsingleton_tateH1_complexUnits :
    Subsingleton (CyclicTate.TateH1 (ℂ ≃ₐ[ℝ] ℂ) (Additive ℂˣ) conjAe) :=
  subsingleton_tateH1_units_of_faithful mem_zpowers_conjAe faithful_galComplexReal

theorem card_tateH1_complexUnits :
    Nat.card (CyclicTate.TateH1 (ℂ ≃ₐ[ℝ] ℂ) (Additive ℂˣ) conjAe) = 1 :=
  card_tateH1_units_of_faithful mem_zpowers_conjAe faithful_galComplexReal

theorem smul_conjAe_neg_one :
    (conjAe : ℂ ≃ₐ[ℝ] ℂ) • (Additive.ofMul (-1 : ℂˣ)) = Additive.ofMul (-1 : ℂˣ) :=
  congrArg Additive.ofMul (Units.ext (by simp))

/-- The class of `-1` in `Ĥ⁰(Gal(ℂ/ℝ), ℂˣ) = ℝˣ / ℝ_{>0}`. -/
def tateH0ClassNegOne : CyclicTate.TateH0 (ℂ ≃ₐ[ℝ] ℂ) (Additive ℂˣ) conjAe :=
  CyclicTate.TateH0.mk conjAe smul_conjAe_neg_one

theorem tateH0ClassNegOne_def :
    tateH0ClassNegOne = CyclicTate.TateH0.mk conjAe smul_conjAe_neg_one := rfl

/-- **`-1` is not a norm from `ℂ`**, so its class in `Ĥ⁰` is nontrivial. -/
theorem tateH0ClassNegOne_ne_zero : tateH0ClassNegOne ≠ 0 := by
  rw [tateH0ClassNegOne_def, Ne, CyclicTate.TateH0.mk_eq_zero_iff]
  rintro ⟨y, hy⟩
  rw [normHom_additive] at hy
  have h : ((mulNorm (G := ℂ ≃ₐ[ℝ] ℂ) (y.toMul) : ℂˣ) : ℂ) = ((-1 : ℂˣ) : ℂ) :=
    congrArg Units.val (Additive.ofMul.injective hy)
  rw [mulNorm_complexUnits_eq_normSq] at h
  have h' : Complex.normSq (y.toMul : ℂ) = -1 := by
    have := congrArg Complex.re h
    simpa using this
  exact absurd (h' ▸ Complex.normSq_nonneg (y.toMul : ℂ)) (by norm_num)

/-- **`Ĥ⁰(Gal(ℂ/ℝ), ℂˣ)` has at most two elements**: a conjugation-invariant unit is a nonzero
real, and it is a norm if positive, `-1` times a norm if negative. -/
theorem tateH0_complexUnits_eq_zero_or
    (t : CyclicTate.TateH0 (ℂ ≃ₐ[ℝ] ℂ) (Additive ℂˣ) conjAe) :
    t = 0 ∨ t = tateH0ClassNegOne := by
  obtain ⟨x, hx, rfl⟩ := CyclicTate.TateH0.mk_surjective t
  set u : ℂˣ := x.toMul with hudef
  set r : ℝ := (u : ℂ).re with hrdef
  have him : (u : ℂ).im = 0 := im_eq_zero_of_smul_conjAe_eq hx
  have hune : (u : ℂ) ≠ 0 := u.ne_zero
  have hre : (u : ℂ) = (r : ℂ) := by
    rw [Complex.ext_iff]; simp [him, hrdef]
  have hrne : r ≠ 0 := fun h ↦ hune (by rw [hre, h]; norm_num)
  rcases lt_trichotomy r 0 with hneg | hzero | hpos
  · -- negative: the class of `u` is the class of `-1`
    right
    rw [tateH0ClassNegOne_def, CyclicTate.TateH0.mk_eq_mk_iff]
    obtain ⟨y, hy⟩ := exists_mulNorm_eq_of_pos (r := -r) (by linarith)
    refine ⟨Additive.ofMul y, ?_⟩
    rw [normHom_additive]
    show Additive.ofMul (mulNorm (G := ℂ ≃ₐ[ℝ] ℂ) y) = Additive.ofMul (u / (-1 : ℂˣ))
    refine congrArg Additive.ofMul (Units.ext ?_)
    rw [hy, Units.val_div_eq_div_val, hre]
    push_cast
    ring
  · exact absurd hzero hrne
  · -- positive: the class of `u` vanishes
    left
    rw [CyclicTate.TateH0.mk_eq_zero_iff]
    obtain ⟨y, hy⟩ := exists_mulNorm_eq_of_pos (r := r) hpos
    refine ⟨Additive.ofMul y, ?_⟩
    rw [normHom_additive]
    show Additive.ofMul (mulNorm (G := ℂ ≃ₐ[ℝ] ℂ) y) = Additive.ofMul u
    exact congrArg Additive.ofMul (Units.ext (by rw [hy, ← hre]))

/-- **`#Ĥ⁰(Gal(ℂ/ℝ), ℂˣ) = #(ℝˣ / N ℂˣ) = 2`.** -/
theorem card_tateH0_complexUnits :
    Nat.card (CyclicTate.TateH0 (ℂ ≃ₐ[ℝ] ℂ) (Additive ℂˣ) conjAe) = 2 := by
  rw [Nat.card_eq_two_iff' (0 : CyclicTate.TateH0 (ℂ ≃ₐ[ℝ] ℂ) (Additive ℂˣ) conjAe)]
  refine ⟨tateH0ClassNegOne, tateH0ClassNegOne_ne_zero, fun t ht ↦ ?_⟩
  rcases tateH0_complexUnits_eq_zero_or t with rfl | h
  · exact absurd rfl ht
  · exact h

/-- **The archimedean local Herbrand quotient: `h(Gal(ℂ/ℝ), ℂˣ) = 2 = [ℂ : ℝ]`.** -/
theorem herbrand_complexUnits :
    CyclicTate.herbrand (ℂ ≃ₐ[ℝ] ℂ) (Additive ℂˣ) conjAe = 2 := by
  rw [CyclicTate.herbrand_def, card_tateH0_complexUnits, card_tateH1_complexUnits]
  norm_num

/-- **The Herbrand quotient of `ℂˣ` for a decomposition group.**  If a finite group `G` acts on
`Additive ℂˣ` through a group isomorphism `e : G ≃* Gal(ℂ/ℝ)`, then `h(G, ℂˣ) = 2` for the
generator `e.symm conjAe`.  This is the form in which
`NumberField.InfinitePlace.stabilizerEquivLocalGal` presents the decomposition group of a real
place ramified in `L`. -/
theorem herbrand_complexUnits_of_group_mulEquiv {G : Type*} [Group G] [Fintype G]
    [DistribMulAction G (Additive ℂˣ)] (e : G ≃* (ℂ ≃ₐ[ℝ] ℂ))
    (he : ∀ (g : G) (m : Additive ℂˣ), e g • m = g • m) :
    CyclicTate.herbrand G (Additive ℂˣ) (e.symm conjAe) = 2 := by
  rw [CyclicTate.herbrand_eq_of_group_mulEquiv e he, MulEquiv.apply_symm_apply,
    herbrand_complexUnits]

/-! ## Transport to an abstract completion -/

section Transport

variable {G : Type*} [Group G] {σ : G}

/-- **A two-element group is `Gal(ℂ/ℝ)`.**  If `G = {1, σ}` with `σ ≠ 1`, the assignment
`σ ↦ conj` is a group isomorphism `G ≃* Gal(ℂ/ℝ)`. -/
def toGalComplexReal (h1 : σ ≠ 1) (hσ : ∀ g : G, g = 1 ∨ g = σ) : G →* (ℂ ≃ₐ[ℝ] ℂ) :=
  letI := Classical.decEq G
  { toFun := fun g ↦ if g = σ then conjAe else 1
    map_one' := if_neg (Ne.symm h1)
    map_mul' := by
      have hss : σ * σ = 1 := by
        rcases hσ (σ * σ) with h | h
        · exact h
        · exact absurd (by simpa using (mul_right_cancel (b := σ) (by rw [h, one_mul]))) h1
      have hconj : (conjAe : ℂ ≃ₐ[ℝ] ℂ) * conjAe = 1 :=
        AlgEquiv.ext fun z ↦ Complex.conj_conj z
      intro a b
      rcases hσ a with rfl | rfl <;> rcases hσ b with rfl | rfl <;>
        simp [if_neg (Ne.symm h1), hss, hconj] }

theorem toGalComplexReal_apply_generator (h1 : σ ≠ 1) (hσ : ∀ g : G, g = 1 ∨ g = σ) :
    toGalComplexReal h1 hσ σ = conjAe := by
  classical
  show (if σ = σ then (conjAe : ℂ ≃ₐ[ℝ] ℂ) else 1) = conjAe
  rw [if_pos rfl]

theorem toGalComplexReal_bijective (h1 : σ ≠ 1) (hσ : ∀ g : G, g = 1 ∨ g = σ) :
    Function.Bijective (toGalComplexReal h1 hσ) := by
  classical
  have hone : toGalComplexReal h1 hσ 1 = 1 := map_one _
  have hgen := toGalComplexReal_apply_generator h1 hσ
  constructor
  · intro a b hab
    rcases hσ a with rfl | rfl <;> rcases hσ b with rfl | rfl
    · rfl
    · exact absurd (by rw [← hone, ← hgen, hab]) conjAe_ne_one.symm
    · exact absurd (by rw [← hone, ← hgen, hab]) conjAe_ne_one
    · rfl
  · intro γ
    rcases eq_one_or_eq_conjAe γ with rfl | rfl
    · exact ⟨1, hone⟩
    · exact ⟨σ, hgen⟩

/-- `G ≃* Gal(ℂ/ℝ)` for a two-element group `G = {1, σ}`. -/
def galComplexRealEquiv (h1 : σ ≠ 1) (hσ : ∀ g : G, g = 1 ∨ g = σ) : G ≃* (ℂ ≃ₐ[ℝ] ℂ) :=
  MulEquiv.ofBijective _ (toGalComplexReal_bijective h1 hσ)

@[simp] theorem galComplexRealEquiv_generator (h1 : σ ≠ 1) (hσ : ∀ g : G, g = 1 ∨ g = σ) :
    galComplexRealEquiv h1 hσ σ = conjAe :=
  toGalComplexReal_apply_generator h1 hσ

/-- **The archimedean local Herbrand quotient, for an abstract completion.**  Let a two-element
group `G = {1, σ}` act on a field `F` by ring automorphisms, and let `e : F ≃+* ℂ` be a ring
isomorphism carrying the action of `σ` to complex conjugation.  Then `h(G, Fˣ) = 2`.

This is the form the computation takes at an infinite place `w` of `L` ramified over `v`: `F`
is the completion `L_w`, `G` is its decomposition group, and `e` is the identification of `L_w`
with `ℂ` (`NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex`). -/
theorem herbrand_units_eq_two_of_ringEquiv_complex {F : Type*} [Fintype G] [Field F]
    [MulSemiringAction G F] (h1 : σ ≠ 1) (hσ : ∀ g : G, g = 1 ∨ g = σ) (e : F ≃+* ℂ)
    (he : ∀ z : F, e (σ • z) = (starRingEnd ℂ) (e z)) :
    CyclicTate.herbrand G (Additive Fˣ) σ = 2 := by
  set φ := galComplexRealEquiv h1 hσ with hφ
  letI : MulSemiringAction G ℂ := MulSemiringAction.compHom ℂ φ.toMonoidHom
  have hact : ∀ (g : G) (z : ℂ), g • z = φ g z := fun _ _ ↦ rfl
  have hequiv : ∀ (g : G) (z : F), e (g • z) = g • e z := by
    intro g z
    rcases hσ g with rfl | rfl
    · rw [one_smul, hact, map_one]
      rfl
    · rw [he, hact, galComplexRealEquiv_generator]
      rfl
  have hEquiv : ∀ (g : G) (x : Additive Fˣ),
      (Units.mapEquiv (e : F ≃* ℂ)).toAdditive (g • x) = g • (Units.mapEquiv (e : F ≃* ℂ)).toAdditive x := by
    intro g x
    exact congrArg Additive.ofMul (Units.ext (hequiv g _))
  rw [CyclicTate.herbrand_eq_of_addEquiv (Units.mapEquiv (e : F ≃* ℂ)).toAdditive hEquiv σ,
    CyclicTate.herbrand_eq_of_group_mulEquiv φ (fun _ _ ↦ rfl) σ, hφ,
    galComplexRealEquiv_generator, herbrand_complexUnits]

/-- **`σ` is complex conjugation as soon as it fixes the reals.**  If a two-element group
`G = {1, σ}` acts faithfully on a field `F` and `e : F ≃+* ℂ` is a ring isomorphism under which
`σ` fixes every element of `F` with real image, then `e` carries `σ` to complex conjugation:
`e (σ • z) = conj (e z)`.

The point is that the induced ring automorphism `e ∘ σ ∘ e⁻¹` of `ℂ` fixes `ℝ` pointwise, hence
is `ℝ`-linear, hence is the identity or conjugation by `Complex.real_algHom_eq_id_or_conj`; and
it is not the identity because the action is faithful and `σ ≠ 1`.  No continuity is needed. -/
theorem eq_conj_of_ringEquiv_complex_of_faithful {F : Type*} [Field F]
    [MulSemiringAction G F] (h1 : σ ≠ 1)
    (hG : Function.Injective fun (g : G) ↦ (fun x : F ↦ g • x))
    (e : F ≃+* ℂ) (hre : ∀ z : F, (e z).im = 0 → σ • z = z) (z : F) :
    e (σ • z) = (starRingEnd ℂ) (e z) := by
  set τ : ℂ →+* ℂ :=
    (e : F →+* ℂ).comp ((MulSemiringAction.toRingHom G F σ).comp (e.symm : ℂ →+* F)) with hτ
  have hτapp : ∀ x : ℂ, τ x = e (σ • e.symm x) := fun _ ↦ rfl
  have hτreal : ∀ r : ℝ, τ (r : ℂ) = (r : ℂ) := by
    intro r
    have him : (e (e.symm (r : ℂ))).im = 0 := by rw [e.apply_symm_apply]; simp
    rw [hτapp, hre _ him, e.apply_symm_apply]
  have hτsmul : ∀ (c : ℝ) (x : ℂ), τ (c • x) = c • τ x := by
    intro c x
    rw [Complex.real_smul, Complex.real_smul, map_mul, hτreal]
  rcases Complex.real_algHom_eq_id_or_conj (AlgHom.mk' τ hτsmul) with h | h
  · -- `τ = id` would make `σ` act trivially on `F`
    exfalso
    refine h1 (hG (funext fun x ↦ ?_))
    have hx : τ (e x) = e x := congrFun (congrArg (fun f : ℂ →ₐ[ℝ] ℂ ↦ (f : ℂ → ℂ)) h) (e x)
    rw [hτapp, e.symm_apply_apply] at hx
    show σ • x = (1 : G) • x
    rw [one_smul]
    exact e.injective hx
  · have hx : τ (e z) = (starRingEnd ℂ) (e z) :=
      congrFun (congrArg (fun f : ℂ →ₐ[ℝ] ℂ ↦ (f : ℂ → ℂ)) h) (e z)
    rw [hτapp, e.symm_apply_apply] at hx
    exact hx

/-- **The archimedean local Herbrand quotient at a ramified real place, in usable form.**  A
two-element group acting faithfully on a field `F` isomorphic to `ℂ`, with the nontrivial
element fixing the reals, has `h(G, Fˣ) = 2`. -/
theorem herbrand_units_eq_two_of_ringEquiv_complex_of_faithful {F : Type*} [Fintype G] [Field F]
    [MulSemiringAction G F] (h1 : σ ≠ 1) (hσ : ∀ g : G, g = 1 ∨ g = σ)
    (hG : Function.Injective fun (g : G) ↦ (fun x : F ↦ g • x))
    (e : F ≃+* ℂ) (hre : ∀ z : F, (e z).im = 0 → σ • z = z) :
    CyclicTate.herbrand G (Additive Fˣ) σ = 2 :=
  herbrand_units_eq_two_of_ringEquiv_complex h1 hσ e
    (eq_conj_of_ringEquiv_complex_of_faithful h1 hG e hre)

end Transport

end LocalCFT
