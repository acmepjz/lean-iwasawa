module

public import Iwasawalib.NumberTheory.LocalCFT.LocalNormIndex

@[expose] public section

/-!
# The norm index of the local units: `#Ĥ⁰(D_w, O_w^×) = e`

`Iwasawalib/NumberTheory/LocalCFT/LocalNormIndex.lean` computes the norm index of the full
multiplicative group of a local field, `#Ĥ⁰(D_w, L_w^×) = #(K_v^× / N L_w^×) = #D_w = e · f`.
This file computes the norm index of the *units of the valuation ring*:

`#Ĥ⁰(D_w, O_w^×) = #(O_v^× / N O_w^×) = e(w|v)`.

The proof is the order function `LocalCFT.ordHom : Additive Fˣ →+ ℤ` and two of its properties.

* The norm multiplies the order by `#G` (`LocalCFT.ordHom_normHom`).  Hence a unit of `𝒪` which
  is a norm from `Fˣ` is a norm from `𝒪ˣ` — this is `O_v^× ∩ N(L_w^×) = N(O_w^×)` — so
  `Ĥ⁰(G, 𝒪ˣ) → Ĥ⁰(G, Fˣ)` is injective
  (`LocalCFT.tateH0Map_unitsInclusion_injective`).
* Reduction of the order mod `#G` therefore descends to a homomorphism
  `LocalCFT.tateOrd : Ĥ⁰(G, Fˣ) →+ ZMod #G` whose kernel is exactly that image
  (`LocalCFT.ker_tateOrd`).  Its image is the subgroup generated by the smallest positive order
  of an invariant unit (`LocalCFT.range_tateOrd`), of index that order.

For `L_w / K_v` the invariant units are the units of `K_v`
(`NumberField.mem_range_adicCompletionComap_of_fixed`), whose orders are exactly the multiples
of `e` because the base change map multiplies the order by `e`
(`IsDedekindDomain.HeightOneSpectrum.valued_adicCompletionComap`); this is
`NumberField.ramificationIdx_dvd_ordHom` and
`NumberField.exists_invariant_ordHom_eq_ramificationIdx`.  Counting gives
`#Ĥ⁰(O_w^×) = (e · f) / f = e`.

## Main statements

* `LocalCFT.card_tateH0_integersUnits`: the abstract statement, for a valued field with a finite
  group acting by valuation-preserving automorphisms.
* `NumberField.card_tateH0_adicCompletionIntegersUnits`: `#Ĥ⁰(D_w, O_w^×) = e(w|v)`, given the
  local norm index `#Ĥ⁰(D_w, L_w^×) = #D_w`.
* `NumberField.card_tateH0_adicCompletionIntegersUnits_tame`: the same with the local norm index
  discharged by `NumberField.card_tateH0_adicCompletionUnits_tame`, i.e. at a place whose
  decomposition group has order prime to the residue characteristic.
* `NumberField.card_range_tateOrd`: unconditionally, the image of the order map on
  `Ĥ⁰(D_w, L_w^×)` has order `f(w|v)` — the unramified quotient of the local norm index.

## Scope

The hypothesis `#Ĥ⁰(D_w, L_w^×) = #D_w` is available in the unramified case
(`NumberField.card_tateH0_adicCompletionUnits_unramified`) and in the tame case
(`NumberField.card_tateH0_adicCompletionUnits_tame`); it is open in the wild case, for the
reason discussed in `Iwasawalib/NumberTheory/LocalCFT/TameRamified.lean`.  Everything else in
this file is unconditional.
-/

noncomputable section

open WithZero CyclicTate

namespace LocalCFT

variable {F : Type*} [Field F] [Valued F ℤᵐ⁰]

/-! ## The order function on `Fˣ` -/

/-- The valuation of a unit of `F`, written additively: `ord u = -v(u)` in the usual
normalisation, as an additive homomorphism `Additive Fˣ →+ ℤ`. -/
def ordHom : Additive Fˣ →+ ℤ :=
  AddMonoidHom.mk' (fun x ↦ Multiplicative.toAdd (valZ x.toMul)) fun x y ↦ by
    show Multiplicative.toAdd (valZ (x.toMul * y.toMul)) = _
    rw [map_mul]
    rfl

theorem ordHom_apply (x : Additive Fˣ) :
    ordHom x = Multiplicative.toAdd (valZ x.toMul) := rfl

theorem coe_ordHom (x : Additive Fˣ) :
    ((Multiplicative.ofAdd (ordHom x) : Multiplicative ℤ) : ℤᵐ⁰) = Valued.v ((x.toMul : Fˣ) : F) := by
  rw [ordHom_apply]
  exact coe_valZ x.toMul

theorem ordHom_eq_iff {x : Additive Fˣ} {m : ℤ} :
    ordHom x = m ↔ (Valued.v ((x.toMul : Fˣ) : F) : ℤᵐ⁰) = ((Multiplicative.ofAdd m : Multiplicative ℤ) : ℤᵐ⁰) := by
  rw [← coe_ordHom]
  constructor
  · intro h; rw [h]
  · intro h
    exact Multiplicative.ofAdd.injective (WithZero.coe_injective h)

theorem valued_eq_exp_ordHom (u : Fˣ) :
    (Valued.v (u : F) : ℤᵐ⁰) = exp (ordHom (Additive.ofMul u)) :=
  (coe_ordHom (Additive.ofMul u)).symm

theorem ordHom_ofMul_zpow (u : Fˣ) (k : ℤ) :
    ordHom (Additive.ofMul (u ^ k)) = k * ordHom (Additive.ofMul u) := by
  rw [show Additive.ofMul (u ^ k) = k • Additive.ofMul u from rfl, map_zsmul, smul_eq_mul]

/-! ## The order function and the group action -/

section Action

variable {G : Type*} [Group G] [Fintype G] [MulSemiringAction G F]
  [MulSemiringAction G (integers (F := F))]
  (hG : ∀ (g : G) (x : F), (Valued.v (g • x) : ℤᵐ⁰) = Valued.v x)
  (hcompat : ∀ (g : G) (a : integers (F := F)),
    ((g • a : integers (F := F)) : F) = g • (a : F))

attribute [local instance] Units.mulDistribMulActionRight

omit [Fintype G] [MulSemiringAction G (integers (F := F))] in
include hG in
/-- The action preserves the order function. -/
theorem ordHom_smul (g : G) (x : Additive Fˣ) : ordHom (g • x) = ordHom x :=
  congrArg Multiplicative.toAdd (valZ_smul hG g x.toMul)

omit [MulSemiringAction G (integers (F := F))] in
include hG in
/-- The norm multiplies the order by the order of the group. -/
theorem ordHom_normHom (x : Additive Fˣ) :
    ordHom (normHom G (Additive Fˣ) x) = (Nat.card G : ℤ) * ordHom x := by
  rw [CyclicTate.normHom_apply, map_sum, Finset.sum_congr rfl fun g _ ↦ ordHom_smul hG g x,
    Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]

omit [Fintype G] in
include hcompat in
/-- A unit of `F` of order zero is a unit of the valuation ring. -/
theorem ordHom_eq_zero_iff (x : Additive Fˣ) :
    ordHom x = 0 ↔ ∃ a : Additive (integers (F := F))ˣ, unitsInclusion hcompat a = x := by
  constructor
  · intro h
    have h1 : (Valued.v ((x.toMul : Fˣ) : F) : ℤᵐ⁰) = 1 := by
      have := (ordHom_eq_iff (x := x) (m := 0)).1 h
      simpa using this
    refine ⟨Additive.ofMul (unitOfValuedEqOne h1), ?_⟩
    exact congrArg Additive.ofMul (Units.ext rfl)
  · rintro ⟨a, rfl⟩
    refine (ordHom_eq_iff).2 ?_
    rw [show ((((unitsInclusion (G := G) hcompat) a).toMul : Fˣ) : F)
        = (((a.toMul : (integers (F := F))ˣ) : integers (F := F)) : F) from rfl,
      valued_coe_units a.toMul]
    rfl

omit [Fintype G] in
/-- The inclusion `𝒪ˣ → Fˣ` is injective. -/
theorem unitsInclusion_injective :
    Function.Injective (unitsInclusion (G := G) hcompat) := by
  intro u u' huu
  have h' : (Units.map (integers (F := F)).subtype.toMonoidHom u.toMul : Fˣ)
      = Units.map (integers (F := F)).subtype.toMonoidHom u'.toMul := huu
  exact Units.ext (Subtype.ext (congrArg Units.val h'))

variable {σ : G}

include hG hcompat in
/-- **`𝒪_v^× ∩ N(L_w^×) = N(𝒪_w^×)`**, in the form that `Ĥ⁰(G, 𝒪ˣ) → Ĥ⁰(G, Fˣ)` is injective:
a unit of `𝒪` which is a norm from `Fˣ` is a norm from `𝒪ˣ`, because the norm multiplies the
order by `#G ≠ 0`. -/
theorem tateH0Map_unitsInclusion_injective (hn : Nat.card G ≠ 0) :
    Function.Injective (tateH0Map (unitsInclusion hcompat) σ) := by
  rw [injective_iff_map_eq_zero]
  intro t ht
  obtain ⟨x, hx, rfl⟩ := TateH0.mk_surjective t
  rw [tateH0Map_mk, TateH0.mk_eq_zero_iff] at ht
  obtain ⟨y, hy⟩ := ht
  have h1 : ordHom (normHom G (Additive Fˣ) y) = 0 := by
    rw [hy]
    exact (ordHom_eq_zero_iff hcompat _).2 ⟨x, rfl⟩
  rw [ordHom_normHom hG] at h1
  have h2 : ordHom y = 0 := by
    rcases mul_eq_zero.1 h1 with h | h
    · exact absurd (Int.natCast_eq_zero.1 h) hn
    · exact h
  obtain ⟨z, hz⟩ := (ordHom_eq_zero_iff hcompat y).1 h2
  refine (TateH0.mk_eq_zero_iff hx).2 ⟨z, unitsInclusion_injective hcompat ?_⟩
  rw [map_normHom, hz, hy]

/-! ## The order map on `Ĥ⁰(G, Fˣ)` -/

omit [MulSemiringAction G (integers (F := F))] in
/-- The order of a norm is divisible by `#G`, so `x ↦ ord x mod #G` descends to `Ĥ⁰(G, Fˣ)`. -/
theorem ordHom_le_ker (hval : ∀ (g : G) (x : F), (Valued.v (g • x) : ℤᵐ⁰) = Valued.v x) (σ : G) :
    (rangeNorm G (Additive Fˣ)).addSubgroupOf (kerSub G (Additive Fˣ) σ) ≤
      ((Int.castAddHom (ZMod (Nat.card G))).comp
        (ordHom.comp (kerSub G (Additive Fˣ) σ).subtype)).ker := by
  intro x hx
  rw [AddSubgroup.mem_addSubgroupOf] at hx
  obtain ⟨y, hy⟩ := mem_rangeNorm.1 hx
  show ((ordHom ((x : kerSub G (Additive Fˣ) σ) : Additive Fˣ) : ℤ) : ZMod (Nat.card G)) = 0
  rw [← hy, ordHom_normHom hval, Int.cast_mul, Int.cast_natCast, ZMod.natCast_self, zero_mul]

/-- **The order map on `Ĥ⁰(G, Fˣ)`**, with values in `ℤ / #G`. -/
def tateOrd (hval : ∀ (g : G) (x : F), (Valued.v (g • x) : ℤᵐ⁰) = Valued.v x) (σ : G) :
    TateH0 G (Additive Fˣ) σ →+ ZMod (Nat.card G) :=
  QuotientAddGroup.lift _ ((Int.castAddHom (ZMod (Nat.card G))).comp
    (ordHom.comp (kerSub G (Additive Fˣ) σ).subtype)) (ordHom_le_ker hval σ)

omit [MulSemiringAction G (integers (F := F))] in
@[simp] theorem tateOrd_mk
    (hval : ∀ (g : G) (x : F), (Valued.v (g • x) : ℤᵐ⁰) = Valued.v x) (σ : G)
    {x : Additive Fˣ} (hx : σ • x = x) :
    tateOrd hval σ (TateH0.mk σ hx) = ((ordHom x : ℤ) : ZMod (Nat.card G)) := rfl

include hG hcompat in
/-- **The kernel of the order map on `Ĥ⁰(G, Fˣ)` is the image of `Ĥ⁰(G, 𝒪ˣ)`.**  One inclusion
is that units of `𝒪` have order zero; the other divides off a norm to reduce to order zero. -/
theorem ker_tateOrd (hn : Nat.card G ≠ 0)
    (hsurj : ∀ m : ℤ, ∃ y : Additive Fˣ, ordHom y = m) (σ : G) :
    (tateOrd hG σ).ker = (tateH0Map (unitsInclusion hcompat) σ).range := by
  haveI : NeZero (Nat.card G) := NeZero.mk hn
  apply le_antisymm
  · intro t ht
    obtain ⟨x, hx, rfl⟩ := TateH0.mk_surjective t
    rw [AddMonoidHom.mem_ker, tateOrd_mk, ZMod.intCast_zmod_eq_zero_iff_dvd] at ht
    obtain ⟨m, hm⟩ := ht
    obtain ⟨y, hy⟩ := hsurj m
    have hfix : σ • (x - normHom G (Additive Fˣ) y) = x - normHom G (Additive Fˣ) y := by
      rw [smul_sub, hx, smul_normHom]
    have hord : ordHom (x - normHom G (Additive Fˣ) y) = 0 := by
      rw [map_sub, ordHom_normHom hG, hy, hm, sub_self]
    obtain ⟨z, hz⟩ := (ordHom_eq_zero_iff hcompat _).1 hord
    have hzfix : σ • z = z := by
      refine unitsInclusion_injective hcompat ?_
      simp only [map_smul]
      rw [hz, hfix]
    refine ⟨TateH0.mk σ hzfix, ?_⟩
    rw [tateH0Map_mk]
    refine (TateH0.mk_eq_mk_iff _ hx).2 ⟨-y, ?_⟩
    rw [map_neg, hz]
    abel
  · rintro t ⟨s, rfl⟩
    obtain ⟨z, hz, rfl⟩ := TateH0.mk_surjective s
    rw [AddMonoidHom.mem_ker, tateH0Map_mk, tateOrd_mk,
      (ordHom_eq_zero_iff hcompat _).2 ⟨z, rfl⟩]
    exact Int.cast_zero

omit [MulSemiringAction G (integers (F := F))] in
include hG in
/-- The image of the order map is the subgroup generated by `d`, when `d` generates the group
of orders of the `σ`-invariant units. -/
theorem range_tateOrd (σ : G) (d : ℕ)
    (hdvd : ∀ x : Additive Fˣ, σ • x = x → (d : ℤ) ∣ ordHom x)
    (hex : ∃ x : Additive Fˣ, ∃ _ : σ • x = x, ordHom x = d) :
    (tateOrd hG σ).range = AddSubgroup.zmultiples ((d : ℕ) : ZMod (Nat.card G)) := by
  obtain ⟨x₀, hx₀, hord₀⟩ := hex
  apply le_antisymm
  · rintro _ ⟨t, rfl⟩
    obtain ⟨x, hx, rfl⟩ := TateH0.mk_surjective t
    obtain ⟨k, hk⟩ := hdvd x hx
    rw [tateOrd_mk]
    refine AddSubgroup.mem_zmultiples_iff.2 ⟨k, ?_⟩
    rw [hk, zsmul_eq_mul]
    push_cast
    ring
  · rw [AddSubgroup.zmultiples_le]
    refine ⟨TateH0.mk σ hx₀, ?_⟩
    rw [tateOrd_mk, hord₀]
    push_cast
    ring

include hG hcompat in
/-- **The norm index of the local units.**  If the orders of the `σ`-invariant units of `F`
form the subgroup `dℤ` of `ℤ`, and `#Ĥ⁰(G, Fˣ) = #G`, then `#Ĥ⁰(G, 𝒪ˣ) = d`.  For the local
extension `L_w / K_v` of number fields, `d` is the ramification index. -/
theorem card_tateH0_integersUnits (hn : Nat.card G ≠ 0)
    (hsurj : ∀ m : ℤ, ∃ y : Additive Fˣ, ordHom y = m) (σ : G) (d : ℕ) (hd : d ∣ Nat.card G)
    (hdvd : ∀ x : Additive Fˣ, σ • x = x → (d : ℤ) ∣ ordHom x)
    (hex : ∃ x : Additive Fˣ, ∃ _ : σ • x = x, ordHom x = d)
    (hcard : Nat.card (TateH0 G (Additive Fˣ) σ) = Nat.card G) :
    Nat.card (TateH0 G (Additive (integers (F := F))ˣ) σ) = d := by
  have hd0 : d ≠ 0 := by
    rintro rfl
    exact hn (Nat.eq_zero_of_zero_dvd hd)
  have hrange : Nat.card (tateOrd hG σ).range = Nat.card G / d := by
    rw [range_tateOrd hG σ d hdvd hex, Nat.card_zmultiples, ZMod.addOrderOf_coe d hn,
      Nat.gcd_eq_right hd]
  have hker : Nat.card (tateOrd hG σ).ker
      = Nat.card (TateH0 G (Additive (integers (F := F))ˣ) σ) := by
    rw [ker_tateOrd hG hcompat hn hsurj σ]
    exact (Nat.card_congr (Equiv.ofInjective _
      (tateH0Map_unitsInclusion_injective hG hcompat hn)).symm)
  have hmul := (tateOrd hG σ).card_eq_card_range_mul_card_ker
  rw [hcard, hrange, hker] at hmul
  have hnd : Nat.card G / d * d = Nat.card G := Nat.div_mul_cancel hd
  have hpos : Nat.card G / d ≠ 0 := by
    intro h
    rw [h, zero_mul] at hnd
    exact hn hnd.symm
  exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hpos) (hmul.symm.trans hnd.symm)

end Action

end LocalCFT

/-! ## The local units of a number field at a finite place -/

namespace NumberField

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum LocalCFT WithZero CyclicTate

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [IsGalois K L]
variable (v : HeightOneSpectrum (𝓞 K)) (w : HeightOneSpectrum (𝓞 L))
  [w.asIdeal.LiesOver v.asIdeal] [Fintype (decompositionGroup K L w)]

attribute [local instance] decompositionIntegersMulSemiringAction Units.mulDistribMulActionRight

omit [Fintype (decompositionGroup K L w)] in
/-- **The order of a `D_w`-invariant unit of `L_w` is divisible by `e(w|v)`**, because such a
unit comes from `K_v` (`NumberField.mem_range_adicCompletionComap_of_fixed`) and the base change
map multiplies the order by `e` (`IsDedekindDomain.HeightOneSpectrum.valued_adicCompletionComap`).
-/
theorem ramificationIdx_dvd_ordHom (x : Additive (w.adicCompletion L)ˣ)
    (hx : ∀ d : decompositionGroup K L w, d • x = x) :
    (v.asIdeal.ramificationIdx' w.asIdeal : ℤ) ∣ ordHom x := by
  have hfix : ∀ d : decompositionGroup K L w,
      d • ((x.toMul : (w.adicCompletion L)ˣ) : w.adicCompletion L)
        = ((x.toMul : (w.adicCompletion L)ˣ) : w.adicCompletion L) := fun d ↦
    congrArg Units.val (congrArg Additive.toMul (hx d))
  obtain ⟨c, hc⟩ := mem_range_adicCompletionComap_of_fixed v w hfix
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [map_zero] at hc
    exact (x.toMul : (w.adicCompletion L)ˣ).ne_zero hc.symm
  refine ⟨ordHom (Additive.ofMul (Units.mk0 c hc0)), ?_⟩
  refine ordHom_eq_iff.2 ?_
  rw [← hc, valued_adicCompletionComap,
    show (Valued.v c : ℤᵐ⁰) = Valued.v ((Units.mk0 c hc0 : (v.adicCompletion K)ˣ)
      : v.adicCompletion K) from rfl,
    valued_eq_exp_ordHom, ← exp_nsmul, nsmul_eq_mul]
  rfl

/-- Every integer is the order of some unit of `L_w`. -/
theorem exists_ordHom_eq (m : ℤ) :
    ∃ y : Additive (w.adicCompletion L)ˣ, ordHom y = m := by
  obtain ⟨π, hπ⟩ := valuedAdicCompletion_surjective (K := L) w (exp (-1 : ℤ))
  have hπ0 : π ≠ 0 := by
    rintro rfl
    rw [map_zero] at hπ
    exact exp_ne_zero hπ.symm
  have h1 : ordHom (Additive.ofMul (Units.mk0 π hπ0)) = -1 := ordHom_eq_iff.2 hπ
  refine ⟨Additive.ofMul (Units.mk0 π hπ0 ^ (-m)), ?_⟩
  rw [ordHom_ofMul_zpow, h1]
  ring

omit [IsGalois K L] [Fintype (decompositionGroup K L w)] in
/-- **There is a `D_w`-invariant unit of `L_w` of order exactly `e(w|v)`**: the image of a
uniformiser of `K_v`. -/
theorem exists_invariant_ordHom_eq_ramificationIdx :
    ∃ x : Additive (w.adicCompletion L)ˣ, (∀ d : decompositionGroup K L w, d • x = x) ∧
      ordHom x = (v.asIdeal.ramificationIdx' w.asIdeal : ℤ) := by
  obtain ⟨π, hπ⟩ := valuedAdicCompletion_surjective (K := K) v (exp (-1 : ℤ))
  have hπ0 : π ≠ 0 := by
    rintro rfl
    rw [map_zero] at hπ
    exact exp_ne_zero hπ.symm
  have h0 : adicCompletionComap K L v w π ≠ 0 := fun hc ↦
    hπ0 ((adicCompletionComap K L v w).injective (by rw [hc, map_zero]))
  set u : (w.adicCompletion L)ˣ := Units.mk0 _ h0 with hudef
  have hu : (u : w.adicCompletion L) = adicCompletionComap K L v w π := rfl
  have hord : ordHom (Additive.ofMul u) = -(v.asIdeal.ramificationIdx' w.asIdeal : ℤ) := by
    refine ordHom_eq_iff.2 ?_
    show (Valued.v ((u : (w.adicCompletion L)ˣ) : w.adicCompletion L) : ℤᵐ⁰) = _
    rw [hu, valued_adicCompletionComap, hπ, ← exp_nsmul, nsmul_eq_mul, mul_neg_one]
    rfl
  have hfixu : ∀ d : decompositionGroup K L w,
      d • Additive.ofMul u = Additive.ofMul u := by
    intro d
    refine congrArg Additive.ofMul (Units.ext ?_)
    show d • ((u : w.adicCompletion L)) = u
    rw [hu]
    exact decomposition_smul_adicCompletionComap v w d π
  refine ⟨-(Additive.ofMul u), fun d ↦ ?_, ?_⟩
  · rw [smul_neg, hfixu d]
  · rw [map_neg, hord, neg_neg]

variable {σ : decompositionGroup K L w}

/-- **The norm index of the local units is the ramification index:**
`#Ĥ⁰(D_w, O_w^×) = #(O_v^× / N O_w^×) = e(w|v)`, given the local norm index
`#Ĥ⁰(D_w, L_w^×) = #D_w` for the full multiplicative group. -/
theorem card_tateH0_adicCompletionIntegersUnits
    (hσ : ∀ d : decompositionGroup K L w, d ∈ Subgroup.zpowers σ)
    (hcard : Nat.card (CyclicTate.TateH0 (decompositionGroup K L w)
        (Additive (w.adicCompletion L)ˣ) σ) = Nat.card (decompositionGroup K L w)) :
    Nat.card (CyclicTate.TateH0 (decompositionGroup K L w)
        (Additive (LocalCFT.integers (F := w.adicCompletion L))ˣ) σ)
      = v.asIdeal.ramificationIdx' w.asIdeal := by
  have hn : Nat.card (decompositionGroup K L w) ≠ 0 := Nat.card_pos.ne'
  have hef : Nat.card (decompositionGroup K L w)
      = v.asIdeal.ramificationIdx' w.asIdeal * v.asIdeal.inertiaDeg' w.asIdeal := by
    rw [← finrank_adicCompletion v w, finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg]
  have hfixG : ∀ x : Additive (w.adicCompletion L)ˣ, σ • x = x →
      ∀ d : decompositionGroup K L w, d • x = x := by
    intro x hx d
    have hmem : σ ∈ MulAction.stabilizer (decompositionGroup K L w) x :=
      MulAction.mem_stabilizer_iff.2 hx
    exact Subgroup.zpowers_le.2 hmem (hσ d)
  refine LocalCFT.card_tateH0_integersUnits (valued_decomposition_smul w) (fun d a ↦ rfl) hn
    (exists_ordHom_eq w) σ _ ⟨_, hef⟩
    (fun x hx ↦ ramificationIdx_dvd_ordHom v w x (hfixG x hx)) ?_ hcard
  obtain ⟨x, hx, hord⟩ := exists_invariant_ordHom_eq_ramificationIdx v w
  exact ⟨x, hx σ, hord⟩

/-- **The unramified quotient of the local norm index.**  On `Ĥ⁰(D_w, L_w^×) = K_v^×/N L_w^×`
the order map `LocalCFT.tateOrd` has image of order exactly `f(w|v)`: the orders of the
`D_w`-invariant units are the multiples of `e`, and `e · f = #D_w`.  Unlike
`NumberField.card_tateH0_adicCompletionIntegersUnits` this needs no hypothesis on the
ramification, and it is the statement that the residue degree is the size of the unramified
quotient of the local norm index. -/
theorem card_range_tateOrd (hσ : ∀ d : decompositionGroup K L w, d ∈ Subgroup.zpowers σ) :
    Nat.card (LocalCFT.tateOrd (valued_decomposition_smul w) σ).range
      = v.asIdeal.inertiaDeg' w.asIdeal := by
  have hn : Nat.card (decompositionGroup K L w) ≠ 0 := Nat.card_pos.ne'
  have hef : Nat.card (decompositionGroup K L w)
      = v.asIdeal.ramificationIdx' w.asIdeal * v.asIdeal.inertiaDeg' w.asIdeal := by
    rw [← finrank_adicCompletion v w, finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg]
  have hfixG : ∀ x : Additive (w.adicCompletion L)ˣ, σ • x = x →
      ∀ d : decompositionGroup K L w, d • x = x := by
    intro x hx d
    have hmem : σ ∈ MulAction.stabilizer (decompositionGroup K L w) x :=
      MulAction.mem_stabilizer_iff.2 hx
    exact Subgroup.zpowers_le.2 hmem (hσ d)
  have hex : ∃ x : Additive (w.adicCompletion L)ˣ, ∃ _ : σ • x = x,
      LocalCFT.ordHom x = (v.asIdeal.ramificationIdx' w.asIdeal : ℤ) := by
    obtain ⟨x, hx, hord⟩ := exists_invariant_ordHom_eq_ramificationIdx v w
    exact ⟨x, hx σ, hord⟩
  rw [LocalCFT.range_tateOrd (valued_decomposition_smul w) σ _
      (fun x hx ↦ ramificationIdx_dvd_ordHom v w x (hfixG x hx)) hex,
    Nat.card_zmultiples, ZMod.addOrderOf_coe _ hn, Nat.gcd_eq_right ⟨_, hef⟩, hef,
    Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero (ramificationIdx_ne_zero' v w))]

/-- **The norm index of the local units at a tamely ramified place:**
`#Ĥ⁰(D_w, O_w^×) = e(w|v)`.  The hypothesis is the one of
`NumberField.card_tateH0_adicCompletionUnits_tame`: a natural number `p` in `w` (the residue
characteristic) whose product with `#D_w` admits a Bézout relation, which holds whenever
`p ∤ #D_w`. -/
theorem card_tateH0_adicCompletionIntegersUnits_tame
    (hσ : ∀ d : decompositionGroup K L w, d ∈ Subgroup.zpowers σ)
    {p : ℕ} (hp : (p : 𝓞 L) ∈ w.asIdeal)
    {a b : ℤ} (hab : a * (Nat.card (decompositionGroup K L w)) + b * p = 1) :
    Nat.card (CyclicTate.TateH0 (decompositionGroup K L w)
        (Additive (LocalCFT.integers (F := w.adicCompletion L))ˣ) σ)
      = v.asIdeal.ramificationIdx' w.asIdeal :=
  card_tateH0_adicCompletionIntegersUnits v w hσ
    (card_tateH0_adicCompletionUnits_tame w hσ hp hab)

end NumberField
