module

public import Iwasawalib.NumberTheory.LocalCFT.LocalInvariantMap

@[expose] public section

/-!
# The local invariant map: explicit values, restriction, and local reciprocity

`Iwasawalib/NumberTheory/LocalCFT/LocalInvariantMap.lean` builds the isomorphism
`LocalCFT.invariantMapEquiv : Ĥ⁰(G, Fˣ) ≃+ ZMod #G` out of the valuation sequence
`0 → 𝒪ˣ → Fˣ → ℤ → 0`, at a complete discretely valued field `F` with a finite cyclic group
`G = ⟨σ⟩` of valuation-preserving automorphisms whose unit group `𝒪ˣ` is cohomologically
trivial (the unramified situation).  This file makes that isomorphism *usable*:

* **Values.**  `LocalCFT.invariantMapEquiv_mk` computes it on the class of an invariant unit:
  it is the valuation of that unit, read mod `#G`.  The normalisation of
  `LocalCFT.valHom` makes a uniformiser have value `-1`, so
  `LocalCFT.normalizedInvariantEquiv` is the sign-corrected isomorphism, for which a
  uniformiser has invariant `1` (`LocalCFT.normalizedInvariantEquiv_mk_of_uniformizer`).

* **Restriction.**  `CyclicTate.tateH0Res` is restriction `Ĥ⁰(G, M) → Ĥ⁰(H, M)` to a subgroup
  `H ≤ G` of a finite cyclic group; it exists because `N_G M ⊆ N_H M`
  (`CyclicTate.exists_normHom_subgroup`).  `LocalCFT.normalizedInvariantEquiv_tateH0Res` says
  the two invariants of a class agree as integers, i.e. `inv_H ∘ res` is `inv_G` followed by
  the reduction `ZMod #G → ZMod #H`.  Put in the common normalisation `(1/#G)ℤ/ℤ` along the
  inclusion `LocalCFT.zmodScale`, this is the classical statement that **restriction
  multiplies the local invariant by the index `[G : H]`**:
  `LocalCFT.normalizedInvariantEquiv_tateH0Res_index`.

* **Local reciprocity.**  `LocalCFT.localArtinEquiv : Ĥ⁰(G, Fˣ) ≃+ Additive G`, i.e.
  `(F^G)ˣ / N(Fˣ) ≅ G`, sending the class of a uniformiser to the chosen generator `σ`
  (`LocalCFT.localArtinEquiv_mk_of_uniformizer`).  `G` here is cyclic, so it is its own
  abelianisation.  At an unramified finite place of a number field this is
  `NumberField.localArtinAdicCompletionUnits`, an isomorphism
  `K_v^× / N(L_w^×) ≅ D_w = Gal(L_w / K_v)`.

## Scope

Everything about `Fˣ` here needs `Ĥ⁰(G, 𝒪ˣ) = Ĥ¹(G, 𝒪ˣ) = 0`, which holds at an unramified
place.  At a tamely ramified place `Ĥ⁰(G, 𝒪ˣ)` is *not* zero (it has order the ramification
index), so the invariant map is not induced by the valuation there and none of the
isomorphisms below apply; only the order statement
`NumberField.card_tateH0_adicCompletionUnits_tame` is available in that case.
-/

noncomputable section

namespace CyclicTate

/-! ## Restriction to a subgroup of a finite cyclic group -/

variable {G : Type*} [Group G] [Fintype G] {M : Type*} [AddCommGroup M] [DistribMulAction G M]

omit [Fintype G] in
/-- A group generated by one element is commutative. -/
theorem mul_comm_of_exists_pow {σ : G} (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (a b : G) :
    a * b = b * a := by
  obtain ⟨k, rfl⟩ := hgen a
  obtain ⟨l, rfl⟩ := hgen b
  exact pow_mul_comm σ k l

/-- **The norm of `G` factors through the norm of a subgroup `H`**: choosing coset
representatives `q.out` for `G ⧸ H`, one has `N_G x = N_H (∑ q, q.out • x)`.  Hence
`N_G M ⊆ N_H M`, which is what makes restriction on `Ĥ⁰` well defined.  Commutativity of `G`
is used to turn the left-coset decomposition into a right-coset one. -/
theorem exists_normHom_subgroup (hcomm : ∀ a b : G, a * b = b * a) (H : Subgroup G)
    [Fintype H] (x : M) : ∃ y : M, normHom H M y = normHom G M x := by
  classical
  haveI : Fintype (G ⧸ H) := Fintype.ofFinite _
  refine ⟨∑ q : G ⧸ H, (Quotient.out q : G) • x, ?_⟩
  have hbij : Function.Bijective (fun p : H × (G ⧸ H) ↦ ((Quotient.out p.2 : G) * p.1 : G)) := by
    constructor
    · rintro ⟨h, q⟩ ⟨h', q'⟩ hEq
      simp only at hEq
      have hq : q = q' := by
        have := congrArg (fun g : G ↦ (QuotientGroup.mk g : G ⧸ H)) hEq
        simpa [QuotientGroup.mk_mul_of_mem _ h.2, QuotientGroup.mk_mul_of_mem _ h'.2] using this
      subst hq
      exact Prod.ext (Subtype.ext (mul_left_cancel hEq)) rfl
    · intro g
      refine ⟨⟨⟨(Quotient.out (QuotientGroup.mk g : G ⧸ H))⁻¹ * g, ?_⟩, QuotientGroup.mk g⟩, ?_⟩
      · rw [← QuotientGroup.eq]
        simp
      · simp
  rw [normHom_apply, normHom_apply]
  simp_rw [Finset.smul_sum]
  rw [← Finset.sum_product', Finset.univ_product_univ]
  refine Fintype.sum_equiv (Equiv.ofBijective _ hbij) _ _ ?_
  rintro ⟨h, q⟩
  show (h : G) • ((Quotient.out q : G) • x) = ((Quotient.out q : G) * h) • x
  rw [smul_smul, hcomm]

omit [Fintype G] in
/-- In a group generated by `σ`, a `σ`-invariant element is invariant. -/
theorem smul_eq_of_exists_pow {σ : G} (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) {x : M}
    (hx : σ • x = x) (g : G) : g • x = x := by
  obtain ⟨k, rfl⟩ := hgen g
  induction k with
  | zero => simp
  | succ n ih => rw [pow_succ, mul_smul, hx, ih]

variable {σ : G}

/-- Restriction of the `σ`-invariants to the `τ`-invariants, for `τ` in a subgroup `H ≤ G`:
the identity on underlying elements. -/
def kerSubRes (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (H : Subgroup G) [Fintype H] (τ : H) :
    kerSub G M σ →+ kerSub H M τ :=
  AddMonoidHom.codRestrict (kerSub G M σ).subtype _ fun x ↦
    mem_kerSub.2 (smul_eq_of_exists_pow hgen (mem_kerSub.1 x.2) (τ : G))

/-- **Restriction `Ĥ⁰(G, M) → Ĥ⁰(H, M)`** to a subgroup `H` of a finite cyclic group
`G = ⟨σ⟩`, with `H = ⟨τ⟩`.  On representatives it is the identity: the content is that
`M^G ⊆ M^H` and `N_G M ⊆ N_H M` (`CyclicTate.exists_normHom_subgroup`). -/
def tateH0Res (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (H : Subgroup G) [Fintype H] (τ : H) :
    TateH0 G M σ →+ TateH0 H M τ :=
  QuotientAddGroup.map _ _ (kerSubRes hgen H τ) (by
    rintro ⟨x, hx⟩ hmem
    obtain ⟨y, rfl⟩ := mem_rangeNorm.1 (show x ∈ rangeNorm G M from hmem)
    exact mem_rangeNorm.2 (exists_normHom_subgroup (mul_comm_of_exists_pow hgen) H y))

@[simp] theorem tateH0Res_mk (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (H : Subgroup G) [Fintype H]
    (τ : H) {x : M} (hx : σ • x = x) :
    tateH0Res hgen H τ (TateH0.mk σ hx) =
      TateH0.mk τ (smul_eq_of_exists_pow hgen hx (τ : G)) := rfl

end CyclicTate

namespace LocalCFT

open CyclicTate MulAction WithZero

theorem zmodCongr_intCast {m n : ℕ} (h : m = n) (c : ℤ) :
    zmodCongr h (c : ZMod m) = (c : ZMod n) := by subst h; rfl

/-- `#G = [G : H] * #H`, the scaling factor between the two normalisations `(1/#G)ℤ/ℤ` and
`(1/#H)ℤ/ℤ` of the local invariant. -/
theorem card_eq_index_mul_card {G : Type*} [Group G] (H : Subgroup G) :
    Nat.card G = H.index * Nat.card H :=
  (Subgroup.index_mul_card H).symm

/-- **The inclusion `(1/n')ℤ/ℤ ⊆ (1/n)ℤ/ℤ` for `n = m * n'`, read on `ZMod`.**  On integers it
is multiplication by `m` (`LocalCFT.zmodScale_intCast`): the class `a/n'` is the class
`m * a / n`.  It is the map along which the two normalisations of a local invariant are
compared in `LocalCFT.normalizedInvariantEquiv_tateH0Res_index`. -/
def zmodScale {n' n : ℕ} (m : ℕ) (h : n = m * n') : ZMod n' →+ ZMod n :=
  ZMod.lift n' ⟨(AddMonoidHom.mulLeft (m : ZMod n)).comp (Int.castAddHom (ZMod n)), by
    show (m : ZMod n) * (((n' : ℕ) : ℤ) : ZMod n) = 0
    rw [Int.cast_natCast, ← Nat.cast_mul, ← h, ZMod.natCast_self]⟩

@[simp] theorem zmodScale_intCast {n' n : ℕ} (m : ℕ) (h : n = m * n') (c : ℤ) :
    zmodScale m h (c : ZMod n') = (m : ZMod n) * (c : ZMod n) :=
  ZMod.lift_coe _ _ _

/-! ## The value of the invariant map -/

section LocalField

variable {F : Type*} [Field F] [Valued F ℤᵐ⁰]
variable {G : Type*} [Group G] [Fintype G] [MulSemiringAction G F]
  [MulSemiringAction G (integers (F := F))]
  (hG : ∀ (g : G) (x : F), (Valued.v (g • x) : ℤᵐ⁰) = Valued.v x)
  (hcompat : ∀ (g : G) (a : integers (F := F)),
    ((g • a : integers (F := F)) : F) = g • (a : F))

attribute [local instance] Units.mulDistribMulActionRight

/-- The normalised additive valuation of a unit: `ordZ π = 1` for a uniformiser `π`
(`LocalCFT.ordZ_of_valued_eq_exp_neg_one`).  It is the negative of the exponent occurring in
`LocalCFT.valHom`, whose sign convention comes from `Valued.v π = exp (-1)`. -/
def ordZ (u : Fˣ) : ℤ := -Multiplicative.toAdd (valZ u)

/-- A uniformiser has `ordZ = 1`. -/
theorem ordZ_of_valued_eq_exp_neg_one {u : Fˣ} (hu : (Valued.v (u : F) : ℤᵐ⁰) = exp (-1 : ℤ)) :
    ordZ u = 1 := by
  have : valZ u = Multiplicative.ofAdd (-1 : ℤ) :=
    WithZero.coe_injective (by rw [coe_valZ]; exact hu)
  rw [ordZ, this]
  rfl

/-- **The local invariant of the class of an invariant unit is its valuation.**  With the sign
convention of `LocalCFT.valHom` this is `-ordZ`; see
`LocalCFT.normalizedInvariantEquiv_mk` for the normalised form. -/
theorem invariantMapEquiv_mk (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ)) {σ : G}
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)]
    {x : Additive Fˣ} (hx : σ • x = x) :
    invariantMapEquiv hG hcompat hπ hgen (TateH0.mk σ hx)
      = ((Multiplicative.toAdd (valZ x.toMul) : ℤ) : ZMod (Nat.card G)) := by
  show zmodCongr _ (PermLattice.tateH0Equiv hgen (() : Unit)
    (TateH0.mk σ (show σ • valHom hG x = valHom hG x by rw [← map_smul, hx]))) = _
  rw [show (PermLattice.tateH0Equiv hgen (() : Unit)
      (TateH0.mk σ (show σ • valHom hG x = valHom hG x by rw [← map_smul, hx])))
      = ((Multiplicative.toAdd (valZ x.toMul) : ℤ) : ZMod _) from rfl]
  exact zmodCongr_intCast _ _

/-- **The local invariant map, normalised so that a uniformiser has invariant `1`.**

This is `LocalCFT.invariantMapEquiv` composed with negation on `ZMod #G`, which compensates
the sign in `LocalCFT.valHom` (there `Valued.v π = exp (-1)` makes a uniformiser have value
`-1`).  Its value on the class of an invariant unit `x` is `ordZ x`
(`LocalCFT.normalizedInvariantEquiv_mk`). -/
def normalizedInvariantEquiv (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ)) {σ : G}
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)] :
    TateH0 G (Additive Fˣ) σ ≃+ ZMod (Nat.card G) :=
  (invariantMapEquiv hG hcompat hπ hgen).trans (AddEquiv.neg (ZMod (Nat.card G)))

theorem normalizedInvariantEquiv_mk (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ)) {σ : G}
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)]
    {x : Additive Fˣ} (hx : σ • x = x) :
    normalizedInvariantEquiv hG hcompat hπ hgen (TateH0.mk σ hx)
      = ((ordZ x.toMul : ℤ) : ZMod (Nat.card G)) := by
  show -(invariantMapEquiv hG hcompat hπ hgen (TateH0.mk σ hx)) = _
  rw [invariantMapEquiv_mk hG hcompat hπ hgen hx, ordZ, Int.cast_neg]

/-- **The class of a uniformiser has normalised invariant `1`**, so it generates
`Ĥ⁰(G, Fˣ) ≅ ZMod #G`. -/
theorem normalizedInvariantEquiv_mk_of_uniformizer
    (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ)) {σ : G}
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)]
    {x : Additive Fˣ} (hx : σ • x = x)
    (hv : (Valued.v (x.toMul : F) : ℤᵐ⁰) = exp (-1 : ℤ)) :
    normalizedInvariantEquiv hG hcompat hπ hgen (TateH0.mk σ hx) = 1 := by
  rw [normalizedInvariantEquiv_mk hG hcompat hπ hgen hx, ordZ_of_valued_eq_exp_neg_one hv]
  exact Int.cast_one

/-! ## Restriction multiplies the invariant by the index -/

section Restriction

variable {σ : G} (H : Subgroup G) [Fintype H] {τ : H}

/-- **Restriction is compatible with the local invariant maps.**

For `H ≤ G = ⟨σ⟩` with `H = ⟨τ⟩`, the invariant of the restricted class is the invariant of
the class, read mod `#H` instead of mod `#G`: both are the valuation of the same
representative.  Since `ZMod #G` is the normalisation `(1/#G)ℤ/ℤ` of the invariant and
`ZMod #H` is `(1/#H)ℤ/ℤ`, and `#G = [G : H] * #H` (`LocalCFT.card_eq_index_mul_card`), in the
common normalisation this says that **restriction multiplies the invariant by the index
`[G : H]`**. -/
theorem invariantMapEquiv_tateH0Res (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ))
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (hgenH : ∀ h : H, ∃ k : ℕ, τ ^ k = h)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH0 H (Additive (integers (F := F))ˣ) τ)]
    [Subsingleton (TateH1 H (Additive (integers (F := F))ˣ) τ)]
    (t : TateH0 G (Additive Fˣ) σ) :
    invariantMapEquiv (F := F) (G := H) (fun h x ↦ hG (h : G) x)
        (fun h a ↦ hcompat (h : G) a) hπ hgenH (tateH0Res hgen H τ t)
      = ZMod.castHom (Subgroup.card_subgroup_dvd_card H) (ZMod (Nat.card H))
          (invariantMapEquiv hG hcompat hπ hgen t) := by
  obtain ⟨x, hx, rfl⟩ := TateH0.mk_surjective t
  rw [tateH0Res_mk, invariantMapEquiv_mk, invariantMapEquiv_mk, map_intCast]

/-- **Restriction is compatible with the normalised local invariant maps**; see
`LocalCFT.invariantMapEquiv_tateH0Res` for the index interpretation. -/
theorem normalizedInvariantEquiv_tateH0Res (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ))
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (hgenH : ∀ h : H, ∃ k : ℕ, τ ^ k = h)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH0 H (Additive (integers (F := F))ˣ) τ)]
    [Subsingleton (TateH1 H (Additive (integers (F := F))ˣ) τ)]
    (t : TateH0 G (Additive Fˣ) σ) :
    normalizedInvariantEquiv (F := F) (G := H) (fun h x ↦ hG (h : G) x)
        (fun h a ↦ hcompat (h : G) a) hπ hgenH (tateH0Res hgen H τ t)
      = ZMod.castHom (Subgroup.card_subgroup_dvd_card H) (ZMod (Nat.card H))
          (normalizedInvariantEquiv hG hcompat hπ hgen t) := by
  obtain ⟨x, hx, rfl⟩ := TateH0.mk_surjective t
  rw [tateH0Res_mk, normalizedInvariantEquiv_mk, normalizedInvariantEquiv_mk, map_intCast]

/-- **Restriction multiplies the local invariant by the index.**

Both invariants are put in the common normalisation `(1/#G)ℤ/ℤ = ZMod #G` by the inclusion
`LocalCFT.zmodScale`; there, the invariant of the restricted class is `[G : H]` times the
invariant of the class.  This is the classical compatibility that makes local invariants of
different local extensions comparable, and is the reason a sum of local invariants can be
formed over all places of a number field. -/
theorem normalizedInvariantEquiv_tateH0Res_index
    (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ))
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g) (hgenH : ∀ h : H, ∃ k : ℕ, τ ^ k = h)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH0 H (Additive (integers (F := F))ˣ) τ)]
    [Subsingleton (TateH1 H (Additive (integers (F := F))ˣ) τ)]
    (t : TateH0 G (Additive Fˣ) σ) :
    zmodScale H.index (card_eq_index_mul_card H)
        (normalizedInvariantEquiv (F := F) (G := H) (fun h x ↦ hG (h : G) x)
          (fun h a ↦ hcompat (h : G) a) hπ hgenH (tateH0Res hgen H τ t))
      = (H.index : ZMod (Nat.card G)) * normalizedInvariantEquiv hG hcompat hπ hgen t := by
  obtain ⟨x, hx, rfl⟩ := TateH0.mk_surjective t
  rw [tateH0Res_mk, normalizedInvariantEquiv_mk, normalizedInvariantEquiv_mk, zmodScale_intCast]

end Restriction

/-! ## Local reciprocity -/

/-- **Local reciprocity at an unramified place, normalised**:
`(F^G)ˣ / N(Fˣ) = Ĥ⁰(G, Fˣ) ≅ G`, sending the class of a uniformiser to the chosen generator
`σ` (`LocalCFT.localArtinEquiv_mk_of_uniformizer`).  `G` is cyclic, hence equal to its own
abelianisation, so this is the local Artin isomorphism
`K^× / N(L^×) ≅ Gal(L/K)^{ab}` in the unramified case.

Compared with `LocalCFT.localReciprocityEquiv` this one is normalised: it is built from
`LocalCFT.normalizedInvariantEquiv`, so a uniformiser goes to `σ` rather than to `σ⁻¹`. -/
def localArtinEquiv (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ)) {σ : G}
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)] :
    TateH0 G (Additive Fˣ) σ ≃+ Additive G :=
  (normalizedInvariantEquiv hG hcompat hπ hgen).trans
    (zmodAddEquivOfGenerator (G := Additive G) (mem_zmultiples_ofMul hgen) rfl)

/-- The local Artin isomorphism sends the class of an invariant unit `x` to `σ ^ ordZ x`. -/
theorem localArtinEquiv_mk (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ)) {σ : G}
    (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)]
    {x : Additive Fˣ} (hx : σ • x = x) :
    localArtinEquiv hG hcompat hπ hgen (TateH0.mk σ hx)
      = Additive.ofMul (σ ^ ordZ x.toMul) := by
  show zmodAddEquivOfGenerator (G := Additive G) (mem_zmultiples_ofMul hgen) rfl
      (normalizedInvariantEquiv hG hcompat hπ hgen (TateH0.mk σ hx)) = _
  rw [normalizedInvariantEquiv_mk hG hcompat hπ hgen hx]
  exact (zmodAddEquivOfGenerator_apply_intCast (G := Additive G) (mem_zmultiples_ofMul hgen) rfl
    (ordZ x.toMul)).trans (ofMul_zpow (ordZ x.toMul) σ).symm

/-- **The class of a uniformiser is the Frobenius-like generator**: local reciprocity sends it
to `σ`.  This is the normalisation that makes `LocalCFT.localArtinEquiv` the local Artin map
in the unramified case. -/
theorem localArtinEquiv_mk_of_uniformizer (hπ : ∃ π : F, (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ))
    {σ : G} (hgen : ∀ g : G, ∃ k : ℕ, σ ^ k = g)
    [Subsingleton (TateH0 G (Additive (integers (F := F))ˣ) σ)]
    [Subsingleton (TateH1 G (Additive (integers (F := F))ˣ) σ)]
    {x : Additive Fˣ} (hx : σ • x = x)
    (hv : (Valued.v (x.toMul : F) : ℤᵐ⁰) = exp (-1 : ℤ)) :
    localArtinEquiv hG hcompat hπ hgen (TateH0.mk σ hx) = Additive.ofMul σ := by
  rw [localArtinEquiv_mk hG hcompat hπ hgen hx, ordZ_of_valued_eq_exp_neg_one hv, zpow_one]

end LocalField

end LocalCFT

/-! ## At an unramified finite place of a number field -/

namespace NumberField

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum WithZero LocalCFT CyclicTate

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [IsGalois K L]
variable (v : HeightOneSpectrum (𝓞 K)) (w : HeightOneSpectrum (𝓞 L))
  [w.asIdeal.LiesOver v.asIdeal]

attribute [local instance] decompositionIntegersMulSemiringAction
  IsLocalRing.residueMulSemiringAction Units.mulDistribMulActionRight

variable [Fintype (decompositionGroup K L w)] {σ : decompositionGroup K L w}

/-- **The normalised local invariant map at an unramified place**:
`Ĥ⁰(D_w, L_w^×) ≃ ZMod n_w`, with the class of a uniformiser of `L_w` going to `1`. -/
def normalizedInvAdicCompletionUnits (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    (hσ : ∀ d : decompositionGroup K L w, d ∈ Subgroup.zpowers σ) :
    TateH0 (decompositionGroup K L w) (Additive (w.adicCompletion L)ˣ) σ
      ≃+ ZMod (Nat.card (decompositionGroup K L w)) :=
  haveI := subsingleton_tateH0_units v w h hσ
  haveI := subsingleton_tateH1_units v w h hσ
  LocalCFT.normalizedInvariantEquiv (F := w.adicCompletion L)
    (G := decompositionGroup K L w)
    (valued_decomposition_smul w) (fun _ _ ↦ rfl)
    (valuedAdicCompletion_surjective (K := L) w (exp (-1 : ℤ)))
    (exists_pow_eq_of_mem_zpowers w hσ)

/-- **Local reciprocity at an unramified finite place of a number field**:
`K_v^× / N(L_w^×) = Ĥ⁰(D_w, L_w^×) ≅ D_w = Gal(L_w / K_v)`.

`D_w` is cyclic, so it is its own abelianisation and this is the full local Artin
isomorphism at `w`.  The class of a uniformiser of `L_w` corresponds to the chosen generator
`σ` of `D_w`, by `LocalCFT.localArtinEquiv_mk_of_uniformizer`.  Its order form is
`NumberField.card_tateH0_adicCompletionUnits_unramified`. -/
def localArtinAdicCompletionUnits (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    (hσ : ∀ d : decompositionGroup K L w, d ∈ Subgroup.zpowers σ) :
    TateH0 (decompositionGroup K L w) (Additive (w.adicCompletion L)ˣ) σ
      ≃+ Additive (decompositionGroup K L w) :=
  haveI := subsingleton_tateH0_units v w h hσ
  haveI := subsingleton_tateH1_units v w h hσ
  LocalCFT.localArtinEquiv (F := w.adicCompletion L) (G := decompositionGroup K L w)
    (valued_decomposition_smul w) (fun _ _ ↦ rfl)
    (valuedAdicCompletion_surjective (K := L) w (exp (-1 : ℤ)))
    (exists_pow_eq_of_mem_zpowers w hσ)

omit [IsGalois K L] [Fintype (decompositionGroup K L w)] in
/-- A unit of `L_w` coming from `K_v` is fixed by the decomposition group. -/
theorem smul_ofMul_unit_of_eq_adicCompletionComap {π : v.adicCompletion K}
    {u : (w.adicCompletion L)ˣ}
    (hu : (u : w.adicCompletion L) = adicCompletionComap K L v w π)
    (d : decompositionGroup K L w) :
    d • (Additive.ofMul u) = Additive.ofMul u :=
  congrArg Additive.ofMul (Units.ext (by
    show d • (u : w.adicCompletion L) = (u : w.adicCompletion L)
    rw [hu]
    exact decomposition_smul_adicCompletionComap v w d π))

/-- **Local reciprocity sends the class of a uniformiser of `K_v` to the generator `σ` of
`D_w`**, at an unramified place.  A uniformiser `π` of `K_v` is still a uniformiser of `L_w`
there (`IsDedekindDomain.HeightOneSpectrum.valued_adicCompletionComap_of_ramificationIdx_eq_one`)
and is fixed by `D_w` (`NumberField.decomposition_smul_adicCompletionComap`), so its class in
`K_v^× / N(L_w^×)` is defined and is the Artin generator.  Identifying `σ` with the arithmetic
Frobenius `arithFrobAt` of `w` is not done in this file.  It is done in
`Iwasawalib/NumberTheory/LocalCFT/ArtinFrobenius.lean`
(`NumberField.localArtinAdicCompletionUnits_mk_uniformizer_arithFrob`), which takes for `σ` the
arithmetic Frobenius: at an unramified place it generates `D_w`
(`NumberField.mem_zpowers_arithFrobDecomposition`, in
`Iwasawalib/NumberTheory/LocalCFT/ResidueFrobenius.lean`), by the injectivity of
`D_w → Gal(k_w / k_v)` (`NumberField.stabilizerHom_injective`).  That file also proves the
surjectivity (`NumberField.stabilizerHom_surjective`), so that this map is the isomorphism
`D_w ≅ Gal(k_w / k_v)` (`NumberField.decompositionMulEquivResidueGal`). -/
theorem localArtinAdicCompletionUnits_mk_uniformizer
    (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    (hσ : ∀ d : decompositionGroup K L w, d ∈ Subgroup.zpowers σ)
    {π : v.adicCompletion K} (hv : (Valued.v π : ℤᵐ⁰) = exp (-1 : ℤ))
    {u : (w.adicCompletion L)ˣ}
    (hu : (u : w.adicCompletion L) = adicCompletionComap K L v w π) :
    localArtinAdicCompletionUnits v w h hσ
        (TateH0.mk σ (smul_ofMul_unit_of_eq_adicCompletionComap v w hu σ))
      = Additive.ofMul σ := by
  haveI := subsingleton_tateH0_units v w h hσ
  haveI := subsingleton_tateH1_units v w h hσ
  refine LocalCFT.localArtinEquiv_mk_of_uniformizer _ _ _ _ _ ?_
  show (Valued.v (u : w.adicCompletion L) : ℤᵐ⁰) = exp (-1 : ℤ)
  rw [hu, valued_adicCompletionComap_of_ramificationIdx_eq_one K L v w h, hv]

/-- **`Ĥ⁰(D_w, L_w^×)` is cyclic** at an unramified place — which the order statement
`NumberField.card_tateH0_adicCompletionUnits_unramified` does not give by itself. -/
theorem isAddCyclic_tateH0_adicCompletionUnits (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    (hσ : ∀ d : decompositionGroup K L w, d ∈ Subgroup.zpowers σ) :
    IsAddCyclic (TateH0 (decompositionGroup K L w) (Additive (w.adicCompletion L)ˣ) σ) :=
  isAddCyclic_of_surjective _ (normalizedInvAdicCompletionUnits v w h hσ).symm.surjective

end NumberField
