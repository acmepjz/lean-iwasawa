module

public import Iwasawalib.NumberTheory.LocalCFT.Inertia
public import Mathlib.RingTheory.Frobenius
public import Mathlib.FieldTheory.Finite.Basic

@[expose] public section

/-!
# The decomposition group is the residue Galois group, and Frobenius generates it

Let `L / K` be a finite Galois extension of number fields, `w` a finite place of `L` lying over
the place `v` of `K`.  The decomposition group `D_w` acts on the residue field extension
`k_w = 𝓞_L ⧸ w` of `k_v = 𝓞_K ⧸ v`, and this file proves the two facts about that action that
the local Artin map needs.

* **`D_w ↠ Gal(k_w / k_v)`** always (`NumberField.stabilizerHom_surjective`): this is Mathlib's
  `Ideal.Quotient.stabilizerHom_surjective`, applied to the finite group `Gal(L/K)` acting on
  `𝓞_L` with `𝓞_K` as the fixed ring.  Together with
  `NumberField.stabilizerHom_injective` (the triviality of inertia at an unramified place, from
  `Iwasawalib/NumberTheory/LocalCFT/Inertia.lean`) this gives the isomorphism
  **`D_w ≅ Gal(k_w / k_v)`** at an unramified place,
  `NumberField.decompositionMulEquivResidueGal`.

* **The arithmetic Frobenius generates `D_w`** at an unramified place
  (`NumberField.mem_zpowers_arithFrobDecomposition`).  Mathlib's `arithFrobAt` is characterised
  by `σ • x ≡ x ^ #k_v (mod w)`, so its image in `Gal(k_w / k_v)` is the residue Frobenius
  `x ↦ x ^ #k_v` (`NumberField.stabilizerHom_arithFrobAt`), which generates the Galois group of
  an extension of finite fields (`FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow`).
  Transporting along the injection `D_w ↪ Gal(k_w / k_v)` gives the statement for `D_w` itself,
  and hence `NumberField.isCyclic_decompositionGroup`.

The place `w` is unramified over `v` here in the form `e(w|v) = 1`, i.e.
`v.asIdeal.ramificationIdx' w.asIdeal = 1`, which is the hypothesis used throughout
`Iwasawalib/NumberTheory/LocalCFT/`.

The cash-in — that the local Artin map of
`Iwasawalib/NumberTheory/LocalCFT/InvariantRestriction.lean` sends the class of a uniformiser to
`arithFrobAt` — is in `Iwasawalib/NumberTheory/LocalCFT/ArtinFrobenius.lean`.

## Main statements

* `NumberField.stabilizerHom_surjective`: `D_w ↠ Gal(k_w / k_v)`.
* `NumberField.decompositionMulEquivResidueGal`: `D_w ≅ Gal(k_w / k_v)` when `e(w|v) = 1`.
* `NumberField.stabilizerHom_arithFrobAt`: `arithFrobAt` maps to the residue Frobenius.
* `NumberField.mem_zpowers_arithFrobDecomposition`: `arithFrobAt` generates `D_w` when
  `e(w|v) = 1`.
* `NumberField.isCyclic_decompositionGroup`: hence `D_w` is cyclic when `e(w|v) = 1`.
* `NumberField.inertia_eq_bot`: the inertia group is trivial when `e(w|v) = 1`.
* `NumberField.eq_arithFrobAt_of_isArithFrobAt`: at an unramified place the Frobenius element is
  unique, so `arithFrobAt` is not merely *a* choice there.
* `NumberField.orderOf_arithFrobDecomposition`: it has order `#D_w`.
* `NumberField.exists_mul_pow_mem_inertia`: with no hypothesis on ramification, `D_w` is
  generated by `arithFrobAt` together with the inertia group.
-/

noncomputable section

open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum NumberField
open scoped Pointwise

namespace NumberField

variable {K : Type*} [Field K] [NumberField K] {L : Type*} [Field L] [NumberField L]
  [Algebra K L] [IsGalois K L]
variable (v : HeightOneSpectrum (𝓞 K)) (w : HeightOneSpectrum (𝓞 L))
  [w.asIdeal.LiesOver v.asIdeal]

attribute [local instance] Ideal.Quotient.field IsDedekindDomain.HeightOneSpectrum.isMaximal

/-- **The decomposition group surjects onto the residue Galois group**, `D_w ↠ Gal(k_w / k_v)`.
No unramifiedness is needed: this is Mathlib's `Ideal.Quotient.stabilizerHom_surjective` for the
finite group `Gal(L/K)` acting on `𝓞_L`. -/
theorem stabilizerHom_surjective :
    Function.Surjective (Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L)) :=
  Ideal.Quotient.stabilizerHom_surjective Gal(L/K) v.asIdeal w.asIdeal

/-- **`D_w ≅ Gal(k_w / k_v)` at an unramified place.**  Injectivity is the triviality of the
inertia group (`NumberField.stabilizerHom_injective`), surjectivity is
`NumberField.stabilizerHom_surjective`. -/
theorem stabilizerHom_bijective (h : v.asIdeal.ramificationIdx' w.asIdeal = 1) :
    Function.Bijective (Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L)) :=
  ⟨stabilizerHom_injective v w h, stabilizerHom_surjective v w⟩

omit [NumberField K] [NumberField L] [IsGalois K L] in
/-- The residue field of `K` at `w.asIdeal.under (𝓞 K)`, which is the form in which
Mathlib's `arithFrobAt` states its congruence, has the same cardinality as `k_v`: the two
ideals are equal by `w.asIdeal.LiesOver v.asIdeal`. -/
theorem natCard_quotient_under_eq [Fintype (𝓞 K ⧸ v.asIdeal)] :
    Nat.card (𝓞 K ⧸ w.asIdeal.under (𝓞 K)) = Fintype.card (𝓞 K ⧸ v.asIdeal) := by
  rw [← Nat.card_eq_fintype_card]
  exact Nat.card_congr
    (Ideal.quotEquivOfEq (Ideal.over_def w.asIdeal v.asIdeal).symm).toEquiv

/-- The arithmetic Frobenius at `w` stabilises `w.asIdeal`, hence lies in the decomposition
group. -/
theorem arithFrobAt_mem_stabilizer :
    arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal ∈
      MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal :=
  IsArithFrobAt.arithFrobAt_mem_stabilizer (𝓞 K) (L ≃ₐ[K] L) w.asIdeal

/-- **The image of `arithFrobAt` in `Gal(k_w / k_v)` is the residue Frobenius `x ↦ x ^ #k_v`.**
This is the defining congruence `σ • x ≡ x ^ #k_v (mod w)` of `IsArithFrobAt`, read on the
quotient. -/
theorem stabilizerHom_arithFrobAt [Fintype (𝓞 K ⧸ v.asIdeal)] :
    Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L)
        ⟨arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal, arithFrobAt_mem_stabilizer (K := K) w⟩
      = FiniteField.frobeniusAlgEquivOfAlgebraic (𝓞 K ⧸ v.asIdeal) (𝓞 L ⧸ w.asIdeal) := by
  refine AlgEquiv.ext fun x ↦ ?_
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [Ideal.Quotient.stabilizerHom_apply]
  have key := (IsArithFrobAt.arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal).mk_apply a
  rw [natCard_quotient_under_eq v w] at key
  exact key.trans (congrFun (FiniteField.coe_frobeniusAlgEquivOfAlgebraic _ _) _).symm

/-- **The arithmetic Frobenius generates the decomposition group at an unramified place**, in
the form of the stabiliser of `w.asIdeal`.  The residue Frobenius generates `Gal(k_w / k_v)`
because `k_w / k_v` is an extension of finite fields
(`FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow`), and `D_w → Gal(k_w / k_v)` is
injective because the inertia group is trivial. -/
theorem exists_pow_eq_arithFrobAt (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    {d : L ≃ₐ[K] L} (hd : d ∈ MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) :
    ∃ n : ℕ, arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal ^ n = d := by
  letI : Fintype (𝓞 K ⧸ v.asIdeal) := Fintype.ofFinite _
  obtain ⟨n, hn⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow
    (𝓞 K ⧸ v.asIdeal) (𝓞 L ⧸ w.asIdeal)).2
      (Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L) ⟨d, hd⟩)
  refine ⟨n.1, ?_⟩
  have : (⟨arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal, arithFrobAt_mem_stabilizer (K := K) w⟩ :
      MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) ^ (n : ℕ) = ⟨d, hd⟩ := by
    refine stabilizerHom_injective v w h ?_
    rw [map_pow, stabilizerHom_arithFrobAt v w]
    exact hn
  exact congrArg (Subtype.val) this


/-- **`D_w ≅ Gal(k_w / k_v)` at an unramified place**, in the form of the stabiliser of
`w.asIdeal` in `Gal(L/K)`. -/
def stabilizerMulEquivResidueGal (h : v.asIdeal.ramificationIdx' w.asIdeal = 1) :
    MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal
      ≃* Gal((𝓞 L ⧸ w.asIdeal)/(𝓞 K ⧸ v.asIdeal)) :=
  MulEquiv.ofBijective _ (stabilizerHom_bijective v w h)

@[simp] theorem stabilizerMulEquivResidueGal_apply
    (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    (d : MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) :
    stabilizerMulEquivResidueGal v w h d
      = Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L) d := rfl

/-- The arithmetic Frobenius of `w`, as an element of the decomposition group. -/
def arithFrobDecomposition : decompositionGroup K L w :=
  ⟨arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal, by
    rw [decompositionGroup_eq_stabilizer (K := K) w]
    exact arithFrobAt_mem_stabilizer (K := K) w⟩

@[simp] theorem coe_arithFrobDecomposition :
    (arithFrobDecomposition (K := K) w : L ≃ₐ[K] L) = arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal := rfl

/-- **`D_w ≅ Gal(k_w / k_v)` at an unramified place.** -/
def decompositionMulEquivResidueGal (h : v.asIdeal.ramificationIdx' w.asIdeal = 1) :
    decompositionGroup K L w ≃* Gal((𝓞 L ⧸ w.asIdeal)/(𝓞 K ⧸ v.asIdeal)) :=
  (MulEquiv.subgroupCongr (decompositionGroup_eq_stabilizer (K := K) w)).trans
    (stabilizerMulEquivResidueGal v w h)

/-- **Frobenius generates the decomposition group**, at an unramified place. -/
theorem exists_pow_eq_arithFrobDecomposition (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    (d : decompositionGroup K L w) : ∃ n : ℕ, arithFrobDecomposition (K := K) w ^ n = d := by
  have hd : (d : L ≃ₐ[K] L) ∈ MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal := by
    rw [← decompositionGroup_eq_stabilizer (K := K) w]; exact d.2
  obtain ⟨n, hn⟩ := exists_pow_eq_arithFrobAt v w h hd
  exact ⟨n, Subtype.ext (by rw [SubmonoidClass.coe_pow, coe_arithFrobDecomposition, hn])⟩

/-- **Frobenius generates the decomposition group**, in the `Subgroup.zpowers` form required by
`NumberField.localArtinAdicCompletionUnits`. -/
theorem mem_zpowers_arithFrobDecomposition (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    (d : decompositionGroup K L w) : d ∈ Subgroup.zpowers (arithFrobDecomposition (K := K) w) := by
  obtain ⟨n, hn⟩ := exists_pow_eq_arithFrobDecomposition v w h d
  exact ⟨(n : ℤ), by simpa only [zpow_natCast] using hn⟩

/-- The decomposition group at an unramified place is generated by the arithmetic Frobenius. -/
theorem zpowers_arithFrobDecomposition_eq_top
    (h : v.asIdeal.ramificationIdx' w.asIdeal = 1) :
    Subgroup.zpowers (arithFrobDecomposition (K := K) w) = ⊤ :=
  eq_top_iff.2 fun d _ ↦ mem_zpowers_arithFrobDecomposition v w h d

/-- The decomposition group at an unramified place is cyclic. -/
theorem isCyclic_decompositionGroup (h : v.asIdeal.ramificationIdx' w.asIdeal = 1) :
    IsCyclic (decompositionGroup K L w) :=
  ⟨⟨arithFrobDecomposition (K := K) w,
    fun d ↦ mem_zpowers_arithFrobDecomposition v w h d⟩⟩

/-- **The inertia group is trivial at an unramified place.**  Its order is the ramification
index by `Ideal.card_inertia_eq_ramificationIdxIn`. -/
theorem inertia_eq_bot (h : v.asIdeal.ramificationIdx' w.asIdeal = 1) :
    w.asIdeal.inertia (L ≃ₐ[K] L) = ⊥ := by
  have hcard : Nat.card (w.asIdeal.inertia (L ≃ₐ[K] L)) = 1 := by
    rw [Ideal.card_inertia_eq_ramificationIdxIn v.asIdeal w.asIdeal,
      Ideal.ramificationIdxIn_eq_ramificationIdx v.asIdeal w.asIdeal (L ≃ₐ[K] L),
      ← Ideal.ramificationIdx'_eq_ramificationIdx v.asIdeal w.asIdeal v.ne_bot]
    exact h
  rwa [← Subgroup.card_eq_one]

/-- **The arithmetic Frobenius is the unique Frobenius at an unramified place**: any `σ` with
`σ • x ≡ x ^ #k_v (mod w)` equals `arithFrobAt`.  Two Frobenius elements differ by an element
of the inertia group (`IsArithFrobAt.mul_inv_mem_inertia`), which is trivial here. -/
theorem eq_arithFrobAt_of_isArithFrobAt (h : v.asIdeal.ramificationIdx' w.asIdeal = 1)
    {σ : L ≃ₐ[K] L} (hσ : IsArithFrobAt (𝓞 K) σ w.asIdeal) :
    σ = arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal := by
  have hmem := hσ.mul_inv_mem_inertia (IsArithFrobAt.arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal)
  rw [inertia_eq_bot v w h, Subgroup.mem_bot] at hmem
  rw [← mul_inv_eq_one]
  exact hmem

/-- **The arithmetic Frobenius has order `#D_w`** at an unramified place, since it generates the
decomposition group. -/
theorem orderOf_arithFrobDecomposition (h : v.asIdeal.ramificationIdx' w.asIdeal = 1) :
    orderOf (arithFrobDecomposition (K := K) w) = Nat.card (decompositionGroup K L w) := by
  rw [← Nat.card_zpowers, zpowers_arithFrobDecomposition_eq_top v w h, Subgroup.card_top]

include v in
/-- **`D_w` is generated by the arithmetic Frobenius together with the inertia group**, with no
unramifiedness hypothesis: every element of the decomposition group is a power of `arithFrobAt`
up to inertia.  This is the ramified form of
`NumberField.exists_pow_eq_arithFrobAt`, which is the case `I_w = 1`. -/
theorem exists_mul_pow_mem_inertia (d : MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) :
    ∃ n : ℕ, d * (⟨arithFrobAt (𝓞 K) (L ≃ₐ[K] L) w.asIdeal,
      arithFrobAt_mem_stabilizer (K := K) w⟩ : MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) ^ n
        ∈ w.asIdeal.inertia (MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) := by
  letI : Fintype (𝓞 K ⧸ v.asIdeal) := Fintype.ofFinite _
  obtain ⟨n, hn⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow
    (𝓞 K ⧸ v.asIdeal) (𝓞 L ⧸ w.asIdeal)).2
      (Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L) d⁻¹)
  refine ⟨n.1, ?_⟩
  rw [← Ideal.Quotient.ker_stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L),
    MonoidHom.mem_ker, map_mul, map_pow, stabilizerHom_arithFrobAt v w]
  rw [show Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L) d
      = (Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L) d⁻¹)⁻¹ by
    rw [map_inv, inv_inv]]
  rw [← hn]
  exact inv_mul_cancel _

end NumberField
