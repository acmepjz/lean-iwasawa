@[expose] public section

/-!
# The commutator subgroup of a compact group with topologically cyclic quotient

Blueprint node `commutator-eq` (Washington, *Introduction to cyclotomic fields*, Lemma 13.14).

Let `G` be a compact Hausdorff topological group, `X` a closed abelian normal subgroup such
that `Γ := G ⧸ X` is topologically cyclic with topological generator `γ`.  Then

`commutator G = {(γ • x) * x⁻¹ | x ∈ X}`,

the right-hand side being a closed subgroup of `G`.  In particular the commutator subgroup is
already closed, so it agrees with its topological closure, which is the form the blueprint
states.

Two remarks on the blueprint:

* the blueprint additionally assumes the existence of a subgroup `I ⊆ G` mapping onto `Γ`.
  This hypothesis is **not needed**: the projection `G → Γ` is surjective, so a lift `g` of `γ`
  always exists, and the subgroup `J := mk⁻¹(⟨γ⟩)` generated by `g` and `X` is dense in `G`,
  which is all the proof uses;
* the identity displayed in the blueprint's proof,
  `(αx)(βy)(αx)⁻¹(βy)⁻¹ = (α • x)(αβ • x)⁻¹(αβ • y)(β • y)⁻¹`, is only valid when `α` and `β`
  commute (it silently drops the term `⁅α, β⁆`), which a general subgroup `I` surjecting onto
  `Γ` need not satisfy.  Here `α`, `β` are powers of a single lift `g`, so they do commute.
-/

open Topology Pointwise
open scoped commutatorElement

section DenseComm

variable {H : Type*} [Group H] [TopologicalSpace H] [IsTopologicalGroup H] [T2Space H]

/-- If a Hausdorff topological group contains a dense set of pairwise commuting elements, then
it is commutative. -/
@[to_additive]
theorem mul_comm_of_dense {D : Set H} (hD : Dense D)
    (hcomm : ∀ a ∈ D, ∀ b ∈ D, a * b = b * a) (a b : H) : a * b = b * a := by
  have step : ∀ a ∈ D, ∀ b : H, a * b = b * a := by
    intro a ha b
    have hcl : IsClosed {c : H | a * c = c * a} :=
      isClosed_eq (continuous_const.mul continuous_id) (continuous_id.mul continuous_const)
    have : D ⊆ {c : H | a * c = c * a} := fun c hc ↦ hcomm a ha c hc
    have := hD.closure_eq ▸ (closure_minimal this hcl)
    exact this (Set.mem_univ b)
  have hcl : IsClosed {c : H | c * b = b * c} :=
    isClosed_eq (continuous_id.mul continuous_const) (continuous_const.mul continuous_id)
  have hsub : D ⊆ {c : H | c * b = b * c} := fun c hc ↦ step c hc b
  have := hD.closure_eq ▸ (closure_minimal hsub hcl)
  exact this (Set.mem_univ a)

end DenseComm

/-- The commutator identity behind blueprint node `commutator-eq`, for two *commuting* elements
`A`, `B` and arbitrary `x`, `y`. -/
theorem commutatorElement_mul_mul {H : Type*} [Group H] (A B x y : H) (hAB : A * B = B * A) :
    ⁅A * x, B * y⁆ = (A * x * A⁻¹) * (A * B * y * (A * B)⁻¹) *
      (A * B * x * (A * B)⁻¹)⁻¹ * (B * y * B⁻¹)⁻¹ := by
  have h : B⁻¹ * A⁻¹ * B = A⁻¹ := by
    calc B⁻¹ * A⁻¹ * B = (A * B)⁻¹ * B := by rw [mul_inv_rev]
      _ = (B * A)⁻¹ * B := by rw [hAB]
      _ = A⁻¹ := by rw [mul_inv_rev]; group
  calc ⁅A * x, B * y⁆ = A * x * B * y * x⁻¹ * A⁻¹ * y⁻¹ * B⁻¹ := by
        rw [commutatorElement_def]; group
    _ = A * x * B * y * x⁻¹ * (B⁻¹ * A⁻¹ * B) * y⁻¹ * B⁻¹ := by rw [h]
    _ = (A * x * A⁻¹) * (A * B * y * (A * B)⁻¹) *
          (A * B * x * (A * B)⁻¹)⁻¹ * (B * y * B⁻¹)⁻¹ := by group

namespace Subgroup

variable {G : Type*} [Group G]
  (X : Subgroup G) [X.Normal] (hX : ∀ a ∈ X, ∀ b ∈ X, a * b = b * a) (γ : G ⧸ X)

include hX

/-- The subgroup `T X = {(γ • x) x⁻¹ | x ∈ X}` of `X`, where `γ` acts by conjugation.  In
additive notation for the `Λ`-module `X` this is `(γ - 1) X = T X`. -/
def gammaSubOne : Subgroup X where
  carrier := Set.range fun x : X ↦ conjAct X hX γ x * x⁻¹
  one_mem' := ⟨1, by simp⟩
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    refine ⟨x * y, ?_⟩
    show conjAct X hX γ (x * y) * (x * y)⁻¹
      = conjAct X hX γ x * x⁻¹ * (conjAct X hX γ y * y⁻¹)
    rw [conjAct_map_mul, mul_inv_rev]
    rw [mul_comm_of_abelian X hX y⁻¹ x⁻¹]
    rw [mul_assoc, mul_assoc, ← mul_assoc (conjAct X hX γ y),
      mul_comm_of_abelian X hX (conjAct X hX γ y) x⁻¹, mul_assoc, ← mul_assoc]
  inv_mem' := by
    rintro _ ⟨x, rfl⟩
    refine ⟨x⁻¹, ?_⟩
    show conjAct X hX γ x⁻¹ * x⁻¹⁻¹ = (conjAct X hX γ x * x⁻¹)⁻¹
    rw [conjAct_map_inv, inv_inv, mul_inv_rev, inv_inv,
      mul_comm_of_abelian X hX (conjAct X hX γ x)⁻¹ x]

theorem mem_gammaSubOne_iff (y : X) :
    y ∈ gammaSubOne X hX γ ↔ ∃ x : X, conjAct X hX γ x * x⁻¹ = y := by
  constructor
  · rintro ⟨x, hx⟩
    exact ⟨x, hx⟩
  · rintro ⟨x, hx⟩
    exact ⟨x, hx⟩

theorem conjAct_mul_inv_mem_gammaSubOne (x : X) :
    conjAct X hX γ x * x⁻¹ ∈ gammaSubOne X hX γ :=
  (mem_gammaSubOne_iff X hX γ _).2 ⟨x, rfl⟩

theorem coe_gammaSubOne :
    (gammaSubOne X hX γ : Set X) = Set.range fun x : X ↦ conjAct X hX γ x * x⁻¹ := by
  ext y
  exact mem_gammaSubOne_iff X hX γ y

end Subgroup

namespace Subgroup

variable {G : Type*} [Group G]
  (X : Subgroup G) [X.Normal] (hX : ∀ a ∈ X, ∀ b ∈ X, a * b = b * a) (γ : G ⧸ X)

include hX

/-- The subgroup `T X` of blueprint node `commutator-eq`, viewed inside `G`. -/
def gammaSubOneG : Subgroup G := (gammaSubOne X hX γ).map X.subtype

theorem mem_gammaSubOneG_iff (z : G) :
    z ∈ gammaSubOneG X hX γ ↔ ∃ x : X, ((conjAct X hX γ x * x⁻¹ : X) : G) = z := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨x, hx⟩ := (mem_gammaSubOne_iff X hX γ y).1 hy
    exact ⟨x, by rw [hx]; rfl⟩
  · rintro ⟨x, rfl⟩
    exact ⟨_, conjAct_mul_inv_mem_gammaSubOne X hX γ x, rfl⟩

theorem mem_gammaSubOneG_iff' (z : G) :
    z ∈ gammaSubOneG X hX γ ↔ ∃ y : X, y ∈ gammaSubOne X hX γ ∧ (y : G) = z := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y, hy, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y, hy, rfl⟩

end Subgroup

namespace Subgroup

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  (X : Subgroup G) [X.Normal] (hX : ∀ a ∈ X, ∀ b ∈ X, a * b = b * a) (γ : G ⧸ X)

include hX

/-- For fixed `σ`, the map `x ↦ σ • x` is continuous. -/
theorem continuous_conjAct_left (σ : G ⧸ X) :
    Continuous fun x : X ↦ conjAct X hX σ x :=
  (continuous_conjQuotient X hX).comp (continuous_const.prodMk continuous_id)

section Abelian

variable (hXc : IsClosed (X : Set G)) (hγ : Dense (Subgroup.zpowers γ : Set (G ⧸ X)))

include hXc hγ

omit hX in
/-- `Γ = G ⧸ X` is commutative, being topologically cyclic. -/
theorem mul_comm_quotient (σ τ : G ⧸ X) : σ * τ = τ * σ := by
  haveI : IsClosed (X : Set G) := hXc
  refine mul_comm_of_dense hγ ?_ σ τ
  rintro _ ⟨m, rfl⟩ _ ⟨n, rfl⟩
  exact (Commute.refl γ).zpow_zpow m n

omit [IsTopologicalGroup G] [X.Normal] hX hγ in
/-- If `G` is compact and `X` is closed, then `X` is a compact space. -/
theorem compactSpace_of_isClosed [CompactSpace G] : CompactSpace X :=
  isCompact_iff_compactSpace.1 hXc.isCompact

/-- The action of `Γ` on `X` preserves `T X`. -/
theorem conjAct_mem_gammaSubOne {y : X} (hy : y ∈ gammaSubOne X hX γ) (σ : G ⧸ X) :
    conjAct X hX σ y ∈ gammaSubOne X hX γ := by
  obtain ⟨x, rfl⟩ := (mem_gammaSubOne_iff X hX γ y).1 hy
  refine (mem_gammaSubOne_iff X hX γ _).2 ⟨conjAct X hX σ x, ?_⟩
  rw [conjAct_map_mul, conjAct_map_inv, ← conjAct_mul, ← conjAct_mul,
    mul_comm_quotient X γ hXc hγ σ γ]

omit hγ in
/-- `T X` is closed in `X`. -/
theorem isClosed_gammaSubOne [CompactSpace G] [T2Space G] :
    IsClosed (gammaSubOne X hX γ : Set X) := by
  haveI := compactSpace_of_isClosed X hXc
  rw [coe_gammaSubOne]
  refine (isCompact_range ?_).isClosed
  exact (continuous_conjAct_left X hX γ).mul continuous_inv

/-- **Blueprint node `commutator-eq`, main step.**  Every `σ ∈ Γ` satisfies
`(σ • x) x⁻¹ ∈ T X`. -/
theorem conjAct_mul_inv_mem_gammaSubOne' [CompactSpace G] [T2Space G]
    (σ : G ⧸ X) (x : X) : conjAct X hX σ x * x⁻¹ ∈ gammaSubOne X hX γ := by
  set S := gammaSubOne X hX γ with hSdef
  have hone : ∀ z : X, conjAct X hX 1 z * z⁻¹ ∈ S := by
    intro z; simp
  have hmul : ∀ σ τ : G ⧸ X, (∀ z : X, conjAct X hX σ z * z⁻¹ ∈ S) →
      (∀ z : X, conjAct X hX τ z * z⁻¹ ∈ S) → ∀ z : X, conjAct X hX (σ * τ) z * z⁻¹ ∈ S := by
    intro σ τ hσ hτ z
    have h1 : conjAct X hX σ (conjAct X hX τ z) * (conjAct X hX τ z)⁻¹ ∈ S := hσ _
    have h2 : conjAct X hX τ z * z⁻¹ ∈ S := hτ z
    have h3 := S.mul_mem h1 h2
    rw [show conjAct X hX σ (conjAct X hX τ z) * (conjAct X hX τ z)⁻¹ *
      (conjAct X hX τ z * z⁻¹) = conjAct X hX σ (conjAct X hX τ z) * z⁻¹ from by group,
      ← conjAct_mul] at h3
    exact h3
  have hinv : ∀ σ : G ⧸ X, (∀ z : X, conjAct X hX σ z * z⁻¹ ∈ S) →
      ∀ z : X, conjAct X hX σ⁻¹ z * z⁻¹ ∈ S := by
    intro σ hσ z
    have h := hσ (conjAct X hX σ⁻¹ z)
    rw [← conjAct_mul, mul_inv_cancel, conjAct_one] at h
    have h2 := S.inv_mem h
    rw [mul_inv_rev, inv_inv] at h2
    exact h2
  set Γ₀ : Subgroup (G ⧸ X) :=
    { carrier := {σ | ∀ z : X, conjAct X hX σ z * z⁻¹ ∈ S}
      one_mem' := hone
      mul_mem' := fun {σ} {τ} hσ hτ ↦ hmul σ τ hσ hτ
      inv_mem' := fun {σ} hσ ↦ hinv σ hσ } with hΓ₀
  have hclosed : IsClosed (Γ₀ : Set (G ⧸ X)) := by
    have heq : (Γ₀ : Set (G ⧸ X)) =
        ⋂ z : X, (fun σ : G ⧸ X ↦ conjAct X hX σ z * z⁻¹) ⁻¹' (S : Set X) := by
      ext σ
      simp only [Set.mem_iInter, Set.mem_preimage]
      exact Iff.rfl
    rw [heq]
    exact isClosed_iInter fun z ↦
      (isClosed_gammaSubOne X hX γ hXc).preimage
        ((continuous_conjAct_right X hX z).mul continuous_const)
  have hle : Subgroup.zpowers γ ≤ Γ₀ :=
    Subgroup.zpowers_le.2 fun z ↦ conjAct_mul_inv_mem_gammaSubOne X hX γ z
  have huniv : (Set.univ : Set (G ⧸ X)) ⊆ (Γ₀ : Set (G ⧸ X)) := by
    rw [← hγ.closure_eq]
    exact closure_minimal hle hclosed
  exact huniv (Set.mem_univ σ) x


omit hX hXc in
/-- The preimage of `⟨γ⟩` in `G` is dense. -/
theorem dense_comap_zpowers :
    Dense (((Subgroup.zpowers γ).comap (QuotientGroup.mk' X) : Subgroup G) : Set G) := by
  rw [dense_iff_inter_open]
  intro U hU hne
  obtain ⟨u, hu⟩ := hne
  have hopen : IsOpen (QuotientGroup.mk '' U : Set (G ⧸ X)) :=
    QuotientGroup.isOpenMap_coe U hU
  obtain ⟨w, hw⟩ := (dense_iff_inter_open.1 hγ) _ hopen ⟨QuotientGroup.mk u, u, hu, rfl⟩
  obtain ⟨u₀, hu₀U, hu₀⟩ := hw.1
  exact ⟨u₀, hu₀U, by simpa [Subgroup.mem_comap, QuotientGroup.mk'_apply, hu₀] using hw.2⟩

variable [CompactSpace G] [T2Space G]

omit hγ in
/-- `T X`, viewed in `G`, is closed. -/
theorem isClosed_gammaSubOneG : IsClosed (gammaSubOneG X hX γ : Set G) := by
  haveI := compactSpace_of_isClosed X hXc
  have hc : IsCompact (gammaSubOne X hX γ : Set X) :=
    (isClosed_gammaSubOne X hX γ hXc).isCompact
  have : (gammaSubOneG X hX γ : Set G) = Subtype.val '' (gammaSubOne X hX γ : Set X) := rfl
  rw [this]
  exact (hc.image continuous_subtype_val).isClosed

/-- **Blueprint node `commutator-eq`** (Washington, *Introduction to cyclotomic fields*,
Lemma 13.14).  If `G` is a compact Hausdorff group, `X` a closed abelian normal subgroup and
`Γ = G ⧸ X` is topologically generated by `γ`, then the commutator subgroup of `G` is exactly
`{(γ • x) x⁻¹ | x ∈ X}`.  In particular it is closed, so it coincides with its topological
closure, which is how the blueprint phrases the conclusion. -/
theorem commutator_eq_gammaSubOneG : _root_.commutator G = gammaSubOneG X hX γ := by
  obtain ⟨g, hgγ⟩ := QuotientGroup.mk_surjective (s := X) γ
  refine le_antisymm ?_ ?_
  · -- `[G, G] ≤ T X`
    have hS : ∀ (σ : G ⧸ X) (x : X), conjAct X hX σ x * x⁻¹ ∈ gammaSubOne X hX γ :=
      conjAct_mul_inv_mem_gammaSubOne' X hX γ hXc hγ
    -- the dense subgroup `J`
    set J : Subgroup G := (Subgroup.zpowers γ).comap (QuotientGroup.mk' X) with hJdef
    have hJdense : Dense (J : Set G) := dense_comap_zpowers X γ hγ
    have hJcomm : ∀ a ∈ J, ∀ b ∈ J, ⁅a, b⁆ ∈ gammaSubOneG X hX γ := by
      intro a ha b hb
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (Subgroup.mem_comap.1 ha)
      obtain ⟨l, hl⟩ := Subgroup.mem_zpowers_iff.1 (Subgroup.mem_comap.1 hb)
      rw [QuotientGroup.mk'_apply] at hk hl
      have hmkg : ∀ m : ℤ, (QuotientGroup.mk (g ^ m) : G ⧸ X) = γ ^ m := by
        intro m
        rw [← hgγ]
        exact map_zpow (QuotientGroup.mk' X) g m
      have hx : (g ^ k)⁻¹ * a ∈ X := by
        rw [← QuotientGroup.eq_one_iff]
        rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, hmkg, hk]
        simp
      have hy : (g ^ l)⁻¹ * b ∈ X := by
        rw [← QuotientGroup.eq_one_iff]
        rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, hmkg, hl]
        simp
      set xx : X := ⟨(g ^ k)⁻¹ * a, hx⟩ with hxx
      set yy : X := ⟨(g ^ l)⁻¹ * b, hy⟩ with hyy
      set τ : G ⧸ X := QuotientGroup.mk (g ^ k) with hτ
      set ρ : G ⧸ X := QuotientGroup.mk (g ^ l) with hρ
      have hτρ : τ * ρ = QuotientGroup.mk (g ^ k * g ^ l) := by
        rw [hτ, hρ, ← QuotientGroup.mk_mul]
      -- the two pieces of `T X`
      have hs₁ : conjAct X hX τ xx * (conjAct X hX (τ * ρ) xx)⁻¹ ∈ gammaSubOne X hX γ := by
        have h0 : conjAct X hX τ (conjAct X hX ρ xx * xx⁻¹) ∈ gammaSubOne X hX γ :=
          conjAct_mem_gammaSubOne X hX γ hXc hγ (hS ρ xx) τ
        rw [conjAct_map_mul, conjAct_map_inv, ← conjAct_mul] at h0
        have := (gammaSubOne X hX γ).inv_mem h0
        rwa [mul_inv_rev, inv_inv] at this
      have hs₂ : conjAct X hX (τ * ρ) yy * (conjAct X hX ρ yy)⁻¹ ∈ gammaSubOne X hX γ := by
        have h0 : conjAct X hX ρ (conjAct X hX τ yy * yy⁻¹) ∈ gammaSubOne X hX γ :=
          conjAct_mem_gammaSubOne X hX γ hXc hγ (hS τ yy) ρ
        rw [conjAct_map_mul, conjAct_map_inv, ← conjAct_mul,
          mul_comm_quotient X γ hXc hγ ρ τ] at h0
        exact h0
      set P := conjAct X hX τ xx
      set Q := conjAct X hX (τ * ρ) xx
      set R := conjAct X hX (τ * ρ) yy
      set T := conjAct X hX ρ yy
      have hw : P * R * Q⁻¹ * T⁻¹ ∈ gammaSubOne X hX γ := by
        have := (gammaSubOne X hX γ).mul_mem hs₁ hs₂
        rwa [show P * Q⁻¹ * (R * T⁻¹) = P * (Q⁻¹ * R) * T⁻¹ from by group,
          mul_comm_of_abelian X hX Q⁻¹ R,
          show P * (R * Q⁻¹) * T⁻¹ = P * R * Q⁻¹ * T⁻¹ from by group] at this
      have hab : a = g ^ k * (xx : G) := by simp [hxx]
      have hbb : b = g ^ l * (yy : G) := by simp [hyy]
      refine (mem_gammaSubOneG_iff' X hX γ _).2 ⟨P * R * Q⁻¹ * T⁻¹, hw, ?_⟩
      have hcoeP : ((P : X) : G) = g ^ k * (xx : G) * (g ^ k)⁻¹ :=
        coe_conjAct_mk X hX (g ^ k) xx
      have hcoeT : ((T : X) : G) = g ^ l * (yy : G) * (g ^ l)⁻¹ :=
        coe_conjAct_mk X hX (g ^ l) yy
      have hcoeQ : ((Q : X) : G)
          = g ^ k * g ^ l * (xx : G) * (g ^ k * g ^ l)⁻¹ := by
        show ((conjAct X hX (τ * ρ) xx : X) : G) = _
        rw [hτρ]
        exact coe_conjAct_mk X hX _ xx
      have hcoeR : ((R : X) : G)
          = g ^ k * g ^ l * (yy : G) * (g ^ k * g ^ l)⁻¹ := by
        show ((conjAct X hX (τ * ρ) yy : X) : G) = _
        rw [hτρ]
        exact coe_conjAct_mk X hX _ yy
      rw [Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv,
        Subgroup.coe_inv, hcoeP, hcoeQ, hcoeR, hcoeT]
      conv_rhs => rw [hab, hbb]
      exact (commutatorElement_mul_mul _ _ _ _
        (((Commute.refl g).zpow_zpow k l).eq)).symm
    -- pass from the dense subgroup `J` to all of `G`
    have hclosedS := isClosed_gammaSubOneG X hX γ hXc
    have hcont1 : ∀ a : G, Continuous fun c : G ↦ ⁅a, c⁆ := by
      intro a
      simp only [commutatorElement_def]
      fun_prop
    have hcont2 : ∀ b : G, Continuous fun c : G ↦ ⁅c, b⁆ := by
      intro b
      simp only [commutatorElement_def]
      fun_prop
    have step1 : ∀ a ∈ J, ∀ b : G, ⁅a, b⁆ ∈ gammaSubOneG X hX γ := by
      intro a ha b
      have hcl : IsClosed {c : G | ⁅a, c⁆ ∈ gammaSubOneG X hX γ} :=
        hclosedS.preimage (hcont1 a)
      have hsub : (J : Set G) ⊆ {c : G | ⁅a, c⁆ ∈ gammaSubOneG X hX γ} :=
        fun c hc ↦ hJcomm a ha c hc
      have h := hJdense.closure_eq ▸ closure_minimal hsub hcl
      exact h (Set.mem_univ b)
    have step2 : ∀ a b : G, ⁅a, b⁆ ∈ gammaSubOneG X hX γ := by
      intro a b
      have hcl : IsClosed {c : G | ⁅c, b⁆ ∈ gammaSubOneG X hX γ} :=
        hclosedS.preimage (hcont2 b)
      have hsub : (J : Set G) ⊆ {c : G | ⁅c, b⁆ ∈ gammaSubOneG X hX γ} :=
        fun c hc ↦ step1 c hc b
      have h := hJdense.closure_eq ▸ closure_minimal hsub hcl
      exact h (Set.mem_univ a)
    rw [_root_.commutator_def]
    exact Subgroup.commutator_le.2 fun a _ b _ ↦ step2 a b
  · -- `T X ≤ [G, G]`
    rintro z hz
    obtain ⟨x, rfl⟩ := (mem_gammaSubOneG_iff X hX γ z).1 hz
    have : ((conjAct X hX γ x * x⁻¹ : X) : G) = ⁅g, (x : G)⁆ := by
      rw [Subgroup.coe_mul, Subgroup.coe_inv, ← hgγ, coe_conjAct_mk, commutatorElement_def]
    rw [this, _root_.commutator_def]
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top (x : G))

end Abelian

end Subgroup
