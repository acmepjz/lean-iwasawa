module

public import Iwasawalib.NumberTheory.ZpExtension.InertiaQuotient

@[expose] public section

/-!
# `Y = X ∩ I Y`, and `I Y` is closed

Step 1 of blueprint node `Xn-isom-qout-of-totally-ramified` ends with the line

> We record for later use the identification
> `Y = X ∩ I₁Y = X ∩ H = X∞ ∩ Gal(L∞/L₀) = Gal(L∞/L₀K∞)`.

That identification is what turns the description of `H = closure ⟨G', I₁, …, I_s⟩` into the
description of `Y_n` as topologically generated by `ω_n X∞` and the `a_i^{(n)}`, the closure
form which `MvZpExtension.hgen_of_closure` consumes.  Its group-theoretic content is isolated
here, together with the parenthetical remark of the blueprint that makes it usable for the
*closed* subgroup `H`:

> (Here `Y` is normal in `G`, because `Y ⊃ G'`; and `I₁Y` is compact, hence a closed subgroup.)

`Subgroup.mem_of_mem_sup_of_mem` is the same computation as the forward direction of
`Subgroup.ker_toQuotientSup`, stated as a membership fact rather than as a kernel.

## Main results

* `Subgroup.mem_of_mem_sup_of_mem`, `Subgroup.inf_sup_eq_self`: `X ∩ I Y = Y`.
* `Subgroup.isClosed_coe_sup_of_normal`: `I Y` is closed when `I` and `Y` are.
* `Subgroup.inf_eq_self_of_le_topologicalClosure`: `X ∩ Z = Y` for any `Z` with
  `Y ≤ Z ≤ closure (I ⊔ Y)`.
-/

open scoped Pointwise

namespace Subgroup

variable {G : Type*} [Group G] (X I Y : Subgroup G)

/-- **`X ∩ I Y ⊆ Y`.**  If `x ∈ X` is written `τ y` with `τ ∈ I` and `y ∈ Y ⊆ X`, then
`τ = x y⁻¹ ∈ I ∩ X = 1`, so `x = y ∈ Y`.  This is the forward direction of
`Subgroup.ker_toQuotientSup`. -/
theorem mem_of_mem_sup_of_mem [Y.Normal] (hYX : Y ≤ X)
    (hIX : ∀ g : G, g ∈ I → g ∈ X → g = 1) {x : G} (hxX : x ∈ X) (hx : x ∈ I ⊔ Y) : x ∈ Y := by
  have hx' : x ∈ (I : Set G) * (Y : Set G) := by
    rw [← Subgroup.mul_normal I Y]
    exact hx
  obtain ⟨τ, hτ, y, hy, hxy⟩ := hx'
  have hτX : τ ∈ X := by
    have hτeq : τ = x * y⁻¹ := by
      simp only at hxy
      rw [← hxy]
      group
    rw [hτeq]
    exact X.mul_mem hxX (X.inv_mem (hYX hy))
  have hτ1 : τ = 1 := hIX τ hτ hτX
  simp only [hτ1, one_mul] at hxy
  rwa [← hxy]

/-- **`X ∩ I Y = Y`**, the identification recorded at the end of Step 1 of blueprint node
`Xn-isom-qout-of-totally-ramified`. -/
theorem inf_sup_eq_self [Y.Normal] (hYX : Y ≤ X)
    (hIX : ∀ g : G, g ∈ I → g ∈ X → g = 1) : X ⊓ (I ⊔ Y) = Y :=
  le_antisymm (fun _ hx ↦ mem_of_mem_sup_of_mem X I Y hYX hIX hx.1 hx.2)
    (le_inf hYX (le_sup_right : Y ≤ I ⊔ Y))

/-- **`I Y` is closed**: it is the image of the compact set `I × Y` under multiplication.  This
is the blueprint's parenthesis "`I₁Y` is compact, hence a closed subgroup". -/
theorem isClosed_coe_sup_of_normal [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
    [T2Space G] [Y.Normal] (hI : IsClosed (I : Set G)) (hY : IsClosed (Y : Set G)) :
    IsClosed ((I ⊔ Y : Subgroup G) : Set G) := by
  rw [Subgroup.mul_normal I Y]
  exact (hI.isCompact.mul hY.isCompact).isClosed

/-- **`X ∩ Z = Y` for every `Z` between `Y` and the closure of `I Y`.**  In the blueprint `Z` is
`Gal(L∞/L₀) = closure ⟨G', I₁, …, I_s⟩`, which is closed and squeezed between `Y` and `I₁ Y`;
the closure is harmless because `I₁ Y` is already closed
(`Subgroup.isClosed_coe_sup_of_normal`). -/
theorem inf_eq_self_of_le_topologicalClosure [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G] [T2Space G] [Y.Normal] (hYX : Y ≤ X)
    (hIX : ∀ g : G, g ∈ I → g ∈ X → g = 1) (hI : IsClosed (I : Set G))
    (hY : IsClosed (Y : Set G)) {Z : Subgroup G} (hYZ : Y ≤ Z)
    (hZ : Z ≤ (I ⊔ Y).topologicalClosure) : X ⊓ Z = Y := by
  have hcl : (I ⊔ Y).topologicalClosure = I ⊔ Y :=
    le_antisymm (Subgroup.topologicalClosure_minimal _ le_rfl
      (isClosed_coe_sup_of_normal I Y hI hY)) (Subgroup.le_topologicalClosure _)
  rw [hcl] at hZ
  refine le_antisymm (fun x hx ↦ mem_of_mem_sup_of_mem X I Y hYX hIX hx.1 (hZ hx.2))
    (le_inf hYX hYZ)

end Subgroup
