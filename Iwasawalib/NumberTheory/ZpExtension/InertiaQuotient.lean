module

public import Iwasawalib.NumberTheory.ZpExtension.CommutatorEq
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.Algebra.Group.Subgroup.Pointwise

@[expose] public section

/-!
# `X / Y ≅ G / IY`: the algebraic content of Step 1 of Washington's Lemma 13.15

Blueprint node `Xn-isom-qout-of-totally-ramified`, Step 1.  There one has an exact sequence
`1 → X → G → Γ → 1`, an inertia subgroup `I ⊆ G` with `I ∩ X = 1` mapping onto `Γ`
(so that `G = XI`), and the subgroup `Y ⊆ X` generated by `T X` and the elements
`a₂, …, a_s`.  With `H := IY` the blueprint computes

`X₀ = G / H = XI / YI ≅ X / (X ∩ YI) = X / Y`.

Everything in that display is group theory, and it is what this file proves:
`Subgroup.mulEquivQuotientOfInertia`.  The two inputs that are *not* group theory —
the identification of `L₀` with the fixed field of `H`, and `I ∩ X = 1` coming from
`L∞/K∞` being unramified while `K∞/K` is totally ramified — are hypotheses here.

The hypothesis `commutator G ≤ Y` is what the blueprint supplies through
`Subgroup.commutator_eq_gammaSubOneG` (blueprint node `commutator-eq`): `G' = T X ⊆ Y`.
It makes both `Y` and `I ⊔ Y` normal in `G`, so the quotients below are groups.
-/

open scoped commutatorElement Pointwise

namespace Subgroup

variable {G : Type*} [Group G]

/-- A subgroup containing the commutator subgroup is normal. -/
theorem normal_of_commutator_le {H : Subgroup G} (h : _root_.commutator G ≤ H) : H.Normal where
  conj_mem n hn g := by
    have : ⁅g, n⁆ ∈ H := by
      refine h ?_
      rw [_root_.commutator_def]
      exact Subgroup.commutator_mem_commutator (mem_top g) (mem_top n)
    have := H.mul_mem this hn
    rwa [commutatorElement_def, inv_mul_cancel_right] at this

variable (X I Y : Subgroup G)

/-- The homomorphism `X → G ⧸ (I ⊔ Y)` used in Step 1 of Washington's Lemma 13.15. -/
noncomputable def toQuotientSup [hn : (I ⊔ Y).Normal] : X →* G ⧸ (I ⊔ Y) :=
  (QuotientGroup.mk' (I ⊔ Y)).comp X.subtype

section

variable [hY : Y.Normal] [hn : (I ⊔ Y).Normal]

omit hY in
theorem toQuotientSup_apply (x : X) :
    toQuotientSup X I Y x = QuotientGroup.mk (x : G) := rfl

omit hY in
/-- `G = X I` makes `X → G ⧸ IY` surjective. -/
theorem surjective_toQuotientSup (hG : ∀ g : G, ∃ x ∈ X, ∃ i ∈ I, g = x * i) :
    Function.Surjective (toQuotientSup X I Y) := by
  intro z
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective (s := I ⊔ Y) z
  obtain ⟨x, hx, i, hi, rfl⟩ := hG g
  refine ⟨⟨x, hx⟩, ?_⟩
  rw [toQuotientSup_apply]
  symm
  rw [QuotientGroup.eq, mul_inv_rev, inv_mul_cancel_right]
  exact (I ⊔ Y).inv_mem ((le_sup_left : I ≤ I ⊔ Y) hi)

/-- `I ∩ X = 1` and `Y ≤ X` identify the kernel of `X → G ⧸ IY` with `Y`. -/
theorem ker_toQuotientSup (hYX : Y ≤ X) (hIX : ∀ g : G, g ∈ I → g ∈ X → g = 1) :
    (toQuotientSup X I Y).ker = Y.subgroupOf X := by
  ext x
  rw [MonoidHom.mem_ker, toQuotientSup_apply, QuotientGroup.eq_one_iff, mem_subgroupOf]
  constructor
  · intro hx
    have hx' : (x : G) ∈ (I : Set G) * (Y : Set G) := by
      rw [← Subgroup.mul_normal I Y]
      exact hx
    obtain ⟨τ, hτ, y, hy, hxy⟩ := hx'
    have hyX : y ∈ X := hYX hy
    have hτX : τ ∈ X := by
      have : τ = (x : G) * y⁻¹ := by
        simp only at hxy
        rw [← hxy]
        group
      rw [this]
      exact X.mul_mem x.2 (X.inv_mem hyX)
    have hτ1 : τ = 1 := hIX τ hτ hτX
    simp only [hτ1, one_mul] at hxy
    rwa [← hxy]
  · intro hx
    exact (le_sup_right : Y ≤ I ⊔ Y) hx

/-- **Step 1 of blueprint node `Xn-isom-qout-of-totally-ramified`**, group-theoretic form:
if `G = XI` with `I ∩ X = 1`, `Y ≤ X` and `Y` normal in `G`, then `X / Y ≅ G / IY`. -/
noncomputable def mulEquivQuotientOfInertia (hYX : Y ≤ X)
    (hIX : ∀ g : G, g ∈ I → g ∈ X → g = 1)
    (hG : ∀ g : G, ∃ x ∈ X, ∃ i ∈ I, g = x * i) :
    (X ⧸ Y.subgroupOf X) ≃* (G ⧸ (I ⊔ Y)) :=
  (_root_.QuotientGroup.quotientMulEquivOfEq
      (ker_toQuotientSup X I Y hYX hIX)).symm.trans
    (_root_.QuotientGroup.quotientKerEquivOfSurjective _
      (surjective_toQuotientSup X I Y hG))

/-- If `G / IY` is finite, then `Y` has finite index in `X`. -/
theorem finite_quotient_subgroupOf (hYX : Y ≤ X)
    (hIX : ∀ g : G, g ∈ I → g ∈ X → g = 1)
    (hG : ∀ g : G, ∃ x ∈ X, ∃ i ∈ I, g = x * i)
    [Finite (G ⧸ (I ⊔ Y))] : Finite (X ⧸ Y.subgroupOf X) :=
  Finite.of_equiv _ (mulEquivQuotientOfInertia X I Y hYX hIX hG).toEquiv.symm

end

end Subgroup

namespace Subgroup

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [T2Space G]
  (X : Subgroup G) [X.Normal] (hX : ∀ a ∈ X, ∀ b ∈ X, a * b = b * a) (γ : G ⧸ X)
  (hXc : IsClosed (X : Set G)) (hγ : Dense (Subgroup.zpowers γ : Set (G ⧸ X)))

include hX hXc hγ

/-- Any subgroup of `G` containing `T X` is normal, by blueprint node `commutator-eq`. -/
theorem normal_of_gammaSubOneG_le {Y : Subgroup G} (hTY : gammaSubOneG X hX γ ≤ Y) : Y.Normal :=
  normal_of_commutator_le (by rw [commutator_eq_gammaSubOneG X hX γ hXc hγ]; exact hTY)

/-- **Step 1 of blueprint node `Xn-isom-qout-of-totally-ramified`**, in the situation of
blueprint node `commutator-eq`: for a subgroup `Y` of `X` containing `T X` and an inertia
subgroup `I` with `I ∩ X = 1` and `G = X I`, one has `X / Y ≅ G / IY`.

This is the display `X₀ = G/H = XI/YI ≅ X/(X ∩ YI) = X/Y` of the blueprint, with `H = IY`. -/
noncomputable def mulEquivQuotientOfInertia' (I Y : Subgroup G)
    (hYX : Y ≤ X) (hTY : gammaSubOneG X hX γ ≤ Y)
    (hIX : ∀ g : G, g ∈ I → g ∈ X → g = 1)
    (hG : ∀ g : G, ∃ x ∈ X, ∃ i ∈ I, g = x * i) :
    letI : Y.Normal := normal_of_gammaSubOneG_le X hX γ hXc hγ hTY
    letI : (I ⊔ Y).Normal :=
      normal_of_gammaSubOneG_le X hX γ hXc hγ (le_trans hTY (le_sup_right : Y ≤ I ⊔ Y))
    (X ⧸ Y.subgroupOf X) ≃* (G ⧸ (I ⊔ Y)) :=
  letI : Y.Normal := normal_of_gammaSubOneG_le X hX γ hXc hγ hTY
  letI : (I ⊔ Y).Normal :=
    normal_of_gammaSubOneG_le X hX γ hXc hγ (le_trans hTY (le_sup_right : Y ≤ I ⊔ Y))
  mulEquivQuotientOfInertia X I Y hYX hIX hG

end Subgroup
