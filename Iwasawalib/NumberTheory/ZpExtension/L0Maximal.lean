module

public import Iwasawalib.NumberTheory.ZpExtension.GaloisGroupProP
public import Iwasawalib.NumberTheory.ZpExtension.LnTower
public import Iwasawalib.NumberTheory.ZpExtension.XinfStepOne

@[expose] public section

/-!
# `L₀ = L∞^H` — the maximality half

Let `K∞ / K` be a `ℤₚᵈ`-extension of number fields, `L∞` the union of the maximal unramified
abelian `p`-extensions of the layers, `G = Gal(L∞/K)`, and let `H ⊆ G` be the subgroup
generated by the commutator subgroup of `G` together with the inertia subgroups of *all*
places of `L∞`.  Step 1 of Washington's Lemma 13.15 asserts `L₀ = L∞^H`.

The containment `L₀ ⊆ L∞^H` is
`MvZpExtension.commutator_sup_iSup_inertiaSubgroup_le_fixingSubgroup_L0In`, proved in
`Iwasawalib.NumberTheory.ZpExtension.XinfStepOne`; it says exactly `H ⊆ Gal(L∞/L₀)`.  This
file proves the other containment, `L∞^H ⊆ L₀`, which is where the *maximality* of `L₀` is
used: `L∞^H / K` is

* Galois, because `H` contains the commutator subgroup, so `Gal(L∞/L∞^H)` is normal
  (`InfiniteGalois.normal_iff_isGalois`);
* abelian, for the same reason;
* unramified everywhere, because `H` contains every inertia subgroup
  (`AbsoluteValue.isUnramifiedEverywhere_of_inertiaSubgroup_le_fixingSubgroup`);
* of `p`-power degree, because `L∞ / K` is (`MvZpExtension.isSExtension_K_Linf`),

and `L₀` is the largest such extension of `K₀ = K`.  The last step is taken with
`IntermediateField.adjoin_le_lift_maximalGaloisSExtension_of_ringHom`, whose ring-homomorphism
form lets us feed in `K → K₀` directly; in particular the identification `K₀ = K` is never
rewritten into a hypothesis, avoiding the "motive is not type correct" failure of
`rw [H.Kn_zero]`.

## Main results

* `MvZpExtension.HH`: the subgroup `H` of the blueprint.
* `MvZpExtension.LinfFixedHH_le_L0In`: `L∞^H ⊆ L₀`.
* `MvZpExtension.LinfFixedHH_eq_L0In`: **`L₀ = L∞^H`**, both halves.
-/

open IntermediateField NumberField
open scoped commutatorElement

variable {p : ℕ} [Fact p.Prime] {ι K Kinf : Type*} [Finite ι]
variable [Field K] [NumberField K] [Field Kinf] [Algebra K Kinf] [IsGalois K Kinf]

namespace MvZpExtension

variable (H : MvZpExtension p ι K Kinf)

/-- **The subgroup `H ⊆ G = Gal(L∞/K)`** of Step 1 of Washington's Lemma 13.15: the subgroup
generated by the commutator subgroup and by the inertia subgroups of all places of `L∞`. -/
noncomputable def HH : Subgroup H.GG :=
  commutator H.GG ⊔ ⨆ w : AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ, w.inertiaSubgroup K

omit [NumberField K] in
theorem commutator_le_HH : commutator H.GG ≤ H.HH := le_sup_left

omit [NumberField K] in
theorem inertiaSubgroup_le_HH (w : AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ) :
    w.inertiaSubgroup K ≤ H.HH :=
  le_trans (le_iSup _ w) le_sup_right

/-- `H ⊆ Gal(L∞/L₀)`: the containment `L₀ ⊆ L∞^H`, restated. -/
theorem HH_le_fixingSubgroup_L0In : H.HH ≤ H.L0In.fixingSubgroup :=
  H.commutator_sup_iSup_inertiaSubgroup_le_fixingSubgroup_L0In

/-- `L∞^H`, the fixed field of `H`. -/
noncomputable def LinfFixedHH : IntermediateField K ↥(H.Linf.restrictScalars K) :=
  IntermediateField.fixedField H.HH

omit [NumberField K] in
theorem HH_le_fixingSubgroup_LinfFixedHH : H.HH ≤ H.LinfFixedHH.fixingSubgroup :=
  (IntermediateField.le_iff_le (H := H.HH) (K := H.LinfFixedHH)).1 le_rfl

omit [NumberField K] in
theorem commutator_le_fixingSubgroup_LinfFixedHH :
    commutator H.GG ≤ H.LinfFixedHH.fixingSubgroup :=
  le_trans H.commutator_le_HH H.HH_le_fixingSubgroup_LinfFixedHH

instance normal_fixingSubgroup_LinfFixedHH : H.LinfFixedHH.fixingSubgroup.Normal :=
  Subgroup.normal_of_commutator_le H.commutator_le_fixingSubgroup_LinfFixedHH

instance isGalois_K_LinfFixedHH : IsGalois K ↥H.LinfFixedHH :=
  (InfiniteGalois.normal_iff_isGalois H.LinfFixedHH).1 inferInstance

/-- `Gal(L∞^H/K)` is abelian: `H` contains the commutator subgroup of `G`. -/
theorem mul_comm_gal_K_LinfFixedHH (σ τ : Gal(↥H.LinfFixedHH/K)) : σ * τ = τ * σ := by
  obtain ⟨σ', rfl⟩ := AlgEquiv.restrictNormalHom_surjective
    (F := K) (E := ↥(H.Linf.restrictScalars K)) (K₁ := ↥H.LinfFixedHH) σ
  obtain ⟨τ', rfl⟩ := AlgEquiv.restrictNormalHom_surjective
    (F := K) (E := ↥(H.Linf.restrictScalars K)) (K₁ := ↥H.LinfFixedHH) τ
  rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement]
  have hmem : ⁅σ', τ'⁆ ∈ H.LinfFixedHH.fixingSubgroup :=
    H.commutator_le_fixingSubgroup_LinfFixedHH
      (Subgroup.commutator_mem_commutator (Subgroup.mem_top σ') (Subgroup.mem_top τ'))
  rwa [← H.LinfFixedHH.restrictNormalHom_ker, MonoidHom.mem_ker] at hmem

instance isAbelianGalois_K_LinfFixedHH : IsAbelianGalois K ↥H.LinfFixedHH where
  is_comm := ⟨H.mul_comm_gal_K_LinfFixedHH⟩

instance isUnramifiedEverywhere_K_LinfFixedHH :
    NumberField.IsUnramifiedEverywhere K ↥H.LinfFixedHH :=
  AbsoluteValue.isUnramifiedEverywhere_of_inertiaSubgroup_le_fixingSubgroup K H.LinfFixedHH
    fun w ↦ le_trans (H.inertiaSubgroup_le_HH w) H.HH_le_fixingSubgroup_LinfFixedHH

instance isSExtension_K_LinfFixedHH : IsSExtension K ↥H.LinfFixedHH {p} :=
  IsSExtension.tower_bot (F := K) (K := ↥H.LinfFixedHH) (S := {p})
    ↥(H.Linf.restrictScalars K)

/-! ### `L∞^H ⊆ L₀` -/

/-- `L∞^H`, viewed as an intermediate field of the separable closure of `K∞` over `K`. -/
noncomputable def LinfFixedHHLift : IntermediateField K (SeparableClosure Kinf) :=
  IntermediateField.lift H.LinfFixedHH

instance isAbelianGalois_K_LinfFixedHHLift : IsAbelianGalois K ↥H.LinfFixedHHLift :=
  .of_algEquiv (IntermediateField.liftAlgEquiv _)

instance isSExtension_K_LinfFixedHHLift : IsSExtension K ↥H.LinfFixedHHLift {p} :=
  .of_algEquiv {p} (IntermediateField.liftAlgEquiv _)

instance isUnramifiedEverywhere_K_LinfFixedHHLift :
    NumberField.IsUnramifiedEverywhere K ↥H.LinfFixedHHLift :=
  .of_algEquiv (IntermediateField.liftAlgEquiv _)

/-- `L∞^H ⊆ L₀`, inside the separable closure of `K∞`: `L∞^H / K` is an unramified abelian
`p`-extension, and `L₀` is the largest one. -/
theorem coe_LinfFixedHHLift_subset_coe_Ln_zero :
    (H.LinfFixedHHLift : Set (SeparableClosure Kinf)) ⊆
      (H.Ln 0 : Set (SeparableClosure Kinf)) := fun _x hx ↦
  IntermediateField.adjoin_le_lift_maximalGaloisSExtension_of_ringHom
    (algebraMap K ↥(H.Kn 0)) (fun y ↦ IsScalarTower.algebraMap_apply K ↥(H.Kn 0) _ y)
    H.LinfFixedHHLift (IntermediateField.subset_adjoin _ _ hx)

/-- **`L∞^H ⊆ L₀`**: the maximality half of `L₀ = L∞^H` in Step 1 of Washington's Lemma
13.15. -/
theorem LinfFixedHH_le_L0In : H.LinfFixedHH ≤ H.L0In := fun x hx ↦ by
  rw [L0In, IntermediateField.mem_restrict, IntermediateField.mem_restrictScalars]
  exact H.coe_LinfFixedHHLift_subset_coe_Ln_zero ((IntermediateField.mem_lift x).2 hx)

/-- **`L₀ = L∞^H`**: Step 1 of Washington's Lemma 13.15, both containments. -/
theorem LinfFixedHH_eq_L0In : H.LinfFixedHH = H.L0In :=
  le_antisymm H.LinfFixedHH_le_L0In
    ((IntermediateField.le_iff_le (H := H.HH) (K := H.L0In)).2 H.HH_le_fixingSubgroup_L0In)

/-- `Gal(L∞/L₀) = Gal(L∞/L∞^H)`. -/
theorem fixingSubgroup_L0In_eq : H.L0In.fixingSubgroup = H.LinfFixedHH.fixingSubgroup := by
  rw [H.LinfFixedHH_eq_L0In]

/-- **`X₀ = G / H`** (with `H` replaced by its fixing subgroup, which is its closure):
`Gal(L₀/K)` is the quotient of `G` by `Gal(L∞/L∞^H)`. -/
noncomputable def galL0InMulEquivQuotient :
    H.GG ⧸ H.LinfFixedHH.fixingSubgroup ≃* Gal(↥H.L0In/K) :=
  (QuotientGroup.quotientMulEquivOfEq (H.fixingSubgroup_L0In_eq.symm.trans
    (H.L0In.restrictNormalHom_ker).symm)).trans
      (QuotientGroup.quotientKerEquivOfSurjective _
        (AlgEquiv.restrictNormalHom_surjective (F := K)
          (E := ↥(H.Linf.restrictScalars K)) (K₁ := ↥H.L0In)))

end MvZpExtension
