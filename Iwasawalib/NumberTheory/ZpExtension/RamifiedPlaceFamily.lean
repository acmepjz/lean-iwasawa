module

public import Iwasawalib.NumberTheory.ZpExtension.BasePrimeRamification
public import Iwasawalib.NumberTheory.ZpExtension.YnShiftTransport

@[expose] public section

/-!
# The family of ramified places of `K∞` and the inertia cover over `K_n`

Washington, *Introduction to cyclotomic fields*, Lemma 13.15 (blueprint node
`Xn-isom-qout-of-totally-ramified`), Step 2, applies Step 1 to `K∞ / K_n` "with the same
places": the primes of `K_n` which ramify in `K∞ / K_n`, one place of `L∞` above each.  This
file provides that family once and for all, as a family of places of `K∞` which does not depend
on `n`, and the resulting description of `H = closure ⟨G', inertia⟩` at the shifted extension
`H.shift n` (before taking closures).

Let `D : RamifiedBasePlaceData H` be a finite package of ramified base primes with one ramified
place `D.place q` of `K∞` above each, and let `e` be such that `Γ^{p^e}` is contained in the
inertia subgroup of every `D.place q`.  The family is indexed by
`D.base × (Γ ⧸ Γ^{p^e})`, and the place with index `(q, c)` is `D.place q` precomposed with a
representative of the coset `c`.  Up to equivalence of absolute values these are *all* places
of `K∞` with nontrivial inertia in `K∞ / K`.

## Main statements

* `MvZpExtension.inertiaSubgroup_comp_Γ_eq`: precomposing a place of `K∞` with an element of
  `Γ` does not change its inertia subgroup in `Γ`.
* `MvZpExtension.comp_eq_self_of_Γpow_le`: an element of `Γ^{p^e}` fixes every place whose
  inertia subgroup contains `Γ^{p^e}`.
* `MvZpExtension.RamifiedBasePlaceData.orbitPlace`: the family of places.
* `MvZpExtension.RamifiedBasePlaceData.finite_orbitIndex`: its index type is finite.
* `MvZpExtension.RamifiedBasePlaceData.Γpow_le_inertiaSubgroup_orbitPlace`: every member of the
  family has inertia subgroup containing `Γ^{p^e}`.
* `MvZpExtension.RamifiedBasePlaceData.exists_isEquiv_orbitPlace`: every place of `K∞` with
  nontrivial inertia is equivalent to a member of the family.
* `MvZpExtension.RamifiedBasePlaceData.nonempty_orbitIndex`: the index type is nonempty
  (conditional, see below).
* `MvZpExtension.inertiaSubgroup_Kn_placeBelow_shiftPlaceEquiv_symm_eq_top`: for `n ≥ e`, a
  place of `L∞` above a member of the family, viewed as a place of the shifted extension, lies
  over a place of `K∞` which is totally ramified in `K∞ / K_n`.
* `MvZpExtension.HH_shift_eq_commutator_sup_iSup`: at `H.shift n`, the subgroup `HH` is
  generated by the commutator subgroup and the inertia subgroups of the selected places.

## Conditionality

`MvZpExtension.RamifiedBasePlaceData.nonempty_orbitIndex` is **not** unconditional: it uses
`MvZpExtension.exists_inertiaSubgroup_ne_bot`, which depends on the `sorry`
`NumberField.IsUnramifiedEverywhere.surjective_artinMap`.  Every other declaration of this file
is unconditional.
-/

open PowerSeries NumberField IsDedekindDomain
open scoped Pointwise commutatorElement

namespace MvZpExtension

variable {p : ℕ} [Fact p.Prime] {ι K Kinf : Type*} [Finite ι]
variable [Field K] [NumberField K] [Field Kinf] [Algebra K Kinf] [IsGalois K Kinf]
variable (H : MvZpExtension p ι K Kinf)

/-! ### Translating a place by an element of `Γ` -/

/-- For a place `v` of `K∞` and `τ ∈ Γ = Gal(K∞/K)`, the inertia subgroup in `Γ` of the
translated place `x ↦ v (τ x)` is equal to the inertia subgroup of `v`.  (In general it is a
conjugate; `Γ` is abelian.) -/
theorem inertiaSubgroup_comp_Γ_eq (v : AbsoluteValue Kinf ℝ) (τ : H.Γ) :
    (v.comp (f := (τ : Kinf →+* Kinf)) τ.injective).inertiaSubgroup K = v.inertiaSubgroup K := by
  haveI := H.isAbelianGalois_Kinf
  rw [AbsoluteValue.inertiaSubgroup_comp_algEquiv_eq_smul]
  ext σ
  rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, inv_inv, MulAut.smul_def, MulAut.conj_apply]
  have h : τ * σ * τ⁻¹ = σ := by
    rw [IsMulCommutative.is_comm.comm τ σ, mul_inv_cancel_right]
  rw [h]

/-- If the inertia subgroup in `Γ` of a place `v` of `K∞` contains `Γ^{p^e}`, then every
`τ ∈ Γ^{p^e}` fixes `v`: the translated place `x ↦ v (τ x)` is equal to `v`, as absolute
values (not only up to equivalence). -/
theorem comp_eq_self_of_Γpow_le {v : AbsoluteValue Kinf ℝ} {e : ℕ}
    (hv : (H.Γpow e : Subgroup H.Γ) ≤ v.inertiaSubgroup K) {τ : H.Γ} (hτ : τ ∈ H.Γpow e) :
    v.comp (f := (τ : Kinf →+* Kinf)) τ.injective = v := by
  ext x
  exact v.apply_eq_of_mem_decompositionSubgroup
    (v.inertiaSubgroup_le_decompositionSubgroup K (hv hτ)) x

/-! ### The family -/

/-- The family of places of `K∞` attached to a package `D` of ramified base primes and a level
`e`.  It is indexed by pairs `(q, c)` of a selected base prime `q : D.base` and a coset
`c ∈ Γ ⧸ Γ^{p^e}`; the place with index `(q, c)` is `x ↦ D.place q (τ x)`, where
`τ = Quotient.out c` is the chosen representative of `c`.

No hypothesis on `e` is part of the definition.  When `Γ^{p^e}` is contained in the inertia
subgroup of every `D.place q`, the place does not depend on the representative
(`MvZpExtension.comp_eq_self_of_Γpow_le`) and the family consists of all places of `K∞` with
nontrivial inertia in `K∞ / K`, up to equivalence
(`MvZpExtension.RamifiedBasePlaceData.exists_isEquiv_orbitPlace`).  Two different indices may
give the same place: the family is not claimed to be injective. -/
noncomputable def RamifiedBasePlaceData.orbitPlace (D : RamifiedBasePlaceData H) (e : ℕ)
    (j : D.base × (H.Γ ⧸ (H.Γpow e : Subgroup H.Γ))) : AbsoluteValue Kinf ℝ :=
  (D.place j.1).comp (f := ((Quotient.out j.2 : H.Γ) : Kinf →+* Kinf)) (Quotient.out j.2).injective

/-- In the `ℤₚ`-case the index type `D.base × (Γ ⧸ Γ^{p^e})` of
`MvZpExtension.RamifiedBasePlaceData.orbitPlace` is finite, for every `e`. -/
instance RamifiedBasePlaceData.finite_orbitIndex [Unique ι] (D : RamifiedBasePlaceData H)
    (e : ℕ) : Finite (D.base × (H.Γ ⧸ (H.Γpow e : Subgroup H.Γ))) := by
  haveI : (H.Γpow e : Subgroup H.Γ).FiniteIndex :=
    ⟨by rw [H.index_Γpow₁ e]; exact pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
  haveI : Finite (H.Γ ⧸ (H.Γpow e : Subgroup H.Γ)) := Subgroup.finite_quotient_of_finiteIndex
  infer_instance

/-- If `Γ^{p^e}` is contained in the inertia subgroup of every selected place `D.place q`, then
it is contained in the inertia subgroup (in `Γ`) of every member of the family
`MvZpExtension.RamifiedBasePlaceData.orbitPlace`. -/
theorem RamifiedBasePlaceData.Γpow_le_inertiaSubgroup_orbitPlace [Unique ι]
    (D : RamifiedBasePlaceData H) {e : ℕ}
    (he : ∀ q : D.base, (H.Γpow e : Subgroup H.Γ) ≤ (D.place q).inertiaSubgroup K)
    (j : D.base × (H.Γ ⧸ (H.Γpow e : Subgroup H.Γ))) :
    (H.Γpow e : Subgroup H.Γ) ≤ (RamifiedBasePlaceData.orbitPlace H D e j).inertiaSubgroup K := by
  rw [RamifiedBasePlaceData.orbitPlace, inertiaSubgroup_comp_Γ_eq]
  exact he j.1

/-- If `Γ^{p^e}` is contained in the inertia subgroup of every selected place `D.place q`, then
every place `w` of `K∞` with nontrivial inertia subgroup in `Γ` is equivalent, as an absolute
value of `K∞`, to a member of the family
`MvZpExtension.RamifiedBasePlaceData.orbitPlace`. -/
theorem RamifiedBasePlaceData.exists_isEquiv_orbitPlace [Unique ι]
    (D : RamifiedBasePlaceData H) {e : ℕ}
    (he : ∀ q : D.base, (H.Γpow e : Subgroup H.Γ) ≤ (D.place q).inertiaSubgroup K)
    (w : AbsoluteValue Kinf ℝ) (hw : w.inertiaSubgroup K ≠ ⊥) :
    ∃ j, w.IsEquiv (RamifiedBasePlaceData.orbitPlace H D e j) := by
  haveI := H.isAbelianGalois_Kinf
  obtain ⟨q, hq⟩ := D.covers w hw
  have hcomp : ((D.place q).comp (algebraMap K Kinf).injective).IsEquiv
      (w.comp (algebraMap K Kinf).injective) := by
    rw [D.comp_eq_adicAbv q]
    exact hq.symm
  obtain ⟨τ, hτ⟩ := H.exists_Γ_conjugating_of_comp_equiv hcomp
  refine ⟨(q, QuotientGroup.mk τ), ?_⟩
  obtain ⟨h, hh⟩ := QuotientGroup.mk_out_eq_mul (H.Γpow e : Subgroup H.Γ) τ
  have hfix := H.comp_eq_self_of_Γpow_le (he q) h.2
  have key : RamifiedBasePlaceData.orbitPlace H D e (q, QuotientGroup.mk τ) =
      (D.place q).comp (f := (τ : Kinf →+* Kinf)) τ.injective := by
    ext x
    have h1 : (Quotient.out (QuotientGroup.mk τ : H.Γ ⧸ (H.Γpow e : Subgroup H.Γ)) : H.Γ) x =
        (h : H.Γ) (τ x) := by
      rw [hh, IsMulCommutative.is_comm.comm τ (h : H.Γ)]
      rfl
    have h2 := congrArg (fun u : AbsoluteValue Kinf ℝ ↦ u (τ x)) hfix
    change D.place q ((Quotient.out (QuotientGroup.mk τ :
      H.Γ ⧸ (H.Γpow e : Subgroup H.Γ)) : H.Γ) x) = D.place q (τ x)
    rw [h1]
    exact h2
  rw [key]
  exact hτ.symm

/-- **The family of ramified places is nonempty**: in the `ℤₚ`-case, for every package `D` of
ramified base primes and every `e`, the index type `D.base × (Γ ⧸ Γ^{p^e})` has an element.
Equivalently, `D.base` is nonempty.

**Warning**: this declaration is *not* unconditional.  Its only route in this repository is
`MvZpExtension.exists_inertiaSubgroup_ne_bot` (at least one place ramifies in `K∞ / K`), which
is derived from `NumberField.IsUnramifiedEverywhere.finiteDimensional`, which is derived from
`NumberField.IsUnramifiedEverywhere.surjective_artinMap`, which is `sorry`.  So this theorem
depends on `sorryAx`, and so does everything below it that does not take the conclusion as a
hypothesis. -/
theorem RamifiedBasePlaceData.nonempty_orbitIndex [Unique ι] (D : RamifiedBasePlaceData H)
    (e : ℕ) : Nonempty (D.base × (H.Γ ⧸ (H.Γpow e : Subgroup H.Γ))) := by
  obtain ⟨w, hw⟩ := H.exists_inertiaSubgroup_ne_bot
  obtain ⟨q, -⟩ := D.covers w hw
  exact ⟨(q, QuotientGroup.mk 1)⟩

/-! ### The cover at the shifted extension -/

/-- Let `w` be a place of `L∞` such that the inertia subgroup in `Γ` of the place of `K∞` below
`w` contains `Γ^{p^e}`, and let `n ≥ e`.  View `w` as a place of the field `L∞` of the shifted
extension `H.shift n` (base field `K_n`).  Then the place of `K∞` below it is totally ramified
in `K∞ / K_n`: its inertia subgroup in `Gal(K∞/K_n)` is everything. -/
theorem inertiaSubgroup_Kn_placeBelow_shiftPlaceEquiv_symm_eq_top [Unique ι] {e n : ℕ}
    (hen : e ≤ n) (w : AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ)
    (hw : (H.Γpow e : Subgroup H.Γ) ≤ (H.placeBelow w).inertiaSubgroup K) :
    ((H.shift n).placeBelow ((H.shiftPlaceEquiv n).symm w)).inertiaSubgroup ↥(H.Kn n) = ⊤ := by
  rw [placeBelow_shiftPlaceEquiv, Equiv.apply_symm_apply]
  exact (H.inertiaSubgroup_Kn_eq_top_iff n _).2 (H.Γpow_le_of_le hen hw)

/-- **The inertia cover over `K_n`.**  Let `v` be a family of places of `K∞` such that every
place of `K∞` with nontrivial inertia in `K∞ / K` is equivalent to some `v j`, and let
`selected j` be a place of `L∞` above `v j`.  Then, for every `n`, the subgroup `HH` of
`Gal(L∞/K_n)` attached to the shifted extension `H.shift n` (generated by the commutator
subgroup and the inertia subgroups at all places of `L∞`) is generated by the commutator
subgroup and the inertia subgroups in `Gal(L∞/K_n)` of the places `selected j`.

No finiteness of the index type and no relation between `n` and the family are assumed. -/
theorem HH_shift_eq_commutator_sup_iSup {s : Type*} (v : s → AbsoluteValue Kinf ℝ) (n : ℕ)
    (hcover : ∀ u : AbsoluteValue Kinf ℝ, u.inertiaSubgroup K ≠ ⊥ → ∃ j, u.IsEquiv (v j))
    (selected : s → AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ)
    (hsel : ∀ j, H.placeBelow (selected j) = v j) :
    (H.shift n).HH = commutator (H.shift n).GG ⊔
      ⨆ j, ((H.shiftPlaceEquiv n).symm (selected j)).inertiaSubgroup ↥(H.Kn n) := by
  apply le_antisymm
  · rw [MvZpExtension.HH]
    refine sup_le le_sup_left (iSup_le fun w' ↦ ?_)
    by_cases h : ((H.shift n).placeBelow w').inertiaSubgroup ↥(H.Kn n) = ⊥
    · rw [(H.shift n).inertiaSubgroup_eq_bot_of_placeBelow_inertiaSubgroup_eq_bot w' h]
      exact bot_le
    · have hK : ((H.shift n).placeBelow w').inertiaSubgroup K ≠ ⊥ := by
        intro hbot
        apply h
        have hle := AbsoluteValue.map_inertiaSubgroup_le K ↥(H.Kn n)
          ((H.shift n).placeBelow w')
        rw [hbot, le_bot_iff] at hle
        exact (Subgroup.map_eq_bot_iff_of_injective _
          (IntermediateField.restrictRestrictAlgEquivMapHom_injective_of_tower_top
            K ↥(H.Kn n) Kinf)).1 hle
      obtain ⟨j, hj⟩ := hcover _ hK
      have hbelow : (H.shift n).placeBelow ((H.shiftPlaceEquiv n).symm (selected j)) = v j := by
        rw [placeBelow_shiftPlaceEquiv, Equiv.apply_symm_apply, hsel]
      have hcomp :
          (((H.shift n).placeBelow ((H.shiftPlaceEquiv n).symm (selected j))).comp
            (algebraMap ↥(H.Kn n) Kinf).injective).IsEquiv
          (((H.shift n).placeBelow w').comp (algebraMap ↥(H.Kn n) Kinf).injective) := by
        rw [hbelow]
        exact hj.symm.comp _
      obtain ⟨τ, hτ⟩ := (H.shift n).exists_GG_conjugating_places_of_comp_equiv
        ((H.shiftPlaceEquiv n).symm (selected j)) w' hcomp
      exact le_trans ((H.shift n).inertiaSubgroup_le_commutator_sup_of_conjugate_equiv τ hτ)
        (sup_le_sup_left (le_iSup (fun u : s ↦
          ((H.shiftPlaceEquiv n).symm (selected u)).inertiaSubgroup ↥(H.Kn n)) j) _)
  · refine sup_le ?_ (iSup_le fun j ↦ ?_)
    · exact (H.shift n).commutator_le_HH
    · have hle := (H.shift n).inertiaSubgroup_le_HH ((H.shiftPlaceEquiv n).symm (selected j))
      refine le_of_eq_of_le ?_ hle
      congr 1

end MvZpExtension
