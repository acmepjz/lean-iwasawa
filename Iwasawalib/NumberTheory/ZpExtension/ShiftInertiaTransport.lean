@[expose] public section

/-!
# The shift dictionary: inertia subgroups, the map to `Γ`, and topological generators

Washington, *Introduction to cyclotomic fields*, Lemma 13.15 (blueprint node
`Xn-isom-qout-of-totally-ramified`), Step 2, applies Step 1 to the extension `K∞ / K_n`, whose
Galois group `Γ^{p^n}` has topological generator `γ^{p^n}`, "with the same places", whose
inertia subgroups in `Gal(L∞/K_n)` are `I ∩ Gal(L∞/K_n)`.  In this repository the extension
`K∞ / K_n` is `H.shift n`, its ambient group `(H.shift n).GG` is a different type from
`H.GG = Gal(L∞/K)`, and the two are related by the injective restriction map
`MvZpExtension.ggShiftRestrictHom`.  This file records what that map does to inertia
subgroups, to the projection to `Γ`, to topological generators of the quotient by `X∞`, and
to the subgroup `(γ - 1) X∞`.

## Main statements

* `IntermediateField.Internal.coe_equivOfEq_apply`,
  `IntermediateField.Internal.coe_restrictScalarsAutEquiv_autCongr_equivOfEq_apply`: transport
  along an equality of intermediate fields does not change underlying elements.
* `Subgroup.dense_zpowers_map_continuousMulEquiv`: an isomorphism of topological groups maps
  a topological generator to a topological generator.
* `MvZpExtension.Internal.coe_shiftLinfRingEquiv_apply`,
  `MvZpExtension.Internal.coe_ggShiftRestrictHom_apply_shiftLinfRingEquiv`: the restriction map
  acts on elements of `L∞` as the original automorphism does.
* `MvZpExtension.mem_inertiaSubgroup_shift_iff`: an element of `Gal(L∞/K_n)` lies in the
  inertia subgroup of a place of `L∞` if and only if its image in `Gal(L∞/K)` does.
* `MvZpExtension.restrictScalarsGalHom_toGamma_shift`: the restriction map is compatible with
  the projections to `Gal(K∞/K_n)` and `Gal(K∞/K)`.
* `MvZpExtension.coe_xinfShiftMulEquiv_apply`,
  `MvZpExtension.mk_ggShiftRestrictHom_eq_of_mk_eq`: compatibility with `X∞`.
* `MvZpExtension.dense_zpowers_mk_shift_of_mk_eq_pow`: an element of `Gal(L∞/K_n)` whose image
  in `Γ` is `γ^{p^n}` is a topological generator modulo `X∞`.
* `MvZpExtension.map_gammaSubOne_xinfShiftMulEquiv`: `(γ' - 1) X∞` is carried to
  `(γ - 1) X∞`, for `γ` the image of `γ'`.

## Conditionality

Every declaration of this file is unconditional: none of them uses class field theory.
-/

open IntermediateField Module NumberField
open scoped Pointwise commutatorElement

/-! ### Transport along an equality of intermediate fields -/

namespace IntermediateField.Internal

variable {A B L : Type*} [Field A] [Field B] [Field L]
variable [Algebra A B] [Algebra B L] [Algebra A L] [IsScalarTower A B L]

/-- For equal intermediate fields `E = E'` of `L / B`, the identification `E ≃ E'` does not
change the underlying element of `L`. -/
theorem coe_equivOfEq_apply {E E' : IntermediateField B L} (h : E = E') (x : ↥E) :
    ((IntermediateField.equivOfEq h x : ↥E') : L) = (x : L) := by
  subst h
  rfl

/-- For equal intermediate fields `E = E'` of `L / B` and a subfield `A` of `B`: let `σ` be an
`A`-automorphism of `E`, and let `σ'` be the `A`-automorphism of `E'` obtained from `σ` by
transport along `E = E'`.  Then for every `x ∈ E`, the element `σ' x` (where `x` is viewed in
`E'`) and the element `σ x` are the same element of `L`. -/
theorem coe_restrictScalarsAutEquiv_autCongr_equivOfEq_apply
    {E E' : IntermediateField B L} (h : E = E')
    (σ : Gal(↥(E.restrictScalars A)/A)) (x : ↥(E.restrictScalars A)) :
    ((IntermediateField.restrictScalarsAutEquiv A E'
        (AlgEquiv.autCongr (IntermediateField.equivOfEq
          (congrArg (IntermediateField.restrictScalars A) h)) σ)
        (IntermediateField.equivOfEq h x) : ↥E') : L) =
      ((σ x : ↥(E.restrictScalars A)) : L) := by
  subst h
  rfl

end IntermediateField.Internal

/-! ### Topological generators and isomorphisms of topological groups -/

/-- An isomorphism `e : A ≃ₜ* B` of topological groups maps a topological generator to a
topological generator: if the subgroup generated by `a` is dense in `A`, then the subgroup
generated by `e a` is dense in `B`. -/
theorem Subgroup.dense_zpowers_map_continuousMulEquiv {A B : Type*} [Group A] [Group B]
    [TopologicalSpace A] [TopologicalSpace B] (e : A ≃ₜ* B) {a : A}
    (ha : Dense (Subgroup.zpowers a : Set A)) :
    Dense (Subgroup.zpowers (e a) : Set B) := by
  have himg : (Subgroup.zpowers (e a) : Set B) = e '' (Subgroup.zpowers a : Set A) := by
    have hmap : (Subgroup.zpowers a).map ((e : A ≃* B) : A →* B) = Subgroup.zpowers (e a) :=
      MonoidHom.map_zpowers _ _
    rw [← hmap, Subgroup.coe_map]
    rfl
  rw [himg]
  exact e.surjective.denseRange.dense_image e.continuous ha

namespace MvZpExtension

variable {p : ℕ} [Fact p.Prime] {ι K Kinf : Type*} [Finite ι]
variable [Field K] [NumberField K] [Field Kinf] [Algebra K Kinf] [IsGalois K Kinf]
variable (H : MvZpExtension p ι K Kinf)

/-! ### The restriction map on elements of `L∞` -/

/-- The identification of the field `L∞` of the shifted extension `H.shift n` with the field
`L∞` of `H` does not change the underlying element of the separable closure of `K∞`. -/
theorem Internal.coe_shiftLinfRingEquiv_apply (n : ℕ)
    (x : ↥((H.shift n).Linf.restrictScalars ↥(H.Kn n))) :
    ((Internal.shiftLinfRingEquiv (H := H) n x : ↥(H.Linf.restrictScalars K)) :
        SeparableClosure Kinf) = (x : SeparableClosure Kinf) :=
  IntermediateField.Internal.coe_equivOfEq_apply (B := Kinf)
    (L := SeparableClosure Kinf) (H.Linf_shift n) x

/-- The image of `σ ∈ Gal(L∞/K_n)` under the restriction map acts on an element of `L∞` as
the `K_n`-automorphism `MvZpExtension.Internal.ggShiftToLinfMulEquiv n σ` of `L∞` does.  The
element is given twice, as `y` and as `y'`, so that no transport has to be unfolded. -/
private theorem Internal.coe_ggShiftRestrictHom_apply_eq_ggShiftToLinfMulEquiv (n : ℕ)
    (σ : (H.shift n).GG) (y : ↥(H.Linf.restrictScalars K)) (y' : ↥H.Linf)
    (hy : (y' : SeparableClosure Kinf) = (y : SeparableClosure Kinf)) :
    ((H.ggShiftRestrictHom n σ y : ↥(H.Linf.restrictScalars K)) : SeparableClosure Kinf) =
      ((Internal.ggShiftToLinfMulEquiv (H := H) n σ y' : ↥H.Linf) :
        SeparableClosure Kinf) := by
  obtain rfl : y' = ⟨y.1, y.2⟩ := Subtype.ext hy
  rw [← IntermediateField.coe_restrictScalarsAutEquiv_apply (K := K) (E := H.Linf)
    (H.ggShiftRestrictHom n σ) y,
    Internal.restrictScalarsAutEquiv_ggShiftRestrictHom (H := H) n σ]
  rfl

/-- For `σ ∈ Gal(L∞/K_n)` (the ambient group of the shifted extension `H.shift n`) and `x` in
the field `L∞` of the shifted extension: the image of `σ` in `Gal(L∞/K)` under the restriction
map, applied to `x` viewed in the field `L∞` of `H`, is the same element of the separable
closure of `K∞` as `σ x`. -/
theorem Internal.coe_ggShiftRestrictHom_apply_shiftLinfRingEquiv (n : ℕ) (σ : (H.shift n).GG)
    (x : ↥((H.shift n).Linf.restrictScalars ↥(H.Kn n))) :
    ((H.ggShiftRestrictHom n σ (Internal.shiftLinfRingEquiv (H := H) n x) :
        ↥(H.Linf.restrictScalars K)) : SeparableClosure Kinf) =
      ((σ x : ↥((H.shift n).Linf.restrictScalars ↥(H.Kn n))) : SeparableClosure Kinf) := by
  have hy : ((IntermediateField.equivOfEq (H.Linf_shift n) x : ↥H.Linf) :
      SeparableClosure Kinf) =
      ((Internal.shiftLinfRingEquiv (H := H) n x : ↥(H.Linf.restrictScalars K)) :
        SeparableClosure Kinf) :=
    (IntermediateField.Internal.coe_equivOfEq_apply (B := Kinf)
      (L := SeparableClosure Kinf) (H.Linf_shift n) x).trans
      (Internal.coe_shiftLinfRingEquiv_apply H n x).symm
  exact (Internal.coe_ggShiftRestrictHom_apply_eq_ggShiftToLinfMulEquiv H n σ _ _ hy).trans
    (IntermediateField.Internal.coe_restrictScalarsAutEquiv_autCongr_equivOfEq_apply
      (A := ↥(H.Kn n)) (B := Kinf) (L := SeparableClosure Kinf) (H.Linf_shift n) σ x)

/-! ### Inertia subgroups -/

/-- Let `w` be a place of `L∞` and `σ ∈ Gal(L∞/K_n)` (the ambient group of the shifted
extension `H.shift n`).  Then `σ` lies in the inertia subgroup in `Gal(L∞/K_n)` of `w` (viewed
as a place of the field `L∞` of the shifted extension) if and only if the image of `σ` in
`Gal(L∞/K)` lies in the inertia subgroup of `w` in `Gal(L∞/K)`.  In other words, the inertia
subgroup over `K_n` is the intersection of the inertia subgroup over `K` with
`Gal(L∞/K_n)`. -/
theorem mem_inertiaSubgroup_shift_iff (n : ℕ) (σ : (H.shift n).GG)
    (w : AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ) :
    σ ∈ ((H.shiftPlaceEquiv n).symm w).inertiaSubgroup ↥(H.Kn n) ↔
      H.ggShiftRestrictHom n σ ∈ w.inertiaSubgroup K := by
  have hw' (y : ↥((H.shift n).Linf.restrictScalars ↥(H.Kn n))) :
      (H.shiftPlaceEquiv n).symm w y = w (Internal.shiftLinfRingEquiv (H := H) n y) := rfl
  have hkey (y : ↥((H.shift n).Linf.restrictScalars ↥(H.Kn n))) :
      H.ggShiftRestrictHom n σ (Internal.shiftLinfRingEquiv (H := H) n y) =
        Internal.shiftLinfRingEquiv (H := H) n (σ y) :=
    Subtype.ext ((Internal.coe_ggShiftRestrictHom_apply_shiftLinfRingEquiv H n σ y).trans
      (Internal.coe_shiftLinfRingEquiv_apply H n (σ y)).symm)
  have hsurj := (Internal.shiftLinfRingEquiv (H := H) n).surjective
  have hna : IsNonarchimedean ((H.shiftPlaceEquiv n).symm w) ↔ IsNonarchimedean w := by
    constructor
    · intro h a b
      obtain ⟨a, rfl⟩ := hsurj a
      obtain ⟨b, rfl⟩ := hsurj b
      rw [← map_add, ← hw', ← hw', ← hw']
      exact h a b
    · intro h a b
      rw [hw', hw', hw', map_add]
      exact h _ _
  refine Iff.trans (AbsoluteValue.mem_inertiaSubgroup_iff _ _) (Iff.trans ?_
    (AbsoluteValue.mem_inertiaSubgroup_iff _ _).symm)
  refine and_congr (Iff.trans (AbsoluteValue.mem_decompositionSubgroup_iff_forall_apply_eq _ _)
    (Iff.trans ?_ (AbsoluteValue.mem_decompositionSubgroup_iff_forall_apply_eq _ _).symm))
    (or_congr hna.not ?_)
  · constructor
    · intro h z
      obtain ⟨y, rfl⟩ := hsurj z
      exact (congrArg w (hkey y)).trans (h y)
    · intro h y
      exact (congrArg w (hkey y)).symm.trans
        (h (Internal.shiftLinfRingEquiv (H := H) n y))
  · constructor
    · intro h z hz
      obtain ⟨y, rfl⟩ := hsurj z
      refine lt_of_eq_of_lt (Eq.trans (congrArg w ?_) (hw' _).symm) (h y hz)
      exact (congrArg (· - Internal.shiftLinfRingEquiv (H := H) n y) (hkey y)).trans
        (map_sub (Internal.shiftLinfRingEquiv (H := H) n) _ _).symm
    · intro h y hy
      refine lt_of_eq_of_lt (Eq.trans (hw' _) (congrArg w ?_))
        (h (Internal.shiftLinfRingEquiv (H := H) n y) hy)
      exact (map_sub (Internal.shiftLinfRingEquiv (H := H) n) _ _).trans
        (congrArg (· - Internal.shiftLinfRingEquiv (H := H) n y) (hkey y)).symm

/-! ### The projection to `Γ` -/

/-- For `σ ∈ Gal(L∞/K)`, `x ∈ K∞` and `y ∈ L∞` the same element as `x`: the image of `σ` in
`Γ` applied to `x` is, as an element of the separable closure of `K∞`, the element `σ y`. -/
private theorem Internal.algebraMap_toGamma_apply_eq (σ : H.GG) (x : Kinf)
    (y : ↥(H.Linf.restrictScalars K))
    (hy : (y : SeparableClosure Kinf) = algebraMap Kinf (SeparableClosure Kinf) x) :
    (algebraMap Kinf (SeparableClosure Kinf) (H.toGamma σ x)) =
      ((σ y : ↥(H.Linf.restrictScalars K)) : SeparableClosure Kinf) := by
  obtain rfl : y = ⟨algebraMap Kinf (SeparableClosure Kinf) x,
      (algebraMap Kinf ↥H.Linf x).2⟩ := Subtype.ext hy
  rw [Internal.toGamma_action_in_Linf (H := H) σ x]
  rfl

/-- For `σ ∈ Gal(L∞/K_n)`, restricting `σ` to `K∞` and then viewing the result in
`Γ = Gal(K∞/K)` gives the same element as first mapping `σ` to `Gal(L∞/K)` and then
restricting to `K∞`. -/
theorem restrictScalarsGalHom_toGamma_shift (n : ℕ) (σ : (H.shift n).GG) :
    H.restrictScalarsGalHom n ((H.shift n).toGamma σ) = H.toGamma (H.ggShiftRestrictHom n σ) := by
  apply AlgEquiv.ext
  intro x
  apply (algebraMap Kinf (SeparableClosure Kinf)).injective
  rw [IntermediateField.restrictScalarsGalHom_apply]
  obtain ⟨x', hx'⟩ : ∃ x' : ↥((H.shift n).Linf.restrictScalars ↥(H.Kn n)),
      (x' : SeparableClosure Kinf) = algebraMap Kinf (SeparableClosure Kinf) x :=
    ⟨⟨algebraMap Kinf (SeparableClosure Kinf) x, (algebraMap Kinf ↥(H.shift n).Linf x).2⟩, rfl⟩
  rw [Internal.algebraMap_toGamma_apply_eq (H.shift n) σ x x' hx',
    Internal.algebraMap_toGamma_apply_eq H (H.ggShiftRestrictHom n σ) x
      (Internal.shiftLinfRingEquiv (H := H) n x')
      ((Internal.coe_shiftLinfRingEquiv_apply H n x').trans hx')]
  exact (Internal.coe_ggShiftRestrictHom_apply_shiftLinfRingEquiv H n σ x').symm

/-! ### Compatibility with `X∞` -/

/-- The identification `MvZpExtension.xinfShiftMulEquiv` of the group `X∞` of the shifted
extension with the group `X∞` of `H` is the restriction map `Gal(L∞/K_n) → Gal(L∞/K)` on
underlying elements.  This restates
`MvZpExtension.Internal.coe_xinfShiftMulEquiv_eq_ggShiftRestrictHom` with `H` explicit. -/
theorem coe_xinfShiftMulEquiv_apply (n : ℕ) (x : ↥(H.shift n).Xinf) :
    ((H.xinfShiftMulEquiv n x : ↥H.Xinf) : H.GG) = H.ggShiftRestrictHom n (x : (H.shift n).GG) :=
  Internal.coe_xinfShiftMulEquiv_eq_ggShiftRestrictHom (H := H) n x

/-- If two elements of `Gal(L∞/K_n)` have the same class modulo the group `X∞` of the shifted
extension, then their images in `Gal(L∞/K)` have the same class modulo `X∞`. -/
theorem mk_ggShiftRestrictHom_eq_of_mk_eq (n : ℕ) {σ τ : (H.shift n).GG}
    (h : (QuotientGroup.mk σ : (H.shift n).GG ⧸ (H.shift n).Xinf) = QuotientGroup.mk τ) :
    (QuotientGroup.mk (H.ggShiftRestrictHom n σ) : H.GG ⧸ H.Xinf) =
      QuotientGroup.mk (H.ggShiftRestrictHom n τ) := by
  rw [QuotientGroup.eq] at h ⊢
  rw [← map_inv, ← map_mul, ← H.coe_xinfShiftMulEquiv_apply n ⟨σ⁻¹ * τ, h⟩]
  exact (H.xinfShiftMulEquiv n ⟨σ⁻¹ * τ, h⟩).2

/-! ### Topological generators -/

/-- In the `ℤₚ`-case, let `γ` be a topological generator of `G ⧸ X∞` and let
`σ ∈ Gal(L∞/K_n)` be an element whose image in `Gal(L∞/K)` has class `γ ^ p ^ n` modulo `X∞`.
Then the class of `σ` is a topological generator of the quotient of `Gal(L∞/K_n)` by the group
`X∞` of the shifted extension.  (Washington, Lemma 13.15, Step 2: `Gal(K∞/K_n) = Γ^{p^n}` has
topological generator `γ^{p^n}`.) -/
theorem dense_zpowers_mk_shift_of_mk_eq_pow [Unique ι] {γ : H.GG ⧸ H.Xinf}
    (hγ : Dense (Subgroup.zpowers γ : Set (H.GG ⧸ H.Xinf))) (n : ℕ) (σ : (H.shift n).GG)
    (hσ : (QuotientGroup.mk (H.ggShiftRestrictHom n σ) : H.GG ⧸ H.Xinf) = γ ^ p ^ n) :
    Dense (Subgroup.zpowers (QuotientGroup.mk σ : (H.shift n).GG ⧸ (H.shift n).Xinf) :
      Set ((H.shift n).GG ⧸ (H.shift n).Xinf)) := by
  have hg : Dense (Subgroup.zpowers (H.gammaMulEquiv γ) : Set H.Γ) :=
    Subgroup.dense_zpowers_map_continuousMulEquiv H.gammaContinuousMulEquiv hγ
  have hcl : closure (Subgroup.zpowers (H.gammaMulEquiv γ ^ p ^ n) : Set H.Γ) = H.Γpow n := by
    rw [Subgroup.zpowers_eq_closure]
    refine H.closure_singleton_eq_Γpow_of_closure_singleton_eq ?_ n
    rw [← Subgroup.zpowers_eq_closure]
    exact hg.closure_eq
  have hτ : H.restrictScalarsGalHom n ((H.shift n).toGamma σ) = H.gammaMulEquiv γ ^ p ^ n := by
    rw [H.restrictScalarsGalHom_toGamma_shift n σ, ← H.gammaMulEquiv_mk, hσ, map_pow]
  -- the generator, inside the fixing subgroup of `K_n`
  let Φ := IntermediateField.fixingSubgroupContinuousMulEquiv (H.Kn n)
  have ht : ((Φ.symm ((H.shift n).toGamma σ) : ↥(H.Kn n).fixingSubgroup) : H.Γ) =
      H.gammaMulEquiv γ ^ p ^ n := hτ
  have hdt : Dense (Subgroup.zpowers (Φ.symm ((H.shift n).toGamma σ)) :
      Set ↥(H.Kn n).fixingSubgroup) := by
    rw [Subtype.dense_iff]
    have himg : ((↑) : ↥(H.Kn n).fixingSubgroup → H.Γ) ''
        (Subgroup.zpowers (Φ.symm ((H.shift n).toGamma σ)) : Set ↥(H.Kn n).fixingSubgroup) =
        (Subgroup.zpowers (H.gammaMulEquiv γ ^ p ^ n) : Set H.Γ) := by
      have hmap : (Subgroup.zpowers (Φ.symm ((H.shift n).toGamma σ))).map
          (H.Kn n).fixingSubgroup.subtype =
          Subgroup.zpowers ((H.Kn n).fixingSubgroup.subtype
            (Φ.symm ((H.shift n).toGamma σ))) := MonoidHom.map_zpowers _ _
      rw [Subgroup.subtype_apply, ht] at hmap
      rw [← hmap, Subgroup.coe_map]
      rfl
    have hfix : ((H.Γpow n : Subgroup H.Γ) : Set H.Γ) = ((H.Kn n).fixingSubgroup : Set H.Γ) := by
      rw [H.fixingSubgroup_Kn n]
    exact ((congrArg closure himg).trans (hcl.trans hfix)).symm.subset
  have hd2 := Subgroup.dense_zpowers_map_continuousMulEquiv Φ hdt
  rw [Φ.apply_symm_apply] at hd2
  have hd3 := Subgroup.dense_zpowers_map_continuousMulEquiv
    (H.shift n).gammaContinuousMulEquiv.symm hd2
  have hmk : (H.shift n).gammaContinuousMulEquiv.symm ((H.shift n).toGamma σ) =
      (QuotientGroup.mk σ : (H.shift n).GG ⧸ (H.shift n).Xinf) :=
    (H.shift n).gammaContinuousMulEquiv.symm_apply_apply (QuotientGroup.mk σ)
  rw [hmk] at hd3
  exact hd3

/-! ### The subgroup `(γ - 1) X∞` -/

/-- For `σ ∈ Gal(L∞/K_n)`, the identification `MvZpExtension.xinfShiftMulEquiv` carries the
subgroup `{(γ' • x) x⁻¹ | x ∈ X∞}` of the group `X∞` of the shifted extension, where `γ'` is
the class of `σ`, onto the subgroup `{(γ • x) x⁻¹ | x ∈ X∞}` of `X∞`, where `γ` is the class of
the image of `σ` in `Gal(L∞/K)`. -/
theorem map_gammaSubOne_xinfShiftMulEquiv (n : ℕ) (σ : (H.shift n).GG) :
    Subgroup.map (H.xinfShiftMulEquiv n).toMonoidHom
        (Subgroup.gammaSubOne (H.shift n).Xinf (H.shift n).mul_comm_Xinf' (QuotientGroup.mk σ)) =
      Subgroup.gammaSubOne H.Xinf H.mul_comm_Xinf'
        (QuotientGroup.mk (H.ggShiftRestrictHom n σ)) := by
  have hconj (x : ↥(H.shift n).Xinf) :
      Subgroup.conjAct H.Xinf H.mul_comm_Xinf' (QuotientGroup.mk (H.ggShiftRestrictHom n σ))
          (H.xinfShiftMulEquiv n x) * (H.xinfShiftMulEquiv n x)⁻¹ =
        H.xinfShiftMulEquiv n
          (Subgroup.conjAct (H.shift n).Xinf (H.shift n).mul_comm_Xinf' (QuotientGroup.mk σ) x *
            x⁻¹) := by
    apply Subtype.ext
    rw [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_conjAct_mk,
      H.coe_xinfShiftMulEquiv_apply, H.coe_xinfShiftMulEquiv_apply, Subgroup.coe_mul,
      Subgroup.coe_inv, Subgroup.coe_conjAct_mk, map_mul, map_inv, map_mul, map_mul, map_inv]
  ext y
  rw [Subgroup.mem_map, Subgroup.mem_gammaSubOne_iff]
  constructor
  · rintro ⟨z, hz, rfl⟩
    obtain ⟨x, rfl⟩ := (Subgroup.mem_gammaSubOne_iff _ _ _ _).1 hz
    exact ⟨H.xinfShiftMulEquiv n x, hconj x⟩
  · rintro ⟨x, rfl⟩
    obtain ⟨x, rfl⟩ := (H.xinfShiftMulEquiv n).surjective x
    exact ⟨_, (Subgroup.mem_gammaSubOne_iff _ _ _ _).2 ⟨x, rfl⟩, (hconj x).symm⟩

end MvZpExtension
