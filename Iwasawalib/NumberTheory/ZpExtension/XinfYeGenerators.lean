module

public import Iwasawalib.NumberTheory.ZpExtension.XinfFgTorsion
public import Iwasawalib.RingTheory.IwasawaAlgebra.NuZpSpan

@[expose] public section

/-!
# The two open hypotheses of Step 3 come from one input: the `a_i` as inertia generators

`MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn` is blueprint node
`Xn-isom-qout-of-totally-ramified`, Step 3, with `Y = Y_e`, and it carries exactly two open
hypotheses:

* `hY`: `Y_e ⊆ ℤ_p·a + ω_e X∞`;
* `hstep2`: `ν_{n,e} Y_e = Y_n` for `n ≥ e`, which is Step 2 of the node.

The blueprint does not prove these separately.  Step 1, applied to the totally ramified
`ℤ_p`-extension `K∞ / K_n` for each `n ≥ e`, produces *one* statement — the generator
description

`Y_n = ℤ_p·(ν_{n,e}·a) + ω_n X∞`,

where `a = {a_2, …, a_s}`, one element for each ramified prime beyond the first, and
`a_i^{(n)} = ν_{n,e} a_i` is the blueprint's computation
`σ_i^{p^n} = (∏_{l<p^n} γ^l • a_i) σ_1^{p^n}` — and both hypotheses fall out of it.  This file
performs that deduction, so that the only thing still missing from the node is the geometry
that produces the `a_i`.

* `hY` is the case `n = e`, where `ν_{e,e} = 1` (`IwasawaAlgebra.nu_self`).
* `hstep2` is `IwasawaAlgebra.map_lsmulZp_span_sup`, the identity
  `ν_{n,e} · (ℤ_p·a + ω_e X∞) = ℤ_p·(ν_{n,e}·a) + ω_n X∞`, combined with the descriptions at
  `e` and at `n`.

No closure operator appears: `ℤ_p·a + ω_n X∞` is already closed
(`IwasawaAlgebra.isClosed_coe_span_sup`), so the blueprint's "closure of the subgroup generated
by `ω_n X∞` and the `a_i^{(n)}`" is literally this `ℤ_p`-submodule.  That identification is
`MvZpExtension.topologicalClosure_span_sup_eq`, proved below, which is what lets the geometric
input be *stated* in the blueprint's own form.

## Main results

* `MvZpExtension.hY_of_generators`, `MvZpExtension.hstep2_of_generators`: the two hypotheses,
  each from the generator description.
* `MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn_of_generators`: **`X∞` is a finitely
  generated torsion `Λ`-module**, with the generator description as the only hypothesis beyond
  the class field theory already used by `MvZpExtension.finite_quotient_YnIn`.
-/

open Filter Topology PowerSeries
open scoped Pointwise
open scoped PowerSeries.WithPiTopology

variable {p : ℕ} [Fact p.Prime] {ι K Kinf : Type*} [Finite ι]
variable [Field K] [NumberField K] [Field Kinf] [Algebra K Kinf] [IsGalois K Kinf]

namespace MvZpExtension

variable (H : MvZpExtension p ι K Kinf) (γ : H.GG ⧸ H.Xinf)

set_option synthInstance.maxHeartbeats 800000 in
/-- **`ℤ_p·a + ω_n X∞` is closed**, so it is its own topological closure.  This is what makes
the blueprint's description of `Y_n` — *the closure of the subgroup generated by `ω_n X∞` and
the `a_i^{(n)}`* — the same as the `ℤ_p`-submodule `ℤ_p·a^{(n)} + ω_n X∞` appearing in
`MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn_of_generators`. -/
theorem topologicalClosure_span_sup_eq (a : Finset (Additive ↥H.Xinf)) (n : ℕ) :
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    haveI := H.isScalarTower_Xinf γ
    haveI := H.continuousSMul_XinfZpModule
    (Submodule.span ℤ_[p] (a : Set (Additive ↥H.Xinf)) ⊔
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
          ℤ_[p]⟦X⟧)} •
          (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p])).topologicalClosure
      = Submodule.span ℤ_[p] (a : Set (Additive ↥H.Xinf)) ⊔
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
          ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p]) := by
  letI := H.XinfZpModule
  letI := H.XinfLambdaModule γ
  haveI := H.isScalarTower_Xinf γ
  haveI := H.continuousSMul_XinfZpModule
  haveI := H.continuousSMul_XinfLambdaModule γ
  haveI := H.t2Space_additive_Xinf
  exact le_antisymm (Submodule.topologicalClosure_minimal _ le_rfl
    (IwasawaAlgebra.isClosed_coe_span_sup a _)) (Submodule.le_topologicalClosure _)

set_option synthInstance.maxHeartbeats 800000 in
/-- **`Y_e = ℤ_p·a + ω_e X∞`**: the case `n = e` of the generator description, where
`ν_{e,e} = 1` (`IwasawaAlgebra.nu_self`). -/
theorem Ye_eq_of_generators (e : ℕ) (a : Finset (Additive ↥H.Xinf))
    (hgen : letI := H.XinfZpModule
      letI := H.XinfLambdaModule γ
      haveI := H.isScalarTower_Xinf γ
      H.xinfZpSubmoduleOfSubgroup (H.YnIn e) (H.isClosed_YnIn e)
        = Submodule.span ℤ_[p]
            (((Polynomial.nu ℤ_[p] p e e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
              (a : Set (Additive ↥H.Xinf))) ⊔
          ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) :
            ℤ_[p]⟦X⟧)} •
            (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p])) :
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    haveI := H.isScalarTower_Xinf γ
    H.xinfZpSubmoduleOfSubgroup (H.YnIn e) (H.isClosed_YnIn e) =
      Submodule.span ℤ_[p] (a : Set (Additive ↥H.Xinf)) ⊔
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) :
          ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p]) := by
  letI := H.XinfZpModule
  letI := H.XinfLambdaModule γ
  haveI := H.isScalarTower_Xinf γ
  rw [hgen, IwasawaAlgebra.nu_self, Polynomial.coe_one, one_smul]

set_option synthInstance.maxHeartbeats 800000 in
/-- **`hY` from the generator description of `Y_e`**, the first of the two open hypotheses of
`MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn`. -/
theorem hY_of_generators (e : ℕ) (a : Finset (Additive ↥H.Xinf))
    (hgen : letI := H.XinfZpModule
      letI := H.XinfLambdaModule γ
      haveI := H.isScalarTower_Xinf γ
      H.xinfZpSubmoduleOfSubgroup (H.YnIn e) (H.isClosed_YnIn e)
        = Submodule.span ℤ_[p]
            (((Polynomial.nu ℤ_[p] p e e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
              (a : Set (Additive ↥H.Xinf))) ⊔
          ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) :
            ℤ_[p]⟦X⟧)} •
            (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p])) :
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    haveI := H.isScalarTower_Xinf γ
    H.xinfZpSubmoduleOfSubgroup (H.YnIn e) (H.isClosed_YnIn e) ≤
      Submodule.span ℤ_[p] (a : Set (Additive ↥H.Xinf)) ⊔
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) :
          ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p]) :=
  le_of_eq (H.Ye_eq_of_generators γ e a hgen)

set_option synthInstance.maxHeartbeats 800000 in
/-- **`hstep2` — Step 2 of the node — from the generator description.**
`ν_{n,e} Y_e = ν_{n,e} · (ℤ_p·a + ω_e X∞) = ℤ_p·(ν_{n,e}·a) + ω_n X∞ = Y_n`. -/
theorem hstep2_of_generators (e : ℕ) (a : Finset (Additive ↥H.Xinf))
    (hgen : letI := H.XinfZpModule
      letI := H.XinfLambdaModule γ
      haveI := H.isScalarTower_Xinf γ
      ∀ n : ℕ, e ≤ n →
        H.xinfZpSubmoduleOfSubgroup (H.YnIn n) (H.isClosed_YnIn n)
          = Submodule.span ℤ_[p]
              (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
                (a : Set (Additive ↥H.Xinf))) ⊔
            ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
              ℤ_[p]⟦X⟧)} •
              (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p])) :
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    haveI := H.isScalarTower_Xinf γ
    ∀ n : ℕ, e ≤ n → Submodule.map
        (IwasawaAlgebra.lsmulZp (Additive ↥H.Xinf)
          ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧))
        (H.xinfZpSubmoduleOfSubgroup (H.YnIn e) (H.isClosed_YnIn e))
      = H.xinfZpSubmoduleOfSubgroup (H.YnIn n) (H.isClosed_YnIn n) := by
  letI := H.XinfZpModule
  letI := H.XinfLambdaModule γ
  haveI := H.isScalarTower_Xinf γ
  intro n hn
  rw [H.Ye_eq_of_generators γ e a (hgen e le_rfl), hgen n hn,
    IwasawaAlgebra.map_lsmulZp_span_sup (M := Additive ↥H.Xinf) (a : Set (Additive ↥H.Xinf)) hn]

set_option synthInstance.maxHeartbeats 800000 in
/-- **Blueprint node `Xn-isom-qout-of-totally-ramified` for `X∞`, from the generator
description of the `Y_n` alone.**  If for every `n ≥ e`

`Y_n = ℤ_p·(ν_{n,e}·a) + ω_n X∞`

— the conclusion of Step 1 applied to the totally ramified `ℤ_p`-extension `K∞ / K_n`, together
with the blueprint's computation `a_i^{(n)} = ν_{n,e} a_i` — then `Additive X∞` is a finitely
generated torsion `Λ`-module.  Both open hypotheses of
`MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn` are discharged from this single input:
`hY` is `MvZpExtension.hY_of_generators` and `hstep2` is
`MvZpExtension.hstep2_of_generators`.

By `MvZpExtension.topologicalClosure_span_sup_eq` the right-hand side is exactly the closure of
the subgroup generated by `ω_n X∞` and the `ν_{n,e} a_i`, which is how the blueprint writes it.

**Warning**: like `MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn`, this depends on the class
field theory `sorry`s in
`Iwasawalib.NumberTheory.NumberField.HilbertClassField.ClassFieldTheory`, through
`MvZpExtension.finite_quotient_YnIn` (`X∞ / Y_n ≅ X_n` is finite).  The purely module-theoretic
`MvZpExtension.moduleFinite_and_isTorsion_Xinf` is free of it. -/
theorem moduleFinite_and_isTorsion_Xinf_Yn_of_generators (e : ℕ)
    (a : Finset (Additive ↥H.Xinf))
    (hgen : letI := H.XinfZpModule
      letI := H.XinfLambdaModule γ
      haveI := H.isScalarTower_Xinf γ
      ∀ n : ℕ, e ≤ n →
        H.xinfZpSubmoduleOfSubgroup (H.YnIn n) (H.isClosed_YnIn n)
          = Submodule.span ℤ_[p]
              (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
                (a : Set (Additive ↥H.Xinf))) ⊔
            ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
              ℤ_[p]⟦X⟧)} •
              (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p])) :
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    Module.Finite ℤ_[p]⟦X⟧ (Additive ↥H.Xinf) ∧
      Module.IsTorsion ℤ_[p]⟦X⟧ (Additive ↥H.Xinf) :=
  H.moduleFinite_and_isTorsion_Xinf_Yn γ e a (H.hY_of_generators γ e a (hgen e le_rfl))
    (H.hstep2_of_generators γ e a hgen)

/-! ### The input in the blueprint's own words -/

set_option synthInstance.maxHeartbeats 800000 in
/-- **The closed subgroup of `X∞` generated by a finite set `b` and by `ω_n X∞` is the
`ℤ_p`-submodule `ℤ_p·b + ω_n X∞`.**  The blueprint describes `Y_n` as *the closure of the
subgroup generated by `ω_n X∞` and `a_2^{(n)}, …, a_s^{(n)}`*; this lemma says that description
is the same as the `ℤ_p`-submodule equality consumed by
`MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn_of_generators`. -/
theorem topologicalClosure_closure_union_eq_span_sup_Xinf (b : Finset (Additive ↥H.Xinf))
    (n : ℕ) :
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    haveI := H.isScalarTower_Xinf γ
    haveI := H.continuousSMul_XinfZpModule
    (AddSubgroup.closure ((b : Set (Additive ↥H.Xinf)) ∪
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
            ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) :
          Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) :
            Set (Additive ↥H.Xinf)))).topologicalClosure
      = (Submodule.span ℤ_[p] (b : Set (Additive ↥H.Xinf)) ⊔
          ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
            ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p] :
              Submodule ℤ_[p] (Additive ↥H.Xinf))).toAddSubgroup := by
  letI := H.XinfZpModule
  letI := H.XinfLambdaModule γ
  haveI := H.isScalarTower_Xinf γ
  haveI := H.continuousSMul_XinfZpModule
  haveI := H.continuousSMul_XinfLambdaModule γ
  haveI := H.t2Space_additive_Xinf
  exact IwasawaAlgebra.topologicalClosure_closure_union_eq_span_sup b _

set_option synthInstance.maxHeartbeats 800000 in
/-- **Blueprint node `Xn-isom-qout-of-totally-ramified` for `X∞`, with the geometric input in
the blueprint's own words.**  If for every `n ≥ e` the subgroup `Y_n = Gal(L∞/K∞L_n)` is the
closure of the subgroup of `X∞` generated by `ω_n X∞ = (γ^{p^n} - 1) X∞` together with the
`s - 1` elements `ν_{n,e} a_2, …, ν_{n,e} a_s`, then `Additive X∞` is a finitely generated
torsion `Λ`-module.

This is `MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn_of_generators` composed with
`MvZpExtension.topologicalClosure_closure_union_eq_span_sup_Xinf`.  The hypothesis is the
conclusion of Step 1 applied to the totally ramified `ℤ_p`-extension `K∞ / K_n`, together with
the blueprint's computation `a_i^{(n)} = ν_{n,e} a_i` out of `σ_i^{p^n} = a_i^{(n)} σ_1^{p^n}`;
producing it is the one thing still missing from the node.

**Warning**: same class field theory dependency as
`MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn`, through
`MvZpExtension.finite_quotient_YnIn`. -/
theorem moduleFinite_and_isTorsion_Xinf_Yn_of_closure [DecidableEq (Additive ↥H.Xinf)] (e : ℕ)
    (a : Finset (Additive ↥H.Xinf))
    (hgen : letI := H.XinfZpModule
      letI := H.XinfLambdaModule γ
      haveI := H.isScalarTower_Xinf γ
      haveI := H.continuousSMul_XinfZpModule
      ∀ n : ℕ, e ≤ n →
        Subgroup.toAddSubgroup (H.YnIn n)
          = (AddSubgroup.closure
              (((a.image fun z ↦
                  ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) • z :
                    Finset (Additive ↥H.Xinf)) : Set (Additive ↥H.Xinf)) ∪
                ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) :
                    Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)} •
                  (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) :
                    Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) :
                      Set (Additive ↥H.Xinf)))).topologicalClosure) :
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    Module.Finite ℤ_[p]⟦X⟧ (Additive ↥H.Xinf) ∧
      Module.IsTorsion ℤ_[p]⟦X⟧ (Additive ↥H.Xinf) := by
  letI := H.XinfZpModule
  letI := H.XinfLambdaModule γ
  haveI := H.isScalarTower_Xinf γ
  haveI := H.continuousSMul_XinfZpModule
  refine H.moduleFinite_and_isTorsion_Xinf_Yn_of_generators γ e a fun n hn ↦ ?_
  have hb : ((a.image fun z ↦
      ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) • z :
        Finset (Additive ↥H.Xinf)) : Set (Additive ↥H.Xinf))
      = ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
        (a : Set (Additive ↥H.Xinf)) := by
    rw [Finset.coe_image]
    exact Set.image_smul
  have h := (hgen n hn).trans (H.topologicalClosure_closure_union_eq_span_sup_Xinf γ
    (a.image fun z ↦ ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) • z) n)
  apply SetLike.coe_injective
  rw [H.coe_xinfZpSubmoduleOfSubgroup (H.YnIn n) (H.isClosed_YnIn n), h, ← hb]
  rfl

end MvZpExtension
