module

public import Iwasawalib.NumberTheory.ZpExtension.L0Maximal

@[expose] public section

/-!
# A finite inertia family generates `HH`

This file isolates the finite-family lattice step in Washington's Lemma 13.15.  Once a finite
set of places has been selected and every inertia subgroup is known to lie in the subgroup
generated by the commutator and those selected inertia subgroups, that subgroup is exactly
`MvZpExtension.HH`.

The remaining arithmetic input is deliberately visible as `hcover`: it follows from the
statement that every place above a ramified prime is Galois-conjugate to the selected lift,
together with triviality of inertia away from the finite ramified set.
-/

open scoped commutatorElement

variable {p : ℕ} [Fact p.Prime] {ι K Kinf : Type*} [Finite ι]
variable [Field K] [NumberField K] [Field Kinf] [Algebra K Kinf] [IsGalois K Kinf]

namespace MvZpExtension

variable (H : MvZpExtension p ι K Kinf)

set_option linter.unusedSectionVars false in
/-- A finite selected family of inertia subgroups generates `HH` as soon as it contains every
inertia subgroup modulo the commutator subgroup. -/
theorem HH_eq_commutator_sup_iSup_selectedInertia
    (s : Finset (AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ))
    (hcover : ∀ v : AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ,
      v.inertiaSubgroup K ≤ commutator H.GG ⊔ ⨆ w : ↥s, (w : AbsoluteValue _ ℝ).inertiaSubgroup K) :
    H.HH = commutator H.GG ⊔ ⨆ w : ↥s, (w : AbsoluteValue _ ℝ).inertiaSubgroup K := by
  apply le_antisymm
  · exact sup_le le_sup_left (iSup_le hcover)
  · exact sup_le H.commutator_le_HH
      (iSup_le fun w ↦ H.inertiaSubgroup_le_HH (w : AbsoluteValue _ ℝ))

end MvZpExtension
