/-- **The generator description of `Y_n` for all `n ≥ e`, from a base-prime package.**  Given
`D : RamifiedBasePlaceData H` (finitely many primes of `K` above `p`, one ramified place of
`K∞` above each, covering every ramified place of `K∞` up to equivalence of restrictions to
`K`), there are a topological generator `γ` of `G ⧸ X∞`, a natural number `e` and a finite
set `a ⊆ Additive X∞` such that for every `n ≥ e` the `ℤ_p`-submodule of `Additive X∞`
attached to `Y_n` is `ℤ_p · (ν_{n,e} • a) + ω_n X∞`.

This is exactly `γ`, `hγ`, `e`, `a` and `hgen` of
`MvZpExtension.multiplicity_classNumber_Kn_eq₁_of_eventual_Yn_data`.

This theorem does not depend on class field theory.  The proof splits on whether `D.base`
is empty.  If it is not, a base prime `q₀` gives the index `j₀ = (q₀, 1)` of
`MvZpExtension.YnIn_eq_topologicalClosure_closure_of_lifts`, applied to the family
`MvZpExtension.RamifiedBasePlaceData.orbitPlace`.  If it is, then by `D.covers` no place of
`K∞` ramifies in `K∞ / K`, and
`MvZpExtension.YnIn_eq_gammaSubOne_of_forall_inertiaSubgroup_eq_bot` gives the description with
`e = 0` and `a = ∅`.  So no ramified place is assumed to exist, and
`MvZpExtension.exists_inertiaSubgroup_ne_bot_of_hcf` is not needed. -/
theorem RamifiedBasePlaceData.exists_eventual_Yn_generators [Unique ι]
    (D : RamifiedBasePlaceData H) :
    ∃ γ : H.GG ⧸ H.Xinf, Dense (Subgroup.zpowers γ : Set (H.GG ⧸ H.Xinf)) ∧
    ∃ (e : ℕ) (a : Finset (Additive ↥H.Xinf)),
      letI := H.XinfZpModule
      letI := H.XinfLambdaModule γ
      haveI := H.isScalarTower_Xinf γ
      ∀ n : ℕ, e ≤ n →
        H.xinfZpSubmoduleOfSubgroup (H.YnIn n) (H.isClosed_YnIn n) =
          Submodule.span ℤ_[p]
              (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
                (a : Set (Additive ↥H.Xinf))) ⊔
            ((Ideal.span
                {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
                  ℤ_[p]⟦X⟧)} •
              (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p]) := by
  classical
  obtain ⟨γ, hγ⟩ := H.exists_dense_zpowers
  rcases isEmpty_or_nonempty D.base with hD | hD
  · -- no place of `K∞` ramifies: `Y_n = (γ ^ p ^ n - 1) X∞`, and `e = 0`, `a = ∅`
    have hunr : ∀ u : AbsoluteValue Kinf ℝ, u.inertiaSubgroup K = ⊥ := by
      intro u
      by_contra hu
      obtain ⟨q, -⟩ := D.covers u hu
      exact isEmptyElim q
    refine ⟨γ, hγ, 0, ∅, fun n _ ↦ ?_⟩
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    haveI := H.isScalarTower_Xinf γ
    haveI := H.continuousSMul_XinfZpModule
    refine H.hgen_of_closure γ 0 ∅ ?_
    have hc := Subgroup.isClosed_gammaSubOne H.Xinf H.mul_comm_Xinf' (γ ^ p ^ n) H.isClosed_Xinf
    rw [Finset.coe_empty, Set.smul_set_empty, Set.empty_union, H.coe_omega_smul_top_Xinf γ n,
      AddSubgroup.closure_eq, H.YnIn_eq_gammaSubOne_of_forall_inertiaSubgroup_eq_bot γ hγ hunr n]
    apply SetLike.coe_injective
    rw [AddSubgroup.topologicalClosure_coe]
    exact hc.closure_eq.symm
  -- some base prime: the family of ramified places has the index `j₀ = (q₀, 1)`
  obtain ⟨q₀⟩ := hD
  obtain ⟨e, he⟩ := D.exists_common_shift
  let j₀ : D.base × (H.Γ ⧸ (H.Γpow e : Subgroup H.Γ)) := (q₀, 1)
  have hv := RamifiedBasePlaceData.Γpow_le_inertiaSubgroup_orbitPlace H D he
  have hcover := RamifiedBasePlaceData.exists_isEquiv_orbitPlace H D he
  haveI : Finite (D.base × (H.Γ ⧸ (H.Γpow e : Subgroup H.Γ))) :=
    RamifiedBasePlaceData.finite_orbitIndex H D e
  choose selected hsel using fun j ↦
    H.exists_Linf_place_placeBelow_eq (RamifiedBasePlaceData.orbitPlace H D e j)
  have hlift : ∀ j, ∃ τ : H.GG, τ ∈ (selected j).inertiaSubgroup K ∧
      (QuotientGroup.mk τ : H.GG ⧸ H.Xinf) = γ ^ p ^ e := by
    intro j
    obtain ⟨τ, hτ, hτγ⟩ := H.exists_mem_inertiaSubgroup_mk_eq (selected j)
      (le_of_le_of_eq (hv j)
        (congrArg (fun u ↦ AbsoluteValue.inertiaSubgroup K u) (hsel j).symm)) γ
    exact ⟨τ, hτ, hτγ⟩
  choose σ hσI hσγ using hlift
  have haXmem : ∀ j, σ j * (σ j₀)⁻¹ ∈ H.Xinf := by
    intro j
    refine (QuotientGroup.eq_one_iff (N := H.Xinf) (σ j * (σ j₀)⁻¹)).1 ?_
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, hσγ j, hσγ j₀, mul_inv_cancel]
  refine ⟨γ, hγ, e, (Set.finite_range fun j ↦
    Additive.ofMul (⟨σ j * (σ j₀)⁻¹, haXmem j⟩ : ↥H.Xinf)).toFinset, fun n hen ↦ ?_⟩
  letI := H.XinfZpModule
  letI := H.XinfLambdaModule γ
  haveI := H.isScalarTower_Xinf γ
  haveI := H.continuousSMul_XinfZpModule
  have haNmem : ∀ j, σ j ^ p ^ (n - e) * (σ j₀ ^ p ^ (n - e))⁻¹ ∈ H.Xinf := by
    intro j
    refine (QuotientGroup.eq_one_iff (N := H.Xinf) _).1 ?_
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_pow, QuotientGroup.mk_pow,
      hσγ j, hσγ j₀, mul_inv_cancel]
  have h41 := H.YnIn_eq_topologicalClosure_closure_of_lifts γ hγ j₀
    (RamifiedBasePlaceData.orbitPlace H D e) hv hcover selected hsel σ hσI hσγ
    (fun j ↦ (⟨σ j ^ p ^ (n - e) * (σ j₀ ^ p ^ (n - e))⁻¹, haNmem j⟩ : ↥H.Xinf)) hen
    (fun j ↦ rfl)
  have hnu : ∀ j,
      Additive.ofMul (⟨σ j ^ p ^ (n - e) * (σ j₀ ^ p ^ (n - e))⁻¹, haNmem j⟩ : ↥H.Xinf) =
        ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
          Additive.ofMul (⟨σ j * (σ j₀)⁻¹, haXmem j⟩ : ↥H.Xinf) := by
    intro j
    have h := H.pow_eq_nu_smul_mul_pow_of_eq_mul γ (⟨σ j * (σ j₀)⁻¹, haXmem j⟩ : ↥H.Xinf)
      (σ j₀) (σ j) n e (hσγ j₀) (inv_mul_cancel_right (σ j) (σ j₀)).symm
    apply Additive.toMul.injective
    apply Subtype.ext
    exact mul_inv_eq_of_eq_mul h
  have hset : Additive.ofMul ''
      ((Subgroup.gammaSubOne H.Xinf H.mul_comm_Xinf' (γ ^ p ^ n) : Set ↥H.Xinf) ∪
        Set.range (fun j ↦
          (⟨σ j ^ p ^ (n - e) * (σ j₀ ^ p ^ (n - e))⁻¹, haNmem j⟩ : ↥H.Xinf))) =
      (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
          (((Set.finite_range fun j ↦
            Additive.ofMul (⟨σ j * (σ j₀)⁻¹, haXmem j⟩ : ↥H.Xinf)).toFinset :
              Finset (Additive ↥H.Xinf)) : Set (Additive ↥H.Xinf))) ∪
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) :
            Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)} •
          (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) :
            Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) : Set (Additive ↥H.Xinf)) := by
    refine (Set.image_union _ _ _).trans ((Set.union_comm _ _).trans ?_)
    congr 1
    · rw [Set.Finite.coe_toFinset, Set.smul_set_range, ← Set.range_comp]
      congr 1
      funext j
      exact hnu j
    · refine Eq.trans ?_ (H.coe_omega_smul_top_Xinf γ n).symm
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        exact ⟨Additive.toMul x, hx, rfl⟩
  refine H.hgen_of_closure γ e _ ?_
  refine Eq.trans (congrArg Subgroup.toAddSubgroup h41) ?_
  refine Eq.trans (Subgroup.toAddSubgroup_topologicalClosure_closure _) ?_
  exact congrArg (fun S : Set (Additive ↥H.Xinf) ↦
    (AddSubgroup.closure S).topologicalClosure) hset

