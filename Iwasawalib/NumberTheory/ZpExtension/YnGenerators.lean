/-- **The generator description of `Y_n` at one level `n ≥ e`** (Washington 13.15, Step 1
applied to `K∞ / K_n`, "with the same places").

Let `γ` be a topological generator of `G ⧸ X∞ = Γ`.  Let `v j` (`j : s`, with a chosen index
`j₀`) be places of `K∞` such that

* `hv`: the inertia subgroup of each `v j` in `Γ` contains `Γ ^ (p ^ e)`;
* `hcover`: every place of `K∞` with nontrivial inertia in `Γ` is equivalent to some `v j`.

For each `j` let `selected j` be a place of `L∞` above `v j`, and `σ j` an element of the
inertia subgroup of `selected j` in `G = Gal(L∞/K)` with image `γ ^ p ^ e` in `G ⧸ X∞`.  Let
`e ≤ n` and let `aN j ∈ X∞` be the element with
`aN j = σ j ^ p ^ (n - e) * (σ j₀ ^ p ^ (n - e))⁻¹`.  Then `Y_n = Gal(L∞/K∞ L_n)`, as a
subgroup of `X∞`, is the topological closure of the subgroup generated by
`{(γ ^ p ^ n • x) x⁻¹ | x ∈ X∞}` and the `aN j`.

This statement is unconditional: the family and the index `j₀` are hypotheses. -/
theorem YnIn_eq_topologicalClosure_closure_of_lifts [Unique ι]
    (γ : H.GG ⧸ H.Xinf) (hγ : Dense (Subgroup.zpowers γ : Set (H.GG ⧸ H.Xinf)))
    {s : Type*} (j₀ : s) (v : s → AbsoluteValue Kinf ℝ) {e : ℕ}
    (hv : ∀ j, (H.Γpow e : Subgroup H.Γ) ≤ (v j).inertiaSubgroup K)
    (hcover : ∀ u : AbsoluteValue Kinf ℝ, u.inertiaSubgroup K ≠ ⊥ → ∃ j, u.IsEquiv (v j))
    (selected : s → AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ)
    (hsel : ∀ j, H.placeBelow (selected j) = v j)
    (σ : s → H.GG) (hσI : ∀ j, σ j ∈ (selected j).inertiaSubgroup K)
    (hσγ : ∀ j, (QuotientGroup.mk (σ j) : H.GG ⧸ H.Xinf) = γ ^ p ^ e)
    (aN : s → ↥H.Xinf) {n : ℕ} (hen : e ≤ n)
    (haN : ∀ j, (aN j : H.GG) = σ j ^ p ^ (n - e) * (σ j₀ ^ p ^ (n - e))⁻¹) :
    H.YnIn n = (Subgroup.closure
      ((Subgroup.gammaSubOne H.Xinf H.mul_comm_Xinf' (γ ^ p ^ n) : Set ↥H.Xinf) ∪
        Set.range aN)).topologicalClosure := by
  -- Step 1: the class of `σ j ^ p ^ (n - e)` is `γ ^ p ^ n`
  have hmkpow : ∀ j, (QuotientGroup.mk (σ j ^ p ^ (n - e)) : H.GG ⧸ H.Xinf) = γ ^ p ^ n := by
    intro j
    rw [QuotientGroup.mk_pow, hσγ j, ← pow_mul, ← pow_add, Nat.add_sub_cancel' hen]
  -- Step 2: an element of `Gal(L∞/K_n)` restricting to `σ j₀ ^ p ^ (n - e)`
  obtain ⟨g', hg'⟩ : ∃ g' : (H.shift n).GG,
      H.ggShiftRestrictHom n g' = σ j₀ ^ p ^ (n - e) := by
    refine ⟨(H.ggShiftMulEquiv n).symm
      ⟨σ j₀ ^ p ^ (n - e), H.pow_mem_GGOverKn hen γ (hσγ j₀)⟩, ?_⟩
    rw [← H.coe_ggShiftMulEquiv n]
    exact congrArg Subtype.val ((H.ggShiftMulEquiv n).apply_symm_apply _)
  have hg'mk : (QuotientGroup.mk (H.ggShiftRestrictHom n g') : H.GG ⧸ H.Xinf) = γ ^ p ^ n :=
    (congrArg _ hg').trans (hmkpow j₀)
  have hγ' := H.dense_zpowers_mk_shift_of_mk_eq_pow hγ n g' hg'mk
  -- Step 3: lifts of the class of `g'` in the inertia subgroups over `K_n`
  have hlift : ∀ j, ∃ i : (H.shift n).GG,
      i ∈ ((H.shiftPlaceEquiv n).symm (selected j)).inertiaSubgroup ↥(H.Kn n) ∧
      (QuotientGroup.mk i : (H.shift n).GG ⧸ (H.shift n).Xinf) = QuotientGroup.mk g' := by
    intro j
    have hram := H.inertiaSubgroup_Kn_placeBelow_shiftPlaceEquiv_symm_eq_top hen (selected j)
      (le_of_le_of_eq (hv j) (congrArg (fun u ↦ AbsoluteValue.inertiaSubgroup K u) (hsel j).symm))
    obtain ⟨x, hx, i, hi, hgi⟩ := (H.shift n).exists_mem_Xinf_mul_mem_inertiaSubgroup
      ((H.shiftPlaceEquiv n).symm (selected j)) _ ((H.shift n).comp_placeBelow _) hram g'
    refine ⟨i, hi, ?_⟩
    rw [hgi, QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff x).2 hx, one_mul]
  choose σ' hσ'I hσ'γ using hlift
  -- Step 4: the lifts restrict to `σ j ^ p ^ (n - e)`
  have hσ'eq : ∀ j, H.ggShiftRestrictHom n (σ' j) = σ j ^ p ^ (n - e) := by
    intro j
    refine H.eq_of_mem_inertiaSubgroup_of_mk_eq (selected j)
      ((H.mem_inertiaSubgroup_shift_iff n _ _).1 (hσ'I j)) (pow_mem (hσI j) _) ?_
    exact (H.mk_ggShiftRestrictHom_eq_of_mk_eq n (hσ'γ j)).trans (hg'mk.trans (hmkpow j).symm)
  -- Step 5: Lemma A at the shifted extension
  have ha'mem : ∀ j, σ' j * (σ' j₀)⁻¹ ∈ (H.shift n).Xinf := by
    intro j
    refine (QuotientGroup.eq_one_iff (N := (H.shift n).Xinf) (σ' j * (σ' j₀)⁻¹)).1 ?_
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, hσ'γ j, hσ'γ j₀, mul_inv_cancel]
  have hA := Subgroup.topologicalClosure_commutator_sup_iSup_subgroupOf_eq
    (H.shift n).Xinf (H.shift n).mul_comm_Xinf' (H.shift n).isClosed_Xinf
    (QuotientGroup.mk g') hγ' j₀
    (fun j ↦ ((H.shiftPlaceEquiv n).symm (selected j)).inertiaSubgroup ↥(H.Kn n))
    (fun j ↦ AbsoluteValue.isClosed_inertiaSubgroup _ _)
    (fun j ↦ (H.shift n).inertiaSubgroup_inf_Xinf _)
    σ' hσ'I hσ'γ (fun j ↦ ⟨σ' j * (σ' j₀)⁻¹, ha'mem j⟩) (fun j ↦ rfl)
  have hcov := H.HH_shift_eq_commutator_sup_iSup v n hcover selected hsel
  -- Step 6: the left-hand side is `Y_0` of the shifted extension, i.e. `Y_n`
  have hY0 : (H.shift n).YnIn 0 = (Subgroup.closure
      ((Subgroup.gammaSubOne (H.shift n).Xinf (H.shift n).mul_comm_Xinf'
          (QuotientGroup.mk g') : Set ↥(H.shift n).Xinf) ∪
        Set.range (fun j ↦ (⟨σ' j * (σ' j₀)⁻¹, ha'mem j⟩ : ↥(H.shift n).Xinf)))).topologicalClosure := by
    refine Eq.trans ?_ hA
    refine Eq.trans (H.topologicalClosure_HH_shift_subgroupOf_Xinf_eq_YnIn_zero n).symm ?_
    exact congrArg (fun S : Subgroup (H.shift n).GG ↦
      S.topologicalClosure.subgroupOf (H.shift n).Xinf) hcov
  -- Step 7: transport along `xinfShiftMulEquiv`
  -- (the identification is made opaque first, so that no transport is ever unfolded)
  have hmap := H.map_YnIn_xinfShiftMulEquiv n
  have h26 := (H.map_gammaSubOne_xinfShiftMulEquiv n g').trans
    (congrArg (Subgroup.gammaSubOne H.Xinf H.mul_comm_Xinf') hg'mk)
  have hcoe := H.coe_xinfShiftMulEquiv_apply n
  generalize hM : H.xinfShiftMulEquiv n = M at hmap h26 hcoe
  obtain ⟨E, rfl⟩ : ∃ E : ↥(H.shift n).Xinf ≃ₜ* ↥H.Xinf, M = E.toMulEquiv :=
    ⟨H.xinfShiftContinuousMulEquiv n, hM.symm.trans (H.xinfShiftMulEquiv_eq n)⟩
  clear hM
  have h3 := Subgroup.map_topologicalClosure_closure_continuousMulEquiv E
    ((Subgroup.gammaSubOne (H.shift n).Xinf (H.shift n).mul_comm_Xinf'
          (QuotientGroup.mk g') : Set ↥(H.shift n).Xinf) ∪
        Set.range (fun j ↦ (⟨σ' j * (σ' j₀)⁻¹, ha'mem j⟩ : ↥(H.shift n).Xinf)))
  have himg1 : E ''
      (Subgroup.gammaSubOne (H.shift n).Xinf (H.shift n).mul_comm_Xinf'
          (QuotientGroup.mk g') : Set ↥(H.shift n).Xinf) =
      (Subgroup.gammaSubOne H.Xinf H.mul_comm_Xinf' (γ ^ p ^ n) : Set ↥H.Xinf) :=
    congrArg (fun S : Subgroup ↥H.Xinf ↦ (S : Set ↥H.Xinf)) h26
  have himg2 : E ''
      Set.range (fun j ↦ (⟨σ' j * (σ' j₀)⁻¹, ha'mem j⟩ : ↥(H.shift n).Xinf)) =
      Set.range aN := by
    rw [← Set.range_comp]
    congr 1
    funext j
    apply Subtype.ext
    refine (hcoe ⟨σ' j * (σ' j₀)⁻¹, ha'mem j⟩).trans ?_
    rw [haN j, ← hσ'eq j, ← hσ'eq j₀, ← map_inv, ← map_mul]
  rw [Set.image_union, himg1, himg2] at h3
  refine Eq.trans ?_ h3
  refine Eq.trans hmap.symm ?_
  exact congrArg (fun S : Subgroup ↥(H.shift n).Xinf ↦
    Subgroup.map E.toMulEquiv.toMonoidHom S) hY0

