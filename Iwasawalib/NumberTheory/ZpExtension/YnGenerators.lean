/-- **T2: the generator description of `Y_n` for all `n ≥ e`.**  Suppose (`hlocal`) that for
every prime `q` of `K` not containing `p` and every place `v` of `K∞` lying over `q` there is
`M ≠ 0` such that the `M`-th power of every element of the inertia subgroup of `v` in
`Gal(K∞/K)` restricts to the identity on every layer `K_n`.  Then there are a topological
generator `γ` of `G ⧸ X∞`, a natural number `e` and a finite set `a ⊆ Additive X∞` such that
for every `n ≥ e` the `ℤ_p`-submodule of `Additive X∞` attached to `Y_n` is
`ℤ_p · (ν_{n,e} • a) + ω_n X∞`.

The hypothesis `hlocal` is word for word the hypothesis of
`MvZpExtension.exists_ramifiedBasePlaceData`.  It is kept explicit here; the theorem
`MvZpExtension.exists_restrictNormalHom_pow_eq_one_of_liesOver_adicAbv` of task T1 discharges
it (see also its corollary `MvZpExtension.exists_ramifiedBasePlaceData_unconditional`, both in
`Iwasawalib/NumberTheory/ZpExtension/TameLocalExponent.lean`).

The conclusion is exactly `γ`, `hγ`, `e`, `a` and `hgen` of
`MvZpExtension.multiplicity_classNumber_Kn_eq₁_of_eventual_Yn_data`.

It is `MvZpExtension.RamifiedBasePlaceData.exists_eventual_Yn_generators` applied to a package
produced by `MvZpExtension.exists_ramifiedBasePlaceData`.  Neither depends on class field
theory, so neither does this theorem. -/
theorem exists_eventual_Yn_generators [Unique ι]
    (hlocal : ∀ (q : HeightOneSpectrum (𝓞 K)),
      (p : 𝓞 K) ∉ q.asIdeal →
      ∀ (v : AbsoluteValue Kinf ℝ),
        [v.LiesOver (HeightOneSpectrum.adicAbv K q)] →
        ∃ M : ℕ, M ≠ 0 ∧
          ∀ n σ, σ ∈ v.inertiaSubgroup K →
            AlgEquiv.restrictNormalHom (H.Kn n) (σ ^ M) = 1) :
    ∃ γ : H.GG ⧸ H.Xinf, Dense (Subgroup.zpowers γ : Set (H.GG ⧸ H.Xinf)) ∧
    ∃ (e : ℕ) (a : Finset (Additive ↥H.Xinf)),
      letI := H.XinfZpModule
      letI := H.XinfLambdaModule γ
      haveI := H.isScalarTower_Xinf γ
      ∀ n : ℕ, e ≤ n →
        H.xinfZpSubmoduleOfSubgroup (H.YnIn n) (H.isClosed_YnIn n) =
          Submodule.span ℤ_[p]
              (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
                (a : Set (Additive ↥H.Xinf))) ⊔
            ((Ideal.span
                {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
                  ℤ_[p]⟦X⟧)} •
              (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf))).restrictScalars ℤ_[p]) := by
  obtain ⟨D⟩ := H.exists_ramifiedBasePlaceData hlocal
  exact RamifiedBasePlaceData.exists_eventual_Yn_generators H D

end MvZpExtension
