  haveI := H.continuousSMul_XinfZpModule
  have hb : ((a.image fun z ↦
      ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) • z :
        Finset (Additive ↥H.Xinf)) : Set (Additive ↥H.Xinf))
      = ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
        (a : Set (Additive ↥H.Xinf)) := by
    rw [Finset.coe_image]
    exact Set.image_smul
  have h2 := H.topologicalClosure_closure_union_eq_span_sup_Xinf γ
    (a.image fun z ↦ ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) • z) n
  rw [hb] at h2
  have h3 := h.trans h2
  apply SetLike.coe_injective
  rw [H.coe_xinfZpSubmoduleOfSubgroup (H.YnIn n) (H.isClosed_YnIn n), h3]
