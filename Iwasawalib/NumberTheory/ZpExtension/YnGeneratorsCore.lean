public import Iwasawalib.NumberTheory.ZpExtension.InertiaInfSup
public import Iwasawalib.NumberTheory.ZpExtension.XinfStepOne
public import Iwasawalib.NumberTheory.ZpExtension.YnInertiaPresentation

@[expose] public section

/-!
# The generator description of `Y_n`: group theory and the `X∞`-side pieces

Source: Washington, *Introduction to cyclotomic fields*, Lemma 13.15 (blueprint node
`Xn-isom-qout-of-totally-ramified`), Step 1 ("`H = I₁Y`", "`X ∩ I₁Y = Y`") and Step 2
("`a_i^{(n)} = ν a_i`", "`(γ^{p^n} - 1) X`").

In the source, `G` is a compact Hausdorff group, `X ⊆ G` a closed abelian normal subgroup with
`G / X = Γ` topologically generated by `γ`, the `I_i` are closed subgroups with `I_i ∩ X = 1`
mapping onto `Γ`, `σ_i ∈ I_i` is the preimage of `γ`, and `a_i ∈ X` is defined by
`σ_i = a_i σ_1`.  The source asserts that the closed subgroup `H` generated by `G'` and the
`I_i` is `I_1 Y`, where `Y` is the closure of the subgroup generated by
`T X = {(γ • x) x⁻¹}` and the `a_i`, and that `X ∩ H = Y`.

This file contains the abstract form of that assertion and the pieces of the `X∞`-side
bookkeeping which do not mention the shifted extension `H.shift n`.

**Every declaration in this file is proved without `sorryAx`** (axioms: `propext`,
`Classical.choice`, `Quot.sound`): no class field theory is used or needed (in particular
nothing here goes through `MvZpExtension.exists_inertiaSubgroup_ne_bot` or
`MvZpExtension.finite_quotient_YnIn`).

## Main statements

* `Subgroup.eq_topologicalClosure_zpowers_of_dense_mk`: a closed subgroup `I` with `I ∩ X = 1`
  containing a lift `σ` of a topological generator of `G ⧸ X` is the closure of `⟨σ⟩`.
* `Subgroup.topologicalClosure_commutator_sup_iSup_subgroupOf_eq`: **Lemma A**,
  `X ∩ closure (G' ⊔ ⨆ j, I j) = closure ⟨T X, a j⟩`.
* `Subgroup.map_topologicalClosure_closure_continuousMulEquiv`,
  `Subgroup.toAddSubgroup_topologicalClosure_closure`: the closure of a generated subgroup is
  transported by a topological isomorphism, and by the passage to additive notation.
* `MvZpExtension.exists_mem_inertiaSubgroup_mk_eq`: `γ ^ p ^ e` lifts into the inertia subgroup
  of a place of `L∞` lying over a place of `K∞` whose inertia contains `Γ ^ (p ^ e)`.
* `MvZpExtension.eq_of_mem_inertiaSubgroup_of_mk_eq`: two elements of one inertia subgroup of
  `L∞ / K` with the same image in `G ⧸ X∞` are equal.
* `MvZpExtension.coe_omega_smul_top_Xinf`: `ω_n X∞ = (γ ^ p ^ n - 1) X∞`.
* `MvZpExtension.hgen_of_closure`: the closure form of the generator description of `Y_n`
  implies its `ℤ_p`-span form.
-/

open PowerSeries
open scoped Pointwise

/-! ### Abstract group theory -/

namespace Subgroup

section Compact

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [T2Space G]

/-- **(E') A closed complement-like subgroup is procyclic, generated by any lift of a
generator.**  Let `G` be a compact Hausdorff group, `X` a closed normal subgroup and `I` a
closed subgroup with `I ∩ X = 1`.  If `σ ∈ I` and the image of `σ` in `G ⧸ X` generates a dense
subgroup, then `I` is the topological closure of the subgroup generated by `σ`.

This is the source's "`σ_i` is a topological generator of `I_i`" (Washington 13.15, the
paragraph before Step 1), without constructing the bijection `I_i ≅ Γ`. -/
theorem eq_topologicalClosure_zpowers_of_dense_mk
    (X : Subgroup G) [X.Normal] (hXc : IsClosed (X : Set G))
    (I : Subgroup G) (hI : IsClosed (I : Set G)) (hIX : ∀ g : G, g ∈ I → g ∈ X → g = 1)
    (σ : G) (hσ : σ ∈ I)
    (hdense : Dense (Subgroup.zpowers (QuotientGroup.mk σ : G ⧸ X) : Set (G ⧸ X))) :
    I = (Subgroup.zpowers σ).topologicalClosure := by
  have hCI : (Subgroup.zpowers σ).topologicalClosure ≤ I :=
    Subgroup.topologicalClosure_minimal _ ((Subgroup.zpowers_le).2 hσ) hI
  have hCc : IsClosed (((Subgroup.zpowers σ).topologicalClosure : Subgroup G) : Set G) :=
    Subgroup.isClosed_topologicalClosure _
  have hJ := Subgroup.dense_comap_zpowers X (QuotientGroup.mk σ : G ⧸ X) hdense
  have hcl : IsClosed ((((Subgroup.zpowers σ).topologicalClosure ⊔ X : Subgroup G)) : Set G) :=
    Subgroup.isClosed_coe_sup_of_normal _ X hCc hXc
  have hJle : (Subgroup.zpowers (QuotientGroup.mk σ : G ⧸ X)).comap (QuotientGroup.mk' X) ≤
      (Subgroup.zpowers σ).topologicalClosure ⊔ X := by
    intro g hg
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (Subgroup.mem_comap.1 hg)
    have h1 : (σ ^ k)⁻¹ * g ∈ X := by
      rw [← QuotientGroup.eq, QuotientGroup.mk_zpow]
      exact hk
    have h2 : σ ^ k ∈ (Subgroup.zpowers σ).topologicalClosure :=
      Subgroup.le_topologicalClosure _ (Subgroup.zpow_mem_zpowers σ k)
    have h3 : g = σ ^ k * ((σ ^ k)⁻¹ * g) := by group
    rw [h3]
    exact Subgroup.mul_mem_sup h2 h1
  have htop : ∀ x : G, x ∈ (Subgroup.zpowers σ).topologicalClosure ⊔ X := by
    intro x
    have hx : x ∈ _root_.closure ((((Subgroup.zpowers (QuotientGroup.mk σ : G ⧸ X)).comap
        (QuotientGroup.mk' X) : Subgroup G)) : Set G) := hJ x
    exact closure_minimal hJle hcl hx
  refine le_antisymm (fun x hx ↦ ?_) hCI
  obtain ⟨c, hc, y, hy, rfl⟩ := Subgroup.mem_sup_of_normal_right.1 (htop x)
  have hyI : y ∈ I := by
    have h4 := I.mul_mem (I.inv_mem (hCI hc)) hx
    rwa [inv_mul_cancel_left] at h4
  rw [hIX y hyI hy, mul_one]
  exact hc

/-- **Lemma A: `X ∩ closure (G' ⊔ ⨆ j, I j) = closure ⟨T X, a j⟩`** (Washington 13.15, Step 1,
"`H = I₁Y`" and "`X ∩ I₁Y = Y`").

Let `G` be a compact Hausdorff group, `X` a closed abelian normal subgroup, and `γ` an element
of `G ⧸ X` generating a dense subgroup.  Let `I j` (`j : s`, `s` any index type with a chosen
index `j₀`) be closed subgroups with `I j ∩ X = 1`, let `σ j ∈ I j` be a lift of `γ`, and let
`a j ∈ X` be the element with `a j = σ j * (σ j₀)⁻¹`, i.e. `σ j = a j * σ j₀`.  Then the
intersection with `X` of the topological closure of the subgroup generated by the commutator
subgroup of `G` and all the `I j` — viewed as a subgroup of `X` — is the topological closure
(in `X`) of the subgroup generated by `T X = {(γ • x) x⁻¹ | x ∈ X}` and the `a j`.

The index `j₀` plays the role of the source's `1`; the element `a j₀ = 1` is included among
the generators, which does not change the generated subgroup. -/
theorem topologicalClosure_commutator_sup_iSup_subgroupOf_eq
    (X : Subgroup G) [X.Normal] (hX : ∀ a ∈ X, ∀ b ∈ X, a * b = b * a)
    (hXc : IsClosed (X : Set G)) (γ : G ⧸ X)
    (hγ : Dense (Subgroup.zpowers γ : Set (G ⧸ X)))
    {s : Type*} (j₀ : s) (I : s → Subgroup G) (hI : ∀ j, IsClosed (I j : Set G))
    (hIX : ∀ j, ∀ g : G, g ∈ I j → g ∈ X → g = 1)
    (σ : s → G) (hσI : ∀ j, σ j ∈ I j)
    (hσγ : ∀ j, (QuotientGroup.mk (σ j) : G ⧸ X) = γ)
    (a : s → X) (ha : ∀ j, (a j : G) = σ j * (σ j₀)⁻¹) :
    (_root_.commutator G ⊔ ⨆ j, I j).topologicalClosure.subgroupOf X =
      (Subgroup.closure ((Subgroup.gammaSubOne X hX γ : Set X) ∪ Set.range a)).topologicalClosure := by
  haveI : CompactSpace X := Subgroup.compactSpace_of_isClosed X hXc
  set Y : Subgroup X :=
    (Subgroup.closure ((Subgroup.gammaSubOne X hX γ : Set X) ∪ Set.range a)).topologicalClosure
    with hY
  set Z : Subgroup G := (_root_.commutator G ⊔ ⨆ j, I j).topologicalClosure with hZ
  -- (i) `YG = Y` viewed in `G` is contained in `X` and closed
  have hYGX : Y.map X.subtype ≤ X := Subgroup.map_subtype_le Y
  have hYc : IsClosed (Y : Set X) := Subgroup.isClosed_topologicalClosure _
  have hYGc : IsClosed ((Y.map X.subtype : Subgroup G) : Set G) := by
    have h : ((Y.map X.subtype : Subgroup G) : Set G) = Subtype.val '' (Y : Set X) := rfl
    rw [h]
    exact (hYc.isCompact.image continuous_subtype_val).isClosed
  -- (ii) the commutator subgroup is `T X`, contained in `YG`; hence `YG` is normal
  have hcomm : _root_.commutator G = Subgroup.gammaSubOneG X hX γ :=
    Subgroup.commutator_eq_gammaSubOneG X hX γ hXc hγ
  have hTY : Subgroup.gammaSubOneG X hX γ ≤ Y.map X.subtype := by
    refine Subgroup.map_mono ?_
    exact le_trans (fun x hx ↦ Subgroup.subset_closure (Or.inl hx))
      (Subgroup.le_topologicalClosure _)
  have hcommY : _root_.commutator G ≤ Y.map X.subtype := hcomm.le.trans hTY
  haveI hYGn : (Y.map X.subtype).Normal := Subgroup.normal_of_commutator_le hcommY
  have haY : ∀ j, (a j : G) ∈ Y.map X.subtype := fun j ↦
    ⟨a j, Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (Or.inr ⟨j, rfl⟩)), rfl⟩
  -- (iii) every `I j` is contained in the closed subgroup `I j₀ ⊔ YG`
  have hcl : IsClosed ((I j₀ ⊔ Y.map X.subtype : Subgroup G) : Set G) :=
    Subgroup.isClosed_coe_sup_of_normal (I j₀) (Y.map X.subtype) (hI j₀) hYGc
  have hIj : ∀ j, I j ≤ I j₀ ⊔ Y.map X.subtype := by
    intro j
    have hd : Dense (Subgroup.zpowers (QuotientGroup.mk (σ j) : G ⧸ X) : Set (G ⧸ X)) := by
      rw [hσγ j]
      exact hγ
    refine le_of_eq_of_le (eq_topologicalClosure_zpowers_of_dense_mk X hXc (I j) (hI j)
      (hIX j) (σ j) (hσI j) hd) ?_
    refine Subgroup.topologicalClosure_minimal _ ?_ hcl
    rw [Subgroup.zpowers_le]
    have h : σ j = (a j : G) * σ j₀ := by
      rw [ha j, inv_mul_cancel_right]
    rw [h]
    exact (I j₀ ⊔ Y.map X.subtype).mul_mem (Subgroup.mem_sup_right (haY j))
      (Subgroup.mem_sup_left (hσI j₀))
  have hZle : Z ≤ (I j₀ ⊔ Y.map X.subtype).topologicalClosure :=
    Subgroup.topologicalClosure_mono (sup_le (hcommY.trans le_sup_right) (iSup_le hIj))
  -- (iv) `YG ≤ Z`
  have hYGZ : Y.map X.subtype ≤ Z := by
    rw [Subgroup.map_le_iff_le_comap]
    have hclosed : IsClosed ((Z.comap X.subtype : Subgroup X) : Set X) := by
      have h : ((Z.comap X.subtype : Subgroup X) : Set X) = Subtype.val ⁻¹' (Z : Set G) := rfl
      rw [h]
      exact (Subgroup.isClosed_topologicalClosure _).preimage continuous_subtype_val
    refine Subgroup.topologicalClosure_minimal _ ?_ hclosed
    rw [Subgroup.closure_le]
    rintro x (hx | ⟨j, rfl⟩)
    · change (x : G) ∈ Z
      refine Subgroup.le_topologicalClosure _ (Subgroup.mem_sup_left ?_)
      rw [hcomm]
      exact ⟨x, hx, rfl⟩
    · change (a j : G) ∈ Z
      rw [ha j]
      refine Subgroup.le_topologicalClosure _ (Subgroup.mem_sup_right ?_)
      exact mul_mem (Subgroup.mem_iSup_of_mem j (hσI j))
        (inv_mem (Subgroup.mem_iSup_of_mem j₀ (hσI j₀)))
  -- (v) `X ⊓ Z = YG`
  have hinf : X ⊓ Z = Y.map X.subtype :=
    Subgroup.inf_eq_self_of_le_topologicalClosure X (I j₀) (Y.map X.subtype) hYGX (hIX j₀)
      (hI j₀) hYGc hYGZ hZle
  rw [← Subgroup.inf_subgroupOf_left, hinf]
  exact Subgroup.comap_map_eq_self_of_injective X.subtype_injective Y

end Compact

/-- A topological group isomorphism `e : A ≃ₜ* B` maps the topological closure of the subgroup
generated by a set `S` onto the topological closure of the subgroup generated by `e '' S`. -/
theorem map_topologicalClosure_closure_continuousMulEquiv
    {A B : Type*} [Group A] [Group B] [TopologicalSpace A] [TopologicalSpace B]
    [IsTopologicalGroup A] [IsTopologicalGroup B] (e : A ≃ₜ* B) (S : Set A) :
    Subgroup.map e.toMulEquiv.toMonoidHom (Subgroup.closure S).topologicalClosure =
      (Subgroup.closure (e '' S)).topologicalClosure := by
  have h1 : Subgroup.closure (e '' S) =
      (Subgroup.closure S).map e.toMulEquiv.toMonoidHom := by
    rw [MonoidHom.map_closure]
    rfl
  apply SetLike.coe_injective
  rw [h1, Subgroup.coe_map, Subgroup.topologicalClosure_coe, Subgroup.topologicalClosure_coe,
    Subgroup.coe_map]
  exact e.toHomeomorph.image_closure _

/-- In additive notation, the topological closure of the subgroup generated by a set `S` is the
topological closure of the additive subgroup generated by the same set, `Additive.ofMul '' S`. -/
theorem toAddSubgroup_topologicalClosure_closure {G : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] (S : Set G) :
    Subgroup.toAddSubgroup (Subgroup.closure S).topologicalClosure =
      (AddSubgroup.closure (Additive.ofMul '' S)).topologicalClosure := by
  have h1 : Additive.ofMul '' S = Additive.toMul ⁻¹' S := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      exact ⟨Additive.toMul x, hx, rfl⟩
  rw [h1, ← Subgroup.toAddSubgroup_closure]
  rfl

end Subgroup

/-! ### The `X∞`-side pieces -/

namespace MvZpExtension

variable {p : ℕ} [Fact p.Prime] {ι K Kinf : Type*} [Finite ι]
variable [Field K] [NumberField K] [Field Kinf] [Algebra K Kinf] [IsGalois K Kinf]
variable (H : MvZpExtension p ι K Kinf)

/-- **A lift of `γ ^ p ^ e` in an inertia subgroup.**  Let `w` be a place of `L∞` and suppose
that the inertia subgroup in `Γ = Gal(K∞/K)` of the place of `K∞` below `w` contains
`Γ ^ (p ^ e)`.  Then for every `γ : G ⧸ X∞` there is an element `σ` of the inertia subgroup
of `w` in `G = Gal(L∞/K)` whose image in `G ⧸ X∞` is `γ ^ p ^ e`.

In the source (`e = 0`, `K∞ / K` totally ramified) this is "let `σ_i ∈ I_i` be the preimage of
`γ`". -/
theorem exists_mem_inertiaSubgroup_mk_eq
    (w : AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ) {e : ℕ}
    (hw : (H.Γpow e : Subgroup H.Γ) ≤ (H.placeBelow w).inertiaSubgroup K)
    (γ : H.GG ⧸ H.Xinf) :
    ∃ σ ∈ w.inertiaSubgroup K, (QuotientGroup.mk σ : H.GG ⧸ H.Xinf) = γ ^ p ^ e := by
  have hmap : (w.inertiaSubgroup K).map
      (AlgEquiv.restrictNormalHom (F := K) (K₁ := ↥(H.Linf.restrictScalars K)) ↥H.KinfIn) =
      ((H.placeBelow w).inertiaSubgroup K).comap (AlgEquiv.autCongr H.kinfInEquiv) := by
    rw [AbsoluteValue.map_inertiaSubgroup_eq_of_liesOver K
      (w.comp (algebraMap ↥H.KinfIn ↥(H.Linf.restrictScalars K)).injective) w,
      H.comp_placeBelow w, AbsoluteValue.inertiaSubgroup_comp_algEquiv_eq_comap]
  have ht : H.gammaMulEquiv (γ ^ p ^ e) ∈ (H.placeBelow w).inertiaSubgroup K := by
    refine hw ?_
    exact (H.mem_Γpow_iff e _).2 ⟨H.gammaMulEquiv γ, map_pow _ _ _⟩
  obtain ⟨t', e1⟩ := (AlgEquiv.autCongr H.kinfInEquiv).surjective
    (H.gammaMulEquiv (γ ^ p ^ e))
  have ht' : t' ∈ (w.inertiaSubgroup K).map
      (AlgEquiv.restrictNormalHom (F := K) (K₁ := ↥(H.Linf.restrictScalars K)) ↥H.KinfIn) := by
    rw [hmap]
    refine Subgroup.mem_comap.2 ?_
    exact e1 ▸ ht
  obtain ⟨σ, hσ, hσt⟩ := ht'
  refine ⟨σ, hσ, ?_⟩
  apply H.gammaMulEquiv.injective
  rw [H.gammaMulEquiv_mk, ← e1, ← hσt]
  rfl

/-- **An inertia subgroup of `L∞ / K` maps injectively to `G ⧸ X∞`.**  Two elements of the
inertia subgroup of one place `w` of `L∞` in `G = Gal(L∞/K)` which have the same image in
`G ⧸ X∞` are equal.  This is the source's `I_i ∩ X∞ = 1`, in the form in which it is used. -/
theorem eq_of_mem_inertiaSubgroup_of_mk_eq (w : AbsoluteValue ↥(H.Linf.restrictScalars K) ℝ)
    {g h : H.GG} (hg : g ∈ w.inertiaSubgroup K) (hh : h ∈ w.inertiaSubgroup K)
    (hgh : (QuotientGroup.mk g : H.GG ⧸ H.Xinf) = QuotientGroup.mk h) : g = h := by
  have hX : g⁻¹ * h ∈ H.Xinf := QuotientGroup.eq.1 hgh
  have h1 := H.inertiaSubgroup_inf_Xinf w (g⁻¹ * h) (mul_mem (inv_mem hg) hh) hX
  exact inv_mul_eq_one.1 h1

/-- **`ω_n X∞ = (γ ^ p ^ n - 1) X∞`.**  For the `Λ = ℤ_p⟦X⟧`-module structure on
`Additive X∞` attached to `γ : G ⧸ X∞`, the underlying set of the submodule
`(ω_n) • ⊤`, where `ω_n = (1 + X) ^ (p ^ n) - 1`, is the underlying set of the subgroup
`{(γ ^ p ^ n • x) x⁻¹ | x ∈ X∞}` of `X∞`, written additively.

The case `n = 0` (`ω_0 = X`) is `MvZpExtension.coe_span_X_smul_top_Xinf`.  No density
hypothesis on `γ` is needed. -/
theorem coe_omega_smul_top_Xinf (γ : H.GG ⧸ H.Xinf) (n : ℕ) :
    letI := H.XinfLambdaModule γ
    ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)} •
        (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) :
        Set (Additive ↥H.Xinf)) =
      ((Subgroup.toAddSubgroup (Subgroup.gammaSubOne H.Xinf H.mul_comm_Xinf' (γ ^ p ^ n)) :
          AddSubgroup (Additive ↥H.Xinf)) : Set (Additive ↥H.Xinf)) := by
  letI := H.XinfLambdaModule γ
  have key : ∀ x : ↥H.Xinf,
      (((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)) •
        Additive.ofMul x =
      Additive.ofMul (Subgroup.conjAct H.Xinf H.mul_comm_Xinf' (γ ^ p ^ n) x * x⁻¹) := by
    intro x
    rw [show (((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)) =
      (1 + X) ^ (p ^ n) - 1 by rw [Polynomial.oneAddXPowSubOne_def]; simp]
    rw [sub_smul, one_smul, H.oneAddX_pow_smul_ofMul γ x (p ^ n)]
    rfl
  rw [Submodule.ideal_span_singleton_smul]
  ext w
  simp only [SetLike.mem_coe]
  constructor
  · intro hw
    obtain ⟨y, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hw
    have hk := key (Additive.toMul y)
    rw [ofMul_toMul] at hk
    rw [hk, Subgroup.ofMul_mem_toAddSubgroup]
    exact Subgroup.conjAct_mul_inv_mem_gammaSubOne H.Xinf H.mul_comm_Xinf' (γ ^ p ^ n) _
  · intro hw
    obtain ⟨g, hg⟩ := (Subgroup.mem_gammaSubOne_iff H.Xinf H.mul_comm_Xinf' (γ ^ p ^ n)
      (Additive.toMul w)).1 hw
    rw [Submodule.mem_smul_pointwise_iff_exists]
    refine ⟨Additive.ofMul g, Submodule.mem_top, ?_⟩
    rw [key, hg]
    rfl

set_option synthInstance.maxHeartbeats 800000 in
/-- **Closure form of the generator description of `Y_n` ⇒ span form.**  Fix `γ`, `e`, a finite
set `a ⊆ Additive X∞` and a level `n`.  If `Y_n`, written additively, is the topological
closure of the additive subgroup generated by the set `ν_{n,e} • a` together with `ω_n X∞`,
then the `ℤ_p`-submodule of `Additive X∞` attached to `Y_n` is
`ℤ_p · (ν_{n,e} • a) + ω_n X∞`.

The conclusion is, for this one `n`, the equation appearing under `∀ n, e ≤ n →` in the
hypothesis `hgen` of `MvZpExtension.multiplicity_classNumber_Kn_eq₁_of_eventual_Yn_data`.
The statement does not assume `e ≤ n`. -/
theorem hgen_of_closure (γ : H.GG ⧸ H.Xinf) (e : ℕ) (a : Finset (Additive ↥H.Xinf)) {n : ℕ}
    (h : letI := H.XinfZpModule
      letI := H.XinfLambdaModule γ
      haveI := H.isScalarTower_Xinf γ
      haveI := H.continuousSMul_XinfZpModule
      Subgroup.toAddSubgroup (H.YnIn n) =
        (AddSubgroup.closure
          ((((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
              (a : Set (Additive ↥H.Xinf))) ∪
            ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) :
                Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)} •
              (⊤ : Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) :
                Submodule ℤ_[p]⟦X⟧ (Additive ↥H.Xinf)) :
                  Set (Additive ↥H.Xinf)))).topologicalClosure) :
    letI := H.XinfZpModule
    letI := H.XinfLambdaModule γ
    haveI := H.isScalarTower_Xinf γ
    H.xinfZpSubmoduleOfSubgroup (H.YnIn n) (H.isClosed_YnIn n) =
      Submodule.span ℤ_[p]
          (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
            (a : Set (Additive ↥H.Xinf))) ⊔
        ((Ideal.span
            {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
