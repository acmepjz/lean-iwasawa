set_option linter.unusedSectionVars false

/-!
# Step 3 of `Xn-isom-qout-of-totally-ramified`: `X_∞` is finitely generated and torsion

Blueprint node `Xn-isom-qout-of-totally-ramified`, Step 3, argues:

* `X / TX` is an extension of the *finite* group `X / Y` by `Y / TX`, which is topologically
  generated by `s - 1` elements over `ℤ_p`; hence `X / TX` is a finitely generated
  `ℤ_p`-module, and the pro-`p` Nakayama lemma makes `X` a finitely generated `Λ`-module;
* `ν_n Y / ω_n X` is a quotient of `Y / TX`, hence of `ℤ_p`-rank at most `s - 1`, and
  `X / ν_n Y` is finite, so `rank_{ℤ_p}(X / ω_n X) ≤ s - 1` for *all* `n`; by
  `p:rank-growth` this rank is `r p^n + O(1)`, whence `r = 0` and `X` is `Λ`-torsion.

The `Λ`-module content of both halves is proved here.

## Main results

* `IwasawaAlgebra.lambdaModuleFinite_of_moduleFinite_quotient_X_smul`: **Nakayama with
  finitely generated coinvariants.**  A profinite `Λ`-module `Z` whose coinvariants
  `Z / TZ` are a finitely generated `ℤ_p`-module is a finitely generated `Λ`-module.  This is
  the form needed in Step 3; `IwasawaAlgebra.lambdaModuleFinite_of_finite_quotient_X_smul`
  (which asks `Z / TZ` to be *finite*) is not enough, because `Y / TX` has positive
  `ℤ_p`-rank in general.
* `IwasawaAlgebra.isTorsion_of_finrank_eq_zero`: a finitely generated `Λ`-module of rank `0`
  is torsion.
* `IwasawaAlgebra.isTorsion_of_forall_finrank_quotSMulTop_omega_le`: **the second half of
  Step 3**: if `rank_{ℤ_p}(M / ω_n M)` is bounded independently of `n`, then `M` is
  `Λ`-torsion.
* `IwasawaAlgebra.finrank_le_card_of_finite_quotient_span`,
  `IwasawaAlgebra.moduleFinite_quotient_of_moduleFinite_of_finite`,
  `IwasawaAlgebra.finrank_quotSMulTop_le_card`: the `ℤ_p`-module inputs of the two halves,
  namely the rank bound from a spanning set with finite cokernel and the extension step
  `M / Y` finite and `Y / TM` finitely generated implies `M / TM` finitely generated.
* `IwasawaAlgebra.moduleFinite_and_isTorsion`,
  `IwasawaAlgebra.moduleFinite_and_isTorsion_of_finite_index`: **Step 3**, assembled.
-/

open Module PowerSeries
open scoped PowerSeries.WithPiTopology
open scoped Pointwise

namespace IwasawaAlgebra

variable {p : ℕ} [Fact p.Prime]

/-! ### Two `ℤ_p`-module lemmas feeding Step 3 -/

section Auxiliary

variable {Q : Type*} [AddCommGroup Q] [Module ℤ_[p] Q]

/-- **The `ℤ_p`-rank bound used in Step 3.**  If a `ℤ_p`-module `Q` has a submodule generated
by `s` with finite quotient, then `rank_{ℤ_p} Q ≤ #s`.  In Step 3 this is applied to
`Q = X / ω_n X` and to the images of the `s - 1` elements `ν_n a_i`. -/
theorem finrank_le_card_of_finite_quotient_span (s : Finset Q)
    (hfin : Finite (Q ⧸ Submodule.span ℤ_[p] (s : Set Q))) :
    Module.finrank ℤ_[p] Q ≤ s.card := by
  haveI := hfin
  haveI : Module.Finite ℤ_[p] ↥(Submodule.span ℤ_[p] (s : Set Q)) :=
    Module.Finite.iff_fg.2 ⟨s, rfl⟩
  haveI : Module.Finite ℤ_[p] (Q ⧸ Submodule.span ℤ_[p] (s : Set Q)) := Module.Finite.of_finite
  haveI : Module.Finite ℤ_[p] Q :=
    Module.Finite.of_submodule_quotient (Submodule.span ℤ_[p] (s : Set Q))
  have hadd := Submodule.finrank_quotient_add_finrank (Submodule.span ℤ_[p] (s : Set Q))
  have h0 : Module.finrank ℤ_[p] (Q ⧸ Submodule.span ℤ_[p] (s : Set Q)) = 0 :=
    Module.finrank_eq_zero_of_finite ℤ_[p] _
  have hs : Module.finrank ℤ_[p] ↥(Submodule.span ℤ_[p] (s : Set Q)) ≤ s.card :=
    finrank_span_finset_le_card (R := ℤ_[p]) s
  omega

/-- **The extension step of Step 3's first half.**  If `N ≤ Y` are `ℤ_p`-submodules of `M`
with `Y / N` a finitely generated `ℤ_p`-module and `M / Y` finite, then `M / N` is a finitely
generated `ℤ_p`-module.  In Step 3, `N = TX`, `Y` is the finite-index submodule, `Y / TX` is
generated by `a_2, …, a_s`, and the conclusion feeds Nakayama. -/
theorem moduleFinite_quotient_of_moduleFinite_of_finite {M : Type*} [AddCommGroup M]
    [Module ℤ_[p] M] (N Y : Submodule ℤ_[p] M) (hNY : N ≤ Y)
    (hY : Module.Finite ℤ_[p] ↥(Y.map N.mkQ)) (hfin : Finite (M ⧸ Y)) :
    Module.Finite ℤ_[p] (M ⧸ N) := by
  haveI := hY
  haveI : Finite ((M ⧸ N) ⧸ Y.map N.mkQ) :=
    Finite.of_equiv _ (Submodule.quotientQuotientEquivQuotient N Y hNY).toEquiv.symm
  haveI : Module.Finite ℤ_[p] ((M ⧸ N) ⧸ Y.map N.mkQ) := Module.Finite.of_finite
  exact Module.Finite.of_submodule_quotient (Y.map N.mkQ)

end Auxiliary

/-! ### Nakayama with finitely generated coinvariants -/

section Nakayama

variable {Z : Type*} [AddCommGroup Z] [Module ℤ_[p] Z] [Module ℤ_[p]⟦X⟧ Z]
  [IsScalarTower ℤ_[p] ℤ_[p]⟦X⟧ Z] [TopologicalSpace Z] [IsTopologicalAddGroup Z]
  [CompactSpace Z] [T2Space Z] [TotallyDisconnectedSpace Z] [ContinuousSMul ℤ_[p]⟦X⟧ Z]

/-- **Blueprint node `p:nak`, the form used in Step 3 of
`Xn-isom-qout-of-totally-ramified`.**  A profinite `Λ`-module whose coinvariants `Z / TZ` are
a finitely generated `ℤ_p`-module is a finitely generated `Λ`-module. -/
theorem lambdaModuleFinite_of_moduleFinite_quotient_X_smul
    (hfg : Module.Finite ℤ_[p]
      (Z ⧸ ((Ideal.span {(X : ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ Z)).restrictScalars ℤ_[p]))) :
    Module.Finite ℤ_[p]⟦X⟧ Z := by
  classical
  set N : Submodule ℤ_[p] Z :=
    (Ideal.span {(X : ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ Z)).restrictScalars ℤ_[p] with hN
  obtain ⟨t, ht⟩ := hfg.1
  -- lift the `ℤ_p`-generators of `Z / TZ` to `Z`
  choose sec hsec using (N.mkQ_surjective)
  set s : Finset Z := t.image sec with hs
  set W : Submodule ℤ_[p]⟦X⟧ Z :=
    Submodule.span ℤ_[p]⟦X⟧ (s : Set Z) ⊔ Ideal.span {(X : ℤ_[p]⟦X⟧)} •
      (⊤ : Submodule ℤ_[p]⟦X⟧ Z) with hW
  have hsub : N ≤ W.restrictScalars ℤ_[p] := fun z hz ↦
    (le_sup_right : Ideal.span {(X : ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ Z) ≤ W) hz
  have hmap : Submodule.map N.mkQ (W.restrictScalars ℤ_[p]) = ⊤ := by
    rw [eq_top_iff, ← ht]
    refine Submodule.span_le.2 fun q hq ↦ ⟨sec q, ?_, hsec q⟩
    exact (le_sup_left : Submodule.span ℤ_[p]⟦X⟧ (s : Set Z) ≤ W)
      (Submodule.subset_span (Finset.mem_image_of_mem sec hq))
  have hWtop : W = ⊤ := by
    have hker : LinearMap.ker N.mkQ ≤ W.restrictScalars ℤ_[p] := by
      rwa [Submodule.ker_mkQ]
    have hcm := Submodule.comap_map_eq_self hker
    rw [hmap, Submodule.comap_top] at hcm
    exact (Submodule.restrictScalars_eq_top_iff ℤ_[p] ℤ_[p]⟦X⟧ Z).1 hcm.symm
  have hspan : Submodule.span ℤ_[p]⟦X⟧ (s : Set Z) = ⊤ :=
    span_eq_top_of_sup_X_smul_top_le s (le_of_eq hWtop.symm)
  exact ⟨⟨s, by rw [hspan]⟩⟩

/-- A restatement of `IwasawaAlgebra.lambdaModuleFinite_of_moduleFinite_quotient_X_smul` in
which the coinvariants are presented by an arbitrary `ℤ_p`-submodule `N` whose underlying set
is `T Z`; this is how the operator-theoretic side (`IwasawaAlgebra.coe_span_X_smul_top`, where
`T Z` appears as `LinearMap.range d`) hands it over. -/
theorem lambdaModuleFinite_of_moduleFinite_quotient (N : Submodule ℤ_[p] Z)
    (hN : (N : Set Z)
      = ((Ideal.span {(X : ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ Z) : Submodule ℤ_[p]⟦X⟧ Z) :
          Set Z))
    (hfg : Module.Finite ℤ_[p] (Z ⧸ N)) :
    Module.Finite ℤ_[p]⟦X⟧ Z := by
  haveI := hfg
  refine lambdaModuleFinite_of_moduleFinite_quotient_X_smul ?_
  exact Module.Finite.equiv (Submodule.quotEquivOfEq N _ (SetLike.ext' hN))

end Nakayama

/-! ### Torsion from a bounded `ℤ_p`-rank of the `ω_n`-coinvariants -/

section Torsion

variable {M : Type*} [AddCommGroup M] [Module ℤ_[p] M] [Module ℤ_[p]⟦X⟧ M]
  [IsScalarTower ℤ_[p] ℤ_[p]⟦X⟧ M] [Module.Finite ℤ_[p]⟦X⟧ M]

/-- A finitely generated `Λ`-module of `Λ`-rank `0` is a torsion `Λ`-module. -/
theorem isTorsion_of_finrank_eq_zero (hrank : Module.finrank ℤ_[p]⟦X⟧ M = 0) :
    Module.IsTorsion ℤ_[p]⟦X⟧ M := by
  obtain ⟨L, hLfree, hLfin, hLrank, hQtor⟩ :=
    Module.exists_free_submodule_isTorsion_quotient ℤ_[p]⟦X⟧ M
  haveI := hLfree
  haveI := hLfin
  haveI : Subsingleton ↥L := Module.finrank_zero_iff.1 (by rw [hLrank, hrank])
  have hLbot : L = ⊥ := by
    refine (Submodule.eq_bot_iff L).2 fun x hx ↦ ?_
    exact congrArg Subtype.val (Subsingleton.elim (⟨x, hx⟩ : ↥L) 0)
  subst hLbot
  exact (Submodule.quotEquivOfEqBot (⊥ : Submodule ℤ_[p]⟦X⟧ M) rfl).isTorsion.1 hQtor

/-- **Blueprint node `Xn-isom-qout-of-totally-ramified`, Step 3, second half.**  If the
`ℤ_p`-ranks of the coinvariants `M / ω_n M` are bounded independently of `n`, then the
finitely generated `Λ`-module `M` is `Λ`-torsion.  Indeed by blueprint node `p:rank-growth`
(`IwasawaAlgebra.exists_bound_finrank_quotSMulTop_omega`) that rank is
`rank_Λ(M) p^n + O(1)`, which is bounded only if `rank_Λ(M) = 0`. -/
theorem isTorsion_of_forall_finrank_quotSMulTop_omega_le (c : ℕ)
    (hle : ∀ n : ℕ, Module.finrank ℤ_[p] (QuotSMulTop
      ((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) M) ≤ c) :
    Module.IsTorsion ℤ_[p]⟦X⟧ M := by
  have hp1 : 1 < p := (Fact.out : p.Prime).one_lt
  obtain ⟨c', hc'⟩ := exists_bound_finrank_quotSMulTop_omega (p := p) M
  refine isTorsion_of_finrank_eq_zero ?_
  by_contra hne
  set r := Module.finrank ℤ_[p]⟦X⟧ M with hr
  set n := c + c' + 1 with hn
  have hpow : c + c' < p ^ n := lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.lt_pow_self hp1).le
  have h1 := hc' n
  have h2 := hle n
  have h3 : p ^ n ≤ r * p ^ n := Nat.le_mul_of_pos_left _ (Nat.pos_of_ne_zero hne)
  have h4 : (r : ℤ) * (p : ℤ) ^ n = ((r * p ^ n : ℕ) : ℤ) := by push_cast; ring
  rw [h4] at h1
  omega

/-- **The rank bound of Step 3, in the form the geometry supplies it.**  Let `N` be a
`ℤ_p`-submodule of finite index in `M` (in Step 3, `N = ν_n Y`) and let `s` be a finite set
whose `ℤ_p`-span covers `N` modulo `g M` (in Step 3, `g = ω_n` and `s` consists of the
`s - 1` elements `ν_n a_i`, using `ω_n M = ν_n T M ⊆ ν_n Y`).  Then
`rank_{ℤ_p}(M / g M) ≤ #s`, a bound independent of `g`. -/
theorem finrank_quotSMulTop_le_card (g : ℤ_[p]⟦X⟧) (N : Submodule ℤ_[p] M)
    (hfin : Finite (M ⧸ N)) (s : Finset M)
    (hs : ∀ y ∈ N, ∃ v ∈ Submodule.span ℤ_[p] (s : Set M),
      y - v ∈ Ideal.span {g} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)) :
    Module.finrank ℤ_[p] (QuotSMulTop g M) ≤ s.card := by
  classical
  haveI := hfin
  have hPeq : Ideal.span {g} • (⊤ : Submodule ℤ_[p]⟦X⟧ M) = g • (⊤ : Submodule ℤ_[p]⟦X⟧ M) :=
    Submodule.ideal_span_singleton_smul g ⊤
  set P : Submodule ℤ_[p]⟦X⟧ M := g • (⊤ : Submodule ℤ_[p]⟦X⟧ M) with hP
  set π : M →ₗ[ℤ_[p]] QuotSMulTop g M := LinearMap.restrictScalars ℤ_[p] P.mkQ with hπ
  have hπsurj : Function.Surjective π := P.mkQ_surjective
  set s' : Finset (QuotSMulTop g M) := s.image π with hs'
  set S : Submodule ℤ_[p] (QuotSMulTop g M) :=
    Submodule.span ℤ_[p] (s' : Set (QuotSMulTop g M)) with hS
  have hfinQS : Finite ((QuotSMulTop g M) ⧸ S) := by
    have hker : N ≤ LinearMap.ker (S.mkQ.comp π) := by
      intro y hy
      obtain ⟨v, hv, hvy⟩ := hs y hy
      have h1 : π y = π v := by
        have h0 : π (y - v) = 0 := (Submodule.Quotient.mk_eq_zero P).2 (hPeq ▸ hvy)
        rw [map_sub, sub_eq_zero] at h0
        exact h0
      have h2 : π v ∈ S := by
        have := Submodule.apply_mem_span_image_of_mem_span (f := π) hv
        rwa [hS, hs', Finset.coe_image]
      simp only [LinearMap.mem_ker, LinearMap.coe_comp, Function.comp_apply, h1,
        Submodule.mkQ_apply]
      exact (Submodule.Quotient.mk_eq_zero S).2 h2
    refine Finite.of_surjective (Submodule.liftQ N _ hker) ?_
    refine Function.Surjective.of_comp (g := N.mkQ) ?_
    have : (Submodule.liftQ N (S.mkQ.comp π) hker) ∘ N.mkQ = S.mkQ ∘ π := rfl
    rw [this]
    exact (Submodule.mkQ_surjective S).comp hπsurj
  exact (finrank_le_card_of_finite_quotient_span s' hfinQS).trans (Finset.card_image_le)

/-- **Blueprint node `Xn-isom-qout-of-totally-ramified`, Step 3.**  A profinite `Λ`-module
whose coinvariants `M / TM` are a finitely generated `ℤ_p`-module and whose `ω_n`-coinvariants
have `ℤ_p`-rank bounded independently of `n` is a finitely generated torsion `Λ`-module. -/
theorem moduleFinite_and_isTorsion [TopologicalSpace M] [IsTopologicalAddGroup M]
    [CompactSpace M] [T2Space M] [TotallyDisconnectedSpace M] [ContinuousSMul ℤ_[p]⟦X⟧ M]
    (hfg : Module.Finite ℤ_[p]
      (M ⧸ ((Ideal.span {(X : ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)).restrictScalars ℤ_[p])))
    (c : ℕ)
    (hle : ∀ n : ℕ, Module.finrank ℤ_[p] (QuotSMulTop
      ((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) M) ≤ c) :
    Module.Finite ℤ_[p]⟦X⟧ M ∧ Module.IsTorsion ℤ_[p]⟦X⟧ M := by
  haveI := lambdaModuleFinite_of_moduleFinite_quotient_X_smul hfg
  exact ⟨this, isTorsion_of_forall_finrank_quotSMulTop_omega_le c hle⟩

/-- **Blueprint node `Xn-isom-qout-of-totally-ramified`, Step 3, assembled.**  Let `M` be a
profinite `Λ`-module, `Y` a `ℤ_p`-submodule containing `T M` with `M / Y` finite and `Y / TM`
a finitely generated `ℤ_p`-module, and suppose that for every `n` there is a `ℤ_p`-submodule
`N n` of finite index (in the application `N n = ν_n Y`) covered modulo `ω_n M` by at most `c`
elements.  Then `M` is a finitely generated torsion `Λ`-module. -/
theorem moduleFinite_and_isTorsion_of_finite_index [TopologicalSpace M]
    [IsTopologicalAddGroup M] [CompactSpace M] [T2Space M] [TotallyDisconnectedSpace M]
    [ContinuousSMul ℤ_[p]⟦X⟧ M] (Y : Submodule ℤ_[p] M)
    (hTY : ((Ideal.span {(X : ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)).restrictScalars ℤ_[p])
      ≤ Y)
    (hYfg : Module.Finite ℤ_[p] ↥(Y.map
      ((Ideal.span {(X : ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)).restrictScalars ℤ_[p]).mkQ))
    (hMY : Finite (M ⧸ Y)) (c : ℕ) (N : ℕ → Submodule ℤ_[p] M)
    (hN : ∀ n, Finite (M ⧸ N n)) (sN : ℕ → Finset M) (hcard : ∀ n, (sN n).card ≤ c)
    (hcov : ∀ n : ℕ, ∀ y ∈ N n, ∃ v ∈ Submodule.span ℤ_[p] ((sN n : Finset M) : Set M),
      y - v ∈ Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
        ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)) :
    Module.Finite ℤ_[p]⟦X⟧ M ∧ Module.IsTorsion ℤ_[p]⟦X⟧ M :=
  moduleFinite_and_isTorsion
    (moduleFinite_quotient_of_moduleFinite_of_finite _ Y hTY hYfg hMY) c
    (fun n ↦ (finrank_quotSMulTop_le_card _ (N n) (hN n) (sN n) (hcov n)).trans (hcard n))

end Torsion

end IwasawaAlgebra
