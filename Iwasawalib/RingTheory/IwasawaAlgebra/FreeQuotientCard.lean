module

public import Mathlib.LinearAlgebra.Quotient.Pi
public import Mathlib.LinearAlgebra.Basis.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.SetTheory.Cardinal.Finite

@[expose] public section

/-!
# Quotients of a free module by `I • M`

If `M` is a free `A`-module with a finite basis indexed by `ι` and `I` is an ideal of `A`,
then `M ⧸ I • M` is isomorphic to `ι → A ⧸ I`; in particular its cardinality is
`#(A ⧸ I) ^ #ι`.
-/

namespace Module.Basis

variable {A M ι : Type*} [CommRing A] [AddCommGroup M] [Module A M] [Fintype ι] [DecidableEq ι]
  (b : Module.Basis ι A M) (I : Ideal A)

omit [DecidableEq ι] in
theorem map_equivFun_smul_top :
    Submodule.map (b.equivFun : M →ₗ[A] ι → A) (I • ⊤) =
      Submodule.pi Set.univ fun _ : ι ↦ (I : Submodule A A) := by
  refine le_antisymm ?_ fun y hy ↦ ?_
  · rw [Submodule.map_le_iff_le_comap]
    refine Submodule.smul_le.2 fun c hc x _ ↦ ?_
    simp only [Submodule.mem_comap, LinearEquiv.coe_coe, map_smul, Submodule.mem_pi,
      Set.mem_univ, forall_const, Pi.smul_apply, smul_eq_mul]
    exact fun i ↦ Ideal.mul_mem_right _ _ hc
  · refine ⟨b.equivFun.symm y, ?_, b.equivFun.apply_symm_apply y⟩
    rw [Module.Basis.equivFun_symm_apply]
    refine Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem_smul ?_ Submodule.mem_top
    simpa using (Submodule.mem_pi ..).1 hy i (Set.mem_univ i)

/-- If `M` is free with basis indexed by `ι`, then `M ⧸ I • M ≃ₗ[A] (ι → A ⧸ I)`. -/
noncomputable def quotientSmulTopEquivPi :
    (M ⧸ (I • ⊤ : Submodule A M)) ≃ₗ[A] (ι → A ⧸ I) :=
  (Submodule.Quotient.equiv _ _ b.equivFun (b.map_equivFun_smul_top I)).trans
    (Submodule.quotientPi _)

include b in
theorem card_quotient_smul_top :
    Nat.card (M ⧸ (I • ⊤ : Submodule A M)) = Nat.card (A ⧸ I) ^ Fintype.card ι := by
  rw [Nat.card_congr (b.quotientSmulTopEquivPi I).toEquiv, Nat.card_pi, Finset.prod_const,
    Finset.card_univ]

end Module.Basis

namespace Ideal

variable {A M : Type*} [CommRing A] [CommRing M] [Algebra A M]

/-- If an ideal `J` of `M` and an `A`-submodule `K` of `M` have the same underlying set,
then the two quotients are in bijection. -/
def quotientEquivQuotientOfCarrierEq (J : Ideal M) (K : Submodule A M)
    (h : (J : Set M) = (K : Set M)) : (M ⧸ J) ≃ (M ⧸ K) :=
  Quotient.congr (Equiv.refl M) fun x y ↦ by
    simp only [Equiv.refl_apply, Submodule.quotientRel_def]
    exact ⟨fun hx ↦ (Set.ext_iff.1 h (x - y)).1 hx, fun hx ↦ (Set.ext_iff.1 h (x - y)).2 hx⟩

/-- The ideal of `M` generated by the image of `a : A` is the `A`-submodule `(a) • M`. -/
theorem coe_span_algebraMap_eq (a : A) :
    ((Ideal.span {algebraMap A M a} : Ideal M) : Set M) =
      ((Ideal.span {a} • ⊤ : Submodule A M) : Set M) := by
  ext x
  simp only [SetLike.mem_coe]
  constructor
  · intro hx
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.1 hx
    have : y * algebraMap A M a = a • y := by rw [Algebra.smul_def]; ring
    rw [this]
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self a) Submodule.mem_top
  · intro hx
    refine Submodule.smul_induction_on hx (fun c hc y _ ↦ ?_) fun _ _ h1 h2 ↦ Ideal.add_mem _ h1 h2
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.1 hc
    exact Ideal.mem_span_singleton'.2 ⟨algebraMap A M r * y, by rw [Algebra.smul_def, map_mul]; ring⟩

end Ideal
