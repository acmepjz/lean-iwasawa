@[expose] public section

/-!
# The structure theorem for finitely generated torsion `Λ`-modules

This file proves blueprint node `Lambda-module-structure` and sets up the `μ`- and
`λ`-invariants of blueprint node `iwasawa-mod-invariants` (ii).

## Main results

* `IwasawaAlgebra.exists_gen_of_height_eq_one`: a height one prime of `Λ = ℤ_p⟦X⟧` is
  generated either by `p` or by a distinguished polynomial of positive degree.
* `IwasawaAlgebra.IsWeierstrassNormalForm`: the normal form `f = p ^ m * F * u` of a nonzero
  element of `Λ`, with `F` distinguished and `u` a unit; it exists and is unique.
* `IwasawaAlgebra.mu`, `IwasawaAlgebra.lambda`: the resulting `μ`- and `λ`-invariants of an
  element of `Λ`.
* `IwasawaAlgebra.exists_isPseudoIsomorphic_pi`: **blueprint node `Lambda-module-structure`**,
  a finitely generated torsion `Λ`-module is pseudo-isomorphic to a finite product of
  `Λ ⧸ (g ^ e)` where each `g` is `p` or an irreducible distinguished polynomial.
-/

open PowerSeries

namespace IwasawaAlgebra

variable {p : ℕ} [Fact p.Prime]

/-- **Blueprint node `Lambda-ht-1-principal`**, combined form: a height one prime of
`Λ = ℤ_p⟦X⟧` is generated by a prime element, which may be taken to be either `p` itself or
a distinguished polynomial of positive degree. -/
theorem exists_gen_of_height_eq_one {P : Ideal ℤ_[p]⟦X⟧} [P.IsPrime] (hP : P.height = 1) :
    ∃ g : ℤ_[p]⟦X⟧, Prime g ∧ P = Ideal.span {g} ∧
      (g = (p : ℤ_[p]⟦X⟧) ∨ ∃ F : Polynomial ℤ_[p],
        F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p]) ∧ 0 < F.natDegree ∧
          g = (F : ℤ_[p]⟦X⟧)) := by
  by_cases hp : (p : ℤ_[p]⟦X⟧) ∈ P
  · exact ⟨(p : ℤ_[p]⟦X⟧), prime_p p, eq_span_singleton_p_of_mem hP hp, Or.inl rfl⟩
  · obtain ⟨F, ⟨hF, hPF⟩, -⟩ := exists_unique_distinguished_span_eq_of_height_eq_one hP hp
    have hdeg : 0 < F.natDegree := by
      rcases Nat.eq_zero_or_pos F.natDegree with h | h
      · exfalso
        have hc : F.coeff 0 = 1 := by
          have hm := hF.monic
          rw [Polynomial.Monic, Polynomial.leadingCoeff, h] at hm
          exact hm
        have hF1 : F = 1 := by
          have e := Polynomial.eq_C_of_natDegree_eq_zero h
          rw [hc, Polynomial.C_1] at e
          exact e
        rw [hF1, Polynomial.coe_one, Ideal.span_singleton_one] at hPF
        exact ‹P.IsPrime›.ne_top hPF
      · exact h
    have hne : (F : ℤ_[p]⟦X⟧) ≠ 0 := by
      intro h
      rw [h, Ideal.span_singleton_eq_bot.2 rfl] at hPF
      exact Ideal.ne_bot_of_height_eq_one hP hPF
    exact ⟨(F : ℤ_[p]⟦X⟧), (Ideal.span_singleton_prime hne).1 (hPF ▸ ‹P.IsPrime›), hPF,
      Or.inr ⟨F, hF, hdeg, rfl⟩⟩

/-- The Weierstrass normal form `f = p ^ m * F * u` of an element of `Λ = ℤ_p⟦X⟧`, with `F`
a distinguished polynomial and `u` a unit. -/
structure IsWeierstrassNormalForm (f : ℤ_[p]⟦X⟧) (m : ℕ) (F : Polynomial ℤ_[p])
    (u : ℤ_[p]⟦X⟧) : Prop where
  isDistinguishedAt : F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p])
  isUnit : IsUnit u
  eq : f = (p : ℤ_[p]⟦X⟧) ^ m * (F : ℤ_[p]⟦X⟧) * u

/-- `p` does not divide a distinguished polynomial in `ℤ_p⟦X⟧`. -/
theorem not_p_dvd_of_isDistinguishedAt {F : Polynomial ℤ_[p]}
    (hF : F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p])) :
    ¬ (p : ℤ_[p]⟦X⟧) ∣ (F : ℤ_[p]⟦X⟧) := by
  intro h
  rw [show ((p : ℤ_[p]⟦X⟧)) = PowerSeries.C (p : ℤ_[p]) from (map_natCast _ _).symm,
    PowerSeries.C_dvd_iff] at h
  have h1 := h F.natDegree
  rw [Polynomial.coeff_coe, hF.monic.coeff_natDegree] at h1
  exact (PadicInt.prime_p (p := p)).not_unit (isUnit_of_dvd_one h1)

/-- Existence of the Weierstrass normal form. -/
theorem exists_isWeierstrassNormalForm {f : ℤ_[p]⟦X⟧} (hf : f ≠ 0) :
    ∃ (m : ℕ) (F : Polynomial ℤ_[p]) (u : ℤ_[p]⟦X⟧), IsWeierstrassNormalForm f m F u := by
  have hfin : FiniteMultiplicity (p : ℤ_[p]⟦X⟧) f := FiniteMultiplicity.of_prime_left (prime_p p) hf
  obtain ⟨g, hg⟩ := pow_multiplicity_dvd (p : ℤ_[p]⟦X⟧) f
  have hgp : ¬ (p : ℤ_[p]⟦X⟧) ∣ g := by
    intro ⟨c, hc⟩
    refine hfin.not_pow_dvd_of_multiplicity_lt (Nat.lt_succ_self _) ⟨c, ?_⟩
    rw [pow_succ, mul_assoc, ← hc]
    exact hg
  have hmap : g.map (IsLocalRing.residue ℤ_[p]) ≠ 0 := fun h ↦ hgp (map_residue_eq_zero_iff.1 h)
  obtain ⟨F, u, hFu⟩ := PowerSeries.exists_isWeierstrassFactorization hmap
  exact ⟨multiplicity (p : ℤ_[p]⟦X⟧) f, F, u,
    ⟨hFu.isDistinguishedAt, hFu.isUnit, by rw [mul_assoc, ← hFu.eq_mul]; exact hg⟩⟩

/-- Uniqueness of the Weierstrass normal form. -/
theorem IsWeierstrassNormalForm.unique {f : ℤ_[p]⟦X⟧} {m m' : ℕ} {F F' : Polynomial ℤ_[p]}
    {u u' : ℤ_[p]⟦X⟧} (H : IsWeierstrassNormalForm f m F u)
    (H' : IsWeierstrassNormalForm f m' F' u') : m = m' ∧ F = F' ∧ u = u' := by
  have key : ∀ (k : ℕ) (G : Polynomial ℤ_[p]) (v : ℤ_[p]⟦X⟧),
      G.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p]) → IsUnit v →
      ¬ (p : ℤ_[p]⟦X⟧) ∣ ((G : ℤ_[p]⟦X⟧) * v) := by
    intro k G v hG hv hdvd
    obtain ⟨w, rfl⟩ := hv
    have h2 : (p : ℤ_[p]⟦X⟧) ∣ (G : ℤ_[p]⟦X⟧) * (w : ℤ_[p]⟦X⟧) * ((w⁻¹ : ℤ_[p]⟦X⟧ˣ) :
        ℤ_[p]⟦X⟧) := hdvd.mul_right _
    rw [mul_assoc, Units.mul_inv, mul_one] at h2
    exact not_p_dvd_of_isDistinguishedAt hG h2
  have hFu : ¬ (p : ℤ_[p]⟦X⟧) ∣ ((F : ℤ_[p]⟦X⟧) * u) := key m F u H.isDistinguishedAt H.isUnit
  have hFu' : ¬ (p : ℤ_[p]⟦X⟧) ∣ ((F' : ℤ_[p]⟦X⟧) * u') := key m' F' u' H'.isDistinguishedAt
    H'.isUnit
  have heq : (p : ℤ_[p]⟦X⟧) ^ m * ((F : ℤ_[p]⟦X⟧) * u) =
      (p : ℤ_[p]⟦X⟧) ^ m' * ((F' : ℤ_[p]⟦X⟧) * u') := by
    rw [← mul_assoc, ← mul_assoc, ← H.eq, ← H'.eq]
  have hm : m = m' := by
    rcases le_total m m' with h | h
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · omega
      · exfalso
        apply hFu
        refine ⟨(p : ℤ_[p]⟦X⟧) ^ (k - 1) * ((F' : ℤ_[p]⟦X⟧) * u'), ?_⟩
        have hpne : ((p : ℤ_[p]⟦X⟧)) ^ m ≠ 0 := pow_ne_zero _ (prime_p p).ne_zero
        refine mul_left_cancel₀ hpne ?_
        rw [heq, pow_add]
        obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
        simp only [Nat.add_sub_cancel, pow_succ]
        ring
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · omega
      · exfalso
        apply hFu'
        refine ⟨(p : ℤ_[p]⟦X⟧) ^ (k - 1) * ((F : ℤ_[p]⟦X⟧) * u), ?_⟩
        have hpne : ((p : ℤ_[p]⟦X⟧)) ^ m' ≠ 0 := pow_ne_zero _ (prime_p p).ne_zero
        refine mul_left_cancel₀ hpne ?_
        rw [← heq, pow_add]
        obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
        simp only [Nat.add_sub_cancel, pow_succ]
        ring
  subst hm
  have hcancel : (F : ℤ_[p]⟦X⟧) * u = (F' : ℤ_[p]⟦X⟧) * u' :=
    mul_left_cancel₀ (pow_ne_zero m (prime_p p).ne_zero) heq
  have hspan : Ideal.span {(F : ℤ_[p]⟦X⟧)} = Ideal.span {(F' : ℤ_[p]⟦X⟧)} := by
    rw [← Ideal.span_singleton_mul_right_unit H.isUnit, hcancel,
      Ideal.span_singleton_mul_right_unit H'.isUnit]
  have hFF : F = F' := IsDistinguishedAt.eq_of_span_eq H.isDistinguishedAt H'.isDistinguishedAt
    hspan
  subst hFF
  refine ⟨rfl, rfl, ?_⟩
  have hFne : (F : ℤ_[p]⟦X⟧) ≠ 0 := by
    intro h
    exact not_p_dvd_of_isDistinguishedAt H.isDistinguishedAt (h ▸ dvd_zero _)
  exact mul_left_cancel₀ hFne hcancel

open Classical in
/-- The pair `(μ, F)` extracted from the Weierstrass normal form of `f`; junk for `f = 0`. -/
noncomputable def weierstrassData (f : ℤ_[p]⟦X⟧) : ℕ × Polynomial ℤ_[p] :=
  if h : ∃ (m : ℕ) (F : Polynomial ℤ_[p]) (u : ℤ_[p]⟦X⟧), IsWeierstrassNormalForm f m F u then
    (h.choose, h.choose_spec.choose) else (0, 0)

/-- **Blueprint node `iwasawa-mod-invariants` (ii)**: the `μ`-invariant of `f ∈ Λ`, i.e. the
largest `m` with `f ∈ p ^ m Λ`. -/
noncomputable def mu (f : ℤ_[p]⟦X⟧) : ℕ := (weierstrassData f).1

/-- **Blueprint node `iwasawa-mod-invariants` (ii)**: the `λ`-invariant of `f ∈ Λ`, i.e. the
degree of the distinguished polynomial in the Weierstrass normal form of `f`. -/
noncomputable def lambda (f : ℤ_[p]⟦X⟧) : ℕ := (weierstrassData f).2.natDegree

theorem weierstrassData_spec {f : ℤ_[p]⟦X⟧} (hf : f ≠ 0) :
    ∃ u : ℤ_[p]⟦X⟧, IsWeierstrassNormalForm f (mu f) (weierstrassData f).2 u := by
  classical
  have h : ∃ (m : ℕ) (F : Polynomial ℤ_[p]) (u : ℤ_[p]⟦X⟧), IsWeierstrassNormalForm f m F u :=
    exists_isWeierstrassNormalForm hf
  rw [mu, weierstrassData, dif_pos h]
  exact ⟨h.choose_spec.choose_spec.choose, h.choose_spec.choose_spec.choose_spec⟩

/-- The `μ`- and `λ`-invariants read off any Weierstrass normal form. -/
theorem IsWeierstrassNormalForm.mu_eq_and_lambda_eq {f : ℤ_[p]⟦X⟧} {m : ℕ}
    {F : Polynomial ℤ_[p]} {u : ℤ_[p]⟦X⟧} (hf : f ≠ 0) (H : IsWeierstrassNormalForm f m F u) :
    mu f = m ∧ lambda f = F.natDegree := by
  obtain ⟨v, hv⟩ := weierstrassData_spec hf
  obtain ⟨h1, h2, -⟩ := hv.unique H
  exact ⟨h1, by rw [lambda, h2]⟩

/-- **Blueprint node `Lambda-module-structure`**: a finitely generated torsion module over the
Iwasawa algebra `Λ = ℤ_p⟦X⟧` is pseudo-isomorphic to a finite product of modules `Λ ⧸ (g ^ e)`
with `e ≥ 1`, where each `g` is either `p` or an irreducible distinguished polynomial of
positive degree. -/
theorem exists_isPseudoIsomorphic_pi {M : Type*} [AddCommGroup M] [Module ℤ_[p]⟦X⟧ M]
    [Module.Finite ℤ_[p]⟦X⟧ M] (hM : Module.IsTorsion ℤ_[p]⟦X⟧ M) :
    ∃ (ι : Type) (_ : Fintype ι) (g : ι → ℤ_[p]⟦X⟧) (e : ι → ℕ),
      (∀ i, Prime (g i)) ∧ (∀ i, 0 < e i) ∧
      (∀ i, g i = (p : ℤ_[p]⟦X⟧) ∨ ∃ F : Polynomial ℤ_[p],
        F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p]) ∧ 0 < F.natDegree ∧
          g i = (F : ℤ_[p]⟦X⟧)) ∧
      M ∼ₚᵢₛ[ℤ_[p]⟦X⟧] ((i : ι) → ℤ_[p]⟦X⟧ ⧸ Ideal.span {g i ^ e i}) := by
  obtain ⟨ι, hι, P, hPheight, e, he, hpis⟩ := hM.isPseudoIsomorphic_pi
  have hgen : ∀ i : ι, ∃ g : ℤ_[p]⟦X⟧, Prime g ∧ (P i).1 = Ideal.span {g} ∧
      (g = (p : ℤ_[p]⟦X⟧) ∨ ∃ F : Polynomial ℤ_[p],
        F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p]) ∧ 0 < F.natDegree ∧
          g = (F : ℤ_[p]⟦X⟧)) := fun i ↦
    have : (P i).1.IsPrime := (P i).2
    exists_gen_of_height_eq_one (hPheight i)
  choose g hgprime hgspan hgcases using hgen
  have hideal : ∀ i : ι, (P i).1 ^ (e i) = Ideal.span {g i ^ e i} := fun i ↦ by
    rw [hgspan i, Ideal.span_singleton_pow]
  refine ⟨ι, hι, g, e, hgprime, he, hgcases, hpis.trans ⟨_,
    (LinearEquiv.piCongrRight fun i ↦ Submodule.quotEquivOfEq _ _ (congrArg
      (fun I : Ideal ℤ_[p]⟦X⟧ ↦ (I : Submodule ℤ_[p]⟦X⟧ ℤ_[p]⟦X⟧)) (hideal i))).isPseudoIsomorphism⟩⟩

end IwasawaAlgebra
