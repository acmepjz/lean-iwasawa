module

public import Iwasawalib.RingTheory.IwasawaAlgebra.CharacteristicIdealPow

@[expose] public section

/-!
# The `μ`- and `λ`-invariants of a finitely generated torsion `Λ`-module

Blueprint node `iwasawa-mod-invariants` defines `μ(f)` and `λ(f)` for an element `f` of the
Iwasawa algebra through its Weierstrass normal form `f = p ^ μ * F * u`; this is
`IwasawaAlgebra.mu` and `IwasawaAlgebra.lambda`. Node `iwasawa-mod-invariants-2` transfers
these to a finitely generated torsion `Λ`-module `M` through a generator of its characteristic
ideal; this file carries out that transfer.

## Main results

* `IwasawaAlgebra.mu_mul`, `IwasawaAlgebra.lambda_mul`: additivity of `μ` and `λ`.
* `IwasawaAlgebra.mu_of_associated`, `IwasawaAlgebra.lambda_of_associated`: `μ` and `λ` only
  depend on the ideal generated by `f`.
* `IwasawaAlgebra.muMod`, `IwasawaAlgebra.lambdaMod`: the invariants of a module, together with
  `IwasawaAlgebra.muMod_eq`, `IwasawaAlgebra.lambdaMod_eq` which read them off any generator
  of the characteristic ideal.
* `IwasawaAlgebra.muMod_eq_sum`, `IwasawaAlgebra.lambdaMod_eq_sum`: their values on the
  decomposition provided by the structure theorem.
-/

open PowerSeries

namespace IwasawaAlgebra

variable {p : ℕ} [Fact p.Prime]

section Elements

/-- `p` has `μ = 1` and `λ = 0`. -/
theorem isWeierstrassNormalForm_p :
    IsWeierstrassNormalForm (p : ℤ_[p]⟦X⟧) 1 1 1 :=
  ⟨⟨⟨fun {i} hi ↦ by simp only [Polynomial.natDegree_one] at hi; omega⟩, Polynomial.monic_one⟩,
    isUnit_one, by simp⟩

theorem mu_p : mu (p : ℤ_[p]⟦X⟧) = 1 :=
  (isWeierstrassNormalForm_p.mu_eq_and_lambda_eq (prime_p p).ne_zero).1

theorem lambda_p : lambda (p : ℤ_[p]⟦X⟧) = 0 := by
  rw [(isWeierstrassNormalForm_p.mu_eq_and_lambda_eq (prime_p p).ne_zero).2,
    Polynomial.natDegree_one]

/-- A distinguished polynomial has `μ = 0` and `λ = its degree`. -/
theorem isWeierstrassNormalForm_distinguished {F : Polynomial ℤ_[p]}
    (hF : F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p])) :
    IsWeierstrassNormalForm (F : ℤ_[p]⟦X⟧) 0 F 1 :=
  ⟨hF, isUnit_one, by simp⟩

theorem coe_ne_zero_of_isDistinguishedAt {F : Polynomial ℤ_[p]}
    (hF : F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p])) : (F : ℤ_[p]⟦X⟧) ≠ 0 :=
  fun h ↦ hF.monic.ne_zero (Polynomial.coe_injective (R := ℤ_[p])
    (h.trans Polynomial.coe_zero.symm))

theorem mu_coe_distinguished {F : Polynomial ℤ_[p]}
    (hF : F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p])) : mu (F : ℤ_[p]⟦X⟧) = 0 :=
  ((isWeierstrassNormalForm_distinguished hF).mu_eq_and_lambda_eq
    (coe_ne_zero_of_isDistinguishedAt hF)).1

theorem lambda_coe_distinguished {F : Polynomial ℤ_[p]}
    (hF : F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p])) :
    lambda (F : ℤ_[p]⟦X⟧) = F.natDegree :=
  ((isWeierstrassNormalForm_distinguished hF).mu_eq_and_lambda_eq
    (coe_ne_zero_of_isDistinguishedAt hF)).2

/-- `μ` and `λ` are additive. -/
theorem mu_mul_and_lambda_mul {f g : ℤ_[p]⟦X⟧} (hf : f ≠ 0) (hg : g ≠ 0) :
    mu (f * g) = mu f + mu g ∧ lambda (f * g) = lambda f + lambda g := by
  obtain ⟨u, Hf⟩ := weierstrassData_spec hf
  obtain ⟨v, Hg⟩ := weierstrassData_spec hg
  have H : IsWeierstrassNormalForm (f * g) (mu f + mu g)
      ((weierstrassData f).2 * (weierstrassData g).2) (u * v) := by
    refine ⟨Hf.isDistinguishedAt.mul Hg.isDistinguishedAt, Hf.isUnit.mul Hg.isUnit, ?_⟩
    rw [Polynomial.coe_mul, pow_add]
    conv_lhs => rw [Hf.eq, Hg.eq]
    ring
  obtain ⟨h1, h2⟩ := H.mu_eq_and_lambda_eq (mul_ne_zero hf hg)
  refine ⟨h1, ?_⟩
  rw [h2, Hf.isDistinguishedAt.monic.natDegree_mul Hg.isDistinguishedAt.monic, lambda, lambda]

theorem mu_mul {f g : ℤ_[p]⟦X⟧} (hf : f ≠ 0) (hg : g ≠ 0) : mu (f * g) = mu f + mu g :=
  (mu_mul_and_lambda_mul hf hg).1

theorem lambda_mul {f g : ℤ_[p]⟦X⟧} (hf : f ≠ 0) (hg : g ≠ 0) :
    lambda (f * g) = lambda f + lambda g := (mu_mul_and_lambda_mul hf hg).2

theorem mu_of_isUnit {u : ℤ_[p]⟦X⟧} (hu : IsUnit u) : mu u = 0 ∧ lambda u = 0 := by
  have H : IsWeierstrassNormalForm u 0 1 u :=
    ⟨⟨⟨fun {i} hi ↦ by simp only [Polynomial.natDegree_one] at hi; omega⟩, Polynomial.monic_one⟩,
      hu, by simp⟩
  obtain ⟨h1, h2⟩ := H.mu_eq_and_lambda_eq hu.ne_zero
  exact ⟨h1, by rw [h2, Polynomial.natDegree_one]⟩

/-- `μ` and `λ` only depend on the ideal generated by `f`. -/
theorem mu_of_associated {f g : ℤ_[p]⟦X⟧} (hf : f ≠ 0) (h : Associated f g) :
    mu f = mu g ∧ lambda f = lambda g := by
  obtain ⟨u, rfl⟩ := h
  obtain ⟨h1, h2⟩ := mu_of_isUnit u.isUnit
  rw [mu_mul hf u.ne_zero, lambda_mul hf u.ne_zero, h1, h2]
  simp

theorem mu_one : mu (1 : ℤ_[p]⟦X⟧) = 0 ∧ lambda (1 : ℤ_[p]⟦X⟧) = 0 := mu_of_isUnit isUnit_one

theorem mu_pow {f : ℤ_[p]⟦X⟧} (hf : f ≠ 0) : ∀ e : ℕ,
    mu (f ^ e) = e * mu f ∧ lambda (f ^ e) = e * lambda f
  | 0 => by simpa using mu_one (p := p)
  | (e + 1) => by
    obtain ⟨h1, h2⟩ := mu_pow hf e
    rw [pow_succ, mu_mul (pow_ne_zero e hf) hf, lambda_mul (pow_ne_zero e hf) hf, h1, h2]
    constructor <;> ring

theorem mu_prod {ι : Type*} (s : Finset ι) (f : ι → ℤ_[p]⟦X⟧) (hf : ∀ i ∈ s, f i ≠ 0) :
    mu (∏ i ∈ s, f i) = ∑ i ∈ s, mu (f i) ∧
      lambda (∏ i ∈ s, f i) = ∑ i ∈ s, lambda (f i) := by
  classical
  induction s using Finset.induction with
  | empty => simpa using mu_one (p := p)
  | insert a s has ih =>
    have h0 : ∏ i ∈ s, f i ≠ 0 :=
      Finset.prod_ne_zero_iff.2 fun i hi ↦ hf i (Finset.mem_insert_of_mem hi)
    obtain ⟨h1, h2⟩ := ih fun i hi ↦ hf i (Finset.mem_insert_of_mem hi)
    rw [Finset.prod_insert has, Finset.sum_insert has, Finset.sum_insert has,
      mu_mul (hf a (Finset.mem_insert_self a s)) h0,
      lambda_mul (hf a (Finset.mem_insert_self a s)) h0, h1, h2]
    exact ⟨rfl, rfl⟩

end Elements

section Modules

variable (p)

open Classical in
/-- The `μ`-invariant of a finitely generated torsion `Λ`-module: the `μ`-invariant of a
generator of its characteristic ideal. -/
noncomputable def muMod (M : Type*) [AddCommGroup M] [Module ℤ_[p]⟦X⟧ M] : ℕ :=
  if h : ∃ a : ℤ_[p]⟦X⟧, a ≠ 0 ∧ Module.charIdeal ℤ_[p]⟦X⟧ M = Ideal.span {a} then
    mu h.choose else 0

open Classical in
/-- The `λ`-invariant of a finitely generated torsion `Λ`-module: the `λ`-invariant of a
generator of its characteristic ideal. -/
noncomputable def lambdaMod (M : Type*) [AddCommGroup M] [Module ℤ_[p]⟦X⟧ M] : ℕ :=
  if h : ∃ a : ℤ_[p]⟦X⟧, a ≠ 0 ∧ Module.charIdeal ℤ_[p]⟦X⟧ M = Ideal.span {a} then
    lambda h.choose else 0

variable {p}
variable {M : Type*} [AddCommGroup M] [Module ℤ_[p]⟦X⟧ M]

/-- The invariants of a module are read off any nonzero generator of its characteristic
ideal. -/
theorem muMod_eq_and_lambdaMod_eq {a : ℤ_[p]⟦X⟧} (ha : a ≠ 0)
    (h : Module.charIdeal ℤ_[p]⟦X⟧ M = Ideal.span {a}) :
    muMod p M = mu a ∧ lambdaMod p M = lambda a := by
  classical
  have hex : ∃ b : ℤ_[p]⟦X⟧, b ≠ 0 ∧ Module.charIdeal ℤ_[p]⟦X⟧ M = Ideal.span {b} := ⟨a, ha, h⟩
  obtain ⟨hb0, hb⟩ := hex.choose_spec
  have hassoc : Associated hex.choose a :=
    Ideal.span_singleton_eq_span_singleton.1 (hb.symm.trans h)
  obtain ⟨h1, h2⟩ := mu_of_associated hb0 hassoc
  rw [muMod, lambdaMod, dif_pos hex, dif_pos hex, h1, h2]
  exact ⟨rfl, rfl⟩

theorem muMod_eq {a : ℤ_[p]⟦X⟧} (ha : a ≠ 0)
    (h : Module.charIdeal ℤ_[p]⟦X⟧ M = Ideal.span {a}) : muMod p M = mu a :=
  (muMod_eq_and_lambdaMod_eq ha h).1

theorem lambdaMod_eq {a : ℤ_[p]⟦X⟧} (ha : a ≠ 0)
    (h : Module.charIdeal ℤ_[p]⟦X⟧ M = Ideal.span {a}) : lambdaMod p M = lambda a :=
  (muMod_eq_and_lambdaMod_eq ha h).2

/-- The invariants of a module, read off a decomposition of a generator of the characteristic
ideal into prime powers: this is blueprint node `iwasawa-mod-invariants-2`. -/
theorem muMod_eq_sum_and_lambdaMod_eq_sum {ι : Type*} [Fintype ι] (g : ι → ℤ_[p]⟦X⟧)
    (e : ι → ℕ) (hg : ∀ i, Prime (g i))
    (h : Module.charIdeal ℤ_[p]⟦X⟧ M = Ideal.span {∏ i, g i ^ e i}) :
    muMod p M = ∑ i, e i * mu (g i) ∧ lambdaMod p M = ∑ i, e i * lambda (g i) := by
  have hne : (∏ i, g i ^ e i) ≠ 0 :=
    Finset.prod_ne_zero_iff.2 fun i _ ↦ pow_ne_zero _ (hg i).ne_zero
  obtain ⟨h1, h2⟩ := mu_prod Finset.univ (fun i ↦ g i ^ e i)
    fun i _ ↦ pow_ne_zero _ (hg i).ne_zero
  refine ⟨?_, ?_⟩
  · rw [muMod_eq hne h, h1]
    exact Finset.sum_congr rfl fun i _ ↦ (mu_pow (hg i).ne_zero (e i)).1
  · rw [lambdaMod_eq hne h, h2]
    exact Finset.sum_congr rfl fun i _ ↦ (mu_pow (hg i).ne_zero (e i)).2

/-- `μ(Λ ⧸ (p ^ c)) = c` and `λ(Λ ⧸ (p ^ c)) = 0`. -/
theorem muMod_quotient_p_pow (c : ℕ) :
    muMod p (ℤ_[p]⟦X⟧ ⧸ (Ideal.span {(p : ℤ_[p]⟦X⟧) ^ c} : Ideal ℤ_[p]⟦X⟧)) = c ∧
      lambdaMod p (ℤ_[p]⟦X⟧ ⧸ (Ideal.span {(p : ℤ_[p]⟦X⟧) ^ c} : Ideal ℤ_[p]⟦X⟧)) = 0 := by
  have hchar := Module.charIdeal_quotient_span_pow_of_prime (prime_p p) c
  have hne : ((p : ℤ_[p]⟦X⟧) ^ c) ≠ 0 := pow_ne_zero _ (prime_p p).ne_zero
  obtain ⟨h1, h2⟩ := mu_pow (prime_p p).ne_zero c
  rw [muMod_eq hne hchar, lambdaMod_eq hne hchar, h1, h2, mu_p, lambda_p]
  simp

/-- `μ(Λ ⧸ (F ^ c)) = 0` and `λ(Λ ⧸ (F ^ c)) = c * deg F` for `F` distinguished. -/
theorem muMod_quotient_distinguished_pow {F : Polynomial ℤ_[p]}
    (hF : F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p]))
    (hFp : Prime (F : ℤ_[p]⟦X⟧)) (c : ℕ) :
    muMod p (ℤ_[p]⟦X⟧ ⧸ (Ideal.span {(F : ℤ_[p]⟦X⟧) ^ c} : Ideal ℤ_[p]⟦X⟧)) = 0 ∧
      lambdaMod p (ℤ_[p]⟦X⟧ ⧸ (Ideal.span {(F : ℤ_[p]⟦X⟧) ^ c} : Ideal ℤ_[p]⟦X⟧)) =
        c * F.natDegree := by
  have hchar := Module.charIdeal_quotient_span_pow_of_prime hFp c
  have hne : ((F : ℤ_[p]⟦X⟧) ^ c) ≠ 0 := pow_ne_zero _ hFp.ne_zero
  obtain ⟨h1, h2⟩ := mu_pow hFp.ne_zero c
  rw [muMod_eq hne hchar, lambdaMod_eq hne hchar, h1, h2, mu_coe_distinguished hF,
    lambda_coe_distinguished hF]
  simp

end Modules

end IwasawaAlgebra
