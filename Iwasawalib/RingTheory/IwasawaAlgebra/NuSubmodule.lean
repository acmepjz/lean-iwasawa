module

public import Iwasawalib.RingTheory.IwasawaAlgebra.CoinvariantGrowth
public import Iwasawalib.RingTheory.IwasawaAlgebra.LambdaTopology

@[expose] public section

/-!
# `Y_n = ν_n Y`, the module-theoretic core of Step 2 of `Xn-isom-qout-of-totally-ramified`

Blueprint node `Xn-isom-qout-of-totally-ramified`, Step 2, identifies the submodule `Y_n`
attached to the base field `K_n` with `ν_n Y`, where `Y` is the submodule attached to `K` and

`ν_{n,e} := ∑_{k < p ^ (n - e)} γ ^ (k p ^ e)`.

Concretely `Y` is the closed `Λ`-submodule generated by `ω_e X_∞` and finitely many elements
`a_2, …, a_s`, and `Y_n` is the closed `Λ`-submodule generated by `ω_n X_∞` and
`ν_{n,e} a_2, …, ν_{n,e} a_s`.  This file proves, for an arbitrary `Λ`-module and an arbitrary
generating set `A`, the two statements that make that step work:

* `IwasawaAlgebra.nu_smul_sup_span`: the purely algebraic identity
  `ν_{n,e} · (ω_e M + ⟨A⟩) = ω_n M + ⟨ν_{n,e} · A⟩`, which rests on `ω_e ν_{n,e} = ω_n`
  (`Polynomial.nu_mul_oneAddXPowSubOne`);
* `IwasawaAlgebra.nu_smul_topologicalClosure_sup_span`: the same identity for the topological
  closures, valid on a compact Hausdorff `Λ`-module, because `ν_{n,e} · (-)` is continuous and
  therefore carries closures to closures there (`IwasawaAlgebra.smul_topologicalClosure`).

The blueprint deduces `Y_n = ν_n Y` from these together with the observation that modulo
`ν_n ω_e M` the elements `ν_n a_i` are `γ`-fixed, so that the closed `Λ`-submodule and the
closed subgroup generated by them agree.  That last remark is only needed to match the
*subgroup*-theoretic description of `Y_n`; the `Λ`-submodule statement proved here is the one
used downstream, in `MvZpExtension.exists_multiplicity_classNumber_of_card_eq`.
-/

open PowerSeries
open scoped Pointwise
open scoped PowerSeries.WithPiTopology

namespace IwasawaAlgebra

variable {p : ℕ} [Fact p.Prime]

/-! ### `ω` and `ν` inside `Λ` -/

/-- `ω_e ν_{n,e} = ω_n` in `Λ = ℤ_p⟦X⟧`, the image of `Polynomial.nu_mul_oneAddXPowSubOne`. -/
theorem coe_oneAddXPowSubOne_mul_coe_nu {n e : ℕ} (h : e ≤ n) :
    ((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) *
        ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)
      = ((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) := by
  rw [← Polynomial.coe_mul, Polynomial.nu_mul_oneAddXPowSubOne ℤ_[p] p h]

/-- `ω_0 = (1 + X) ^ (p ^ 0) - 1 = X = T`. -/
theorem coe_oneAddXPowSubOne_pow_zero :
    ((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ 0) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) = X := by
  rw [Polynomial.oneAddXPowSubOne_def]
  simp

/-! ### The algebraic identity -/

section Algebraic

variable {M : Type*} [AddCommGroup M] [Module ℤ_[p]⟦X⟧ M]

/-- **Blueprint node `Xn-isom-qout-of-totally-ramified`, Step 2, algebraic form.**
`ν_{n,e} · (ω_e M + ⟨A⟩) = ω_n M + ⟨ν_{n,e} · A⟩`. -/
theorem nu_smul_sup_span (A : Set M) {n e : ℕ} (h : e ≤ n) :
    ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) :
              ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)) ⊔ Submodule.span ℤ_[p]⟦X⟧ A)
      = (Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
            ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)) ⊔
          Submodule.span ℤ_[p]⟦X⟧
            (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) • A) := by
  set nu : ℤ_[p]⟦X⟧ := ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) with hnu
  set N : Submodule ℤ_[p]⟦X⟧ M :=
    Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)} •
      (⊤ : Submodule ℤ_[p]⟦X⟧ M) with hN
  set P : Submodule ℤ_[p]⟦X⟧ M := Submodule.span ℤ_[p]⟦X⟧ A with hP
  have h1 : nu • N = Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) :
      Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M) := by
    rw [hN, ← Submodule.ideal_span_singleton_smul, ← Submodule.mul_smul,
      Ideal.span_singleton_mul_span_singleton, hnu, mul_comm,
      coe_oneAddXPowSubOne_mul_coe_nu h]
  have h2 : nu • P = Submodule.span ℤ_[p]⟦X⟧ (nu • A) := Submodule.smul_span nu A
  calc nu • (N ⊔ P) = Ideal.span {nu} • (N ⊔ P) :=
        (Submodule.ideal_span_singleton_smul nu _).symm
    _ = Ideal.span {nu} • N ⊔ Ideal.span {nu} • P := Submodule.smul_sup _ _ _
    _ = nu • N ⊔ nu • P := by
        rw [Submodule.ideal_span_singleton_smul, Submodule.ideal_span_singleton_smul]
    _ = _ := by rw [h1, h2]

end Algebraic

/-! ### Passing to closures -/

section Topological

variable {M : Type*} [AddCommGroup M] [Module ℤ_[p]⟦X⟧ M] [TopologicalSpace M]
  [IsTopologicalAddGroup M] [CompactSpace M] [T2Space M] [ContinuousSMul ℤ_[p]⟦X⟧ M]

/-- On a compact Hausdorff topological module, multiplication by a ring element commutes with
taking the closure of a submodule. -/
theorem smul_topologicalClosure (r : ℤ_[p]⟦X⟧) (N : Submodule ℤ_[p]⟦X⟧ M) :
    r • N.topologicalClosure = (r • N).topologicalClosure := by
  have hcont : Continuous fun z : M ↦ r • z := continuous_const.smul continuous_id
  have himg : ((r • N.topologicalClosure : Submodule ℤ_[p]⟦X⟧ M) : Set M)
      = (fun z : M ↦ r • z) '' (closure (N : Set M)) := by
    rw [Submodule.coe_pointwise_smul, Submodule.topologicalClosure_coe]
    rfl
  refine le_antisymm ?_ ?_
  · -- `r • closure N ⊆ closure (r • N)` by continuity
    intro z hz
    have hz' : z ∈ (fun z : M ↦ r • z) '' (closure (N : Set M)) := himg ▸ hz
    have h2 := image_closure_subset_closure_image hcont hz'
    have h3 : z ∈ closure ((r • N : Submodule ℤ_[p]⟦X⟧ M) : Set M) := by
      rwa [show ((r • N : Submodule ℤ_[p]⟦X⟧ M) : Set M)
        = (fun z : M ↦ r • z) '' (N : Set M) from by
          rw [Submodule.coe_pointwise_smul]; rfl]
    rwa [← Submodule.topologicalClosure_coe] at h3
  · -- `r • closure N` is compact, hence closed, and contains `r • N`
    have hcl : IsClosed ((r • N.topologicalClosure : Submodule ℤ_[p]⟦X⟧ M) : Set M) := by
      have hK : IsCompact ((N.topologicalClosure : Submodule ℤ_[p]⟦X⟧ M) : Set M) :=
        N.isClosed_topologicalClosure.isCompact
      rw [himg, ← Submodule.topologicalClosure_coe]
      exact (hK.image hcont).isClosed
    exact Submodule.topologicalClosure_minimal _
      (smul_le_smul_left r N.le_topologicalClosure) hcl

/-- **Blueprint node `Xn-isom-qout-of-totally-ramified`, Step 2**, for the closed submodules
that actually occur: `ν_{n,e} · Y = Y_n`, where `Y` is the closed `Λ`-submodule generated by
`ω_e M` and `A`, and `Y_n` the one generated by `ω_n M` and `ν_{n,e} · A`. -/
theorem nu_smul_topologicalClosure_sup_span (A : Set M) {n e : ℕ} (h : e ≤ n) :
    ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) •
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) :
              ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)) ⊔
            Submodule.span ℤ_[p]⟦X⟧ A).topologicalClosure
      = ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
            ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)) ⊔
          Submodule.span ℤ_[p]⟦X⟧
            (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) • A)
          ).topologicalClosure := by
  rw [smul_topologicalClosure, nu_smul_sup_span A h]

end Topological

end IwasawaAlgebra
