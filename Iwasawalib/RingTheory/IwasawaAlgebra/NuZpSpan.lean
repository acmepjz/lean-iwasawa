module

public import Iwasawalib.RingTheory.IwasawaAlgebra.ClosedSubmodule
public import Iwasawalib.RingTheory.IwasawaAlgebra.FgTorsionSpan

@[expose] public section

/-!
# `ν_{n,e} · (ℤ_p·a + ω_e M) = ℤ_p·(ν_{n,e}·a) + ω_n M`

This is Step 2 of blueprint node `Xn-isom-qout-of-totally-ramified` at the `ℤ_p`-level, which
is the level at which `MvZpExtension.moduleFinite_and_isTorsion_Xinf_Yn` consumes it:
`IwasawaAlgebra.nu_smul_sup_span` (in
`Iwasawalib.RingTheory.IwasawaAlgebra.NuSubmodule`) is the same identity for `Λ`-submodules and
`Λ`-spans, but the submodule `Y_n = Gal(L∞/K∞L_n)` enters Step 3 only as a `ℤ_p`-submodule,
and `ν_{n,e} Y` is formed there as `Submodule.map (IwasawaAlgebra.lsmulZp M ν_{n,e})`.

No topology is needed: `ℤ_p·a + ω_e M` is *already closed*
(`IwasawaAlgebra.isClosed_coe_span_sup`), so no closure has to be taken and none has to be
moved across `ν_{n,e} · (-)`.

## Main results

* `IwasawaAlgebra.map_lsmulZp_restrictScalars_smul`: `r · (N|_{ℤ_p}) = (r · N)|_{ℤ_p}`.
* `IwasawaAlgebra.map_lsmulZp_span_sup`: the identity itself.
* `IwasawaAlgebra.nu_self`: `ν_{e,e} = 1`, so that the identity is trivial at `n = e`.
-/

open PowerSeries
open scoped Pointwise
open scoped PowerSeries.WithPiTopology

namespace IwasawaAlgebra

variable {p : ℕ} [Fact p.Prime]

variable {M : Type*} [AddCommGroup M] [Module ℤ_[p] M] [Module ℤ_[p]⟦X⟧ M]
  [IsScalarTower ℤ_[p] ℤ_[p]⟦X⟧ M]

/-- Multiplication by `r : Λ` carries the `ℤ_p`-submodule underlying a `Λ`-submodule `N` onto
the one underlying `r · N`. -/
theorem map_lsmulZp_restrictScalars_smul (r : ℤ_[p]⟦X⟧) (N : Submodule ℤ_[p]⟦X⟧ M) :
    Submodule.map (lsmulZp M r) (N.restrictScalars ℤ_[p])
      = (r • N).restrictScalars ℤ_[p] := by
  refine Submodule.ext fun x ↦ ?_
  rw [Submodule.mem_map, Submodule.restrictScalars_mem, Submodule.mem_smul_pointwise_iff_exists]
  exact ⟨fun ⟨y, hy, hxy⟩ ↦ ⟨y, hy, hxy⟩, fun ⟨y, hy, hxy⟩ ↦ ⟨y, hy, hxy⟩⟩

/-- **Step 2 at the `ℤ_p`-level**: `ν_{n,e} · (ℤ_p·a + ω_e M) = ℤ_p·(ν_{n,e}·a) + ω_n M`.
The `ℤ_p`-span passes through because `ν_{n,e} · (-)` is `ℤ_p`-linear
(`IwasawaAlgebra.lsmulZp`), and `ν_{n,e} ω_e = ω_n`
(`IwasawaAlgebra.nu_smul_omega_smul_top`). -/
theorem map_lsmulZp_span_sup (A : Set M) {n e : ℕ} (h : e ≤ n) :
    Submodule.map (lsmulZp M ((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧))
        (Submodule.span ℤ_[p] A ⊔
          ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ e) : Polynomial ℤ_[p]) :
            ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)).restrictScalars ℤ_[p]))
      = Submodule.span ℤ_[p]
          (((Polynomial.nu ℤ_[p] p n e : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧) • A) ⊔
        ((Ideal.span {((Polynomial.oneAddXPowSubOne ℤ_[p] (p ^ n) : Polynomial ℤ_[p]) :
          ℤ_[p]⟦X⟧)} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)).restrictScalars ℤ_[p]) := by
  rw [Submodule.map_sup, Submodule.map_span, map_lsmulZp_restrictScalars_smul,
    nu_smul_omega_smul_top (M := M) h]
  congr 2

/-! ### The blueprint's "closure of the subgroup generated by" -/

section Closed

variable [TopologicalSpace M] [IsTopologicalAddGroup M] [CompactSpace M] [T2Space M]
  [ContinuousSMul ℤ_[p] M] [ContinuousSMul ℤ_[p]⟦X⟧ M]

omit [IsTopologicalAddGroup M] [CompactSpace M] [T2Space M] [ContinuousSMul ℤ_[p] M] in
/-- **A closed additive subgroup of a topological `Λ`-module is a `ℤ_p`-submodule.**  This is
`IwasawaAlgebra.C_smul_mem_of_isClosed` (`ℤ` is dense in `ℤ_p`) read through the scalar
tower. -/
theorem zpSMul_mem_of_isClosed {S : AddSubgroup M} (hS : IsClosed (S : Set M)) {x : M}
    (hx : x ∈ S) (c : ℤ_[p]) : c • x ∈ S := by
  have h := C_smul_mem_of_isClosed hS hx c
  rwa [show (C c : ℤ_[p]⟦X⟧) = algebraMap ℤ_[p] ℤ_[p]⟦X⟧ c from rfl, algebraMap_smul] at h

/-- **The closed subgroup generated by a finite set `a` and by `r · M` is the `ℤ_p`-submodule
`ℤ_p·a + r·M`.**  This is the identification that lets the blueprint's description of `Y_n` —
*the closure of the subgroup generated by `ω_n X∞` and the `a_i^{(n)}`* — be used as the
`ℤ_p`-submodule equality that Step 3 consumes.  Both containments are cheap: `ℤ_p·a + r·M` is
closed (`IwasawaAlgebra.isClosed_coe_span_sup`) and contains the generators, and conversely a
closed subgroup is `ℤ_p`-stable, so the closure already contains `ℤ_p·a`. -/
theorem topologicalClosure_closure_union_eq_span_sup (a : Finset M) (r : ℤ_[p]⟦X⟧) :
    (AddSubgroup.closure ((a : Set M) ∪
        ((Ideal.span {r} • (⊤ : Submodule ℤ_[p]⟦X⟧ M) : Submodule ℤ_[p]⟦X⟧ M) :
          Set M))).topologicalClosure
      = (Submodule.span ℤ_[p] (a : Set M) ⊔
          ((Ideal.span {r} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)).restrictScalars ℤ_[p] :
            Submodule ℤ_[p] M)).toAddSubgroup := by
  set S : Set M := (a : Set M) ∪
    ((Ideal.span {r} • (⊤ : Submodule ℤ_[p]⟦X⟧ M) : Submodule ℤ_[p]⟦X⟧ M) : Set M) with hS
  set N : Submodule ℤ_[p] M := Submodule.span ℤ_[p] (a : Set M) ⊔
    ((Ideal.span {r} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)).restrictScalars ℤ_[p]) with hNdef
  have hsub : AddSubgroup.closure S ≤ N.toAddSubgroup := by
    rw [AddSubgroup.closure_le]
    rintro x (hx | hx)
    · exact Submodule.mem_sup_left (Submodule.subset_span hx)
    · exact Submodule.mem_sup_right hx
  refine le_antisymm (AddSubgroup.topologicalClosure_minimal _ hsub
    (isClosed_coe_span_sup a r)) ?_
  set T : AddSubgroup M := (AddSubgroup.closure S).topologicalClosure with hTdef
  have hTcl : IsClosed (T : Set M) := AddSubgroup.isClosed_topologicalClosure _
  have hgen : S ⊆ (T : Set M) :=
    fun x hx ↦ AddSubgroup.le_topologicalClosure _ (AddSubgroup.subset_closure hx)
  let P : Submodule ℤ_[p] M :=
    { carrier := (T : Set M)
      add_mem' := T.add_mem
      zero_mem' := T.zero_mem
      smul_mem' := fun c _ hx ↦ zpSMul_mem_of_isClosed hTcl hx c }
  have h1 : Submodule.span ℤ_[p] (a : Set M) ≤ P :=
    Submodule.span_le.2 fun x hx ↦ hgen (Or.inl hx)
  have h2 : ((Ideal.span {r} • (⊤ : Submodule ℤ_[p]⟦X⟧ M)).restrictScalars ℤ_[p] :
      Submodule ℤ_[p] M) ≤ P := fun x hx ↦ hgen (Or.inr hx)
  exact fun x hx ↦ sup_le h1 h2 hx

end Closed

/-- `ν_{e,e} = 1`. -/
theorem nu_self (R : Type*) [CommRing R] (q e : ℕ) : Polynomial.nu R q e e = 1 := by
  rw [Polynomial.nu]
  simp

end IwasawaAlgebra
