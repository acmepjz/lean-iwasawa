@[expose] public section

/-!
# `quotient-by-distinguished` (iii)

Let `F ∈ ℤ_p[X]` be a distinguished polynomial of degree `d ≥ 1` and let `g ∈ ℤ_p[X]` be such
that multiplication by `g` is injective on `ℤ_p[X] ⧸ (F)`. Then `ℤ_p[X] ⧸ (F, g)` is finite and
`ord_p #(ℤ_p[X] ⧸ (F, g)) = ∑_α v(g(α))`, where `α` runs over the `d` roots of `F` in `ℚ̄_p`,
counted with multiplicity.

## Main results

* `AdjoinRoot.card_quotient_span_singleton`: `#(ℤ_p[X] ⧸ (F, g)) = p ^ v(N(g))` where
  `N(g) = Algebra.norm ℤ_[p] (mk F g)`.
* `Polynomial.IsDistinguishedAt.val_norm_eq_sum_roots`: `v(N(g)) = ∑_α v(g(α))`.
* `Polynomial.IsDistinguishedAt.card_quotient_pair`: **blueprint node
  `quotient-by-distinguished` (iii)**, in the polynomial ring.
* `Polynomial.IsDistinguishedAt.card_quotient_pair_powerSeries`: the same statement for the
  Iwasawa algebra `Λ = ℤ_p⟦X⟧`.
-/

open Polynomial PowerSeries

/-- `ℤ_p` is complete for the `(p)`-adic topology. This is
`PadicInt.instIsAdicCompleteMaximalIdeal` transported along
`PadicInt.maximalIdeal_eq_span_p`. -/
instance PadicInt.instIsAdicCompleteSpanSingletonP (p : ℕ) [Fact p.Prime] :
    IsAdicComplete (Ideal.span {(p : ℤ_[p])}) ℤ_[p] := by
  rw [← PadicInt.maximalIdeal_eq_span_p]
  infer_instance

namespace Ideal

variable {R : Type*} [CommRing R]

/-- `R ⧸ (a, b)` is the quotient of `R ⧸ (a)` by the ideal generated by the class of `b`. -/
noncomputable def quotientPairEquiv (a b : R) :
    (R ⧸ Ideal.span {a, b}) ≃+*
      ((R ⧸ Ideal.span {a}) ⧸ (Ideal.span {Ideal.Quotient.mk (Ideal.span {a}) b} :
        Ideal (R ⧸ Ideal.span {a}))) := by
  refine RingEquiv.trans (Ideal.quotEquivOfEq ?_)
    (DoubleQuot.quotQuotEquivQuotSup (Ideal.span {a}) (Ideal.span {b})).symm |>.trans
      (Ideal.quotEquivOfEq ?_)
  · rw [show ({a, b} : Set R) = {a} ∪ {b} from rfl, Ideal.span_union]
  · rw [Ideal.map_span, Set.image_singleton]

/-- Transport of `R ⧸ (a, b)` along an isomorphism `R ⧸ (a) ≃ S ⧸ (a')` matching the classes
of `b` and `b'`. -/
theorem card_quotient_pair_congr {S : Type*} [CommRing S] (a b : R) (a' b' : S)
    (e : (R ⧸ Ideal.span {a}) ≃+* (S ⧸ Ideal.span {a'}))
    (he : e (Ideal.Quotient.mk _ b) = Ideal.Quotient.mk _ b') :
    Nat.card (R ⧸ Ideal.span {a, b}) = Nat.card (S ⧸ Ideal.span {a', b'}) := by
  rw [Nat.card_congr (quotientPairEquiv a b).toEquiv,
    Nat.card_congr (quotientPairEquiv a' b').toEquiv]
  refine Nat.card_congr (Ideal.quotientEquiv _ _ e ?_).toEquiv
  rw [Ideal.map_span, Set.image_singleton]
  exact congrArg (fun x ↦ Ideal.span {x}) he.symm

end Ideal

namespace AdjoinRoot

variable {p : ℕ} [Fact p.Prime] {F : Polynomial ℤ_[p]} (hF : F.Monic) {g : Polynomial ℤ_[p]}

/-- The range of the multiplication by `mk F g` is the ideal it generates. -/
theorem range_lmul_eq_span (x : AdjoinRoot F) :
    (Ideal.span {x} : Ideal (AdjoinRoot F)).carrier =
      (LinearMap.range ((Algebra.lmul ℤ_[p] (AdjoinRoot F)) x)).carrier := by
  ext z
  simp only [Submodule.carrier_eq_coe, SetLike.mem_coe, LinearMap.mem_range,
    Ideal.mem_span_singleton', Algebra.coe_lmul_eq_mul, LinearMap.mul_apply']
  exact ⟨fun ⟨c, hc⟩ ↦ ⟨c, by rw [← hc]; exact mul_comm _ _⟩,
    fun ⟨y, hy⟩ ↦ ⟨y, by rw [← hy]; exact mul_comm _ _⟩⟩

include hF

omit hF in
/-- Multiplication by `g` is injective on `ℤ_p[X] ⧸ (F)` as soon as `F ∣ g * h` forces
`F ∣ h`. -/
theorem injective_lmul_mk (hdvd : ∀ h : Polynomial ℤ_[p], F ∣ g * h → F ∣ h) :
    Function.Injective ((Algebra.lmul ℤ_[p] (AdjoinRoot F)) (mk F g)) := by
  rw [injective_iff_map_eq_zero]
  intro y hy
  induction y using AdjoinRoot.induction_on with
  | ih h =>
    rw [Algebra.coe_lmul_eq_mul, LinearMap.mul_apply', ← map_mul, mk_eq_zero] at hy
    exact mk_eq_zero.2 (hdvd h hy)

/-- **Elementary divisors for `ℤ_p[X] ⧸ (F, g)`**: the quotient of `AdjoinRoot F` by the
ideal generated by `g` has `p ^ v(N(g))` elements, where `N` is the norm. -/
theorem card_quotient_span_singleton (hdvd : ∀ h : Polynomial ℤ_[p], F ∣ g * h → F ∣ h) :
    Nat.card (AdjoinRoot F ⧸ (Ideal.span {mk F g} : Ideal (AdjoinRoot F))) =
      p ^ (Algebra.norm ℤ_[p] (mk F g)).valuation := by
  classical
  have hcard := PadicInt.card_quotient_range (powerBasis' hF).basis
    ((Algebra.lmul ℤ_[p] (AdjoinRoot F)) (mk F g)) (injective_lmul_mk hdvd)
  rw [Algebra.norm_apply, ← hcard]
  exact Nat.card_congr (Ideal.quotientEquivQuotientOfCarrierEq (A := ℤ_[p]) _ _
    (range_lmul_eq_span (mk F g)))

/-- If multiplication by `g` is injective on `ℤ_p[X] ⧸ (F)`, then its norm is nonzero. -/
theorem norm_mk_ne_zero (hdvd : ∀ h : Polynomial ℤ_[p], F ∣ g * h → F ∣ h) :
    Algebra.norm ℤ_[p] (mk F g) ≠ 0 := by
  haveI : Module.Free ℤ_[p] (AdjoinRoot F) := .of_basis (powerBasis' hF).basis
  haveI : Module.Finite ℤ_[p] (AdjoinRoot F) := .of_basis (powerBasis' hF).basis
  rw [Algebra.norm_apply]
  intro h
  exact LinearMap.det_eq_zero_iff_ker_ne_bot.1 h
    (LinearMap.ker_eq_bot.2 (injective_lmul_mk hdvd))

end AdjoinRoot

namespace Polynomial.IsDistinguishedAt

variable {p : ℕ} [Fact p.Prime] {F : Polynomial ℤ_[p]}
  (hF : F.IsDistinguishedAt (Ideal.span {(p : ℤ_[p])})) {g : Polynomial ℤ_[p]}

include hF

/-- The valuation of the norm of `g` in `ℤ_p[X] ⧸ (F)` is the sum of the valuations of the
values of `g` at the roots of `F`. -/
theorem val_norm_eq_sum_roots (hg : Algebra.norm ℤ_[p] (AdjoinRoot.mk F g) ≠ 0) :
    ((Algebra.norm ℤ_[p] (AdjoinRoot.mk F g)).valuation : ℝ) =
      (((F.map (PadicInt.toPadicAlgCl p)).roots.map
        fun α ↦ PadicAlgCl.val p (Polynomial.eval α (g.map (PadicInt.toPadicAlgCl p)))).sum) := by
  set φ := PadicInt.toPadicAlgCl p with hφ
  have hmap := AdjoinRoot.map_norm_mk φ hF.monic g
  have hprod := AdjoinRoot.norm_mk_eq_prod_roots (hF.monic.map φ) (g.map φ)
  rw [hprod] at hmap
  have hinj : Function.Injective φ :=
    (FaithfulSMul.algebraMap_injective ℚ_[p] (PadicAlgCl p)).comp Subtype.coe_injective
  have hnz : ∀ x ∈ (F.map φ).roots.map fun α ↦ Polynomial.eval α (g.map φ), x ≠ 0 := by
    intro x hx hzero
    refine hg (hinj ?_)
    rw [map_zero, hmap]
    exact Multiset.prod_eq_zero (hzero ▸ hx)
  have hv : ((Algebra.norm ℤ_[p] (AdjoinRoot.mk F g)).valuation : ℝ)
      = PadicAlgCl.val p (φ (Algebra.norm ℤ_[p] (AdjoinRoot.mk F g))) :=
    (PadicAlgCl.val_toPadicAlgCl (a := Algebra.norm ℤ_[p] (AdjoinRoot.mk F g)) hg).symm
  rw [hv, hmap, PadicAlgCl.val_multiset_prod (p := p) _ hnz, Multiset.map_map]
  rfl

/-- `ℤ_p[X] ⧸ (F, g)` has `p ^ v(N(g))` elements. -/
theorem card_quotient_pair (hdvd : ∀ h : Polynomial ℤ_[p], F ∣ g * h → F ∣ h) :
    Nat.card (Polynomial ℤ_[p] ⧸ Ideal.span {F, g}) =
      p ^ (Algebra.norm ℤ_[p] (AdjoinRoot.mk F g)).valuation := by
  rw [Nat.card_congr (Ideal.quotientPairEquiv F g).toEquiv]
  exact AdjoinRoot.card_quotient_span_singleton hF.monic hdvd

/-- `Λ ⧸ (F, g)` has `p ^ v(N(g))` elements, for `F` distinguished and `g` a polynomial with
multiplication by `g` injective on `ℤ_p[X] ⧸ (F)`. -/
theorem card_quotient_pair_powerSeries
    (hdvd : ∀ h : Polynomial ℤ_[p], F ∣ g * h → F ∣ h) :
    Nat.card (ℤ_[p]⟦X⟧ ⧸ Ideal.span {(F : ℤ_[p]⟦X⟧), (g : ℤ_[p]⟦X⟧)}) =
      p ^ (Algebra.norm ℤ_[p] (AdjoinRoot.mk F g)).valuation := by
  rw [← card_quotient_pair hF hdvd]
  refine (Ideal.card_quotient_pair_congr F g (F : ℤ_[p]⟦X⟧) (g : ℤ_[p]⟦X⟧)
    hF.algEquivQuotient.toRingEquiv ?_).symm
  exact hF.algEquivQuotient_mk g

/-- **Blueprint node `quotient-by-distinguished` (iii)**: `Λ ⧸ (F, g)` is finite, and
`ord_p #(Λ ⧸ (F, g)) = ∑_α v(g(α))`, the sum being over the roots of `F` in `ℚ̄_p` counted
with multiplicity. -/
theorem exists_card_quotient_pair_powerSeries
   
    (hdvd : ∀ h : Polynomial ℤ_[p], F ∣ g * h → F ∣ h) :
    ∃ k : ℕ, Nat.card (ℤ_[p]⟦X⟧ ⧸ Ideal.span {(F : ℤ_[p]⟦X⟧), (g : ℤ_[p]⟦X⟧)}) = p ^ k ∧
      Nat.card (Polynomial ℤ_[p] ⧸ Ideal.span {F, g}) = p ^ k ∧
      (k : ℝ) = (((F.map (PadicInt.toPadicAlgCl p)).roots.map fun α ↦
        PadicAlgCl.val p (Polynomial.eval α (g.map (PadicInt.toPadicAlgCl p)))).sum) :=
  ⟨(Algebra.norm ℤ_[p] (AdjoinRoot.mk F g)).valuation,
    card_quotient_pair_powerSeries hF hdvd, card_quotient_pair hF hdvd,
    val_norm_eq_sum_roots hF (AdjoinRoot.norm_mk_ne_zero hF.monic hdvd)⟩

/-- `ℤ_p[X] ⧸ (F, g)` is finite. -/
theorem finite_quotient_pair (hdvd : ∀ h : Polynomial ℤ_[p], F ∣ g * h → F ∣ h) :
    Finite (Polynomial ℤ_[p] ⧸ Ideal.span {F, g}) := by
  refine Nat.finite_of_card_ne_zero ?_
  rw [card_quotient_pair hF hdvd]
  exact pow_ne_zero _ (Fact.out : p.Prime).ne_zero

/-- `Λ ⧸ (F, g)` is finite. -/
theorem finite_quotient_pair_powerSeries
   
    (hdvd : ∀ h : Polynomial ℤ_[p], F ∣ g * h → F ∣ h) :
    Finite (ℤ_[p]⟦X⟧ ⧸ Ideal.span {(F : ℤ_[p]⟦X⟧), (g : ℤ_[p]⟦X⟧)}) := by
  refine Nat.finite_of_card_ne_zero ?_
  rw [card_quotient_pair_powerSeries hF hdvd]
  exact pow_ne_zero _ (Fact.out : p.Prime).ne_zero

end Polynomial.IsDistinguishedAt

namespace IwasawaAlgebra

variable {p : ℕ} [Fact p.Prime]

/-- **Blueprint node `quotient-by-distinguished` (iii)**, in the form used in
`growth-general`: if `f` is a prime distinguished polynomial which does not divide the
polynomial `g`, then `Λ ⧸ (f ^ b, g)` is finite of order `p ^ k`, where `k` is the sum of the
valuations `v(g(α))` over the roots `α` of `f ^ b` in `ℚ̄_p`, counted with multiplicity. -/
theorem exists_card_quotient_pow_pair {f : Polynomial ℤ_[p]}
    (hf : f.IsDistinguishedAt (Ideal.span {(p : ℤ_[p])})) (hfp : Prime f) (b : ℕ)
    {g : Polynomial ℤ_[p]} (hfg : ¬ f ∣ g) :
    ∃ k : ℕ,
      Nat.card (ℤ_[p]⟦X⟧ ⧸ Ideal.span {((f ^ b : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧),
        (g : ℤ_[p]⟦X⟧)}) = p ^ k ∧
      Nat.card (Polynomial ℤ_[p] ⧸ Ideal.span {f ^ b, g}) = p ^ k ∧
      (k : ℝ) = ((((f ^ b).map (PadicInt.toPadicAlgCl p)).roots.map fun α ↦
        PadicAlgCl.val p (Polynomial.eval α (g.map (PadicInt.toPadicAlgCl p)))).sum) :=
  (hf.pow b).exists_card_quotient_pair_powerSeries
    fun _ hh ↦ hfp.pow_dvd_of_dvd_mul_left b hfg hh

theorem finite_quotient_pow_pair_powerSeries {f : Polynomial ℤ_[p]}
    (hf : f.IsDistinguishedAt (Ideal.span {(p : ℤ_[p])})) (hfp : Prime f) (b : ℕ)
    {g : Polynomial ℤ_[p]} (hfg : ¬ f ∣ g) :
    Finite (ℤ_[p]⟦X⟧ ⧸ Ideal.span {((f ^ b : Polynomial ℤ_[p]) : ℤ_[p]⟦X⟧), (g : ℤ_[p]⟦X⟧)}) :=
  (hf.pow b).finite_quotient_pair_powerSeries
    fun _ hh ↦ hfp.pow_dvd_of_dvd_mul_left b hfg hh

end IwasawaAlgebra
