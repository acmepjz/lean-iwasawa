@[expose] public section

/-!
# The Iwasawa algebra is a UFD, and its height one primes

Let `Λ = ℤ_p⟦X⟧` be the Iwasawa algebra. This file proves blueprint nodes `Lambda-is-UFD`
and `Lambda-ht-1-principal`:

* `Λ` is a Noetherian local domain which is a unique factorization monoid, hence a Krull
  domain, hence satisfies `HeightOneLocalizationIsPID` (all of these come from Mathlib
  instances, and are recorded here as named theorems);
* every height one prime of `Λ` is principal, generated by a prime element
  (`IwasawaAlgebra.exists_prime_span_eq_of_height_eq_one`);
* if the prime `p` lies in a height one prime `P`, then `P = (p)`
  (`IwasawaAlgebra.eq_span_singleton_p_of_mem`);
* otherwise `P` is generated by a unique distinguished polynomial
  (`IwasawaAlgebra.exists_unique_distinguished_span_eq_of_height_eq_one`).

Along the way we prove that `C q` is a prime element of `R⟦X⟧` whenever `q` is a prime
element of `R` (`PowerSeries.prime_C`), which does not seem to be in Mathlib.
-/

open PowerSeries Finset

namespace PowerSeries

variable {R : Type*} [CommRing R]

/-- A power series is divisible by the constant `q` if and only if all its coefficients are. -/
theorem C_dvd_iff {q : R} {f : R⟦X⟧} : (C q : R⟦X⟧) ∣ f ↔ ∀ i, q ∣ coeff i f := by
  constructor
  · rintro ⟨g, rfl⟩ i
    rw [coeff_C_mul]
    exact Dvd.intro _ rfl
  · intro h
    choose c hc using h
    exact ⟨PowerSeries.mk c, by ext i; rw [coeff_C_mul, coeff_mk, ← hc]⟩

/-- If `q` is a prime element of `R`, then `C q` is a prime element of `R⟦X⟧`. -/
theorem prime_C {q : R} (hq : Prime q) : Prime (C q : R⟦X⟧) := by
  classical
  refine ⟨fun h ↦ hq.ne_zero (by simpa using congr(constantCoeff $h)), ?_, ?_⟩
  · intro h
    exact hq.not_unit (by simpa using h.map (constantCoeff (R := R)))
  · intro f g hfg
    by_contra! hcon
    obtain ⟨hf, hg⟩ := hcon
    rw [C_dvd_iff, not_forall] at hf hg
    set i := Nat.find hf with hidef
    set j := Nat.find hg with hjdef
    have hi : ¬ q ∣ coeff i f := Nat.find_spec hf
    have hj : ¬ q ∣ coeff j g := Nat.find_spec hg
    have hilt : ∀ a < i, q ∣ coeff a f := fun a ha ↦ not_not.1 (Nat.find_min hf ha)
    have hjlt : ∀ b < j, q ∣ coeff b g := fun b hb ↦ not_not.1 (Nat.find_min hg hb)
    have hdvd : q ∣ coeff (i + j) (f * g) := (C_dvd_iff.1 hfg) (i + j)
    rw [coeff_mul] at hdvd
    have hmem : ((i, j) : ℕ × ℕ) ∈ antidiagonal (i + j) := by simp
    rw [← Finset.add_sum_erase _ _ hmem] at hdvd
    have hrest : q ∣ ∑ x ∈ (antidiagonal (i + j)).erase (i, j), coeff x.1 f * coeff x.2 g := by
      refine Finset.dvd_sum fun x hx ↦ ?_
      obtain ⟨hxne, hxmem⟩ := Finset.mem_erase.1 hx
      replace hxmem : x.1 + x.2 = i + j := by simpa using hxmem
      rcases lt_trichotomy x.1 i with h | h | h
      · exact Dvd.dvd.mul_right (hilt _ h) _
      · exact absurd (Prod.ext h (by omega)) hxne
      · exact Dvd.dvd.mul_left (hjlt _ (by omega)) _
    have : q ∣ coeff i f * coeff j g := (dvd_add_right hrest).1 (by rwa [add_comm] at hdvd)
    exact (hq.2.2 _ _ this).elim hi hj

end PowerSeries

/-- In a unique factorization domain, every height one prime is generated by a prime
element. -/
theorem UniqueFactorizationMonoid.exists_prime_span_eq_of_height_eq_one
    {A : Type*} [CommRing A] [IsDomain A] [UniqueFactorizationMonoid A]
    {P : Ideal A} [P.IsPrime] (hP : P.height = 1) :
    ∃ q : A, Prime q ∧ P = Ideal.span {q} := by
  have hPbot : P ≠ ⊥ := Ideal.ne_bot_of_height_eq_one hP
  obtain ⟨a, haP, ha0⟩ : ∃ a ∈ P, a ≠ 0 := by
    by_contra! h
    exact hPbot (by rw [eq_bot_iff]; intro x hx; simpa using h x hx)
  have hprod : (UniqueFactorizationMonoid.factors a).prod ∈ P := by
    obtain ⟨u, hu⟩ := UniqueFactorizationMonoid.factors_prod ha0
    rw [← hu] at haP
    exact (Ideal.IsPrime.mul_mem_iff_mem_or_mem ‹_›).1 haP |>.resolve_right
      (fun h ↦ ‹P.IsPrime›.ne_top (Ideal.eq_top_of_isUnit_mem _ h u.isUnit))
  obtain ⟨q, hqmem, hqP⟩ := (Ideal.IsPrime.multiset_prod_mem_iff_exists_mem ‹_› _).1 hprod
  have hq : Prime q := UniqueFactorizationMonoid.prime_of_factor q hqmem
  exact ⟨q, hq, Ideal.eq_span_singleton_of_height_eq_one hP hqP hq⟩

namespace IwasawaAlgebra

variable (p : ℕ) [Fact p.Prime]

/-- **Blueprint node `Lambda-is-UFD`**: the Iwasawa algebra `Λ = ℤ_p⟦X⟧` is a unique
factorization domain. -/
theorem uniqueFactorizationMonoid_powerSeries : UniqueFactorizationMonoid ℤ_[p]⟦X⟧ :=
  inferInstance

/-- `Λ = ℤ_p⟦X⟧` is a Noetherian ring. -/
theorem isNoetherianRing_powerSeries : IsNoetherianRing ℤ_[p]⟦X⟧ := inferInstance

/-- `Λ = ℤ_p⟦X⟧` is a domain. -/
theorem isDomain_powerSeries : IsDomain ℤ_[p]⟦X⟧ := inferInstance

/-- `Λ = ℤ_p⟦X⟧` is a local ring. -/
theorem isLocalRing_powerSeries : IsLocalRing ℤ_[p]⟦X⟧ := inferInstance

/-- `Λ = ℤ_p⟦X⟧` is a Krull domain. -/
theorem isKrullDomain_powerSeries : IsKrullDomain ℤ_[p]⟦X⟧ := inferInstance

/-- The height one localizations of `Λ = ℤ_p⟦X⟧` are PIDs. This is the hypothesis needed
to apply the structure theorem. -/
theorem heightOneLocalizationIsPID_powerSeries : HeightOneLocalizationIsPID ℤ_[p]⟦X⟧ :=
  inferInstance

/-- `p` is a prime element of `Λ = ℤ_p⟦X⟧`. -/
theorem prime_p : Prime (p : ℤ_[p]⟦X⟧) := by
  have : (p : ℤ_[p]⟦X⟧) = PowerSeries.C (p : ℤ_[p]) := by rw [map_natCast]
  rw [this]
  exact PowerSeries.prime_C (PadicInt.prime_p (p := p))

variable {p}

/-- A power series over `ℤ_p` reduces to zero in `𝔽_p⟦X⟧` if and only if it is divisible
by `p`. -/
theorem map_residue_eq_zero_iff {g : ℤ_[p]⟦X⟧} :
    g.map (IsLocalRing.residue ℤ_[p]) = 0 ↔ (p : ℤ_[p]⟦X⟧) ∣ g := by
  rw [show ((p : ℤ_[p]⟦X⟧)) = PowerSeries.C (p : ℤ_[p]) from (map_natCast _ _).symm,
    PowerSeries.C_dvd_iff]
  rw [PowerSeries.ext_iff]
  refine forall_congr' fun i ↦ ?_
  rw [PowerSeries.coeff_map, map_zero, IsLocalRing.residue_eq_zero_iff,
    PadicInt.maximalIdeal_eq_span_p, Ideal.mem_span_singleton]

/-- **Blueprint node `Lambda-ht-1-principal`**: every height one prime of `Λ = ℤ_p⟦X⟧` is
generated by a prime element. -/
theorem exists_prime_span_eq_of_height_eq_one {P : Ideal ℤ_[p]⟦X⟧} [P.IsPrime]
    (hP : P.height = 1) : ∃ q : ℤ_[p]⟦X⟧, Prime q ∧ P = Ideal.span {q} :=
  UniqueFactorizationMonoid.exists_prime_span_eq_of_height_eq_one hP

/-- **Blueprint node `Lambda-ht-1-principal` (i)**: a height one prime of `Λ` containing `p`
is equal to `(p)`. -/
theorem eq_span_singleton_p_of_mem {P : Ideal ℤ_[p]⟦X⟧} [P.IsPrime] (hP : P.height = 1)
    (hp : (p : ℤ_[p]⟦X⟧) ∈ P) : P = Ideal.span {(p : ℤ_[p]⟦X⟧)} :=
  Ideal.eq_span_singleton_of_height_eq_one hP hp (prime_p p)

/-- If two distinguished polynomials generate the same ideal of `ℤ_p⟦X⟧`, they are equal.
This is the uniqueness half of the Weierstrass preparation theorem. -/
theorem IsDistinguishedAt.eq_of_span_eq {F F' : Polynomial ℤ_[p]}
    (hF : F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p]))
    (hF' : F'.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p]))
    (h : Ideal.span {(F : ℤ_[p]⟦X⟧)} = Ideal.span {(F' : ℤ_[p]⟦X⟧)}) : F = F' := by
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.1 h
  have H1 : (F' : ℤ_[p]⟦X⟧).IsWeierstrassFactorization F (u : ℤ_[p]⟦X⟧) :=
    ⟨hF, u.isUnit, by rw [← hu]⟩
  have H2 : (F' : ℤ_[p]⟦X⟧).IsWeierstrassFactorization F' 1 := ⟨hF', isUnit_one, by ring⟩
  exact (H1.elim H2).1

/-- **Blueprint node `Lambda-ht-1-principal` (ii)**: a height one prime of `Λ` not containing
`p` is generated by a unique distinguished polynomial. -/
theorem exists_unique_distinguished_span_eq_of_height_eq_one {P : Ideal ℤ_[p]⟦X⟧} [P.IsPrime]
    (hP : P.height = 1) (hp : (p : ℤ_[p]⟦X⟧) ∉ P) :
    ∃! F : Polynomial ℤ_[p], F.IsDistinguishedAt (IsLocalRing.maximalIdeal ℤ_[p]) ∧
      P = Ideal.span {(F : ℤ_[p]⟦X⟧)} := by
  obtain ⟨g, hg, rfl⟩ := exists_prime_span_eq_of_height_eq_one hP
  have hgp : ¬ (p : ℤ_[p]⟦X⟧) ∣ g := by
    rintro ⟨h, rfl⟩
    rcases hg.2.2 (p : ℤ_[p]⟦X⟧) h dvd_rfl with hd | hd
    · exact hp (Ideal.mem_span_singleton.2 hd)
    · obtain ⟨k, hk⟩ := hd
      have hh0 : h ≠ 0 := fun h0 ↦ hg.ne_zero (by simp [h0])
      have hz : h * (1 - (p : ℤ_[p]⟦X⟧) * k) = 0 := by linear_combination hk
      rcases mul_eq_zero.1 hz with h1 | h1
      · exact hh0 h1
      · exact (prime_p p).not_unit ⟨⟨(p : ℤ_[p]⟦X⟧), k, by linear_combination -h1,
          by linear_combination -h1⟩, rfl⟩
  have hmap : g.map (IsLocalRing.residue ℤ_[p]) ≠ 0 := fun h ↦ hgp (map_residue_eq_zero_iff.1 h)
  obtain ⟨F, u, hFu⟩ := PowerSeries.exists_isWeierstrassFactorization hmap
  refine ⟨F, ⟨hFu.isDistinguishedAt, ?_⟩, ?_⟩
  · rw [hFu.eq_mul, Ideal.span_singleton_mul_right_unit hFu.isUnit]
  · rintro F' ⟨hF', hspan⟩
    refine (IsDistinguishedAt.eq_of_span_eq hF' hFu.isDistinguishedAt ?_)
    rw [← hspan, hFu.eq_mul, Ideal.span_singleton_mul_right_unit hFu.isUnit]

end IwasawaAlgebra
